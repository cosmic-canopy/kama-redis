{
  "name": "@kama/redis",
  "version": "0.2.0",
  "license": "MIT OR Apache-2.0",
  "kind": "library",
  "kama": ">=0.9.667",
  "description": "Redis and Valkey client in pure kama: RESP2 and RESP3, TLS, pipelining, pub/sub, cluster and sentinel",
  "repository": "https://github.com/cosmic-canopy/kama-redis",
  "keywords": ["redis", "valkey", "resp", "database", "cache"],
  "dependencies": {
    "@kama/tls": { "version": "^0.1.3" }
  },
  "publish": {
    "exclude": [
      ".claude/", ".github/", "tools/", "docs/",
      "AGENTS.md", "AGENTS.package.md", "AGENTS.redis.md", "CLAUDE.md", "KAMA_GAPS.md"
    ]
  },
  "modules": {
    ".": { "visibility": "public" },
    "resp": { "visibility": "public" },
    "cluster": { "visibility": "public" },
    "wire": { "visibility": "internal" },
    "secure": { "visibility": "internal" }
  }
}
