// redis::Config. The URL's own reading is RedisUrl's (url_test.kama); these are the options this package decides
// (src/config.kama's header, docs/ROADMAP.md "Phase 2"), each honoured or refused, and the typed setters.
import { core::println, std::collections::DynamicArray, std::time::Duration, redis::Config, redis::Protocol,
         redis::RedisError, redis::UrlTransport, redis::TlsVerify, redis::TlsVersion, redis::SentinelRole, redis::ReadFrom,
         redis::Connection, redis::Subscriber, redis::Transport, redis::socketPathMax, std::memory::Owned,
         redis_unit_tests::check, FakeServer, Step };
export { configTests };

fn string refusal(const ref string url) {
    Result<Config, RedisError> r = Config.parse(url: url);
    return match (r) { case Ok(value: c): "accepted"; case Err(error: e): e.message(); };
}

fn bool accepted(const ref string url) { return refusal(url: url) == "accepted"; }

fn Config parsed(const ref string url) {
    Result<Config, RedisError> r = Config.parse(url: url);
    Config c = match (give r) {
        case Ok(value: v): give v;
        case Err(error: e): { string m = e.message(); panic(msg: "config_test: ${m}"); }
    };
    return give c;
}

// `n` bytes of x.
fn string xs(isize n) {
    string s = "";
    isize i = 0;
    while (i < n) { s = s.concat(other: "x"); i = i + 1; }
    return s;
}

fn int64 ms(Duration d) { return d.asMillis(); }

fn bool refusedConfig(const ref Result<Config, RedisError> r) { return match (r) { case Ok(value: c): false; case Err(error: e): true; }; }
fn bool refusedSetting(const ref Result<Unit, RedisError> r) { return match (r) { case Ok(value: u): false; case Err(error: e): true; }; }

fn bool isNone(Optional<Protocol> p) { return match (p) { case Some(value: v): false; case None: true; }; }
fn bool isProtocol(Optional<Protocol> p, int32 n) { return match (p) { case Some(value: v): v.number() == n; case None: false; }; }
fn string orDash(Optional<string> s) { return match (s) { case Some(value: v): copy v; case None: "-"; }; }

fn int32 defaultTests() {
    int32 f = 0;
    Config c = parsed(url: "redis://");
    f = f + check(ok: c.transport() == UrlTransport::Tcp && c.host() == "127.0.0.1" && c.port() == 6379, what: "defaults: 127.0.0.1:6379 over TCP");
    f = f + check(ok: c.database() == 0i64 && isNone(p: c.protocol()), what: "defaults: database 0, protocol unset");
    f = f + check(ok: ms(d: c.connectTimeout()) == 5000i64 && ms(d: c.commandTimeout()) == 5000i64, what: "defaults: 5 s timeouts");
    f = f + check(ok: c.keepAlive().asSecs() == 15i64, what: "defaults: keepalive 15 s, as redis-cli");
    f = f + check(ok: c.identity() && orDash(s: c.clientName()) == "-" && orDash(s: c.user()) == "-" && orDash(s: c.password()) == "-",
                  what: "defaults: identity on, no name, no credentials");
    f = f + check(ok: c.limits().maxDepth == 1024, what: "defaults: the reader's limits");
    return f;
}

fn int32 optionTests() {
    int32 f = 0;
    Config c = parsed(url: "redis://kr_acl:kr_acl_pw@example.com:6390/3?protocol=2&connect_timeout=2.5&command_timeout=0&client_name=app-1&keepalive=0");
    f = f + check(ok: c.host() == "example.com" && c.port() == 6390 && c.database() == 3i64, what: "options: host, port, database");
    f = f + check(ok: orDash(s: c.user()) == "kr_acl" && orDash(s: c.password()) == "kr_acl_pw", what: "options: user and password");
    f = f + check(ok: isProtocol(p: c.protocol(), n: 2), what: "options: protocol=2");
    f = f + check(ok: ms(d: c.connectTimeout()) == 2500i64 && ms(d: c.commandTimeout()) == 0i64, what: "options: timeouts");
    f = f + check(ok: orDash(s: c.clientName()) == "app-1" && c.keepAlive().asNanos() == 0i64, what: "options: client_name, keepalive off");

    Config v = parsed(url: "valkey://:secret@[::1]/1?protocol=3&keepalive=32767");
    f = f + check(ok: v.host() == "::1" && orDash(s: v.user()) == "-" && orDash(s: v.password()) == "secret", what: "options: valkey://, a password alone, IPv6");
    f = f + check(ok: isProtocol(p: v.protocol(), n: 3) && v.keepAlive().asSecs() == 32767i64, what: "options: protocol=3, the largest keepalive");

    Config u = parsed(url: "unix:///tmp/redis.sock?db=2&command_timeout=0.001");
    f = f + check(ok: u.transport() == UrlTransport::Unix && u.socketPath() == "/tmp/redis.sock" && u.database() == 2i64, what: "options: unix:// and ?db=");
    f = f + check(ok: ms(d: u.commandTimeout()) == 1i64, what: "options: a millisecond");

    // Reconnecting: on, with 5 s, by default; reconnect=off; reconnect_timeout in seconds, 0 for no limit.
    Config r = parsed(url: "redis://h");
    f = f + check(ok: r.reconnect() && ms(d: r.reconnectTimeout()) == 5000i64, what: "options: reconnect on, reconnect_timeout 5 s, by default");
    Config ro = parsed(url: "redis://h?reconnect=off&reconnect_timeout=0.25");
    f = f + check(ok: !ro.reconnect() && ms(d: ro.reconnectTimeout()) == 250i64, what: "options: reconnect=off, reconnect_timeout=0.25");
    Config rz = parsed(url: "unix:///tmp/r.sock?reconnect=on&reconnect_timeout=0");
    f = f + check(ok: rz.reconnect() && rz.reconnectTimeout().asNanos() == 0i64, what: "options: reconnect=on, reconnect_timeout=0 for no limit, on unix:// too");
    Config set = parsed(url: "redis://h");
    set.setReconnect(on: false);
    Result<Unit, RedisError> neg = set.setReconnectTimeout(timeout: Duration.fromMillis(ms: -1i64));
    Result<Unit, RedisError> two = set.setReconnectTimeout(timeout: Duration.fromSecs(s: 2i64));
    bool negRefused = match (neg) { case Err(error: e): e.message() == "reconnect_timeout cannot be negative: 0 is no limit"; case Ok(value: x): false; };
    bool twoSet = match (two) { case Ok(value: x): true; case Err(error: e): false; };
    f = f + check(ok: !set.reconnect() && negRefused && twoSet && ms(d: set.reconnectTimeout()) == 2000i64, what: "setters: setReconnect, setReconnectTimeout, a negative one refused");
    Config copied = copy set;
    f = f + check(ok: !copied.reconnect() && ms(d: copied.reconnectTimeout()) == 2000i64, what: "copy: the reconnect settings");
    return f;
}

fn int32 refusalTests() {
    int32 f = 0;
    string unknown = refusal(url: "redis://host?socket_timeout=1");
    f = f + check(ok: unknown == "unknown URL option \"socket_timeout\": the options are protocol, connect_timeout, command_timeout, client_name, keepalive, reconnect and reconnect_timeout; a cluster's read_from and max_redirects; Sentinel's master_name and role; and over TLS tls_verify, tls_ca, tls_cert, tls_key and tls_server_name",
                  what: "refused: an unknown option: ${unknown}");
    f = f + check(ok: !accepted(url: "redis://host?dial_timeout=1") && !accepted(url: "redis://host?timeout=1"), what: "refused: other clients' names");
    string maybe = refusal(url: "redis://host?reconnect=yes");
    f = f + check(ok: maybe == "reconnect is on or off: reconnect=off", what: "refused: reconnect=yes: ${maybe}");
    string slow = refusal(url: "redis://host?reconnect_timeout=5s");
    f = f + check(ok: slow == "reconnect_timeout is seconds, to the millisecond, and 0 for no limit: reconnect_timeout=2.5", what: "refused: reconnect_timeout=5s: ${slow}");
    f = f + check(ok: refusal(url: "http://host").startsWith(prefix: "not a URL") || refusal(url: "http://host").startsWith(prefix: "unknown scheme"), what: "refused: RedisUrl's refusal passes through");

    DynamicArray<string> protocols = DynamicArray.empty();
    protocols.add(item: "1"); protocols.add(item: "4"); protocols.add(item: "resp3"); protocols.add(item: ""); protocols.add(item: "03");
    isize i = 0;
    while (i < protocols.length()) {
        string p = copy protocols[i];
        string m = refusal(url: "redis://host?protocol=".concat(other: p));
        f = f + check(ok: m == "protocol is 2 or 3: protocol=3", what: "refused: protocol=${p}: ${m}");
        i = i + 1;
    }

    DynamicArray<string> badTimes = DynamicArray.empty();
    badTimes.add(item: "2s"); badTimes.add(item: "-1"); badTimes.add(item: ""); badTimes.add(item: "1."); badTimes.add(item: ".5");
    badTimes.add(item: "1.2345"); badTimes.add(item: "1e3"); badTimes.add(item: "1234567890"); badTimes.add(item: "%201"); badTimes.add(item: "1,5");
    i = 0;
    while (i < badTimes.length()) {
        string t = copy badTimes[i];
        string m = refusal(url: "redis://host?connect_timeout=".concat(other: t));
        f = f + check(ok: m == "connect_timeout is seconds, to the millisecond, and 0 for no limit: connect_timeout=2.5", what: "refused: connect_timeout=${t}: ${m}");
        string n = refusal(url: "redis://host?command_timeout=".concat(other: t));
        f = f + check(ok: n == "command_timeout is seconds, to the millisecond, and 0 for no limit: command_timeout=2.5", what: "refused: command_timeout=${t}");
        i = i + 1;
    }
    Config big = parsed(url: "redis://host?connect_timeout=999999999.999");
    f = f + check(ok: big.connectTimeout().asMillis() == 999999999999i64, what: "accepted: nine digits of seconds");

    DynamicArray<string> badKeep = DynamicArray.empty();
    badKeep.add(item: "1.5"); badKeep.add(item: "-1"); badKeep.add(item: ""); badKeep.add(item: "32768"); badKeep.add(item: "abc");
    i = 0;
    while (i < badKeep.length()) {
        string k = copy badKeep[i];
        string m = refusal(url: "redis://host?keepalive=".concat(other: k));
        f = f + check(ok: m == "keepalive is whole seconds up to 32767, and 0 for off: keepalive=15", what: "refused: keepalive=${k}: ${m}");
        i = i + 1;
    }

    string spaced = "client_name cannot contain spaces, newlines or special characters: the server takes the bytes ! to ~";
    f = f + check(ok: refusal(url: "redis://host?client_name=a%20b") == spaced, what: "refused: a client_name with a space");
    f = f + check(ok: refusal(url: "redis://host?client_name=a%0Ab") == spaced, what: "refused: a client_name with a newline");
    f = f + check(ok: refusal(url: "redis://host?client_name=%C3%A9") == spaced, what: "refused: a client_name past ~");
    f = f + check(ok: refusal(url: "redis://host?client_name=") == "client_name is empty: an empty name sets none, so leave it out", what: "refused: an empty client_name");
    f = f + check(ok: accepted(url: "redis://host?client_name=!~"), what: "accepted: a client_name of ! and ~");

    string longPath = "unix:///".concat(other: xs(n: socketPathMax()));
    f = f + check(ok: refusal(url: longPath).startsWith(prefix: "the socket path is longer than the "), what: "refused: a socket path too long");
    string fitting = "unix://".concat(other: "/".concat(other: xs(n: socketPathMax() - 1)));
    f = f + check(ok: accepted(url: fitting), what: "accepted: a socket path of the longest length");
    return f;
}

fn int32 setterTests() {
    int32 f = 0;
    Result<Config, RedisError> noHost = Config.tcp(host: "", port: 6379);
    f = f + check(ok: refusedConfig(r: noHost), what: "tcp: an empty host is refused");
    Result<Config, RedisError> port0 = Config.tcp(host: "h", port: 0);
    Result<Config, RedisError> portBig = Config.tcp(host: "h", port: 65536);
    f = f + check(ok: refusedConfig(r: port0) && refusedConfig(r: portBig),
                  what: "tcp: a port outside 1 to 65535 is refused");
    Result<Config, RedisError> noPath = Config.unix(path: "");
    Result<Config, RedisError> longPath = Config.unix(path: "/".concat(other: xs(n: socketPathMax())));
    f = f + check(ok: refusedConfig(r: noPath) && refusedConfig(r: longPath),
                  what: "unix: an empty or too long path is refused");

    Result<Config, RedisError> made = Config.tcp(host: "example.com", port: 6380);
    Config c = match (give made) { case Ok(value: v): give v; case Err(error: e): { panic(msg: "config_test: tcp"); } };
    f = f + check(ok: c.host() == "example.com" && c.port() == 6380 && c.transport() == UrlTransport::Tcp, what: "tcp: host and port");

    Result<Unit, RedisError> emptyPw = c.setAuth(user: Optional::None, password: "");
    f = f + check(ok: refusedSetting(r: emptyPw), what: "setAuth: an empty password is refused");
    Result<Unit, RedisError> emptyUser = c.setAuth(user: Optional::Some(value: ""), password: "pw");
    f = f + check(ok: refusedSetting(r: emptyUser), what: "setAuth: an empty user is refused");
    Result<Unit, RedisError> auth = c.setAuth(user: Optional::Some(value: "kr_acl"), password: "kr_acl_pw");
    f = f + check(ok: !refusedSetting(r: auth) && orDash(s: c.user()) == "kr_acl", what: "setAuth: a user and password");

    Result<Unit, RedisError> negDb = c.setDatabase(db: -1i64);
    f = f + check(ok: refusedSetting(r: negDb), what: "setDatabase: below 0 is refused");
    Result<Unit, RedisError> spaced = c.setClientName(name: "a b");
    f = f + check(ok: refusedSetting(r: spaced), what: "setClientName: a space is refused");
    Result<Unit, RedisError> negWait = c.setConnectTimeout(timeout: Duration.fromMillis(ms: -1i64));
    f = f + check(ok: refusedSetting(r: negWait), what: "setConnectTimeout: negative is refused");
    Result<Unit, RedisError> noWait = c.setCommandTimeout(timeout: Duration.zero());
    f = f + check(ok: !refusedSetting(r: noWait) && c.commandTimeout().asNanos() == 0i64, what: "setCommandTimeout: zero is no limit");
    Result<Unit, RedisError> partKeep = c.setKeepAlive(interval: Duration.fromMillis(ms: 1500i64));
    Result<Unit, RedisError> bigKeep = c.setKeepAlive(interval: Duration.fromSecs(s: 32768i64));
    f = f + check(ok: refusedSetting(r: partKeep) && refusedSetting(r: bigKeep),
                  what: "setKeepAlive: a part of a second, or past 32767, is refused");
    c.setProtocol(protocol: Protocol::Resp2);
    c.setIdentity(on: false);
    Config twin = copy c;
    f = f + check(ok: isProtocol(p: twin.protocol(), n: 2) && !twin.identity() && orDash(s: twin.password()) == "kr_acl_pw" && twin.port() == 6380,
                  what: "copy: every setting");
    return f;
}

fn string orNone(Optional<string> s) { return match (s) { case Some(value: v): copy v; case None: "<none>"; }; }
fn bool hasBytes(const ref Optional<DynamicArray<uint8>> b) { return match (b) { case Some(value: v): true; case None: false; }; }

// TLS (docs/ROADMAP.md, "Phase 5"): rediss:// and valkeys://, their options, and the setters.
fn int32 tlsTests() {
    int32 f = 0;
    Config d = parsed(url: "rediss://example.com");
    f = f + check(ok: d.transport() == UrlTransport::Tls && d.host() == "example.com" && d.port() == 6379, what: "tls: rediss:// is TLS over TCP, port 6379");
    f = f + check(ok: d.tlsVerify() == TlsVerify::Full && orNone(s: d.tlsTrustFile()) == "<none>" && !hasBytes(b: d.tlsTrustPem()),
                  what: "tls: by default the chain and the name are verified, against the system's roots");
    f = f + check(ok: orNone(s: d.tlsCertificateFile()) == "<none>" && orNone(s: d.tlsKeyFile()) == "<none>" && d.tlsKeyPassword().length() == 0,
                  what: "tls: by default no client certificate");
    f = f + check(ok: d.tlsServerName() == "example.com" && d.tlsMinVersion() == TlsVersion::Tls12 && d.tlsMaxVersion() == TlsVersion::Tls13,
                  what: "tls: by default the host is the name, and TLS 1.2 to 1.3");
    Config v = parsed(url: "valkeys://[::1]:6380/2");
    f = f + check(ok: v.transport() == UrlTransport::Tls && v.host() == "::1" && v.tlsServerName() == "::1" && v.database() == 2i64,
                  what: "tls: valkeys://, an IPv6 address as the name");

    Config o = parsed(url: "rediss://h?tls_verify=chain&tls_ca=/etc/ca.pem&tls_cert=/c.pem&tls_key=/k.pem&tls_server_name=redis.internal&protocol=2");
    f = f + check(ok: o.tlsVerify() == TlsVerify::Chain && orNone(s: o.tlsTrustFile()) == "/etc/ca.pem", what: "tls: tls_verify=chain, tls_ca");
    f = f + check(ok: orNone(s: o.tlsCertificateFile()) == "/c.pem" && orNone(s: o.tlsKeyFile()) == "/k.pem", what: "tls: tls_cert and tls_key");
    f = f + check(ok: o.tlsServerName() == "redis.internal" && o.host() == "h" && isProtocol(p: o.protocol(), n: 2),
                  what: "tls: tls_server_name names what is verified, beside the other options");
    Config n = parsed(url: "rediss://h?tls_verify=none");
    f = f + check(ok: n.tlsVerify() == TlsVerify::None, what: "tls: tls_verify=none, by name");
    Config pct = parsed(url: "rediss://h?tls_ca=%2Ftmp%2Fmy%20ca.pem");
    f = f + check(ok: orNone(s: pct.tlsTrustFile()) == "/tmp/my ca.pem", what: "tls: a path is percent-decoded");

    // Each TLS option, on a URL that is not TLS.
    DynamicArray<string> keys = DynamicArray.empty();
    keys.add(item: "tls_verify=full"); keys.add(item: "tls_ca=/ca.pem"); keys.add(item: "tls_cert=/c.pem"); keys.add(item: "tls_key=/k.pem");
    keys.add(item: "tls_server_name=x");
    isize i = 0;
    while (i < keys.length()) {
        string q = copy keys[i];
        string m = refusal(url: "redis://h?".concat(other: q));
        string key = "";
        isize k = 0;
        while (k < q.length() && q.bytes()[k] != 61ui8) { k = k + 1; }
        key = q.substring(start: 0, end: k);
        f = f + check(ok: m == key.concat(other: " is a TLS option: connect over rediss:// or valkeys://"), what: "tls: ${key} refused on redis://: ${m}");
        string u = refusal(url: "unix:///tmp/r.sock?".concat(other: q));
        f = f + check(ok: u == key.concat(other: " is a TLS option: connect over rediss:// or valkeys://"), what: "tls: ${key} refused on unix://");
        i = i + 1;
    }
    f = f + check(ok: refusal(url: "rediss://h?tls_verify=yes") == "tls_verify is full, chain or none: tls_verify=full", what: "tls: tls_verify=yes refused");
    f = f + check(ok: refusal(url: "rediss://h?tls_verify=FULL") == "tls_verify is full, chain or none: tls_verify=full", what: "tls: tls_verify is lower case");
    f = f + check(ok: refusal(url: "rediss://h?tls_ca=") == "tls_ca is empty: give a file's path", what: "tls: an empty tls_ca refused");
    string pair = "tls_cert and tls_key go together: give both, or neither";
    f = f + check(ok: refusal(url: "rediss://h?tls_cert=/c.pem") == pair && refusal(url: "rediss://h?tls_key=/k.pem") == pair, what: "tls: a certificate without its key, or a key alone, refused");
    string unused = "a CA (tls_ca) is not used when nothing is verified (tls_verify=none): leave the CA out, or verify";
    f = f + check(ok: refusal(url: "rediss://h?tls_verify=none&tls_ca=/ca.pem") == unused && refusal(url: "rediss://h?tls_ca=/ca.pem&tls_verify=none") == unused,
                  what: "tls: a CA with tls_verify=none refused, in either order");
    f = f + check(ok: refusal(url: "rediss://h?tls_server_name=a%20b").startsWith(prefix: "tls_server_name cannot contain spaces"), what: "tls: a server name with a space refused");
    f = f + check(ok: refusal(url: "rediss://h?tls_server_name=") == "tls_server_name is empty: an empty name sets none, so leave it out", what: "tls: an empty server name refused");
    f = f + check(ok: !accepted(url: "rediss://h?ssl_cert_reqs=none") && !accepted(url: "rediss://h?skip_verify=true") && !accepted(url: "rediss://h?verifyPeer=NONE"),
                  what: "tls: other clients' names for turning verification off are refused, never taken");

    // The setters.
    Result<Config, RedisError> plain = Config.tcp(host: "h", port: 6379);
    Config p = match (give plain) { case Ok(value: x): give x; case Err(error: e): { panic(msg: "config_test: tcp"); } };
    Result<Unit, RedisError> onPlain = p.setTlsVerify(mode: TlsVerify::Chain);
    f = f + check(ok: refusedSetting(r: onPlain), what: "tls setters: refused on a configuration that is not TLS");
    Result<Config, RedisError> made = Config.tls(host: "redis.example", port: 6380);
    Config t = match (give made) { case Ok(value: x): give x; case Err(error: e): { panic(msg: "config_test: tls"); } };
    f = f + check(ok: t.transport() == UrlTransport::Tls && t.port() == 6380 && t.tlsVerify() == TlsVerify::Full, what: "tls: Config.tls");
    Result<Config, RedisError> noHost = Config.tls(host: "", port: 6380);
    f = f + check(ok: refusedConfig(r: noHost), what: "tls: Config.tls refuses an empty host");
    Result<Unit, RedisError> ca = t.setTlsTrustFile(path: "/ca.pem");
    Result<Unit, RedisError> none = t.setTlsVerify(mode: TlsVerify::None);
    f = f + check(ok: !refusedSetting(r: ca) && refusedSetting(r: none) && t.tlsVerify() == TlsVerify::Full, what: "setTlsVerify: None refused while a CA is set");
    DynamicArray<uint8> pem = DynamicArray.empty();
    pem.addAll(items: "-----BEGIN CERTIFICATE-----".bytes());
    Result<Unit, RedisError> pemTrust = t.setTlsTrustPem(pem: give pem);
    f = f + check(ok: !refusedSetting(r: pemTrust) && hasBytes(b: t.tlsTrustPem()) && orNone(s: t.tlsTrustFile()) == "<none>", what: "setTlsTrustPem: replaces the file");
    Result<Unit, RedisError> emptyCa = t.setTlsTrustFile(path: "");
    f = f + check(ok: refusedSetting(r: emptyCa), what: "setTlsTrustFile: an empty path refused");
    Result<Unit, RedisError> id = t.setTlsIdentityFiles(certificate: "/c.pem", key: "/k.pem", password: "pw");
    f = f + check(ok: !refusedSetting(r: id) && orNone(s: t.tlsKeyFile()) == "/k.pem" && t.tlsKeyPassword().length() == 2, what: "setTlsIdentityFiles: with a password");
    Result<Unit, RedisError> noKey = t.setTlsIdentityFiles(certificate: "/c.pem", key: "", password: "");
    f = f + check(ok: refusedSetting(r: noKey), what: "setTlsIdentityFiles: an empty key path refused");
    Result<Unit, RedisError> name = t.setTlsServerName(name: "cache.internal");
    f = f + check(ok: !refusedSetting(r: name) && t.tlsServerName() == "cache.internal", what: "setTlsServerName");
    Result<Unit, RedisError> backwards = t.setTlsVersions(min: TlsVersion::Tls13, max: TlsVersion::Tls12);
    Result<Unit, RedisError> only13 = t.setTlsVersions(min: TlsVersion::Tls13, max: TlsVersion::Tls13);
    f = f + check(ok: refusedSetting(r: backwards) && !refusedSetting(r: only13) && t.tlsMinVersion() == TlsVersion::Tls13, what: "setTlsVersions: a range, never backwards");
    Config twin = copy t;
    f = f + check(ok: twin.tlsServerName() == "cache.internal" && hasBytes(b: twin.tlsTrustPem()) && orNone(s: twin.tlsCertificateFile()) == "/c.pem"
                      && twin.tlsKeyPassword().length() == 2 && twin.tlsMinVersion() == TlsVersion::Tls13 && twin.transport() == UrlTransport::Tls,
                  what: "copy: the TLS settings too");
    return f;
}

// Several hosts (docs/ROADMAP.md, "Phase 6"): a cluster's seeds, or the sentinels.
fn int32 hostsTests() {
    int32 f = 0;
    Config one = parsed(url: "redis://h:7000");
    f = f + check(ok: one.hostCount() == 1 && one.hostAt(index: 0) == "h" && one.portAt(index: 0) == 7000, what: "hosts: one");
    Config seeds = parsed(url: "redis://u:p@h1:7000,h2,[::1]:7002/2");
    f = f + check(ok: seeds.hostCount() == 3 && seeds.host() == "h1" && seeds.port() == 7000, what: "hosts: the first is host() and port()");
    f = f + check(ok: seeds.hostAt(index: 1) == "h2" && seeds.portAt(index: 1) == 6379 && seeds.hostAt(index: 2) == "::1" && seeds.portAt(index: 2) == 7002,
                  what: "hosts: each later one with its port, 6379 when it names none, an IPv6 one without brackets");
    f = f + check(ok: orDash(s: seeds.user()) == "u" && seeds.database() == 2i64 && !seeds.viaSentinel(), what: "hosts: one user and database for all");
    Config twin = copy seeds;
    f = f + check(ok: twin.hostCount() == 3 && twin.hostAt(index: 2) == "::1" && twin.portAt(index: 1) == 6379, what: "hosts: copy keeps every host");
    f = f + check(ok: refusal(url: "redis://h1,h2:7001").contains(substring: "the first names its port"), what: "hosts: the first names its port");
    f = f + check(ok: refusal(url: "redis://h1:7000,").contains(substring: "an empty host") && refusal(url: "redis://h1:7000,,h2:7001").contains(substring: "an empty host"),
                  what: "hosts: an empty host is refused");
    Result<Config, RedisError> made = Config.tcp(host: "h1", port: 7000);
    Config built = match (give made) { case Ok(value: v): give v; case Err(error: e): { return f + check(ok: false, what: "hosts: Config.tcp"); } };
    Result<Unit, RedisError> added = built.addHost(host: "h2", port: 7001);
    Result<Unit, RedisError> noPort = built.addHost(host: "h3", port: 0);
    Result<Unit, RedisError> noHost = built.addHost(host: "", port: 7003);
    f = f + check(ok: !refusedSetting(r: added) && built.hostCount() == 2 && built.portAt(index: 1) == 7001, what: "addHost: a seed");
    f = f + check(ok: refusedSetting(r: noPort) && refusedSetting(r: noHost) && built.hostCount() == 2, what: "addHost: a bad port or an empty host, refused");
    Result<Config, RedisError> sock = Config.unix(path: "/tmp/r.sock");
    Config local = match (give sock) { case Ok(value: v): give v; case Err(error: e): { return f + check(ok: false, what: "hosts: Config.unix"); } };
    Result<Unit, RedisError> onSocket = local.addHost(host: "h", port: 1);
    f = f + check(ok: refusedSetting(r: onSocket) && local.hostCount() == 1, what: "addHost: refused over a Unix-domain socket");
    return f;
}

// Sentinel's settings: the scheme, master_name, role and the sentinels' own credentials.
fn int32 sentinelTests() {
    int32 f = 0;
    Config s = parsed(url: "redis-sentinel://kr_acl:kr_acl_pw@s1,s2:26380,s3/1?master_name=kr&role=replica");
    f = f + check(ok: s.viaSentinel() && s.transport() == UrlTransport::Tcp && s.hostCount() == 3, what: "sentinel: three sentinels over TCP");
    f = f + check(ok: s.port() == 26379 && s.portAt(index: 1) == 26380 && s.portAt(index: 2) == 26379, what: "sentinel: 26379 unless a port is named");
    f = f + check(ok: orDash(s: s.masterName()) == "kr" && s.role() == SentinelRole::Replica, what: "sentinel: master_name and role");
    f = f + check(ok: orDash(s: s.user()) == "kr_acl" && s.database() == 1i64 && orDash(s: s.sentinelPassword()) == "-",
                  what: "sentinel: the URL's credentials and database are the server's, the sentinels' unset");
    Config tls = parsed(url: "rediss-sentinel://s1?master_name=kr&tls_verify=chain");
    f = f + check(ok: tls.viaSentinel() && tls.transport() == UrlTransport::Tls && tls.tlsVerify() == TlsVerify::Chain && tls.role() == SentinelRole::Master,
                  what: "sentinel: rediss-sentinel is TLS, with TLS options, the master by default");
    f = f + check(ok: refusal(url: "redis-sentinel://s1").contains(substring: "master_name"), what: "sentinel: master_name is needed");
    f = f + check(ok: refusal(url: "redis-sentinel://s1?master_name=").contains(substring: "master_name is empty"), what: "sentinel: an empty master_name");
    f = f + check(ok: refusal(url: "redis-sentinel://s1?master_name=kr&role=primary").contains(substring: "master or replica"), what: "sentinel: role is master or replica");
    f = f + check(ok: refusal(url: "redis://h?master_name=kr").contains(substring: "Sentinel option") && refusal(url: "redis://h?role=replica").contains(substring: "Sentinel option"),
                  what: "sentinel: master_name and role are refused elsewhere");
    f = f + check(ok: refusal(url: "redis-sentinel://?master_name=kr").contains(substring: "names its sentinels"), what: "sentinel: a URL with no sentinels");
    Result<Unit, RedisError> auth = s.setSentinelAuth(user: Optional::Some(value: "kr_sentinel"), password: "pw");
    Result<Unit, RedisError> emptyPw = s.setSentinelAuth(user: Optional::None, password: "");
    Result<Unit, RedisError> emptyUser = s.setSentinelAuth(user: Optional::Some(value: ""), password: "pw");
    f = f + check(ok: !refusedSetting(r: auth) && orDash(s: s.sentinelUser()) == "kr_sentinel" && orDash(s: s.sentinelPassword()) == "pw",
                  what: "setSentinelAuth: the sentinels' own user and password");
    f = f + check(ok: refusedSetting(r: emptyPw) && refusedSetting(r: emptyUser) && orDash(s: s.sentinelPassword()) == "pw", what: "setSentinelAuth: an empty password or user, refused");
    Config twin = copy s;
    f = f + check(ok: twin.viaSentinel() && orDash(s: twin.masterName()) == "kr" && twin.role() == SentinelRole::Replica
                      && orDash(s: twin.sentinelUser()) == "kr_sentinel" && orDash(s: twin.sentinelPassword()) == "pw",
                  what: "copy: the Sentinel settings too");
    Config plain = parsed(url: "redis://h");
    Result<Unit, RedisError> roleElsewhere = plain.setSentinelRole(role: SentinelRole::Replica);
    Result<Unit, RedisError> authElsewhere = plain.setSentinelAuth(user: Optional::None, password: "pw");
    f = f + check(ok: refusedSetting(r: roleElsewhere) && refusedSetting(r: authElsewhere), what: "sentinel: its setters are refused elsewhere");
    Result<Config, RedisError> made = Config.sentinel(masterName: "kr", host: "s1", port: 26379, tls: true);
    Config built = match (give made) { case Ok(value: v): give v; case Err(error: e): { return f + check(ok: false, what: "Config.sentinel"); } };
    Result<Unit, RedisError> more = built.addHost(host: "s2", port: 26380);
    Result<Unit, RedisError> role = built.setSentinelRole(role: SentinelRole::Replica);
    f = f + check(ok: built.viaSentinel() && built.transport() == UrlTransport::Tls && built.hostCount() == 2 && built.role() == SentinelRole::Replica
                      && !refusedSetting(r: more) && !refusedSetting(r: role),
                  what: "Config.sentinel: TLS, another sentinel, a replica");
    Result<Config, RedisError> noName = Config.sentinel(masterName: "", host: "s1", port: 26379, tls: false);
    f = f + check(ok: refusedConfig(r: noName), what: "Config.sentinel: an empty master name");
    return f;
}

// A cluster's options, honoured by Config and refused by a single connection.
fn int32 clusterOptionTests() {
    int32 f = 0;
    Config d = parsed(url: "redis://h1:7000,h2:7001");
    f = f + check(ok: d.readFrom() == ReadFrom::Primary && d.maxRedirects() == 5 && !d.clusterOptions(), what: "cluster: defaults, primary and 5");
    Config c = parsed(url: "redis://h1:7000?read_from=replica&max_redirects=0");
    f = f + check(ok: c.readFrom() == ReadFrom::Replica && c.maxRedirects() == 0 && c.clusterOptions(), what: "cluster: read_from and max_redirects");
    f = f + check(ok: refusal(url: "redis://h?read_from=any").contains(substring: "primary or replica"), what: "cluster: read_from is primary or replica");
    f = f + check(ok: refusal(url: "redis://h?max_redirects=101").contains(substring: "0 to 100") && refusal(url: "redis://h?max_redirects=-1").contains(substring: "0 to 100")
                      && refusal(url: "redis://h?max_redirects=x").contains(substring: "0 to 100"),
                  what: "cluster: max_redirects is 0 to 100");
    Config twin = copy c;
    f = f + check(ok: twin.readFrom() == ReadFrom::Replica && twin.maxRedirects() == 0 && twin.clusterOptions(), what: "copy: the cluster options too");
    Result<Unit, RedisError> most = d.setMaxRedirects(count: 100);
    Result<Unit, RedisError> past = d.setMaxRedirects(count: 101);
    d.setReadFrom(from: ReadFrom::Replica);
    f = f + check(ok: !refusedSetting(r: most) && refusedSetting(r: past) && d.maxRedirects() == 100 && d.readFrom() == ReadFrom::Replica,
                  what: "setMaxRedirects and setReadFrom");
    return f;
}

fn string connectRefusal(const ref string url) {
    Config c = parsed(url: url);
    Result<Connection, RedisError> r = Connection.connect(config: c);
    return match (r) { case Ok(value: x): "connected"; case Err(error: e): e.message(); };
}

// What a single connection refuses, before it dials anything.
unsafe fn int32 connectionRefusalTests() {
    int32 f = 0;
    f = f + check(ok: connectRefusal(url: "redis://127.0.0.1:1,127.0.0.1:2").contains(substring: "Cluster.connect"), what: "connect: several hosts are a cluster's");
    f = f + check(ok: connectRefusal(url: "redis://127.0.0.1:1?read_from=replica").contains(substring: "a cluster's options")
                      && connectRefusal(url: "redis://127.0.0.1:1?max_redirects=3").contains(substring: "a cluster's options"),
                  what: "connect: a cluster's options are refused");
    Config s = parsed(url: "redis://127.0.0.1:1,127.0.0.1:2");
    Result<Subscriber, RedisError> sub = Subscriber.connect(config: s);
    bool subRefused = match (sub) { case Ok(value: x): false; case Err(error: e): e.message().contains(substring: "Cluster.connect"); };
    f = f + check(ok: subRefused, what: "Subscriber.connect: several hosts are refused too");
    Config viaSentinels = parsed(url: "redis-sentinel://127.0.0.1:1?master_name=kr");
    DynamicArray<Step> none = DynamicArray.empty();
    Owned<Transport> fake = new FakeServer.make(steps: give none, chunk: 1, writeLimit: 3);
    Result<Connection, RedisError> over = Connection.connectOver(transport: give fake, config: viaSentinels);
    bool overRefused = match (over) { case Ok(value: x): false; case Err(error: e): e.message().contains(substring: "a transport the caller opened"); };
    f = f + check(ok: overRefused, what: "connectOver: a Sentinel configuration is refused");
    return f;
}

unsafe fn int32 configTests() {
    int32 f = 0;
    f = f + defaultTests();
    f = f + optionTests();
    f = f + refusalTests();
    f = f + setterTests();
    f = f + tlsTests();
    f = f + hostsTests();
    f = f + sentinelTests();
    f = f + clusterOptionTests();
    f = f + connectionRefusalTests();
    return f;
}
