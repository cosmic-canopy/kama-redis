// Reconnecting (docs/ROADMAP.md, "Phase 7a") over a scripted dialer: a lost connection is made again by its next
// call, and never resends the call that saw it lost. Each redial's script is everything the new link must carry,
// in order: the handshake, the PING that ends a redial, then the next command, never the lost one. A command the
// client should not send meets an Expect it does not match, and the call fails.
import { std::collections::DynamicArray, std::collections::ConstView, std::memory::Owned, std::time::Duration, std::time::Instant,
         std::time::monotonicNow, std::encoding::utf8::decode, std::encoding::utf8::Utf8Error,
         redis::Connection, redis::Config, redis::Command, redis::Pipeline, redis::Replies, redis::Protocol, redis::RedisError,
         redis::TxOutcome, redis::Dialer, redis::Subscriber, redis::Delivery, redis::ChannelKind, redis::cluster::keySlot,
         redis::resp::Value, redis::resp::Reader, redis::resp::Read,
         redis_unit_tests::check, redis_unit_tests::stop, Step, ScriptDialer, Dial, welcome, expect, reply, proxy, configOf, isSimple, callOutcome, callClosed,
         commandOf, transaction, setThenIncr, pushIn, connected };
export { reconnectTests };


// The server whose replies the scripts play.
fn string server() { return "redis-8.10.2"; }

fn DynamicArray<Step> steps() { return DynamicArray.empty(); }

// A redial's handshake with server(), and the PING that ends it.
fn DynamicArray<Step> again() {
    DynamicArray<Step> s = welcome(server: server());
    s.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    return give s;
}

// A connection over `dials`, the first of which must serve its handshake.
unsafe fn Connection dialed(DynamicArray<Dial> dials, const ref Config config, const ref string what) {
    Owned<Dialer> d = new ScriptDialer.make(dials: give dials);
    Result<Connection, RedisError> r = Connection.connectWith(dialer: give d, config: config);
    Connection c = match (give r) {
        case Ok(value: v): give v;
        case Err(error: e): { string m = e.message(); return stop::<Connection>(msg: "reconnect_test: ${what}: ${m}"); }
    };
    return give c;
}

// The first link: the handshake, then GET kr:lost, which the server reads and answers by closing the connection.
fn DynamicArray<Step> losing() {
    DynamicArray<Step> s = welcome(server: server());
    s.add(item: Step::Close);
    return give s;
}

unsafe fn Result<Value, RedisError> send(ref Connection c, const ref string text) {
    Command command = commandOf(text: text);
    return c.call(command: command);
}

fn bool isIo(const ref Result<Value, RedisError> r) {
    return match (r) { case Err(error: e): match (e) { case Io(error: x): true; case _: false; }; case Ok(value: v): false; };
}

// The cause of a call's Reconnect, as "<tries> <what>": "1 WRONGPASS", "2 connect"; "-" for anything else.
fn string reconnectOf(const ref Result<Value, RedisError> r) {
    return match (r) {
        case Err(error: e): match (e) {
            case Reconnect(error: x): {
                int32 n = x.tries();
                string why = match (x.cause()) {
                    case Server(error: s): s.codeText();
                    case Connect(error: c): "connect";
                    case Tls(detail: d, cause: t): "tls";
                    case Timeout: "timeout";
                    case _: x.cause().message();
                };
                := "${n} ".concat(other: why);
            }
            case _: "-";
        };
        case Ok(value: v): "-";
    };
}

unsafe fn int32 redialTests() {
    int32 f = 0;
    Config plain = configOf(url: "redis://127.0.0.1:6379");

    // A link lost mid-call: that call's error is the loss, and the next call makes a new link and sends only itself.
    DynamicArray<Dial> d1 = DynamicArray.empty();
    d1.add(item: Dial::Serve(steps: losing()));
    DynamicArray<Step> next = again();
    next.add(item: expect(command: "GET kr:next", answer: reply(server: server(), kase: "get-missing/3")));
    d1.add(item: Dial::Serve(steps: give next));
    Connection c1 = dialed(dials: give d1, config: plain, what: "lost mid-call");
    Result<Value, RedisError> lost = send(c: c1, text: "GET kr:lost");
    bool open = !c1.isClosed();
    Result<Value, RedisError> after = send(c: c1, text: "GET kr:next");
    string afterGot = callOutcome(r: after);
    f = f + check(ok: isIo(r: lost) && open, what: "redial: the call that saw the link lost fails with it, and the connection is not closed");
    f = f + check(ok: afterGot == "ok", what: "redial: the next call makes a new link, and sends only itself: ${afterGot}");

    // A server still down: refused three times, then up. The call waits it out within reconnect_timeout.
    DynamicArray<Dial> d2 = DynamicArray.empty();
    d2.add(item: Dial::Serve(steps: losing()));
    d2.add(item: Dial::Refuse); d2.add(item: Dial::Refuse); d2.add(item: Dial::Refuse);
    DynamicArray<Step> up = again();
    up.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    d2.add(item: Dial::Serve(steps: give up));
    Connection c2 = dialed(dials: give d2, config: plain, what: "down, then up");
    Result<Value, RedisError> lost2 = send(c: c2, text: "GET kr:lost");
    Result<Value, RedisError> back = send(c: c2, text: "PING");
    string backGot = callOutcome(r: back);
    f = f + check(ok: isSimple(r: back, text: "PONG"), what: "redial: refused three times, then served, within reconnect_timeout: ${backGot}");

    // A forwarder in front of a server that is down accepts, then closes: tried again, as a refusal is.
    DynamicArray<Dial> d3 = DynamicArray.empty();
    d3.add(item: Dial::Serve(steps: losing()));
    DynamicArray<Step> closing = steps();
    closing.add(item: Step::Hangup);
    d3.add(item: Dial::Serve(steps: give closing));
    DynamicArray<Step> resetting = steps();
    resetting.add(item: Step::Reset);
    d3.add(item: Dial::Serve(steps: give resetting));
    DynamicArray<Step> up3 = again();
    up3.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    d3.add(item: Dial::Serve(steps: give up3));
    Connection c3 = dialed(dials: give d3, config: plain, what: "accepted and closed");
    Result<Value, RedisError> lost3 = send(c: c3, text: "GET kr:lost");
    Result<Value, RedisError> back3 = send(c: c3, text: "PING");
    string back3Got = callOutcome(r: back3);
    f = f + check(ok: isSimple(r: back3, text: "PONG"), what: "redial: a link closed, then one reset, before the handshake ended, are tried again: ${back3Got}");

    // A server reloading its dataset takes the handshake and answers the closing PING -LOADING: waited out.
    DynamicArray<Dial> d4 = DynamicArray.empty();
    d4.add(item: Dial::Serve(steps: losing()));
    DynamicArray<Step> loading = welcome(server: server());
    loading.add(item: expect(command: "PING", answer: reply(server: server(), kase: "loading-ping")));
    d4.add(item: Dial::Serve(steps: give loading));
    DynamicArray<Step> loaded = again();
    loaded.add(item: expect(command: "GET kr:next", answer: reply(server: server(), kase: "get-missing/3")));
    d4.add(item: Dial::Serve(steps: give loaded));
    Connection c4 = dialed(dials: give d4, config: plain, what: "loading");
    Result<Value, RedisError> lost4 = send(c: c4, text: "GET kr:lost");
    Result<Value, RedisError> back4 = send(c: c4, text: "GET kr:next");
    string back4Got = callOutcome(r: back4);
    f = f + check(ok: back4Got == "ok", what: "redial: a server that answers PING with LOADING is waited out, and the call goes to the one that loaded: ${back4Got}");

    // A server with no room left refuses as it accepts (maxclients): tried again.
    DynamicArray<Dial> d5 = DynamicArray.empty();
    d5.add(item: Dial::Serve(steps: losing()));
    DynamicArray<Step> full = steps();
    full.add(item: Step::Send(bytes: reply(server: server(), kase: "maxclients")));
    full.add(item: Step::Hangup);
    d5.add(item: Dial::Serve(steps: give full));
    DynamicArray<Step> room = again();
    room.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    d5.add(item: Dial::Serve(steps: give room));
    Connection c5 = dialed(dials: give d5, config: plain, what: "maxclients");
    Result<Value, RedisError> lost5 = send(c: c5, text: "GET kr:lost");
    Result<Value, RedisError> back5 = send(c: c5, text: "PING");
    string back5Got = callOutcome(r: back5);
    f = f + check(ok: isSimple(r: back5, text: "PONG"), what: "redial: a server with no room left is tried again: ${back5Got}");
    return f;
}

unsafe fn int32 finalTests() {
    int32 f = 0;
    // A refusal with a code of its own is final: WRONGPASS, once, with nothing of the call sent.
    Config auth = configOf(url: "redis://kr_acl:kr_acl_pw@127.0.0.1:6379?reconnect_timeout=0.2");
    DynamicArray<Dial> d1 = DynamicArray.empty();
    DynamicArray<Step> first = steps();
    first.add(item: expect(command: "HELLO 3 AUTH kr_acl kr_acl_pw", answer: reply(server: server(), kase: "hello3-auth")));
    first.add(item: expect(command: "CLIENT SETINFO LIB-NAME kama-redis", answer: reply(server: server(), kase: "setinfo-name")));
    first.add(item: Step::Any(reply: reply(server: server(), kase: "setinfo-ver")));
    first.add(item: Step::Close);
    d1.add(item: Dial::Serve(steps: give first));
    DynamicArray<Step> wrong = steps();
    wrong.add(item: expect(command: "HELLO 3 AUTH kr_acl kr_acl_pw", answer: reply(server: server(), kase: "hello3-auth-wrong")));
    d1.add(item: Dial::Serve(steps: give wrong));
    Connection c1 = dialed(dials: give d1, config: auth, what: "wrongpass");
    Result<Value, RedisError> lost = send(c: c1, text: "GET kr:lost");
    Result<Value, RedisError> refused = send(c: c1, text: "GET kr:next");
    string why = reconnectOf(r: refused);
    string words = callOutcome(r: refused);
    f = f + check(ok: why == "1 WRONGPASS", what: "final: WRONGPASS at a redial is Reconnect after one try: ${why}");
    f = f + check(ok: words.startsWith(prefix: "the connection was lost, and reconnecting failed (1 try): WRONGPASS"), what: "final: the Reconnect's words: ${words}");
    f = f + check(ok: !c1.isClosed(), what: "final: the connection is not closed after a failed redial: the next call tries again");

    // A server still down past reconnect_timeout: Reconnect, with the last try's Connect.
    Config brief = configOf(url: "redis://127.0.0.1:6379?reconnect_timeout=0.2");
    DynamicArray<Dial> d2 = DynamicArray.empty();
    d2.add(item: Dial::Serve(steps: losing()));
    Connection c2 = dialed(dials: give d2, config: brief, what: "down");
    Result<Value, RedisError> lost2 = send(c: c2, text: "GET kr:lost");
    Result<Value, RedisError> down = send(c: c2, text: "PING");
    string downWhy = reconnectOf(r: down);
    f = f + check(ok: downWhy.endsWith(suffix: " connect") && !downWhy.startsWith(prefix: "1 "), what: "final: a server down past reconnect_timeout is Reconnect, after more than one try: ${downWhy}");

    // reconnect=off, connectOver and close(): the connection stays closed.
    Config off = configOf(url: "redis://127.0.0.1:6379?reconnect=off");
    DynamicArray<Dial> d3 = DynamicArray.empty();
    d3.add(item: Dial::Serve(steps: losing()));
    d3.add(item: Dial::Serve(steps: again()));
    Connection c3 = dialed(dials: give d3, config: off, what: "reconnect=off");
    Result<Value, RedisError> lost3 = send(c: c3, text: "GET kr:lost");
    Result<Value, RedisError> stays = send(c: c3, text: "PING");
    f = f + check(ok: callClosed(r: stays) && c3.isClosed(), what: "final: reconnect=off leaves a lost connection closed");
    Config plain = configOf(url: "redis://127.0.0.1:6379");
    DynamicArray<Dial> d4 = DynamicArray.empty();
    d4.add(item: Dial::Serve(steps: welcome(server: server())));
    d4.add(item: Dial::Serve(steps: again()));
    Connection c4 = dialed(dials: give d4, config: plain, what: "close()");
    c4.close();
    Result<Value, RedisError> shut = send(c: c4, text: "PING");
    f = f + check(ok: callClosed(r: shut) && c4.isClosed(), what: "final: a connection the caller closed stays closed");
    return f;
}

unsafe fn int32 keptTests() {
    int32 f = 0;
    // The protocol the connection speaks is the redial's: RESP2 (a proxy refused HELLO) stays RESP2.
    Config plain = configOf(url: "redis://127.0.0.1:6379");
    DynamicArray<Dial> d1 = DynamicArray.empty();
    DynamicArray<Step> envoy = steps();
    envoy.add(item: expect(command: "HELLO 3", answer: proxy(name: "envoy-1.39.0 HELLO 3")));
    envoy.add(item: Step::Any(reply: reply(server: "redis-6.2.24", kase: "setinfo-name")));
    envoy.add(item: Step::Any(reply: reply(server: "redis-6.2.24", kase: "setinfo-ver")));
    envoy.add(item: expect(command: "PING", answer: proxy(name: "envoy-1.39.0 PING")));
    envoy.add(item: Step::Close);
    d1.add(item: Dial::Serve(steps: give envoy));
    DynamicArray<Step> envoy2 = steps();
    envoy2.add(item: expect(command: "PING", answer: proxy(name: "envoy-1.39.0 PING")));
    envoy2.add(item: expect(command: "PING", answer: proxy(name: "envoy-1.39.0 PING")));
    envoy2.add(item: expect(command: "GET kr:next", answer: reply(server: "redis-6.2.24", kase: "get-missing/2")));
    d1.add(item: Dial::Serve(steps: give envoy2));
    Connection c1 = dialed(dials: give d1, config: plain, what: "resp2");
    Result<Value, RedisError> lost1 = send(c: c1, text: "GET kr:lost");
    Result<Value, RedisError> back1 = send(c: c1, text: "GET kr:next");
    string back1Got = callOutcome(r: back1);
    f = f + check(ok: back1Got == "ok" && c1.protocol() == Protocol::Resp2, what: "kept: RESP2 stays RESP2, with no HELLO: ${back1Got}");

    // RESP3 stays RESP3: a redial whose HELLO is refused never falls back to the RESP2 path.
    Config brief = configOf(url: "redis://127.0.0.1:6379?reconnect_timeout=0.05");
    DynamicArray<Dial> d2 = DynamicArray.empty();
    d2.add(item: Dial::Serve(steps: losing()));
    DynamicArray<Step> refuses = steps();
    refuses.add(item: expect(command: "HELLO 3", answer: proxy(name: "envoy-1.39.0 HELLO 3")));
    refuses.add(item: Step::Any(reply: reply(server: "redis-6.2.24", kase: "setinfo-name")));
    refuses.add(item: Step::Any(reply: reply(server: "redis-6.2.24", kase: "setinfo-ver")));
    refuses.add(item: expect(command: "PING", answer: proxy(name: "envoy-1.39.0 PING")));
    refuses.add(item: expect(command: "PING", answer: proxy(name: "envoy-1.39.0 PING")));
    refuses.add(item: expect(command: "GET kr:next", answer: reply(server: "redis-6.2.24", kase: "get-missing/2")));
    d2.add(item: Dial::Serve(steps: give refuses));
    Connection c2 = dialed(dials: give d2, config: brief, what: "resp3");
    Result<Value, RedisError> lost2 = send(c: c2, text: "GET kr:lost");
    Result<Value, RedisError> back2 = send(c: c2, text: "GET kr:next");
    string back2Got = callOutcome(r: back2);
    f = f + check(ok: back2Got != "ok" && c2.protocol() == Protocol::Resp3, what: "kept: RESP3 stays RESP3, never the RESP2 path: ${back2Got}");

    // What select and authenticate set, every redial sets again; a refused select sets nothing.
    DynamicArray<Dial> d3 = DynamicArray.empty();
    DynamicArray<Step> first = welcome(server: server());
    first.add(item: expect(command: "SELECT 2", answer: reply(server: server(), kase: "select1")));
    first.add(item: expect(command: "SELECT 16", answer: reply(server: server(), kase: "select-range")));
    first.add(item: expect(command: "AUTH kr_acl kr_acl_pw", answer: reply(server: server(), kase: "auth2")));
    first.add(item: Step::Close);
    d3.add(item: Dial::Serve(steps: give first));
    DynamicArray<Step> restored = steps();
    restored.add(item: expect(command: "HELLO 3 AUTH kr_acl kr_acl_pw", answer: reply(server: server(), kase: "hello3-auth")));
    restored.add(item: expect(command: "SELECT 2", answer: reply(server: server(), kase: "select1")));
    restored.add(item: expect(command: "CLIENT SETINFO LIB-NAME kama-redis", answer: reply(server: server(), kase: "setinfo-name")));
    restored.add(item: Step::Any(reply: reply(server: server(), kase: "setinfo-ver")));
    restored.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    restored.add(item: expect(command: "GET kr:next", answer: reply(server: server(), kase: "get-missing/3")));
    d3.add(item: Dial::Serve(steps: give restored));
    Connection c3 = dialed(dials: give d3, config: plain, what: "select and authenticate");
    Result<Unit, RedisError> s2 = c3.select(db: 2);
    Result<Unit, RedisError> s16 = c3.select(db: 16);
    Result<Unit, RedisError> a = c3.authenticate(user: Optional::Some(value: "kr_acl"), password: "kr_acl_pw");
    Result<Value, RedisError> lost3 = send(c: c3, text: "GET kr:lost");
    Result<Value, RedisError> back3 = send(c: c3, text: "GET kr:next");
    string back3Got = callOutcome(r: back3);
    f = f + check(ok: back3Got == "ok", what: "kept: a redial selects database 2 and logs in as kr_acl, as select and authenticate set: ${back3Got}");
    return f;
}

// How a transaction ended: "held back" (WatchConflict: it was never sent, since every script here commits what is
// sent), "committed", or the error.
fn string fate(Result<TxOutcome, RedisError> r) {
    return match (give r) {
        case Ok(value: o): match (o) { case WatchConflict: "held back"; case _: "committed"; };
        case Err(error: e): e.message();
    };
}

// A link that commits the next transaction (setThenIncr), after a redial's handshake.
fn DynamicArray<Step> committing() {
    DynamicArray<Step> s = again();
    transaction(s: s, server: server(), protocol: "3", exec: reply(server: server(), kase: "exec-ok/3"));
    return give s;
}

unsafe fn int32 watchTests() {
    int32 f = 0;
    Config plain = configOf(url: "redis://127.0.0.1:6379");
    Pipeline tx = setThenIncr();
    // A WATCH lost with its link: the next transaction is held back as WatchConflict, never sent; the one after it has
    // no WATCH to lose, and is sent (committed) on a new link.
    DynamicArray<Dial> d1 = DynamicArray.empty();
    DynamicArray<Step> first = welcome(server: server());
    first.add(item: expect(command: "WATCH kr:w", answer: reply(server: server(), kase: "select1")));
    first.add(item: Step::Close);
    d1.add(item: Dial::Serve(steps: give first));
    d1.add(item: Dial::Serve(steps: committing()));
    Connection c1 = dialed(dials: give d1, config: plain, what: "watch lost");
    Result<Value, RedisError> w = send(c: c1, text: "WATCH kr:w");
    Result<Value, RedisError> lost = send(c: c1, text: "GET kr:lost");
    string t1 = fate(r: c1.transact(pipeline: tx));
    string t2 = fate(r: c1.transact(pipeline: tx));
    f = f + check(ok: t1 == "held back", what: "watch: a transaction after its WATCH was lost with the link is WatchConflict, and is not sent: ${t1}");
    f = f + check(ok: t2 == "committed", what: "watch: the transaction after that one redials and is sent: ${t2}");

    // An UNWATCH answered OK drops the WATCH: a loss after it loses nothing, and the transaction is sent.
    DynamicArray<Dial> d2 = DynamicArray.empty();
    DynamicArray<Step> one = welcome(server: server());
    one.add(item: expect(command: "WATCH kr:w", answer: reply(server: server(), kase: "select1")));
    one.add(item: expect(command: "UNWATCH", answer: reply(server: server(), kase: "select1")));
    one.add(item: Step::Close);
    d2.add(item: Dial::Serve(steps: give one));
    d2.add(item: Dial::Serve(steps: committing()));
    Connection c2 = dialed(dials: give d2, config: plain, what: "unwatch");
    Result<Value, RedisError> w2 = send(c: c2, text: "WATCH kr:w");
    Result<Value, RedisError> u2 = send(c: c2, text: "UNWATCH");
    Result<Value, RedisError> lost2 = send(c: c2, text: "GET kr:lost");
    string t3 = fate(r: c2.transact(pipeline: tx));
    f = f + check(ok: t3 == "committed", what: "watch: after UNWATCH, a loss loses no WATCH: the transaction is sent: ${t3}");

    // A WATCH in a pipeline counts, once the server answered it OK.
    DynamicArray<Dial> d3 = DynamicArray.empty();
    DynamicArray<Step> three = welcome(server: server());
    three.add(item: expect(command: "GET kr:w", answer: reply(server: server(), kase: "get-missing/3")));
    three.add(item: expect(command: "WATCH kr:w", answer: reply(server: server(), kase: "select1")));
    three.add(item: Step::Close);
    d3.add(item: Dial::Serve(steps: give three));
    d3.add(item: Dial::Serve(steps: committing()));
    Connection c3 = dialed(dials: give d3, config: plain, what: "pipeline watch");
    Pipeline p = Pipeline.make();
    Command get = commandOf(text: "GET kr:w");
    p.add(command: get);
    Command watch = commandOf(text: "WATCH kr:w");
    p.add(command: watch);
    Result<Replies, RedisError> rp = c3.run(pipeline: p);
    Result<Value, RedisError> lost3 = send(c: c3, text: "GET kr:lost");
    string t4 = fate(r: c3.transact(pipeline: tx));
    f = f + check(ok: t4 == "held back", what: "watch: a WATCH in a pipeline, lost with the link, makes the next transaction WatchConflict: ${t4}");

    // A transaction ends its WATCH, whatever EXEC answers: a loss after it loses nothing.
    DynamicArray<Dial> d5 = DynamicArray.empty();
    DynamicArray<Step> five = welcome(server: server());
    five.add(item: expect(command: "WATCH kr:w", answer: reply(server: server(), kase: "select1")));
    transaction(s: five, server: server(), protocol: "3", exec: reply(server: server(), kase: "exec-ok/3"));
    five.add(item: Step::Close);
    d5.add(item: Dial::Serve(steps: give five));
    d5.add(item: Dial::Serve(steps: committing()));
    Connection c5 = dialed(dials: give d5, config: plain, what: "watch ended");
    Result<Value, RedisError> w5 = send(c: c5, text: "WATCH kr:w");
    string t5 = fate(r: c5.transact(pipeline: tx));
    Result<Value, RedisError> lost5 = send(c: c5, text: "GET kr:lost");
    string t6 = fate(r: c5.transact(pipeline: tx));
    f = f + check(ok: t5 == "committed" && t6 == "committed", what: "watch: a transaction ends its WATCH, so a loss after it loses none: ${t5}, ${t6}");
    return f;
}

// The backoff is the connection's, across calls: a call right after a failed redial waits for it, within its own
// reconnect_timeout, and still makes a try.
unsafe fn int32 paceTests() {
    int32 f = 0;
    Config brief = configOf(url: "redis://127.0.0.1:6379?reconnect_timeout=0.05");
    DynamicArray<Dial> d = DynamicArray.empty();
    d.add(item: Dial::Serve(steps: losing()));
    Connection c = dialed(dials: give d, config: brief, what: "pace");
    Result<Value, RedisError> lost = send(c: c, text: "GET kr:lost");
    Result<Value, RedisError> first = send(c: c, text: "PING");
    Instant before = monotonicNow();
    Result<Value, RedisError> second = send(c: c, text: "PING");
    int64 waited = before.elapsed().asMillis();
    string firstWhy = reconnectOf(r: first);
    string secondWhy = reconnectOf(r: second);
    f = f + check(ok: firstWhy.endsWith(suffix: " connect") && secondWhy.endsWith(suffix: " connect"), what: "pace: each call makes at least one try: ${firstWhy}, ${secondWhy}");
    f = f + check(ok: waited >= 40i64, what: "pace: a call right after a failed redial waits for the backoff, within its reconnect_timeout (${waited} ms)");
    return f;
}

// The check before a call writes (docs/ROADMAP.md, "Phase 7a", step 6): what came while the connection sat idle.
unsafe fn int32 idleTests() {
    int32 f = 0;
    Config plain = configOf(url: "redis://127.0.0.1:6379");
    DynamicArray<uint8> push = pushIn(b: reply(server: server(), kase: "message/3"));

    // A link closed while idle (CLIENT KILL, the idle timeout): found before the call writes, so the call makes the
    // link again and sends, and never sees the loss.
    DynamicArray<Dial> d1 = DynamicArray.empty();
    DynamicArray<Step> killed = welcome(server: server());
    killed.add(item: Step::Hangup);
    d1.add(item: Dial::Serve(steps: give killed));
    DynamicArray<Step> next = again();
    next.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    d1.add(item: Dial::Serve(steps: give next));
    Connection c1 = dialed(dials: give d1, config: plain, what: "closed while idle");
    Result<Value, RedisError> p1 = send(c: c1, text: "PING");
    string g1 = callOutcome(r: p1);
    f = f + check(ok: isSimple(r: p1, text: "PONG"), what: "idle: a link closed while idle is found before the call writes, and the call never sees it: ${g1}");

    // A push while idle is set aside, then the close behind it found: the call goes to a new link.
    DynamicArray<Dial> d2 = DynamicArray.empty();
    DynamicArray<Step> pushed = welcome(server: server());
    pushed.add(item: Step::Send(bytes: copy push));
    pushed.add(item: Step::Hangup);
    d2.add(item: Dial::Serve(steps: give pushed));
    DynamicArray<Step> next2 = again();
    next2.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    d2.add(item: Dial::Serve(steps: give next2));
    Connection c2 = dialed(dials: give d2, config: plain, what: "push while idle");
    Result<Value, RedisError> p2 = send(c: c2, text: "PING");
    isize kept = c2.pendingPushes();
    f = f + check(ok: isSimple(r: p2, text: "PONG") && kept == 1, what: "idle: a push while idle is set aside, and the close behind it found (${kept} kept)");

    // A reply no call asked for is not taken for the next call's: the link is made again, and the call sent there.
    DynamicArray<Dial> d3 = DynamicArray.empty();
    DynamicArray<Step> stray = welcome(server: server());
    stray.add(item: Step::Send(bytes: reply(server: server(), kase: "select1")));
    d3.add(item: Dial::Serve(steps: give stray));
    DynamicArray<Step> next3 = again();
    next3.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    d3.add(item: Dial::Serve(steps: give next3));
    Connection c3 = dialed(dials: give d3, config: plain, what: "a stray reply");
    Result<Value, RedisError> p3 = send(c: c3, text: "PING");
    string g3 = callOutcome(r: p3);
    f = f + check(ok: isSimple(r: p3, text: "PONG"), what: "idle: a reply no call asked for is never the next call's: a new link: ${g3}");

    // Part of a reply no call asked for: the same.
    DynamicArray<Dial> d4 = DynamicArray.empty();
    DynamicArray<Step> half = welcome(server: server());
    DynamicArray<uint8> big = reply(server: server(), kase: "get-hit/3");
    DynamicArray<uint8> front = DynamicArray.empty();
    front.addAll(items: big.view().slice(from: 0, count: big.length() - 3));
    half.add(item: Step::Send(bytes: give front));
    d4.add(item: Dial::Serve(steps: give half));
    DynamicArray<Step> next4 = again();
    next4.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    d4.add(item: Dial::Serve(steps: give next4));
    Connection c4 = dialed(dials: give d4, config: plain, what: "part of a reply");
    Result<Value, RedisError> p4 = send(c: c4, text: "PING");
    string g4 = callOutcome(r: p4);
    f = f + check(ok: isSimple(r: p4, text: "PONG"), what: "idle: part of a reply no call asked for is never the next call's: a new link: ${g4}");

    // Part of an array no call asked for (MGET's, cut short): the same.
    DynamicArray<Dial> d4b = DynamicArray.empty();
    DynamicArray<Step> halfArray = welcome(server: server());
    DynamicArray<uint8> mget = reply(server: server(), kase: "mget/3");
    DynamicArray<uint8> mgetFront = DynamicArray.empty();
    mgetFront.addAll(items: mget.view().slice(from: 0, count: mget.length() - 3));
    halfArray.add(item: Step::Send(bytes: give mgetFront));
    d4b.add(item: Dial::Serve(steps: give halfArray));
    DynamicArray<Step> next4b = again();
    next4b.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    d4b.add(item: Dial::Serve(steps: give next4b));
    Connection c4b = dialed(dials: give d4b, config: plain, what: "part of an array");
    Result<Value, RedisError> p4b = send(c: c4b, text: "PING");
    string g4b = callOutcome(r: p4b);
    f = f + check(ok: isSimple(r: p4b, text: "PONG"), what: "idle: part of an array no call asked for is never the next call's: a new link: ${g4b}");

    // A push half come stays in the reader: the call writes, and its reply comes after the push's rest.
    DynamicArray<Dial> d5 = DynamicArray.empty();
    DynamicArray<Step> split = welcome(server: server());
    DynamicArray<uint8> head = DynamicArray.empty();
    head.addAll(items: push.view().slice(from: 0, count: push.length() - 4));
    DynamicArray<uint8> rest = DynamicArray.empty();
    rest.addAll(items: push.view().slice(from: push.length() - 4, count: 4));
    DynamicArray<uint8> pong = reply(server: server(), kase: "ping");
    rest.addAll(items: pong.view());
    split.add(item: Step::Send(bytes: give head));
    split.add(item: expect(command: "PING", answer: give rest));
    d5.add(item: Dial::Serve(steps: give split));
    Connection c5 = dialed(dials: give d5, config: plain, what: "a push half come");
    Result<Value, RedisError> p5 = send(c: c5, text: "PING");
    isize kept5 = c5.pendingPushes();
    string g5 = callOutcome(r: p5);
    f = f + check(ok: isSimple(r: p5, text: "PONG") && kept5 == 1, what: "idle: a push half come stays in the reader, and the call goes on: ${g5} (${kept5} kept)");

    // A pipeline and a transaction find a closed link too; a WATCH in force is lost with it.
    DynamicArray<Dial> d6 = DynamicArray.empty();
    DynamicArray<Step> six = welcome(server: server());
    six.add(item: expect(command: "WATCH kr:w", answer: reply(server: server(), kase: "select1")));
    six.add(item: Step::Hangup);
    d6.add(item: Dial::Serve(steps: give six));
    d6.add(item: Dial::Serve(steps: committing()));
    Connection c6 = dialed(dials: give d6, config: plain, what: "watch, then closed while idle");
    Result<Value, RedisError> w6 = send(c: c6, text: "WATCH kr:w");
    Pipeline tx = setThenIncr();
    string t6 = fate(r: c6.transact(pipeline: tx));
    string t7 = fate(r: c6.transact(pipeline: tx));
    f = f + check(ok: t6 == "held back" && t7 == "committed", what: "idle: a WATCH lost while idle holds the next transaction back; the one after is sent: ${t6}, ${t7}");
    DynamicArray<Dial> d7 = DynamicArray.empty();
    DynamicArray<Step> seven = welcome(server: server());
    seven.add(item: Step::Hangup);
    d7.add(item: Dial::Serve(steps: give seven));
    DynamicArray<Step> next7 = again();
    next7.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    next7.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    d7.add(item: Dial::Serve(steps: give next7));
    Connection c7 = dialed(dials: give d7, config: plain, what: "pipeline, closed while idle");
    Pipeline pings = Pipeline.make();
    Command ping = Command.of(name: "PING");
    pings.add(command: ping);
    pings.add(command: ping);
    Result<Replies, RedisError> rp = c7.run(pipeline: pings);
    string g7 = match (rp) { case Ok(value: r): "ok"; case Err(error: e): e.message(); };
    f = f + check(ok: g7 == "ok", what: "idle: a pipeline finds a link closed while idle, and goes to a new one: ${g7}");

    // Over a transport the caller opened there is nothing to make the link again with: the end of the stream is the
    // call's error, as it would have been once the call wrote.
    DynamicArray<Step> own = welcome(server: server());
    own.add(item: Step::Hangup);
    Connection c8 = connected(script: give own, url: "redis://", what: "connectOver, closed while idle");
    Result<Value, RedisError> p8 = send(c: c8, text: "PING");
    string g8 = callOutcome(r: p8);
    f = f + check(ok: isIo(r: p8) && g8 == "Server closed the connection" && c8.isClosed(), what: "idle: over the caller's transport, a link closed while idle is the call's Io: ${g8}");
    return f;
}

// ---- a subscriber's ----

fn string utf8(ConstView<uint8> b) {
    Result<string, Utf8Error> r = decode(bytes: b);
    return match (give r) { case Ok(value: x): give x; case Err(error: e): "?"; };
}

// What `next` handed over: "message kr:c1 hello", "unsubscribed shard kr:s1", "reconnected: <cause>", "none", or
// "(error) <message>".
fn string said(Result<Optional<Delivery>, RedisError> r) {
    return match (give r) {
        case Err(error: e): { string m = e.message(); := "(error) ${m}"; }
        case Ok(value: o): match (give o) {
            case None: "none";
            case Some(value: d): match (give d) {
                case Message(message: m): { string ch = utf8(b: m.channel()); string pl = utf8(b: m.payload()); := "message ${ch} ${pl}"; }
                case Unsubscribed(kind: k, channel: c): {
                    string word = match (k) { case Channel: "channel"; case Pattern: "pattern"; case Shard: "shard"; };
                    string name = utf8(b: c.view());
                    := "unsubscribed ${word} ${name}";
                }
                case Reconnected(cause: e): { string m = e.message(); := "reconnected: ${m}"; }
            };
        };
    };
}

fn string done(Result<Unit, RedisError> r) {
    return match (give r) { case Ok(value: u): "ok"; case Err(error: e): { string m = e.message(); := "(error) ${m}"; } };
}

// The capture for pub/sub case `kase` under RESP3 ("sub-one" -> "sub-one/3").
fn DynamicArray<uint8> pub(const ref string kase) { return reply(server: server(), kase: kase.concat(other: "/3")); }

// The `index`th whole value of a capture.
fn DynamicArray<uint8> frameOf(const ref DynamicArray<uint8> b, isize index) {
    Reader r = Reader.make();
    r.feed(bytes: b.view());
    isize start = 0;
    isize k = 0;
    while (start < b.length()) {
        Read got = r.next();
        isize end = b.length() - r.buffered();
        if (k == index) {
            DynamicArray<uint8> one = DynamicArray.empty();
            one.addAll(items: b.view().slice(from: start, count: end - start));
            return give one;
        }
        start = end;
        k = k + 1;
    }
    panic(msg: "reconnect_test: no such frame");
}

fn DynamicArray<uint8> joined(const ref DynamicArray<uint8> a, const ref DynamicArray<uint8> b) {
    DynamicArray<uint8> all = DynamicArray.empty();
    all.addAll(items: a.view());
    all.addAll(items: b.view());
    return give all;
}

fn DynamicArray<string> names(const ref string a, const ref string b) {
    DynamicArray<string> list = DynamicArray.empty();
    list.add(item: copy a);
    if (b.length() > 0) { list.add(item: copy b); }
    return give list;
}

unsafe fn Subscriber subscriberWith(DynamicArray<Dial> dials, const ref Config config, const ref string what) {
    Owned<Dialer> d = new ScriptDialer.make(dials: give dials);
    Result<Subscriber, RedisError> r = Subscriber.connectWith(dialer: give d, config: config);
    Subscriber sub = match (give r) {
        case Ok(value: x): give x;
        case Err(error: e): { string m = e.message(); return stop::<Subscriber>(msg: "reconnect_test: ${what}: ${m}"); }
    };
    return give sub;
}

unsafe fn int32 subscriberTests() {
    int32 f = 0;
    Config plain = configOf(url: "redis://127.0.0.1:6379");
    DynamicArray<uint8> hello = pub(kase: "message");

    // Every kept name is subscribed again, channels, then patterns, then shard channels; `Reconnected` comes after
    // what was already queued and before anything of the new link.
    DynamicArray<Dial> d1 = DynamicArray.empty();
    DynamicArray<Step> first = welcome(server: server());
    first.add(item: expect(command: "SUBSCRIBE kr:c1", answer: pub(kase: "sub-one")));
    DynamicArray<uint8> twoPatterns = pub(kase: "psub-two-after-one");
    DynamicArray<uint8> withMessage = joined(a: frameOf(b: twoPatterns, index: 0), b: hello);
    withMessage.addAll(items: frameOf(b: twoPatterns, index: 1).view());
    first.add(item: expect(command: "PSUBSCRIBE kr:p* kr:q*", answer: give withMessage));
    first.add(item: expect(command: "SSUBSCRIBE kr:s1", answer: pub(kase: "ssub-one")));
    first.add(item: Step::Close);
    d1.add(item: Dial::Serve(steps: give first));
    DynamicArray<Step> second = again();
    second.add(item: expect(command: "SUBSCRIBE kr:c1", answer: pub(kase: "sub-one")));
    second.add(item: expect(command: "PSUBSCRIBE kr:p* kr:q*", answer: pub(kase: "psub-two")));
    second.add(item: expect(command: "SSUBSCRIBE kr:s1", answer: pub(kase: "ssub-one")));
    second.add(item: Step::Send(bytes: copy hello));
    d1.add(item: Dial::Serve(steps: give second));
    Subscriber s1 = subscriberWith(dials: give d1, config: plain, what: "resubscribe");
    string a1 = done(r: s1.subscribe(names: names(a: "kr:c1", b: "")));
    string a2 = done(r: s1.psubscribe(names: names(a: "kr:p*", b: "kr:q*")));
    string a3 = done(r: s1.ssubscribe(names: names(a: "kr:s1", b: "")));
    string pinged = done(r: s1.ping());
    string n1 = said(r: s1.next(timeout: Optional::None));
    string n2 = said(r: s1.next(timeout: Optional::None));
    string n3 = said(r: s1.next(timeout: Optional::None));
    f = f + check(ok: a1 == "ok" && a2 == "ok" && a3 == "ok" && pinged.startsWith(prefix: "(error) "), what: "subscriber: subscribed, then a PING meets the link lost: ${pinged}");
    f = f + check(ok: n1 == "message kr:c1 hello", what: "subscriber: what was queued before the loss comes first: ${n1}");
    f = f + check(ok: n2 == "reconnected: Server closed the connection", what: "subscriber: then Reconnected, with what ended the old link: ${n2}");
    f = f + check(ok: n3 == "message kr:c1 hello" && s1.channelCount() == 1 && s1.patternCount() == 2 && s1.shardCount() == 1,
                  what: "subscriber: every name subscribed again, channels, patterns, then shard channels, and the new link's message: ${n3}");

    // A name the server refuses when it is subscribed again (NOPERM since the ACL changed, MOVED once the slot left)
    // is no longer kept, and comes as Unsubscribed after Reconnected.
    DynamicArray<Dial> d2 = DynamicArray.empty();
    DynamicArray<Step> granted = welcome(server: server());
    granted.add(item: expect(command: "SUBSCRIBE kr:c1 kr:c2", answer: pub(kase: "sub-two")));
    granted.add(item: expect(command: "SSUBSCRIBE kr:s1", answer: pub(kase: "ssub-one")));
    granted.add(item: Step::Close);
    d2.add(item: Dial::Serve(steps: give granted));
    DynamicArray<Step> denied = again();
    denied.add(item: expect(command: "SUBSCRIBE kr:c1 kr:c2", answer: pub(kase: "sub-noperm")));
    denied.add(item: expect(command: "SSUBSCRIBE kr:s1", answer: pub(kase: "cluster-moved")));
    d2.add(item: Dial::Serve(steps: give denied));
    Subscriber s2 = subscriberWith(dials: give d2, config: plain, what: "refused");
    string b1 = done(r: s2.subscribe(names: names(a: "kr:c1", b: "kr:c2")));
    string b2 = done(r: s2.ssubscribe(names: names(a: "kr:s1", b: "")));
    string b3 = done(r: s2.ping());
    string m1 = said(r: s2.next(timeout: Optional::None));
    string m2 = said(r: s2.next(timeout: Optional::None));
    string m3 = said(r: s2.next(timeout: Optional::None));
    string m4 = said(r: s2.next(timeout: Optional::None));
    string m5 = said(r: s2.next(timeout: Optional::None));
    f = f + check(ok: m1.startsWith(prefix: "reconnected: ") && m2 == "unsubscribed channel kr:c1" && m3 == "unsubscribed channel kr:c2" && m4 == "unsubscribed shard kr:s1",
                  what: "subscriber: names refused when subscribed again come as Unsubscribed after Reconnected: ${m1}; ${m2}; ${m3}; ${m4}");
    f = f + check(ok: m5.startsWith(prefix: "(error) nothing is subscribed") && s2.channelCount() == 0 && s2.shardCount() == 0,
                  what: "subscriber: then nothing is kept: ${m5}");

    // Shard channels are subscribed again a slot at a time, in slot order, as a cluster wants them.
    DynamicArray<Dial> d3 = DynamicArray.empty();
    DynamicArray<Step> shards = welcome(server: server());
    shards.add(item: expect(command: "SSUBSCRIBE kr:s1 kr:s7", answer: joined(a: pub(kase: "ssub-one"), b: pub(kase: "cluster-ssub-last"))));
    shards.add(item: Step::Close);
    d3.add(item: Dial::Serve(steps: give shards));
    DynamicArray<Step> bySlot = again();
    bool s1First = keySlot(key: "kr:s1".bytes()) < keySlot(key: "kr:s7".bytes());
    if (s1First) {
        bySlot.add(item: expect(command: "SSUBSCRIBE kr:s1", answer: pub(kase: "ssub-one")));
        bySlot.add(item: expect(command: "SSUBSCRIBE kr:s7", answer: pub(kase: "cluster-ssub-last")));
    } else {
        bySlot.add(item: expect(command: "SSUBSCRIBE kr:s7", answer: pub(kase: "cluster-ssub-last")));
        bySlot.add(item: expect(command: "SSUBSCRIBE kr:s1", answer: pub(kase: "ssub-one")));
    }
    d3.add(item: Dial::Serve(steps: give bySlot));
    Subscriber s3 = subscriberWith(dials: give d3, config: plain, what: "by slot");
    string c1 = done(r: s3.ssubscribe(names: names(a: "kr:s1", b: "kr:s7")));
    string c2 = done(r: s3.ping());
    string c3 = said(r: s3.next(timeout: Optional::None));
    f = f + check(ok: c3.startsWith(prefix: "reconnected: ") && s3.shardCount() == 2, what: "subscriber: shard channels subscribed again a slot at a time: ${c3}");

    // An unsubscribe that failed with the link is never undone; nor is an unsubscribe from all of a kind.
    DynamicArray<Dial> d4 = DynamicArray.empty();
    DynamicArray<Step> dropping = welcome(server: server());
    dropping.add(item: expect(command: "SUBSCRIBE kr:c1 kr:c2", answer: pub(kase: "sub-two")));
    dropping.add(item: expect(command: "PSUBSCRIBE kr:p*", answer: pub(kase: "psub-after-three")));
    dropping.add(item: Step::Close);
    d4.add(item: Dial::Serve(steps: give dropping));
    DynamicArray<Step> kept = again();
    kept.add(item: expect(command: "SUBSCRIBE kr:c2", answer: frameOf(b: pub(kase: "sub-two"), index: 1)));
    kept.add(item: expect(command: "PSUBSCRIBE kr:p*", answer: pub(kase: "psub-one")));
    kept.add(item: Step::Close);
    d4.add(item: Dial::Serve(steps: give kept));
    DynamicArray<Step> third = again();
    third.add(item: expect(command: "SUBSCRIBE kr:c2", answer: frameOf(b: pub(kase: "sub-two"), index: 1)));
    d4.add(item: Dial::Serve(steps: give third));
    Subscriber s4 = subscriberWith(dials: give d4, config: plain, what: "failed unsubscribe");
    string e1 = done(r: s4.subscribe(names: names(a: "kr:c1", b: "kr:c2")));
    string e2 = done(r: s4.psubscribe(names: names(a: "kr:p*", b: "")));
    string e3 = done(r: s4.unsubscribe(names: names(a: "kr:c1", b: "")));
    string e4 = said(r: s4.next(timeout: Optional::None));
    f = f + check(ok: e3.startsWith(prefix: "(error) ") && e4.startsWith(prefix: "reconnected: ") && s4.channelCount() == 1 && s4.patternCount() == 1,
                  what: "subscriber: an unsubscribe that failed with the link is not undone: ${e3}; ${e4}");
    DynamicArray<string> none = DynamicArray.empty();
    string e5 = done(r: s4.punsubscribe(names: none));
    string e6 = said(r: s4.next(timeout: Optional::Some(value: Duration.zero())));
    f = f + check(ok: e5.startsWith(prefix: "(error) ") && e6.startsWith(prefix: "reconnected: ") && s4.patternCount() == 0 && s4.channelCount() == 1,
                  what: "subscriber: nor is an unsubscribe from all patterns; a zero timeout still makes the link again: ${e5}; ${e6}");

    // release() on a lost subscriber hands back the connection, which its next call makes again.
    DynamicArray<Dial> d5 = DynamicArray.empty();
    DynamicArray<Step> five = welcome(server: server());
    five.add(item: expect(command: "SUBSCRIBE kr:c1", answer: pub(kase: "sub-one")));
    five.add(item: Step::Close);
    d5.add(item: Dial::Serve(steps: give five));
    DynamicArray<Step> back = again();
    back.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    d5.add(item: Dial::Serve(steps: give back));
    Subscriber s5 = subscriberWith(dials: give d5, config: plain, what: "release");
    string g1 = done(r: s5.subscribe(names: names(a: "kr:c1", b: "")));
    string g2 = done(r: s5.ping());
    Result<Connection, RedisError> handed = s5.release();
    string g3 = match (give handed) {
        case Ok(value: conn): {
            Command ping = Command.of(name: "PING");
            Result<Value, RedisError> r = conn.call(command: ping);
            := callOutcome(r: r);
        }
        case Err(error: e): e.message();
    };
    f = f + check(ok: g3 == "ok", what: "subscriber: release() hands back a lost connection, which its next call makes again: ${g3}");

    // close() is for good; a redial that fails keeps the names for the next.
    Config brief = configOf(url: "redis://127.0.0.1:6379?reconnect_timeout=0.05");
    DynamicArray<Dial> d6 = DynamicArray.empty();
    DynamicArray<Step> six = welcome(server: server());
    six.add(item: expect(command: "SUBSCRIBE kr:c1", answer: pub(kase: "sub-one")));
    six.add(item: Step::Close);
    d6.add(item: Dial::Serve(steps: give six));
    Subscriber s6 = subscriberWith(dials: give d6, config: brief, what: "failed redial");
    string h1 = done(r: s6.subscribe(names: names(a: "kr:c1", b: "")));
    string h2 = done(r: s6.ping());
    string h3 = said(r: s6.next(timeout: Optional::None));
    f = f + check(ok: h3.startsWith(prefix: "(error) the connection was lost, and reconnecting failed") && s6.channelCount() == 1 && !s6.isClosed(),
                  what: "subscriber: a redial that fails is Reconnect, and the names stay kept: ${h3}");
    s6.close();
    string h4 = said(r: s6.next(timeout: Optional::None));
    f = f + check(ok: h4 == "(error) the connection is closed" && s6.isClosed(), what: "subscriber: close() is for good: ${h4}");

    // The link lost again while the names are subscribed again: they stay kept, and the next redial subscribes them.
    DynamicArray<Dial> d8 = DynamicArray.empty();
    DynamicArray<Step> eight = welcome(server: server());
    eight.add(item: expect(command: "SUBSCRIBE kr:c1", answer: pub(kase: "sub-one")));
    eight.add(item: Step::Close);
    d8.add(item: Dial::Serve(steps: give eight));
    DynamicArray<Step> brokenAgain = again();
    brokenAgain.add(item: Step::Close);
    d8.add(item: Dial::Serve(steps: give brokenAgain));
    DynamicArray<Step> whole = again();
    whole.add(item: expect(command: "SUBSCRIBE kr:c1", answer: pub(kase: "sub-one")));
    whole.add(item: Step::Send(bytes: copy hello));
    d8.add(item: Dial::Serve(steps: give whole));
    Subscriber s8 = subscriberWith(dials: give d8, config: plain, what: "lost again");
    string j1 = done(r: s8.subscribe(names: names(a: "kr:c1", b: "")));
    string j2 = done(r: s8.ping());
    string j3 = said(r: s8.next(timeout: Optional::None));
    bool keptThrough = s8.channelCount() == 1;
    string j4 = said(r: s8.next(timeout: Optional::None));
    string j5 = said(r: s8.next(timeout: Optional::None));
    string j6 = said(r: s8.next(timeout: Optional::None));
    f = f + check(ok: j3.startsWith(prefix: "(error) ") && keptThrough && j4.startsWith(prefix: "reconnected: ") && j5.startsWith(prefix: "reconnected: ") && j6 == "message kr:c1 hello",
                  what: "subscriber: the link lost again while subscribing again keeps the names, and the next redial subscribes them: ${j3}; ${j4}; ${j5}; ${j6}");

    // A subscribe on a lost subscriber makes the link again first: what was kept, then the new name.
    DynamicArray<Dial> d9 = DynamicArray.empty();
    DynamicArray<Step> nine = welcome(server: server());
    nine.add(item: expect(command: "SUBSCRIBE kr:c1", answer: pub(kase: "sub-one")));
    nine.add(item: Step::Close);
    d9.add(item: Dial::Serve(steps: give nine));
    DynamicArray<Step> more = again();
    more.add(item: expect(command: "SUBSCRIBE kr:c1", answer: pub(kase: "sub-one")));
    more.add(item: expect(command: "SUBSCRIBE kr:c2", answer: frameOf(b: pub(kase: "sub-two"), index: 1)));
    d9.add(item: Dial::Serve(steps: give more));
    Subscriber s9 = subscriberWith(dials: give d9, config: plain, what: "subscribe when lost");
    string q1 = done(r: s9.subscribe(names: names(a: "kr:c1", b: "")));
    string q2 = done(r: s9.ping());
    string q3 = done(r: s9.subscribe(names: names(a: "kr:c2", b: "")));
    string q4 = said(r: s9.next(timeout: Optional::Some(value: Duration.zero())));
    f = f + check(ok: q3 == "ok" && q4.startsWith(prefix: "reconnected: ") && s9.channelCount() == 2,
                  what: "subscriber: a subscribe on a lost subscriber makes the link again first: ${q3}; ${q4}");

    // Under RESP2: the RESP2 path's PING, then SUBSCRIBE again.
    Config two = configOf(url: "redis://127.0.0.1:6379?protocol=2");
    DynamicArray<Dial> d7 = DynamicArray.empty();
    DynamicArray<Step> old = DynamicArray.empty();
    old.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    old.add(item: expect(command: "SUBSCRIBE kr:c1", answer: reply(server: server(), kase: "sub-one/2")));
    old.add(item: Step::Hangup);
    d7.add(item: Dial::Serve(steps: give old));
    DynamicArray<Step> old2 = DynamicArray.empty();
    old2.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    old2.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    old2.add(item: expect(command: "SUBSCRIBE kr:c1", answer: reply(server: server(), kase: "sub-one/2")));
    old2.add(item: Step::Send(bytes: reply(server: server(), kase: "message/2")));
    d7.add(item: Dial::Serve(steps: give old2));
    Subscriber s7 = subscriberWith(dials: give d7, config: two, what: "resp2");
    string k1 = done(r: s7.subscribe(names: names(a: "kr:c1", b: "")));
    string k2 = said(r: s7.next(timeout: Optional::None));
    string k3 = said(r: s7.next(timeout: Optional::None));
    f = f + check(ok: k2.startsWith(prefix: "reconnected: ") && k3 == "message kr:c1 hello" && s7.protocol() == Protocol::Resp2,
                  what: "subscriber: under RESP2, a link lost while next waits is made again inside next: ${k2}; ${k3}");
    return f;
}

unsafe fn int32 reconnectTests() {
    int32 f = 0;
    f = f + redialTests();
    f = f + finalTests();
    f = f + keptTests();
    f = f + watchTests();
    f = f + paceTests();
    f = f + idleTests();
    f = f + subscriberTests();
    return f;
}
