// redis::RedisUrl. The redis://, rediss://, valkey:// and valkeys:// readings are redis-cli's and valkey-cli's, asked
// live (url_vectors.kama, generated by tools/gen-url-vectors.sh). unix:// and the query are this package's own
// rules (src/url.kama's header), so their cases are written here.
import { core::println, std::collections::DynamicArray, std::encoding::hex::encode as hexEncode, std::fmt::i64Str,
         redis::RedisUrl, redis::UrlTransport, redis::UrlError,
         redis_unit_tests::check, urlInputs, urlWant, urlNotes };
export { urlTests };

// What a parsed URL says, in the vectors' notation. `want` says which reading the CLI gave, so the same one is made.
fn string reading(const ref string url, const ref string want) {
    Result<RedisUrl, UrlError> r = RedisUrl.parse(text: url);
    return match (r) {
        case Err(error: e): "refused";
        case Ok(value: u): describe(u: u, address: want.startsWith(prefix: "address"));
    };
}

fn string describe(const ref RedisUrl u, bool address) {
    if (address) {
        Optional<string> h = u.host();
        string host = match (give h) { case Some(value: v): give v; case None: "127.0.0.1"; };
        Optional<int32> p = u.port();
        int32 port = match (p) { case Some(value: v): v; case None: 6379; };
        string hostHex = hexEncode(bytes: host.bytes());
        return "address host=${hostHex} port=${port}";
    }
    bool tls = match (u.transport()) { case Tls: true; case _: false; };
    if (tls) { return "session tls=1"; }
    // What redis-cli sends: AUTH [user] password when there is a password, SELECT when the database is not 0.
    Optional<string> pw = u.password();
    Optional<string> us = u.user();
    string password = hexOrDash(o: pw);
    string user = "-";
    if (password != "-") { user = hexOrDash(o: us); }
    Optional<int64> d = u.db();
    int64 db = match (d) { case Some(value: v): v; case None: 0i64; };
    string dbText = i64Str(v: db);
    return "session tls=0 user=${user} password=${password} db=${dbText}";
}

fn string hexOrDash(const ref Optional<string> o) {
    return match (o) { case Some(value: v): hexEncode(bytes: v.bytes()); case None: "-"; };
}

fn int32 vectorTests() {
    int32 f = 0;
    DynamicArray<string> inputs = urlInputs();
    DynamicArray<string> wants = urlWant();
    isize i = 0;
    while (i < inputs.length()) {
        string got = reading(url: inputs[i], want: wants[i]);
        if (got != wants[i]) {
            string url = copy inputs[i];
            string want = copy wants[i];
            println(s: "  FAIL url vector: ${url}\n      want ${want}\n      got  ${got}");
            f = f + 1;
        }
        i = i + 1;
    }
    f = f + check(ok: inputs.length() > 100, what: "url vectors: more than 100 cases");
    return f;
}

fn Result<RedisUrl, UrlError> parse(const ref string text) { return RedisUrl.parse(text: text); }

fn bool refused(const ref string text) {
    Result<RedisUrl, UrlError> r = parse(text: text);
    return match (r) { case Err(error: e): true; case Ok(value: u): false; };
}

fn bool refusedSaying(const ref string text, const ref string words) {
    Result<RedisUrl, UrlError> r = parse(text: text);
    return match (r) { case Err(error: e): e.message().contains(substring: words); case Ok(value: u): false; };
}

fn string some(const ref Optional<string> o) {
    return match (o) { case Some(value: v): copy v; case None: "<none>"; };
}

// One line per URL, for the cases below: transport, host, port, path, user, password, db, then the query.
fn string summary(const ref string text) {
    Result<RedisUrl, UrlError> r = parse(text: text);
    return match (r) {
        case Err(error: e): "refused";
        case Ok(value: u): summarize(u: u);
    };
}

fn string summarize(const ref RedisUrl u) {
    string kind = match (u.transport()) { case Tcp: "tcp"; case Tls: "tls"; case Unix: "unix"; };
    Optional<string> h = u.host();
    Optional<string> us = u.user();
    Optional<string> pw = u.password();
    string host = some(o: h);
    string user = some(o: us);
    string password = some(o: pw);
    Optional<int32> p = u.port();
    string port = match (p) { case Some(value: v): i64Str(v: cast<int64>(v)); case None: "<none>"; };
    Optional<int64> d = u.db();
    string db = match (d) { case Some(value: v): i64Str(v: v); case None: "<none>"; };
    string path = u.socketPath();
    string s = "${kind} host=${host} port=${port} path=${path} user=${user} password=${password} db=${db}";
    isize i = 0;
    while (i < u.queryLength()) {
        string k = u.queryKey(index: i);
        string v = u.queryValue(index: i);
        s = s.concat(other: " ${k}=${v}");
        i = i + 1;
    }
    return s;
}

fn int32 ownRuleTests() {
    int32 f = 0;
    f = f + check(ok: summary(text: "unix:///tmp/redis.sock") == "unix host=<none> port=<none> path=/tmp/redis.sock user=<none> password=<none> db=<none>",
                  what: "url unix: a socket path");
    f = f + check(ok: summary(text: "unix://user:pass@/tmp/r.sock?db=3") == "unix host=<none> port=<none> path=/tmp/r.sock user=user password=pass db=3 db=3",
                  what: "url unix: user, password and ?db=");
    f = f + check(ok: summary(text: "unix://:pass@/tmp/r.sock") == "unix host=<none> port=<none> path=/tmp/r.sock user=<none> password=pass db=<none>",
                  what: "url unix: a password alone");
    f = f + check(ok: summary(text: "UNIX:///tmp/a%20b.sock?timeout=5&protocol=2") == "unix host=<none> port=<none> path=/tmp/a b.sock user=<none> password=<none> db=<none> timeout=5 protocol=2",
                  what: "url unix: the scheme's case, a decoded path, the query in order");
    f = f + check(ok: refusedSaying(text: "unix://tmp/x.sock", words: "names no host"), what: "url unix: a host is refused, not dropped");
    f = f + check(ok: refused(text: "unix://") && refused(text: "unix:///") && refused(text: "unix://user:pass@"), what: "url unix: no socket path");
    f = f + check(ok: refused(text: "unix:///s?db=x") && refused(text: "unix:///s?db=-1"), what: "url unix: a database that is not a number");
    f = f + check(ok: refusedSaying(text: "unix:///s?password=x", words: "before the host"), what: "url unix: redis-py's ?password= is refused");
    f = f + check(ok: refusedSaying(text: "unix:///s?db=1&db=2", words: "twice"), what: "url unix: a key given twice");
    f = f + check(ok: refused(text: "unix:///s%zz"), what: "url unix: a bad percent-encoding in the path");

    f = f + check(ok: summary(text: "redis://h/2?protocol=2&client_name=a%20b&empty=") == "tcp host=h port=<none> path= user=<none> password=<none> db=2 protocol=2 client_name=a b empty=",
                  what: "url query: kept in order, decoded, for Config");
    f = f + check(ok: summary(text: "redis://h?protocol=3") == "tcp host=h port=<none> path= user=<none> password=<none> db=<none> protocol=3",
                  what: "url query: straight after the host");
    f = f + check(ok: refusedSaying(text: "redis://h?db=2", words: "goes in the path"), what: "url query: ?db= on a TCP URL");
    f = f + check(ok: refused(text: "redis://h?x") && refused(text: "redis://h?=v") && refused(text: "redis://h?a=1&&b=2"), what: "url query: an item that is not key=value");
    f = f + check(ok: refusedSaying(text: "redis://h?a=1&a=2", words: "twice"), what: "url query: a key given twice");
    f = f + check(ok: refused(text: "redis://h?user=x") && refused(text: "redis://h?username=x"), what: "url query: the user goes before the host");

    f = f + check(ok: summary(text: "rediss://h") == "tls host=h port=<none> path= user=<none> password=<none> db=<none>", what: "url scheme: rediss is TLS");
    f = f + check(ok: summary(text: "valkeys://h:1") == "tls host=h port=1 path= user=<none> password=<none> db=<none>", what: "url scheme: valkeys is TLS");
    f = f + check(ok: summary(text: "ReDiS://h") == "tcp host=h port=<none> path= user=<none> password=<none> db=<none>", what: "url scheme: any case");
    f = f + check(ok: refusedSaying(text: "http://h", words: "unknown scheme"), what: "url scheme: an unknown scheme");
    f = f + check(ok: refused(text: "") && refused(text: "redis") && refused(text: "redis:") && refused(text: "redis:/"), what: "url scheme: not a URL");
    f = f + check(ok: summary(text: "redis://h/9223372036854775807") == "tcp host=h port=<none> path= user=<none> password=<none> db=9223372036854775807",
                  what: "url db: the largest");
    f = f + check(ok: refused(text: "redis://h/9223372036854775808"), what: "url db: past int64");
    f = f + check(ok: refusedSaying(text: "redis://h:6379x", words: "port is a number"), what: "url port: the refusal says how to write it");
    f = f + check(ok: summary(text: "redis://\u{fc}ber:1") == "tcp host=\u{fc}ber port=1 path= user=<none> password=<none> db=<none>", what: "url host: as written, not decoded");
    return f;
}

// Several hosts and the sentinel schemes, this package's own forms (src/url.kama's header): the vectors check that the
// first host is read as redis-cli reads it.
fn string hosts(const ref string text) {
    Result<RedisUrl, UrlError> r = parse(text: text);
    return match (r) { case Err(error: e): "refused"; case Ok(value: u): listed(u: u); };
}

fn string listed(const ref RedisUrl u) {
    string s = "";
    if (u.isSentinel()) { s = "sentinels"; }
    isize i = 0;
    while (i < u.hostCount()) {
        string h = u.hostAt(index: i);
        string p = match (u.portAt(index: i)) { case Some(value: v): i64Str(v: cast<int64>(v)); case None: "-"; };
        s = s.concat(other: " ${h}:${p}");
        i = i + 1;
    }
    return s;
}

fn int32 hostListTests() {
    int32 f = 0;
    f = f + check(ok: hosts(text: "redis://h1:7000,h2:7001,h3") == " h1:7000 h2:7001 h3:-", what: "url hosts: a list, a later host with no port");
    f = f + check(ok: hosts(text: "rediss://[::1]:7000,[2001:db8::1],h") == " ::1:7000 2001:db8::1:- h:-", what: "url hosts: IPv6 in brackets");
    f = f + check(ok: hosts(text: "redis://") == "" && hosts(text: "redis://h") == " h:-", what: "url hosts: none, and one");
    f = f + check(ok: hosts(text: "redis-sentinel://s1,s2:26380?master_name=kr") == "sentinels s1:- s2:26380", what: "url sentinel: the first need not name its port");
    f = f + check(ok: hosts(text: "REDISS-SENTINEL://s1") == "sentinels s1:-", what: "url sentinel: rediss-sentinel, in any case");
    f = f + check(ok: summary(text: "rediss-sentinel://u:p@s1/2?master_name=kr") == "tls host=s1 port=<none> path= user=u password=p db=2 master_name=kr",
                  what: "url sentinel: TLS, the server's credentials and database, the query for Config");
    f = f + check(ok: refusedSaying(text: "redis://h1,h2:7001", words: "the first names its port"), what: "url hosts: the first names its port");
    f = f + check(ok: refusedSaying(text: "redis://h1:1,,h2:2", words: "an empty host") && refusedSaying(text: "redis://,h1:1", words: "an empty host")
                      && refusedSaying(text: "redis-sentinel://s1,", words: "an empty host"),
                  what: "url hosts: an empty host anywhere in the list");
    f = f + check(ok: refusedSaying(text: "redis://h1:1,h2:x", words: "port is a number"), what: "url hosts: a later host's port is checked too");
    f = f + check(ok: refusedSaying(text: "redis-sentinel://", words: "names its sentinels") && refusedSaying(text: "redis-sentinel://u:p@/0", words: "names its sentinels"),
                  what: "url sentinel: no sentinels");
    f = f + check(ok: refusedSaying(text: "sentinel://s1", words: "redis-sentinel://"), what: "url scheme: the refusal names the sentinel schemes");
    return f;
}

fn int32 urlTests() {
    int32 f = 0;
    f = f + vectorTests();
    f = f + ownRuleTests();
    f = f + hostListTests();
    return f;
}
