// redis::cluster's CRC16 and key slots, against the cluster specification and the servers (slot_vectors.kama,
// generated by tools/gen-slot-vectors.sh).
import { core::println, std::collections::DynamicArray, redis::cluster::keySlot, redis::cluster::crc16, redis::cluster::SLOT_COUNT,
         redis_unit_tests::check, unhex,
         crcCheckValue, crcSpecTable, tagKeys, tagHashed, slotKeys, slotWant };
export { slotTests };

fn int32 slotTests() {
    int32 f = 0;
    string check9 = "123456789";
    f = f + check(ok: cast<int64>(crc16(bytes: check9.bytes())) == crcCheckValue(), what: "slot: CRC16 of \"123456789\" is the specification's check value");

    // CRC16 of one byte b is the table's entry b, so the specification's whole table is checked byte by byte.
    DynamicArray<int64> table = crcSpecTable();
    int32 wrong = 0;
    int32 b = 0;
    while (b < 256) {
        DynamicArray<uint8> one = DynamicArray.empty();
        one.add(item: cast<uint8>(b));
        if (cast<int64>(crc16(bytes: one.view())) != table[cast<isize>(b)]) { wrong = wrong + 1; }
        b = b + 1;
    }
    f = f + check(ok: table.length() == 256 && wrong == 0, what: "slot: CRC16 agrees with the specification's crc16tab, entry by entry");

    DynamicArray<string> keys = tagKeys();
    DynamicArray<string> hashed = tagHashed();
    isize i = 0;
    while (i < keys.length()) {
        string key = copy keys[i];
        isize want = cast<isize>(crc16(bytes: hashed[i].bytes())) % SLOT_COUNT;
        f = f + check(ok: keySlot(key: keys[i].bytes()) == want, what: "slot: the specification's hash-tag example ${key}");
        i = i + 1;
    }

    DynamicArray<string> live = slotKeys();
    DynamicArray<int64> slots = slotWant();
    wrong = 0;
    i = 0;
    while (i < live.length()) {
        DynamicArray<uint8> key = unhex(text: live[i]);
        isize got = keySlot(key: key.view());
        if (cast<int64>(got) != slots[i]) {
            string hex = copy live[i];
            int64 want = slots[i];
            println(s: "  FAIL slot: key ${hex} is slot ${got}, the servers say ${want}");
            wrong = wrong + 1;
        }
        i = i + 1;
    }
    f = f + check(ok: live.length() > 1000 && wrong == 0, what: "slot: every key the servers were asked lands in the slot they gave");
    return f;
}
