// redis::resp, against hostile bytes and against itself. Expectations here are properties (every split of the
// input reads the same, every prefix of a reply is incomplete, what the writer writes the reader reads back), or
// this package's own decisions (attributes, streamed forms, limits). What hiredis says about each input is in
// resp_vectors.kama, generated by tools/gen-resp-vectors.sh, and checked by `respVectorTests`.
import { core::println, std::collections::DynamicArray, std::collections::ConstView, std::collections::View,
         std::encoding::hex::encode as hexEncode, std::encoding::hex::decode as hexDecode,
         std::encoding::hex::DecodeError, std::encoding::utf8::decode as utf8Decode, std::encoding::utf8::Utf8Error, std::fmt::i64Str, std::concurrent::Isolate,
         redis::resp::Reader, redis::resp::Writer, redis::resp::Value, redis::resp::Read, redis::resp::Limits,
         redis_unit_tests::check, respNames, respSources, respInputs, respMaxElements, respWant, respNotes };
export { respTests, describe, readAll, readChunked, unhex };

// ---- helpers shared with the vector tests ----

// Hex digits to bytes; spaces are ignored. A typo is a bug in this file, so it panics.
fn DynamicArray<uint8> unhex(const ref string text) { return unhexBytes(b: text.bytes()); }

fn DynamicArray<uint8> unhexBytes(ConstView<uint8> b) {
    DynamicArray<uint8> squeezed = DynamicArray.empty();
    isize i = 0;
    while (i < b.length()) {
        if (b[i] != 32ui8) { squeezed.add(item: b[i]); }
        i = i + 1;
    }
    Result<string, Utf8Error> t = utf8Decode(bytes: squeezed.view());
    string digits = match (give t) { case Ok(value: v): give v; case Err(error: e): { panic(msg: "unhex: not text"); := ""; } };
    Result<DynamicArray<uint8>, DecodeError> r = hexDecode(text: digits);
    return match (give r) { case Ok(value: v): give v; case Err(error: e): { panic(msg: "unhex: not hex"); := DynamicArray.empty(); } };
}

// A value as one line, the same line tools/resp-dump.c prints for hiredis's reply.
fn string describe(const ref Value v) {
    return match (v) {
        case Simple(bytes: b): "simple:".concat(other: hexEncode(bytes: b.view()));
        case Error(bytes: b): "error:".concat(other: hexEncode(bytes: b.view()));
        case Integer(value: n): "int:".concat(other: i64Str(v: n));
        case Double(value: d): describeDouble(d: d);
        case Boolean(value: t): t ? "bool:t" : "bool:f";
        case Null: "null";
        case BigNumber(digits: b): "bignum:".concat(other: hexEncode(bytes: b.view()));
        case Bulk(bytes: b): "bulk:".concat(other: hexEncode(bytes: b.view()));
        case Verbatim(format: f, bytes: b): "verbatim:".concat(other: hexEncode(bytes: f.view())).concat(other: ":").concat(other: hexEncode(bytes: b.view()));
        case Array(items: xs): "array[".concat(other: describeAll(xs: xs)).concat(other: "]");
        case Map(entries: xs): "map[".concat(other: describeAll(xs: xs)).concat(other: "]");
        case Set(items: xs): "set[".concat(other: describeAll(xs: xs)).concat(other: "]");
        case Push(items: xs): "push[".concat(other: describeAll(xs: xs)).concat(other: "]");
        case Attributed(parts: xs): "attr[".concat(other: describeAll(xs: xs)).concat(other: "]");
    };
}

fn string describeDouble(float64 d) {
    if (d != d) { return "double:nan"; }
    uint64 bits = bitcast<uint64>(d);
    string digits = "0123456789abcdef";
    string s = "double:";
    int32 shift = 60;
    while (shift >= 0) {
        isize n = cast<isize>((bits >> shift) & 15ui64);
        s = s.concat(other: digits.substring(start: n, end: n + 1));
        shift = shift - 4;
    }
    return s;
}

fn string describeAll(const ref DynamicArray<Value> xs) {
    string s = "";
    isize i = 0;
    while (i < xs.length()) {
        if (i > 0) { s = s.concat(other: ","); }
        s = s.concat(other: describe(v: xs[i]));
        i = i + 1;
    }
    return s;
}

// Read `input` fed `chunk` bytes at a time: every value, then how it ended — `end` (nothing left over), `more`
// (a reply begun and not finished) or `error:<message>`. `describe(a) ; describe(b)|end`.
fn string readAll(ConstView<uint8> input, isize chunk, Limits limits) {
    DynamicArray<isize> cuts = DynamicArray.empty();
    isize at = 0;
    while (at < input.length()) {
        isize n = chunk;
        if (n > input.length() - at) { n = input.length() - at; }
        cuts.add(item: n);
        at = at + n;
    }
    return readChunked(input: input, cuts: cuts, limits: limits);
}

// The same, with the pieces' sizes given.
fn string readChunked(ConstView<uint8> input, const ref DynamicArray<isize> cuts, Limits limits) {
    Reader r = Reader.withLimits(limits: limits);
    string seen = "";
    bool any = false;
    isize pos = 0;
    isize piece = 0;
    while (true) {
        bool reading = true;
        while (reading) {
            Read x = r.next();
            match (give x) {
                case Complete(value: v): {
                    if (any) { seen = seen.concat(other: " ; "); }
                    seen = seen.concat(other: describe(v: v));
                    any = true;
                }
                case Incomplete: { reading = false; }
                case Invalid(error: e): { return seen.concat(other: "|error:").concat(other: e.message()); }
            };
        }
        if (piece >= cuts.length()) { break; }
        r.feed(bytes: input.slice(from: pos, count: cuts[piece]));
        pos = pos + cuts[piece];
        piece = piece + 1;
    }
    if (r.isIdle()) { return seen.concat(other: "|end"); }
    return seen.concat(other: "|more");
}

// ---- a deterministic generator ----

type value Rng {
    uint64 state = 88172645463325252ui64;
    public ctor seeded(uint64 seed) { this.state = seed | 1ui64; }
    public fn uint64 next() {
        this.state = this.state ^ (this.state << 13);
        this.state = this.state ^ (this.state >> 7);
        this.state = this.state ^ (this.state << 17);
        return this.state;
    }
    // 0 <= n < bound
    public fn isize below(isize bound) { return cast<isize>(this.next() % cast<uint64>(bound)); }
}

fn DynamicArray<isize> randomCuts(isize total, uint64 seed) {
    Rng g = Rng.seeded(seed: seed);
    DynamicArray<isize> cuts = DynamicArray.empty();
    isize at = 0;
    while (at < total) {
        isize n = 1 + g.below(bound: 9);
        if (n > total - at) { n = total - at; }
        cuts.add(item: n);
        at = at + n;
    }
    return cuts;
}

fn Limits defaults() { return Limits.defaults(); }

fn string readWhole(const ref string input) { return readAll(input: input.bytes(), chunk: 1 << 30, limits: defaults()); }

fn string readWith(const ref string input, Limits limits) { return readAll(input: input.bytes(), chunk: 1 << 30, limits: limits); }

// ---- the corpus: inputs only ----

fn DynamicArray<string> corpus() {
    DynamicArray<string> v = DynamicArray.empty();
    v.add(item: "+OK\r\n");
    v.add(item: "-ERR unknown command\r\n");
    v.add(item: ":0\r\n");
    v.add(item: ":-9223372036854775808\r\n");
    v.add(item: ",3.14\r\n");
    v.add(item: ",-inf\r\n");
    v.add(item: ",nan\r\n");
    v.add(item: "_\r\n");
    v.add(item: "#t\r\n");
    v.add(item: "#F\r\n");
    v.add(item: "(3492890328409238509324850943850943825024385\r\n");
    v.add(item: "$5\r\nhello\r\n");
    v.add(item: "$0\r\n\r\n");
    v.add(item: "$4\r\na\r\nb\r\n");
    v.add(item: "$-1\r\n");
    v.add(item: "*-1\r\n");
    v.add(item: "!21\r\nSYNTAX invalid syntax\r\n");
    v.add(item: "=15\r\ntxt:Some string\r\n");
    v.add(item: "*0\r\n");
    v.add(item: "*3\r\n:1\r\n:2\r\n:3\r\n");
    v.add(item: "*2\r\n*3\r\n:1\r\n$5\r\nhello\r\n:2\r\n#f\r\n");
    v.add(item: "%2\r\n+first\r\n:1\r\n+second\r\n:2\r\n");
    v.add(item: "~5\r\n+orange\r\n+apple\r\n#t\r\n:100\r\n:999\r\n");
    v.add(item: ">3\r\n+message\r\n+somechannel\r\n+this is the message\r\n");
    v.add(item: "|1\r\n+key-popularity\r\n%2\r\n$1\r\na\r\n,0.1923\r\n$1\r\nb\r\n,0.0012\r\n*2\r\n:2039123\r\n:9543892\r\n");
    v.add(item: "*3\r\n:1\r\n:2\r\n|1\r\n+ttl\r\n:3600\r\n:3\r\n");
    v.add(item: "$?\r\n;4\r\nHell\r\n;5\r\no wor\r\n;1\r\nd\r\n;0\r\n");
    v.add(item: "*?\r\n:1\r\n:2\r\n:3\r\n.\r\n");
    v.add(item: "%?\r\n+a\r\n:1\r\n+b\r\n:2\r\n.\r\n");
    v.add(item: "~?\r\n*?\r\n.\r\n$?\r\n;1\r\nx\r\n;0\r\n.\r\n");
    v.add(item: ">2\r\n+invalidate\r\n*1\r\n$3\r\nkey\r\n$9\r\nGet-Reply\r\n");
    // Invalid.
    v.add(item: "@foo\r\n");
    v.add(item: ":01\r\n");
    v.add(item: ",+1\r\n");
    v.add(item: "_x\r\n");
    v.add(item: "#x\r\n");
    v.add(item: "(1-2\r\n");
    v.add(item: "+a\rb\r\n");
    v.add(item: "$-2\r\n");
    v.add(item: "$3\r\nfooXY");
    v.add(item: "=3\r\ntxt\r\n");
    v.add(item: "*-2\r\n");
    v.add(item: "*1\r\n:1\r\n.\r\n");
    v.add(item: "%?\r\n+a\r\n.\r\n");
    v.add(item: "*?\r\n|1\r\n+a\r\n+b\r\n.\r\n");
    v.add(item: ";3\r\nabc\r\n");
    v.add(item: "$?\r\n:1\r\n");
    v.add(item: ">?\r\n");
    return v;
}

// ---- the tests ----

// Every input reads the same whole, a byte at a time, in random pieces, and split at every offset.
fn int32 splitTests() {
    int32 f = 0;
    DynamicArray<string> inputs = corpus();
    isize c = 0;
    while (c < inputs.length()) {
        bool agree = splitAgrees(b: inputs[c].bytes(), c: c);
        f = f + check(ok: agree, what: "resp split: corpus case ${c} reads the same however it is split");
        c = c + 1;
    }
    return f;
}

fn bool splitAgrees(ConstView<uint8> b, isize c) {
    {
        string whole = readAll(input: b, chunk: 1 << 30, limits: defaults());
        string bytewise = readAll(input: b, chunk: 1, limits: defaults());
        bool agree = whole == bytewise;
        uint64 seed = 1ui64;
        while (seed < 4ui64) {
            DynamicArray<isize> cuts = randomCuts(total: b.length(), seed: seed * 7919ui64 + cast<uint64>(c));
            string pieces = readChunked(input: b, cuts: cuts, limits: defaults());
            if (pieces != whole) { agree = false; }
            seed = seed + 1ui64;
        }
        isize at = 1;
        while (at < b.length()) {
            DynamicArray<isize> two = DynamicArray.empty();
            two.add(item: at);
            two.add(item: b.length() - at);
            string split = readChunked(input: b, cuts: two, limits: defaults());
            if (split != whole) { agree = false; }
            at = at + 1;
        }
        return agree;
    }
}

// Every strict prefix of an input is a prefix of its reading: the values so far, then `more`, or the final error.
fn int32 prefixTests() {
    int32 f = 0;
    DynamicArray<string> inputs = corpus();
    isize c = 0;
    while (c < inputs.length()) {
        bool ok = prefixesHold(b: inputs[c].bytes());
        f = f + check(ok: ok, what: "resp prefix: every prefix of corpus case ${c} is incomplete or its final error");
        c = c + 1;
    }
    return f;
}

fn bool prefixesHold(ConstView<uint8> b) {
    {
        string whole = readAll(input: b, chunk: 1 << 30, limits: defaults());
        bool ok = true;
        isize n = 0;
        while (n < b.length()) {
            string part = readAll(input: b.slice(from: 0, count: n), chunk: 1 << 30, limits: defaults());
            bool fine = part == whole || prefixOk(part: part, whole: whole, n: n);
            if (!fine) { ok = false; }
            n = n + 1;
        }
        return ok;
    }
}

// `part` ends `|more`, or `|end` when the cut fell between replies, and its values begin `whole`'s.
fn bool prefixOk(const ref string part, const ref string whole, isize n) {
    if (n == 0) { return part == "|end"; }
    if (!part.endsWith(suffix: "|more") && !part.endsWith(suffix: "|end")) { return false; }
    isize cut = part.length() - 5;
    if (part.endsWith(suffix: "|end")) { cut = part.length() - 4; }
    string values = part.substring(start: 0, end: cut);
    return whole.startsWith(prefix: values);
}

// Replies back to back come out one after another.
fn int32 pipelineTests() {
    int32 f = 0;
    DynamicArray<string> inputs = corpus();
    string all = "";
    string want = "";
    bool any = false;
    isize c = 0;
    while (c < inputs.length()) {
        string one = readWhole(input: inputs[c]);
        if (one.endsWith(suffix: "|end")) {
            all = all.concat(other: inputs[c]);
            if (any) { want = want.concat(other: " ; "); }
            want = want.concat(other: one.substring(start: 0, end: one.length() - 4));
            any = true;
        }
        c = c + 1;
    }
    want = want.concat(other: "|end");
    f = f + check(ok: readWhole(input: all) == want, what: "resp pipeline: the valid corpus back to back reads as each case in turn");
    string bytewise = readAll(input: all.bytes(), chunk: 1, limits: defaults());
    f = f + check(ok: bytewise == want, what: "resp pipeline: the same, a byte at a time");
    f = f + check(ok: readWhole(input: ">2\r\n+message\r\n+ch\r\n+OK\r\n") == "push[simple:6d657373616765,simple:6368] ; simple:4f4b|end",
                  what: "resp pipeline: a push before a reply comes out first");
    return f;
}

fn string nested(isize depth, const ref string open, const ref string leaf, const ref string close) {
    string s = "";
    isize i = 0;
    while (i < depth) { s = s.concat(other: open); i = i + 1; }
    s = s.concat(other: leaf);
    i = 0;
    while (i < depth) { s = s.concat(other: close); i = i + 1; }
    return s;
}

fn bool isError(const ref string got, const ref string message) { return got.endsWith(suffix: "|error:".concat(other: message)); }

fn int32 depthTests() {
    int32 f = 0;
    Limits l = defaults();
    isize d = l.maxDepth;
    f = f + check(ok: readWhole(input: nested(depth: d, open: "*1\r\n", leaf: ":1\r\n", close: "")).endsWith(suffix: "|end"),
                  what: "resp depth: arrays nested to the default maxDepth read");
    f = f + check(ok: isError(got: readWhole(input: nested(depth: d + 1, open: "*1\r\n", leaf: ":1\r\n", close: "")), message: "Max nesting depth exceeded"),
                  what: "resp depth: one level past the default maxDepth is refused");

    Limits three = defaults();
    three.maxDepth = 3;
    f = f + check(ok: readWith(input: nested(depth: 3, open: "*1\r\n", leaf: ":1\r\n", close: ""), limits: three) == "array[array[array[int:1]]]|end",
                  what: "resp depth: three arrays at maxDepth 3");
    f = f + check(ok: isError(got: readWith(input: nested(depth: 4, open: "*1\r\n", leaf: ":1\r\n", close: ""), limits: three), message: "Max nesting depth exceeded"),
                  what: "resp depth: four arrays at maxDepth 3");
    f = f + check(ok: readWith(input: nested(depth: 3, open: "*?\r\n", leaf: ":1\r\n", close: ".\r\n"), limits: three).endsWith(suffix: "|end"),
                  what: "resp depth: three streamed arrays at maxDepth 3");
    f = f + check(ok: isError(got: readWith(input: nested(depth: 4, open: "*?\r\n", leaf: ":1\r\n", close: ".\r\n"), limits: three), message: "Max nesting depth exceeded"),
                  what: "resp depth: four streamed arrays at maxDepth 3");
    f = f + check(ok: readWith(input: nested(depth: 3, open: "%1\r\n+k\r\n", leaf: ":1\r\n", close: ""), limits: three).endsWith(suffix: "|end"),
                  what: "resp depth: three maps at maxDepth 3");
    f = f + check(ok: isError(got: readWith(input: nested(depth: 4, open: "%1\r\n+k\r\n", leaf: ":1\r\n", close: ""), limits: three), message: "Max nesting depth exceeded"),
                  what: "resp depth: four maps at maxDepth 3");
    // An attribute level is a level: it nests the value it describes one deeper.
    f = f + check(ok: readWith(input: nested(depth: 3, open: "|1\r\n+a\r\n+b\r\n", leaf: ":1\r\n", close: ""), limits: three) == "attr[simple:61,simple:62,simple:61,simple:62,simple:61,simple:62,int:1]|end",
                  what: "resp depth: consecutive attributes at one level merge, and cost one level");
    f = f + check(ok: readWith(input: nested(depth: 2, open: "*1\r\n|1\r\n+a\r\n+b\r\n", leaf: ":1\r\n", close: ""), limits: three).endsWith(suffix: "|error:Max nesting depth exceeded"),
                  what: "resp depth: two arrays each holding an attributed value need four levels");
    f = f + check(ok: readWith(input: "*1\r\n|1\r\n+a\r\n+b\r\n:1\r\n", limits: three) == "array[attr[simple:61,simple:62,int:1]]|end",
                  what: "resp depth: an attributed element within maxDepth");
    return f;
}

fn int32 sizeTests() {
    int32 f = 0;
    {
        Reader r = Reader.make();
        string s = "*4294967295\r\n";
        r.feed(bytes: s.bytes());
        Read x = r.next();
        bool pending = match (give x) { case Incomplete: true; case _: false; };
        f = f + check(ok: pending && r.retainedBytes() < 65536i64, what: "resp size: a declared 2^32-1 elements with none sent holds nothing");
    }
    {
        Reader r = Reader.make();
        string s = "$536870912\r\n";
        r.feed(bytes: s.bytes());
        Read x = r.next();
        bool pending = match (give x) { case Incomplete: true; case _: false; };
        f = f + check(ok: pending && r.retainedBytes() < 65536i64, what: "resp size: a declared 512 MiB string with nothing sent holds nothing");
    }
    f = f + check(ok: isError(got: readWhole(input: "*4294967296\r\n"), message: "Multi-bulk length out of range"), what: "resp size: 2^32 elements refused");
    f = f + check(ok: isError(got: readWhole(input: "%4294967296\r\n"), message: "Multi-bulk length out of range"), what: "resp size: 2^32 map pairs refused");
    f = f + check(ok: isError(got: readWhole(input: "$536870913\r\n"), message: "Bulk string length out of range"), what: "resp size: 512 MiB + 1 refused");
    f = f + check(ok: isError(got: readWhole(input: "*-2\r\n"), message: "Multi-bulk length out of range"), what: "resp size: a count of -2 refused");
    f = f + check(ok: isError(got: readWhole(input: "$-2\r\n"), message: "Bulk string length out of range"), what: "resp size: a length of -2 refused");
    // A line longer than any legal one fails without its CR LF.
    f = f + check(ok: isError(got: readWhole(input: "*123456789012345678901"), message: "Bad multi-bulk length"), what: "resp size: 21 count digits refused before CR LF");
    f = f + check(ok: isError(got: readWhole(input: ":123456789012345678901"), message: "Bad integer value"), what: "resp size: 21 integer digits refused before CR LF");
    f = f + check(ok: isError(got: readWhole(input: "$123456789012345678901"), message: "Bad bulk string length"), what: "resp size: 21 length digits refused before CR LF");
    f = f + check(ok: readWhole(input: ":12345678901234567890") == "|more", what: "resp size: 20 digits wait for CR LF");
    f = f + check(ok: isError(got: readWhole(input: "#tt"), message: "Bad bool value"), what: "resp size: a two-byte bool refused before CR LF");
    f = f + check(ok: readWhole(input: "#t\r") == "|more", what: "resp size: a bool waits for the LF after its CR");
    Limits small = defaults();
    small.maxBulk = 8i64;
    f = f + check(ok: isError(got: readWith(input: "+123456789", limits: small), message: "Bulk string length out of range"), what: "resp size: a simple string past maxBulk refused before CR LF");
    f = f + check(ok: isError(got: readWith(input: "$9\r\n", limits: small), message: "Bulk string length out of range"), what: "resp size: a bulk past maxBulk refused");
    f = f + check(ok: isError(got: readWith(input: "$?\r\n;5\r\nabcde\r\n;4\r\nfghi\r\n;0\r\n", limits: small), message: "Bulk string length out of range"),
                  what: "resp size: a streamed string past maxBulk refused on the chunk that crosses it");
    f = f + check(ok: readWith(input: "$?\r\n;4\r\nabcd\r\n;4\r\nefgh\r\n;0\r\n", limits: small) == "bulk:6162636465666768|end",
                  what: "resp size: a streamed string of exactly maxBulk");
    Limits few = defaults();
    few.maxElements = 2i64;
    f = f + check(ok: isError(got: readWith(input: "*3\r\n", limits: few), message: "Multi-bulk length out of range"), what: "resp size: a count past maxElements refused");
    f = f + check(ok: isError(got: readWith(input: "*?\r\n:1\r\n:2\r\n:3\r\n.\r\n", limits: few), message: "Multi-bulk length out of range"),
                  what: "resp size: a streamed array past maxElements refused as it grows");
    f = f + check(ok: readWith(input: "%2\r\n:1\r\n:2\r\n:3\r\n:4\r\n", limits: few) == "map[int:1,int:2,int:3,int:4]|end", what: "resp size: maxElements counts map pairs");
    Limits tight = defaults();
    tight.maxReplyBytes = 64i64;
    f = f + check(ok: readWith(input: "*100\r\n", limits: tight) == "|more", what: "resp size: a header alone is within maxReplyBytes");
    string flood = "*100\r\n";
    isize i = 0;
    while (i < 100) { flood = flood.concat(other: "_\r\n"); i = i + 1; }
    f = f + check(ok: isError(got: readWith(input: flood, limits: tight), message: "Reply larger than the reader allows"), what: "resp size: a flood of nulls past maxReplyBytes refused");
    return f;
}

fn int32 bulkTests() {
    int32 f = 0;
    f = f + check(ok: isError(got: readWhole(input: "$3\r\nfooXY"), message: "Bulk string not terminated by CRLF"), what: "resp bulk: payload not followed by CR LF");
    f = f + check(ok: isError(got: readWhole(input: "$3\r\nfoo\n\r"), message: "Bulk string not terminated by CRLF"), what: "resp bulk: LF CR is not CR LF");
    f = f + check(ok: readWhole(input: "$3\r\nfoo\r") == "|more", what: "resp bulk: waits for the LF");
    f = f + check(ok: readWhole(input: "$0\r\n\r\n") == "bulk:|end", what: "resp bulk: empty");
    f = f + check(ok: readWhole(input: "$4\r\n\r\n\r\n\r\n") == "bulk:0d0a0d0a|end", what: "resp bulk: CR LF inside a payload is payload");
    f = f + check(ok: readWhole(input: "=7\r\nmkd:abc\r\n") == "verbatim:6d6b64:616263|end", what: "resp bulk: verbatim");
    f = f + check(ok: readWhole(input: "=4\r\ntxt:\r\n") == "verbatim:747874:|end", what: "resp bulk: verbatim with no text");
    f = f + check(ok: isError(got: readWhole(input: "=4\r\ntxtx\r\n"), message: "Verbatim string 4 bytes of content type are missing or incorrectly encoded."),
                  what: "resp bulk: verbatim without its colon");
    f = f + check(ok: readWhole(input: "!-1\r\n") == "null|end", what: "resp bulk: a blob error of -1 is null, as every -1 is");
    f = f + check(ok: readWhole(input: "=-1\r\n") == "null|end", what: "resp bulk: a verbatim of -1 is null");
    f = f + check(ok: readWhole(input: "$?\r\n;0\r\n") == "bulk:|end", what: "resp bulk: an empty streamed string");
    f = f + check(ok: isError(got: readWhole(input: "$?\r\n;-1\r\n"), message: "Bulk string length out of range"), what: "resp bulk: a negative chunk");
    f = f + check(ok: isError(got: readWhole(input: "=?\r\n"), message: "Bad bulk string length"), what: "resp bulk: no streamed verbatim");
    f = f + check(ok: isError(got: readWhole(input: "!?\r\n"), message: "Bad bulk string length"), what: "resp bulk: no streamed blob error");
    f = f + check(ok: isError(got: readWhole(input: "!\r\n"), message: "Bad bulk string length"), what: "resp bulk: a blob error with no length");
    return f;
}

fn int32 stickyTests() {
    int32 f = 0;
    Reader r = Reader.make();
    string bad = ":x\r\n";
    r.feed(bytes: bad.bytes());
    Read a = r.next();
    string first = match (give a) { case Invalid(error: e): e.message(); case _: "none"; };
    string good = ":1\r\n";
    isize i = 0;
    bool same = true;
    while (i < 100) {
        r.feed(bytes: good.bytes());
        Read b = r.next();
        string again = match (give b) { case Invalid(error: e): e.message(); case _: "none"; };
        if (again != first) { same = false; }
        i = i + 1;
    }
    f = f + check(ok: first == "Bad integer value" && same, what: "resp sticky: the first error answers every later call");
    f = f + check(ok: r.buffered() == 0 && r.retainedBytes() <= 16384i64 && !r.isIdle(), what: "resp sticky: a failed reader drops what it is fed");
    return f;
}

fn int32 scalarTests() {
    int32 f = 0;
    f = f + check(ok: readWhole(input: ":9223372036854775807\r\n") == "int:9223372036854775807|end", what: "resp scalar: int64 max");
    f = f + check(ok: readWhole(input: ":-9223372036854775808\r\n") == "int:-9223372036854775808|end", what: "resp scalar: int64 min");
    f = f + check(ok: isError(got: readWhole(input: ":9223372036854775808\r\n"), message: "Bad integer value"), what: "resp scalar: int64 max + 1");
    f = f + check(ok: isError(got: readWhole(input: ":-9223372036854775809\r\n"), message: "Bad integer value"), what: "resp scalar: int64 min - 1");
    f = f + check(ok: isError(got: readWhole(input: ":-0\r\n"), message: "Bad integer value"), what: "resp scalar: -0");
    f = f + check(ok: isError(got: readWhole(input: ":+1\r\n"), message: "Bad integer value"), what: "resp scalar: +1");
    f = f + check(ok: isError(got: readWhole(input: ":\r\n"), message: "Bad integer value"), what: "resp scalar: empty integer");
    f = f + check(ok: readWhole(input: ",.5\r\n") == "double:3fe0000000000000|end", what: "resp scalar: .5");
    f = f + check(ok: readWhole(input: ",1.\r\n") == "double:3ff0000000000000|end", what: "resp scalar: 1.");
    f = f + check(ok: readWhole(input: ",-0\r\n") == "double:8000000000000000|end", what: "resp scalar: -0 keeps its sign");
    f = f + check(ok: readWhole(input: ",INF\r\n") == "double:7ff0000000000000|end", what: "resp scalar: INF");
    f = f + check(ok: readWhole(input: ",-Inf\r\n") == "double:fff0000000000000|end", what: "resp scalar: -Inf");
    f = f + check(ok: readWhole(input: ",-nan\r\n") == "double:nan|end", what: "resp scalar: -nan");
    f = f + check(ok: isError(got: readWhole(input: ",infinity\r\n"), message: "Bad double value"), what: "resp scalar: infinity is not RESP");
    f = f + check(ok: isError(got: readWhole(input: ",1e\r\n"), message: "Bad double value"), what: "resp scalar: 1e");
    f = f + check(ok: isError(got: readWhole(input: ",.\r\n"), message: "Bad double value"), what: "resp scalar: a lone point");
    f = f + check(ok: isError(got: readWhole(input: ",1e999\r\n"), message: "Bad double value"), what: "resp scalar: overflow");
    string big = ",0.";
    while (big.length() < 326) { big = big.concat(other: "0"); }
    f = f + check(ok: readWhole(input: big.concat(other: "\r\n")) == "double:0000000000000000|end", what: "resp scalar: a 325-byte double");
    f = f + check(ok: isError(got: readWhole(input: big.concat(other: "0\r\n")), message: "Double value is too large"), what: "resp scalar: a 326-byte double");
    f = f + check(ok: readWhole(input: "#T\r\n") == "bool:t|end", what: "resp scalar: #T");
    f = f + check(ok: isError(got: readWhole(input: "#\r\n"), message: "Bad bool value"), what: "resp scalar: an empty bool");
    f = f + check(ok: readWhole(input: "(\r\n") == "bignum:|end", what: "resp scalar: an empty bignum, as hiredis reads one");
    f = f + check(ok: readWhole(input: "(-\r\n") == "bignum:2d|end", what: "resp scalar: a bignum of just -, as hiredis reads one");
    f = f + check(ok: isError(got: readWhole(input: "(+1\r\n"), message: "Bad bignum value"), what: "resp scalar: a bignum with +");
    f = f + check(ok: isError(got: readWhole(input: "+a\nb\r\n"), message: "Bad simple string value"), what: "resp scalar: LF inside a simple string");
    f = f + check(ok: isError(got: readWhole(input: "-a\r\r\n"), message: "Bad simple string value"), what: "resp scalar: CR at the end of an error line");
    // Every byte that starts no type, with hiredis's quoting.
    int32 bad = 0;
    int32 b = 0;
    while (b < 256) {
        uint8 t = cast<uint8>(b);
        DynamicArray<uint8> one = DynamicArray.empty();
        one.add(item: t);
        one.add(item: 13ui8);
        one.add(item: 10ui8);
        string got = readAll(input: one.view(), chunk: 8, limits: defaults());
        bool typed = got.startsWith(prefix: "|error:Protocol error, got \"") && got.endsWith(suffix: "\" as reply type byte");
        bool known = t == 43ui8 || t == 45ui8 || t == 58ui8 || t == 44ui8 || t == 95ui8 || t == 36ui8 || t == 42ui8 || t == 37ui8
                  || t == 124ui8 || t == 126ui8 || t == 35ui8 || t == 61ui8 || t == 62ui8 || t == 40ui8 || t == 33ui8;
        if (!known && !typed) { bad = bad + 1; }
        b = b + 1;
    }
    f = f + check(ok: bad == 0, what: "resp scalar: every byte that starts no type is a type-byte error");
    return f;
}

fn int32 attributeTests() {
    int32 f = 0;
    f = f + check(ok: readWhole(input: "|1\r\n+k\r\n+v\r\n:1\r\n") == "attr[simple:6b,simple:76,int:1]|end", what: "resp attribute: on a top-level value");
    f = f + check(ok: readWhole(input: "*2\r\n:1\r\n|1\r\n+k\r\n+v\r\n:2\r\n") == "array[int:1,attr[simple:6b,simple:76,int:2]]|end", what: "resp attribute: on an element, which it does not count");
    f = f + check(ok: readWhole(input: "%1\r\n|1\r\n+a\r\n+b\r\n+key\r\n:1\r\n") == "map[attr[simple:61,simple:62,simple:6b6579],int:1]|end", what: "resp attribute: on a map key");
    f = f + check(ok: readWhole(input: "|1\r\n+a\r\n+b\r\n*1\r\n:1\r\n") == "attr[simple:61,simple:62,array[int:1]]|end", what: "resp attribute: on an aggregate");
    f = f + check(ok: readWhole(input: "|1\r\n+a\r\n+b\r\n|1\r\n+c\r\n+d\r\n:1\r\n") == "attr[simple:61,simple:62,simple:63,simple:64,int:1]|end", what: "resp attribute: two in a row merge");
    f = f + check(ok: readWhole(input: "|1\r\n|1\r\n+x\r\n+y\r\n+a\r\n+b\r\n:1\r\n") == "attr[attr[simple:78,simple:79,simple:61],simple:62,int:1]|end", what: "resp attribute: on an attribute's key");
    f = f + check(ok: readWhole(input: "|0\r\n:1\r\n") == "int:1|end", what: "resp attribute: of no pairs is nothing");
    f = f + check(ok: readWhole(input: "|-1\r\n") == "null|end", what: "resp attribute: of -1 is null, as every -1 is");
    f = f + check(ok: readWhole(input: "|1\r\n+a\r\n+b\r\n") == "|more", what: "resp attribute: waits for its value");
    f = f + check(ok: isError(got: readWhole(input: "*?\r\n|1\r\n+a\r\n+b\r\n.\r\n"), message: "Attribute not followed by a value"), what: "resp attribute: before the end of a streamed array");
    f = f + check(ok: isError(got: readWhole(input: "|?\r\n"), message: "Bad multi-bulk length"), what: "resp attribute: no streamed attribute");
    return f;
}

fn int32 streamTests() {
    int32 f = 0;
    f = f + check(ok: readWhole(input: "$?\r\n;4\r\nHell\r\n;5\r\no wor\r\n;1\r\nd\r\n;0\r\n") == readWhole(input: "$10\r\nHello word\r\n"), what: "resp stream: a streamed string reads as its bulk");
    f = f + check(ok: readWhole(input: "*?\r\n:1\r\n:2\r\n:3\r\n.\r\n") == readWhole(input: "*3\r\n:1\r\n:2\r\n:3\r\n"), what: "resp stream: a streamed array reads as its counted form");
    f = f + check(ok: readWhole(input: "%?\r\n+a\r\n:1\r\n+b\r\n:2\r\n.\r\n") == readWhole(input: "%2\r\n+a\r\n:1\r\n+b\r\n:2\r\n"), what: "resp stream: a streamed map");
    f = f + check(ok: readWhole(input: "~?\r\n.\r\n") == "set[]|end", what: "resp stream: an empty streamed set");
    f = f + check(ok: isError(got: readWhole(input: "%?\r\n+a\r\n.\r\n"), message: "Streamed map ended between a key and its value"), what: "resp stream: a map ended after a key");
    f = f + check(ok: isError(got: readWhole(input: ".\r\n"), message: "Protocol error, got \".\" as reply type byte"), what: "resp stream: . at the top");
    f = f + check(ok: isError(got: readWhole(input: "*2\r\n:1\r\n.\r\n"), message: "Protocol error, got \".\" as reply type byte"), what: "resp stream: . in a counted array");
    f = f + check(ok: isError(got: readWhole(input: "*?\r\n.x\r\n"), message: "Bad streamed aggregate end"), what: "resp stream: . with something after it");
    f = f + check(ok: isError(got: readWhole(input: ";1\r\na\r\n"), message: "Protocol error, got \";\" as reply type byte"), what: "resp stream: ; outside a streamed string");
    f = f + check(ok: isError(got: readWhole(input: "$?\r\n+a\r\n"), message: "Protocol error, got \"+\" as reply type byte"), what: "resp stream: anything but ; inside a streamed string");
    f = f + check(ok: isError(got: readWhole(input: ">?\r\n"), message: "Bad multi-bulk length"), what: "resp stream: no streamed push");
    return f;
}

// Inputs large enough that a reader doing quadratic work would not finish.
fn int32 largeTests() {
    int32 f = 0;
    {
        Reader r = Reader.make();
        string head = "*1000000\r\n";
        r.feed(bytes: head.bytes());
        string one = ":1\r\n:1\r\n";
        isize sent = 0;
        bool early = false;
        isize count = -2;
        while (sent < 500000) {
            r.feed(bytes: one.bytes());
            Read x = r.next();
            match (give x) {
                case Incomplete: { }
                case Complete(value: v): {
                    if (sent != 499999) { early = true; }
                    count = match (v) { case Array(items: xs): xs.length(); case _: -1; };
                }
                case Invalid(error: e): { early = true; }
            };
            sent = sent + 1;
        }
        f = f + check(ok: !early && count == 1000000, what: "resp large: a million elements, eight bytes at a time");
    }
    {
        Reader r = Reader.make();
        string plus = "+";
        r.feed(bytes: plus.bytes());
        string a = "a";
        isize i = 0;
        bool early = false;
        while (i < 2097152) {
            r.feed(bytes: a.bytes());
            Read x = r.next();
            match (give x) { case Incomplete: { } case _: { early = true; } };
            i = i + 1;
        }
        string end = "\r\n";
        r.feed(bytes: end.bytes());
        Read last = r.next();
        isize n = match (give last) { case Complete(value: v): match (v) { case Simple(bytes: b): b.length(); case _: -1; }; case _: -2; };
        f = f + check(ok: !early && n == 2097152, what: "resp large: a 2 MiB simple string a byte at a time");
    }
    {
        Reader r = Reader.make();
        isize size = 67108864;
        string head = "$67108864\r\n";
        r.feed(bytes: head.bytes());
        DynamicArray<uint8> piece = DynamicArray.empty();
        isize i = 0;
        while (i < 16384) { piece.add(item: truncate<uint8>(i)); i = i + 1; }
        isize sent = 0;
        bool small = true;
        while (sent < size) {
            r.feed(bytes: piece.view());
            Read x = r.next();
            match (give x) { case Incomplete: { } case _: { small = false; } };
            if (r.buffered() > 16384) { small = false; }
            sent = sent + 16384;
        }
        string end = "\r\n";
        r.feed(bytes: end.bytes());
        Read last = r.next();
        isize n = match (give last) { case Complete(value: v): match (v) { case Bulk(bytes: b): b.length(); case _: -1; }; case _: -2; };
        f = f + check(ok: small && n == size, what: "resp large: a 64 MiB bulk in 16 KiB pieces, never buffered whole");
    }
    return f;
}

fn int32 fuzzTests() {
    int32 f = 0;
    Limits tiny = defaults();
    tiny.maxBulk = 16i64;
    tiny.maxElements = 8i64;
    tiny.maxDepth = 4;
    tiny.maxReplyBytes = 4096i64;
    string alphabet = "+-:,_$*%|~#=>(!.;?\r\n\r\n0123456789-1tfTFinfa ";
    return fuzzWith(abc: alphabet.bytes(), tiny: tiny);
}

fn int32 fuzzWith(ConstView<uint8> abc, Limits tiny) {
    int32 f = 0;
    Rng g = Rng.seeded(seed: 20261003ui64);
    int32 disagree = 0;
    int32 round = 0;
    while (round < 3000) {
        isize len = 1 + g.below(bound: 64);
        DynamicArray<uint8> noise = DynamicArray.withCapacity(capacity: len);
        isize i = 0;
        while (i < len) {
            if (g.below(bound: 8) == 0) { noise.add(item: truncate<uint8>(g.next())); } else { noise.add(item: abc[g.below(bound: abc.length())]); }
            i = i + 1;
        }
        string whole = readAll(input: noise.view(), chunk: 1 << 30, limits: tiny);
        string bytewise = readAll(input: noise.view(), chunk: 1, limits: tiny);
        if (whole != bytewise) { disagree = disagree + 1; }
        round = round + 1;
    }
    f = f + check(ok: disagree == 0, what: "resp fuzz: 3000 noise inputs read the same whole and a byte at a time");
    DynamicArray<string> inputs = corpus();
    disagree = 0;
    round = 0;
    while (round < 3000) {
        DynamicArray<uint8> m = mutate(b: inputs[g.below(bound: inputs.length())].bytes(), abc: abc, g: g);
        string whole = readAll(input: m.view(), chunk: 1 << 30, limits: defaults());
        string bytewise = readAll(input: m.view(), chunk: 1, limits: defaults());
        string small = readAll(input: m.view(), chunk: 1, limits: tiny);
        if (whole != bytewise) { disagree = disagree + 1; }
        round = round + 1;
    }
    f = f + check(ok: disagree == 0, what: "resp fuzz: 3000 mutated replies read the same whole and a byte at a time");
    return f;
}

// `b` with one byte replaced, dropped or added.
fn DynamicArray<uint8> mutate(ConstView<uint8> b, ConstView<uint8> abc, ref Rng g) {
    DynamicArray<uint8> m = DynamicArray.empty();
    isize at = g.below(bound: b.length());
    isize how = g.below(bound: 3);
    isize i = 0;
    while (i < b.length()) {
        if (i == at && how == 0) { m.add(item: abc[g.below(bound: abc.length())]); }
        else if (i == at && how == 1) { }
        else { m.add(item: b[i]); }
        if (i == at && how == 2) { m.add(item: abc[g.below(bound: abc.length())]); }
        i = i + 1;
    }
    return m;
}

// ---- round trips through the writer ----

fn DynamicArray<uint8> randomBytes(ref Rng g, isize most, bool lineSafe) {
    isize n = g.below(bound: most + 1);
    DynamicArray<uint8> b = DynamicArray.withCapacity(capacity: n);
    isize i = 0;
    while (i < n) {
        uint8 c = truncate<uint8>(g.next());
        if (lineSafe && (c == 13ui8 || c == 10ui8)) { c = 120ui8; }
        b.add(item: c);
        i = i + 1;
    }
    return b;
}

fn float64 randomDouble(ref Rng g) {
    isize pick = g.below(bound: 10);
    if (pick == 0) { return 0.0; }
    if (pick == 1) { return -0.0; }
    if (pick == 2) { return 5e-324; }
    if (pick == 3) { return 1e16; }
    if (pick == 4) { return 0.1; }
    if (pick == 5) { return -1.7976931348623157e308; }
    uint64 bits = g.next();
    float64 d = bitcast<float64>(bits);
    return d;
}

fn Value randomValue(ref Rng g, isize depth) { return randomOf(g: g, depth: depth, attributes: true); }

fn Value randomOf(ref Rng g, isize depth, bool attributes) {
    isize kind = g.below(bound: 14);
    if (!attributes && kind == 13) { kind = 9; }
    if (depth <= 0 && kind >= 9) { kind = g.below(bound: 9); }
    if (kind == 0) { DynamicArray<uint8> b = randomBytes(g: g, most: 12, lineSafe: true); return Value::Simple(bytes: give b); }
    if (kind == 1) { DynamicArray<uint8> b = randomBytes(g: g, most: 12, lineSafe: false); return Value::Error(bytes: give b); }
    if (kind == 2) { return Value::Integer(value: bitcast<int64>(g.next())); }
    if (kind == 3) { return Value::Double(value: randomDouble(g: g)); }
    if (kind == 4) { return Value::Boolean(value: g.below(bound: 2) == 0); }
    if (kind == 5) { return Value::Null; }
    if (kind == 6) {
        DynamicArray<uint8> d = DynamicArray.empty();
        if (g.below(bound: 2) == 0) { d.add(item: 45ui8); }
        isize n = 1 + g.below(bound: 40);
        isize i = 0;
        while (i < n) { d.add(item: truncate<uint8>(48 + g.below(bound: 10))); i = i + 1; }
        return Value::BigNumber(digits: give d);
    }
    if (kind == 7) { DynamicArray<uint8> b = randomBytes(g: g, most: 40, lineSafe: false); return Value::Bulk(bytes: give b); }
    if (kind == 8) {
        DynamicArray<uint8> fmt = DynamicArray.empty();
        fmt.add(item: 116ui8);
        fmt.add(item: 120ui8);
        fmt.add(item: 116ui8);
        DynamicArray<uint8> b = randomBytes(g: g, most: 20, lineSafe: false);
        return Value::Verbatim(format: give fmt, bytes: give b);
    }
    isize n = g.below(bound: 4);
    DynamicArray<Value> xs = DynamicArray.empty();
    isize count = n;
    if (kind == 10) { count = n * 2; }
    if (kind == 13) { count = 2 * (1 + g.below(bound: 2)); }
    isize i = 0;
    while (i < count) { xs.add(item: randomValue(g: g, depth: depth - 1)); i = i + 1; }
    if (kind == 9) { return Value::Array(items: give xs); }
    if (kind == 10) { return Value::Map(entries: give xs); }
    if (kind == 11) { return Value::Set(items: give xs); }
    if (kind == 12) { return Value::Push(items: give xs); }
    // An attributed value, in the reader's canonical form: at least one pair, and a value that is not itself attributed.
    xs.add(item: randomOf(g: g, depth: depth - 1, attributes: false));
    return Value::Attributed(parts: give xs);
}

fn int32 roundTripTests() {
    int32 f = 0;
    Rng g = Rng.seeded(seed: 777ui64);
    int32 wrong = 0;
    int32 refused = 0;
    int32 round = 0;
    while (round < 2000) {
        Value v = randomValue(g: g, depth: 4);
        Writer w = Writer.make();
        if (!w.value(v: v)) { refused = refused + 1; }
        DynamicArray<isize> cuts = randomCuts(total: w.length(), seed: cast<uint64>(round) + 1ui64);
        string back = readChunked(input: w.view(), cuts: cuts, limits: defaults());
        string want = describe(v: v).concat(other: "|end");
        if (back != want) { wrong = wrong + 1; }
        round = round + 1;
    }
    f = f + check(ok: wrong == 0 && refused == 0, what: "resp round trip: 2000 random values written, then read back in random pieces");

    // The streamed forms read back as the counted ones.
    Writer s = Writer.make();
    s.streamedString();
    string p1 = "Hel";
    string p2 = "lo";
    bool c1 = s.chunk(bytes: p1.bytes());
    bool c2 = s.chunk(bytes: p2.bytes());
    s.streamedStringEnd();
    s.streamedArray();
    s.integer(value: 1i64);
    s.streamedMap();
    string k = "k";
    s.bulk(bytes: k.bytes());
    s.nil();
    s.streamedEnd();
    s.streamedEnd();
    s.streamedSet();
    s.streamedEnd();
    string got = readAll(input: s.view(), chunk: 3, limits: defaults());
    f = f + check(ok: c1 && c2 && got == "bulk:48656c6c6f ; array[int:1,map[bulk:6b,null]] ; set[]|end", what: "resp round trip: streamed writer forms");

    // RESP2's nulls.
    Writer n = Writer.make();
    n.nullBulk();
    n.nullArray();
    f = f + check(ok: readAll(input: n.view(), chunk: 1, limits: defaults()) == "null ; null|end", what: "resp round trip: RESP2 nulls");
    return f;
}

fn bool unchanged(const ref Writer w, isize before) { return w.length() == before; }

fn int32 writerTests() {
    int32 f = 0;
    Writer w = Writer.make();
    string ok = "OK";
    bool s = w.simple(text: ok.bytes());
    isize before = w.length();
    string cr = "a\rb";
    f = f + check(ok: s && !w.simple(text: cr.bytes()) && unchanged(w: w, before: before), what: "resp writer: a simple string with CR refused");
    string two = "tx";
    string body = "x";
    f = f + check(ok: !w.verbatim(format: two.bytes(), text: body.bytes()) && unchanged(w: w, before: before), what: "resp writer: a two-byte verbatim format refused");
    string colon = "t:t";
    f = f + check(ok: !w.verbatim(format: colon.bytes(), text: body.bytes()) && unchanged(w: w, before: before), what: "resp writer: a colon in a verbatim format refused");
    string notDigits = "12a";
    string empty = "";
    string minus = "-";
    f = f + check(ok: !w.bigNumber(digits: notDigits.bytes()) && !w.bigNumber(digits: empty.bytes()) && !w.bigNumber(digits: minus.bytes()) && unchanged(w: w, before: before),
                  what: "resp writer: big numbers that are not digits refused");
    f = f + check(ok: !w.chunk(bytes: empty.bytes()) && unchanged(w: w, before: before), what: "resp writer: an empty chunk refused");
    DynamicArray<Value> odd = DynamicArray.empty();
    odd.add(item: Value::Null);
    Value m = Value::Map(entries: give odd);
    f = f + check(ok: !w.value(v: m) && unchanged(w: w, before: before), what: "resp writer: a map with an odd number of entries refused");
    DynamicArray<Value> lone = DynamicArray.empty();
    lone.add(item: Value::Null);
    lone.add(item: Value::Null);
    Value a = Value::Attributed(parts: give lone);
    f = f + check(ok: !w.value(v: a) && unchanged(w: w, before: before), what: "resp writer: an attributed value with no pair refused");
    DynamicArray<Value> innerParts = DynamicArray.empty();
    innerParts.add(item: Value::Null);
    innerParts.add(item: Value::Null);
    innerParts.add(item: Value::Null);
    DynamicArray<Value> outerParts = DynamicArray.empty();
    outerParts.add(item: Value::Null);
    outerParts.add(item: Value::Null);
    outerParts.add(item: Value::Attributed(parts: give innerParts));
    Value nestedAttr = Value::Attributed(parts: give outerParts);
    f = f + check(ok: !w.value(v: nestedAttr) && unchanged(w: w, before: before), what: "resp writer: attributes around attributes refused");
    DynamicArray<Value> deep = DynamicArray.empty();
    DynamicArray<uint8> crb = DynamicArray.empty();
    crb.add(item: 13ui8);
    deep.add(item: Value::Integer(value: 1i64));
    deep.add(item: Value::Simple(bytes: give crb));
    Value arr = Value::Array(items: give deep);
    f = f + check(ok: !w.value(v: arr) && unchanged(w: w, before: before), what: "resp writer: a bad element rolls back its array's header");
    // An error with a line break goes out as a blob error.
    Writer e = Writer.make();
    string multi = "ERR a\r\nb";
    e.error(text: multi.bytes());
    f = f + check(ok: readAll(input: e.view(), chunk: 1, limits: defaults()) == "error:45525220610d0a62|end", what: "resp writer: an error with CR LF is written as !");
    Writer d = Writer.make();
    d.real(value: 1e16);
    d.real(value: 0.1);
    d.real(value: -0.0);
    string doubles = readAll(input: d.view(), chunk: 1, limits: defaults());
    f = f + check(ok: doubles == "double:4341c37937e08000 ; double:3fb999999999999a ; double:8000000000000000|end", what: "resp writer: doubles in shortest form read back exactly");
    return f;
}

fn int32 apiTests() {
    int32 f = 0;
    Reader r = Reader.make();
    f = f + check(ok: r.isIdle(), what: "resp api: a new reader is idle");
    string part = "*2\r\n:1\r";
    isize n = copyInto(to: r.spare(minimum: 4), from: part.bytes());
    r.commit(count: n);
    Read x = r.next();
    bool pending = match (give x) { case Incomplete: true; case _: false; };
    f = f + check(ok: pending && !r.isIdle(), what: "resp api: spare and commit, half a reply");
    string rest = "\n:2\r\n";
    r.feed(bytes: rest.bytes());
    Read y = r.next();
    string got = match (give y) { case Complete(value: v): describe(v: v); case _: "none"; };
    f = f + check(ok: got == "array[int:1,int:2]" && r.isIdle(), what: "resp api: the rest by feed completes it");
    return f;
}

fn isize copyInto(View<uint8> to, ConstView<uint8> from) {
    isize i = 0;
    while (i < from.length() && i < to.length()) { to[i] = from[i]; i = i + 1; }
    return i;
}

// A reply at the default maxDepth, walked (compared, written, dropped) inside an isolate, on the stack kama gives
// every isolate (the main thread's, since 0.9.529).
type resource DeepJob implements Sendable {
    int32 code = -1;
    public ctor make() { }
    public fn void run() { this.code = deepWalk(); }
    public const fn int32 result() { return this.code; }
}

fn void deepWorker(ref DeepJob j) { j.run(); }

fn int32 deepWalk() {
    Limits l = Limits.defaults();
    string text = nested(depth: l.maxDepth, open: "*2\r\n:1\r\n", leaf: "$3\r\nend\r\n", close: "");
    Reader a = Reader.make();
    a.feed(bytes: text.bytes());
    Reader b = Reader.make();
    b.feed(bytes: text.bytes());
    Optional<Value> x = completed(r: a.next());
    Optional<Value> y = completed(r: b.next());
    return compareBoth(a: x, b: y, n: text.length());
}

fn Optional<Value> completed(Read r) {
    return match (give r) { case Complete(value: v): Optional::Some(value: give v); case _: Optional::None; };
}

fn int32 compareBoth(const ref Optional<Value> a, const ref Optional<Value> b, isize n) {
    return match (a) {
        case Some(value: v): match (b) { case Some(value: u): writeSame(v: v, u: u, n: n); case None: 2; };
        case None: 3;
    };
}

fn int32 writeSame(const ref Value v, const ref Value u, isize n) {
    Writer w = Writer.make();
    bool wrote = w.value(v: v);
    if (v.equals(other: u) && wrote && w.length() == n) { return 0; }
    return 1;
}

fn int32 isolateTests() {
    int32 f = 0;
    DeepJob j = DeepJob.make();
    scope { spawn deepWorker(j: ref j); }
    f = f + check(ok: j.result() == 0, what: "resp isolate: a reply at the default maxDepth compared, written and dropped in an isolate");
    return f;
}

// Every vector in resp_vectors.kama, read whole and a byte at a time by a reader with hiredis's limits: no bound
// on a string or a reply, its maxelements (0 is none), and its depth of 1024.
fn int32 respVectorTests() {
    int32 f = 0;
    DynamicArray<string> names = respNames();
    DynamicArray<string> inputs = respInputs();
    DynamicArray<int64> maxes = respMaxElements();
    DynamicArray<string> wants = respWant();
    isize i = 0;
    while (i < names.length()) {
        Limits l = Limits.defaults();
        l.maxBulk = 9223372036854775807i64;
        l.maxReplyBytes = 9223372036854775807i64;
        l.maxDepth = 1024;
        l.maxElements = maxes[i];
        if (maxes[i] == 0i64) { l.maxElements = 9223372036854775807i64; }
        DynamicArray<uint8> bytes = unhex(text: inputs[i]);
        string whole = readAll(input: bytes.view(), chunk: 1 << 30, limits: l);
        string bytewise = readAll(input: bytes.view(), chunk: 1, limits: l);
        if (whole != wants[i] || bytewise != wants[i]) {
            string name = copy names[i];
            string want = clip(s: wants[i]);
            string got = clip(s: whole);
            string gotBytewise = clip(s: bytewise);
            println(s: "  FAIL resp vector: ${name}\n      want ${want}\n      got  ${got}\n      byte at a time ${gotBytewise}");
            f = f + 1;
        }
        i = i + 1;
    }
    f = f + check(ok: names.length() > 500, what: "resp vectors: more than 500 cases");
    return f;
}

fn string clip(const ref string s) {
    if (s.length() <= 300) { return copy s; }
    return s.substring(start: 0, end: 300).concat(other: "…");
}

fn int32 respTests() {
    int32 f = 0;
    f = f + respVectorTests();
    f = f + splitTests();
    f = f + prefixTests();
    f = f + pipelineTests();
    f = f + depthTests();
    f = f + sizeTests();
    f = f + bulkTests();
    f = f + stickyTests();
    f = f + scalarTests();
    f = f + attributeTests();
    f = f + streamTests();
    f = f + largeTests();
    f = f + fuzzTests();
    f = f + roundTripTests();
    f = f + writerTests();
    f = f + apiTests();
    f = f + isolateTests();
    return f;
}
