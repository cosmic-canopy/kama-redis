// A scripted server, in memory: a `Transport` a connection runs over as it would a socket, with no network and no
// clock. It reads each command the client sends (with resp::Reader, as a server would) and answers it with the next
// step of its script. The replies a script plays are real servers' bytes (server_vectors.kama), never typed here.
//
// Every connection test runs it at `chunk: 1` (the client reads one byte at a time) and `writeLimit: 3` (it writes
// three at a time), so every test also proves framing across any split, and writes that come up short.
//
// Its `wait` never blocks: a wait with nothing to read comes back at once without the side asked for, which is how
// a deadline passing looks to a connection. So a script that falls silent ends in `Timeout` at once, whatever the
// timeout, and no test waits on a clock.
//
// A secure server (`secure`) runs Mbed TLS as the server (@kama/tls, over the in-memory `ServerSide`) from the
// client's first byte, and the script sees the plaintext, as postgres's scripted server does. It checks the SNI the
// client sent, and its hangups send close_notify. A client that sends it anything but TLS breaks its handshake, and it
// hangs up.
import { std::collections::DynamicArray, std::collections::View, std::collections::ConstView, std::collections::FixedArray,
         std::io::IoError, std::io::IoErrorKind, std::net::ReliableStream,
         std::memory::Owned, std::encoding::utf8::decode, std::encoding::utf8::Utf8Error, std::concurrent::Sender,
         tls::TlsStream, tls::TlsConfig, tls::TlsError, tls::Progress,
         redis::Transport, redis::Interest, redis::Ready, redis::Dialer, redis::Dialers, redis::DialTarget, redis::RedisError,
         redis::resp::Reader, redis::resp::Read, redis::resp::Value };
export { FakeServer, Step, ScriptDialer, ScriptDialers, Dial, ServerSide };

type enum Step implements Sendable {
    // The client's next command must be exactly `args`; `reply` answers it. Any other command is answered with an
    // error naming both, and the server hangs up.
    Expect(DynamicArray<string> args, DynamicArray<uint8> reply),
    // `Expect`, for a command whose arguments are bytes: each part must be exactly its bytes.
    ExpectBytes(DynamicArray<DynamicArray<uint8>> args, DynamicArray<uint8> reply),
    // The client's next command, whatever it is, is answered with `reply`.
    Any(DynamicArray<uint8> reply),
    // Bytes the server sends of its own accord, as soon as the script reaches them: a push message.
    Send(DynamicArray<uint8> bytes),
    // The client's next command gets no answer, ever.
    Silent,
    // The client's next command is read, and the server closes the connection without answering it, as twemproxy
    // does on a command it does not know.
    Close,
    // The server closes the connection as soon as the script reaches this step, once the client has read what was
    // sent before it.
    Hangup,
    // The server closes the connection as soon as the script reaches this step, and the client's next write into it
    // draws a reset, as on a socket: that write is accepted, then what was sent before is still read, a read past it
    // fails with ConnectionReset, and a write with BrokenPipe. No close_notify over TLS.
    Reset,
    // The client's next command is answered with `reply`, but only after the client's next wait has come back empty.
    Late(DynamicArray<uint8> reply),
    // The client's next command is answered with `reply`, but only to a wait that allows at least `atLeastMs`, or one
    // with no limit; a shorter wait comes back empty, which is how its deadline passing looks to a connection. With
    // `atLeastMs` -1, only a wait with no limit is answered. It shows how long a connection waits for a command.
    Patient(DynamicArray<uint8> reply, int32 atLeastMs),
    // The server sends nothing more of its own accord until the client's next wait has come back empty: the steps
    // after this one are reached only then. It shows what a client does with a message split across its timeout.
    Pause,
    // The client's next command is answered with `reply`, of whose bytes as sent (over TLS, its records) only the
    // first `keep` reach the client before the server hangs up, with no close_notify: a truncated stream.
    Truncate(DynamicArray<uint8> reply, isize keep);
}

// The server's side of a TLS session: what the client sent waits in `inbound` for the engine, and what the engine
// writes collects in `outbound` until the fake hands it to the client. Always non-blocking.
type resource ServerSide implements ReliableStream, Sendable {
    DynamicArray<uint8> inbound;
    isize inAt = 0;
    DynamicArray<uint8> outbound;

    public ctor make() { this.inbound = DynamicArray.empty(); this.inAt = 0; this.outbound = DynamicArray.empty(); }

    public fn void feed(ConstView<uint8> bytes) { this.inbound.addAll(items: bytes); }
    // Hand what the engine wrote to `into`.
    public fn void drain(ref DynamicArray<uint8> into) { into.addAll(items: this.outbound.view()); this.outbound = DynamicArray.empty(); }

    public fn Result<isize, IoError> read(View<uint8> into) {
        isize available = this.inbound.length() - this.inAt;
        if (available == 0) { return Result::Err(error: IoError.of(kind: IoErrorKind::WouldBlock)); }
        isize n = available;
        if (n > into.length()) { n = into.length(); }
        isize i = 0;
        while (i < n) { into[i] = this.inbound[this.inAt + i]; i = i + 1; }
        this.inAt = this.inAt + n;
        if (this.inAt == this.inbound.length()) { this.inbound = DynamicArray.empty(); this.inAt = 0; }
        return Result::Ok(value: n);
    }
    public fn Result<isize, IoError> write(ConstView<uint8> bytes) { this.outbound.addAll(items: bytes); return Result::Ok(value: bytes.length()); }
    public fn Result<Unit, IoError> flush() { return Result::Ok(value: Unit::Unit); }
    public fn Result<Unit, IoError> setNonBlocking(bool on) { return Result::Ok(value: Unit::Unit); }
}

type resource FakeServer implements Transport, Sendable {
    DynamicArray<Step> steps;
    isize next = 0;
    DynamicArray<uint8> toClient;
    // What the script sends, in plaintext, until it is handed on: to the client at once, or over TLS once the
    // handshake is done.
    DynamicArray<uint8> outbox;
    DynamicArray<TlsStream<ServerSide>> engine;   // zero or one: a secure server's session
    bool established = false;
    bool abrupt = false;   // a hangup with no close_notify (Step::Truncate, Step::Reset)
    bool resetting = false;  // the next write after the hangup draws a reset (Step::Reset)
    bool reset = false;      // it did
    string sniWanted;   // the SNI the client must send: "" checks nothing, "-" none at all
    isize readAt = 0;
    Reader fromClient;
    bool hungUp = false;
    isize chunk = 1;
    isize writeLimit = 3;
    // With more than `backlog` bytes of its replies unread by the client, the server takes none of the client's
    // bytes (a write would block, and the transport is not writable) until the client reads. -1: never.
    isize backlog = -1;
    DynamicArray<uint8> held;   // a late reply (Step::Late), given to the client after one wait in vain
    DynamicArray<uint8> patient;   // a patient reply (Step::Patient), given to a wait long enough
    int32 patience = 0;
    bool holding = false;
    bool pausing = false;   // at a Step::Pause, until a wait comes back empty
    // A traced server (`traced`) tells its test what happens: "connect", each command as words, and "close". With
    // `pong` given, it answers every PING with it, whenever it comes, outside the script: a pool's maintenance pings
    // when its rounds come round, which no script can place.
    DynamicArray<Sender<string>> tracer;   // zero or one
    DynamicArray<uint8> pong;
    bool shutDown = false;

    public ctor make(DynamicArray<Step> steps, isize chunk, isize writeLimit) {
        this.steps = give steps;
        this.toClient = DynamicArray.empty();
        this.fromClient = Reader.make();
        this.chunk = chunk;
        this.writeLimit = writeLimit;
        this.backlog = -1;
        this.held = DynamicArray.empty();
        this.patient = DynamicArray.empty();
        this.outbox = DynamicArray.empty();
        this.engine = DynamicArray.empty();
        this.sniWanted = "";
        this.tracer = DynamicArray.empty();
        this.pong = DynamicArray.empty();
        this.advance();
    }

    // `make`, telling `tracer` what happens, and answering every PING with `pong` (when it is not empty).
    public unsafe ctor traced(DynamicArray<Step> steps, isize chunk, isize writeLimit, Sender<string> tracer, DynamicArray<uint8> pong) {
        this.steps = give steps;
        this.toClient = DynamicArray.empty();
        this.fromClient = Reader.make();
        this.chunk = chunk;
        this.writeLimit = writeLimit;
        this.backlog = -1;
        this.held = DynamicArray.empty();
        this.patient = DynamicArray.empty();
        this.outbox = DynamicArray.empty();
        this.engine = DynamicArray.empty();
        this.sniWanted = "";
        this.pong = give pong;
        this.tracer = DynamicArray.empty();
        _ = tracer.send(item: "connect");
        this.tracer.add(item: give tracer);
        this.advance();
    }

    // `make`, over TLS: Mbed TLS as the server, with `config`, from the client's first byte. `sni` is the name the
    // client must send ("-" for none, "" to check nothing); a client that sends another is answered with an error,
    // and the server hangs up.
    public unsafe ctor secure(DynamicArray<Step> steps, isize chunk, isize writeLimit, const ref TlsConfig config, string sni) {
        this.steps = give steps;
        this.toClient = DynamicArray.empty();
        this.fromClient = Reader.make();
        this.chunk = chunk;
        this.writeLimit = writeLimit;
        this.backlog = -1;
        this.held = DynamicArray.empty();
        this.patient = DynamicArray.empty();
        this.outbox = DynamicArray.empty();
        this.engine = DynamicArray.empty();
        this.sniWanted = give sni;
        this.tracer = DynamicArray.empty();
        this.pong = DynamicArray.empty();
        Result<TlsStream<ServerSide>, TlsError> opened = TlsStream::<ServerSide>.server(inner: ServerSide.make(), config: config);
        match (give opened) {
            case Ok(value: t): { this.engine.add(item: give t); }
            case Err(error: e): { this.hungUp = true; }
        };
        this.advance();
    }

    // `make`, blocked on its own output past `backlog` bytes of unread replies.
    public ctor jammed(DynamicArray<Step> steps, isize chunk, isize writeLimit, isize backlog) {
        this.steps = give steps;
        this.toClient = DynamicArray.empty();
        this.fromClient = Reader.make();
        this.chunk = chunk;
        this.writeLimit = writeLimit;
        this.backlog = backlog;
        this.held = DynamicArray.empty();
        this.patient = DynamicArray.empty();
        this.outbox = DynamicArray.empty();
        this.engine = DynamicArray.empty();
        this.sniWanted = "";
        this.tracer = DynamicArray.empty();
        this.pong = DynamicArray.empty();
        this.advance();
    }

    // `jammed`, over TLS.
    public unsafe ctor secureJammed(DynamicArray<Step> steps, isize chunk, isize writeLimit, isize backlog, const ref TlsConfig config, string sni) {
        this.steps = give steps;
        this.toClient = DynamicArray.empty();
        this.fromClient = Reader.make();
        this.chunk = chunk;
        this.writeLimit = writeLimit;
        this.backlog = backlog;
        this.held = DynamicArray.empty();
        this.patient = DynamicArray.empty();
        this.outbox = DynamicArray.empty();
        this.engine = DynamicArray.empty();
        this.sniWanted = give sni;
        this.tracer = DynamicArray.empty();
        this.pong = DynamicArray.empty();
        Result<TlsStream<ServerSide>, TlsError> opened = TlsStream::<ServerSide>.server(inner: ServerSide.make(), config: config);
        match (give opened) {
            case Ok(value: t): { this.engine.add(item: give t); }
            case Err(error: e): { this.hungUp = true; }
        };
        this.advance();
    }

    public unsafe fn Result<isize, IoError> read(View<uint8> into) {
        this.handOn();
        isize available = this.toClient.length() - this.readAt;
        if (available == 0) {
            if (this.hungUp && this.reset) { return Result::Err(error: IoError.of(kind: IoErrorKind::ConnectionReset)); }
            if (this.hungUp) { return Result::Ok(value: 0); }
            return Result::Err(error: IoError.of(kind: IoErrorKind::WouldBlock));
        }
        isize n = available;
        if (n > this.chunk) { n = this.chunk; }
        if (n > into.length()) { n = into.length(); }
        isize i = 0;
        while (i < n) { into[i] = this.toClient[this.readAt + i]; i = i + 1; }
        this.readAt = this.readAt + n;
        return Result::Ok(value: n);
    }

    fn bool blocked() { return this.backlog >= 0 && this.toClient.length() - this.readAt > this.backlog; }

    // After a hangup, what the client still sends is lost, as it is on a socket whose peer has gone; after a reset,
    // the write fails.
    public unsafe fn Result<isize, IoError> write(ConstView<uint8> bytes) {
        this.handOn();
        if (this.hungUp && this.reset) { return Result::Err(error: IoError.of(kind: IoErrorKind::BrokenPipe)); }
        if (this.hungUp && this.resetting) { this.resetting = false; this.reset = true; }
        if (this.hungUp) { return Result::Ok(value: bytes.length()); }
        if (this.blocked()) { return Result::Err(error: IoError.of(kind: IoErrorKind::WouldBlock)); }
        isize n = bytes.length();
        if (n > this.writeLimit) { n = this.writeLimit; }
        if (this.engine.length() > 0) {
            this.engine[0].innerRefMut().feed(bytes: bytes.slice(from: 0, count: n));
            this.pump();
            return Result::Ok(value: n);
        }
        this.fromClient.feed(bytes: bytes.slice(from: 0, count: n));
        this.serve();
        this.handOn();
        return Result::Ok(value: n);
    }

    public unsafe fn Result<Ready, IoError> wait(Interest interest, int32 timeoutMs) {
        this.handOn();
        if (this.holding) {
            bool enough = timeoutMs < 0 || (this.patience >= 0 && timeoutMs >= this.patience);
            if (!enough) { return Result::Ok(value: Ready.of(readable: false, writable: !this.blocked())); }
            this.outbox.addAll(items: this.patient.view());
            this.patient = DynamicArray.empty();
            this.holding = false;
            this.handOn();
        }
        if (this.pausing && this.readAt == this.toClient.length() && !this.hungUp) {
            // This wait ends empty; what the script sends next is there for the one after.
            this.pausing = false;
            this.advance();
            this.handOn();
            return Result::Ok(value: Ready.of(readable: false, writable: !this.blocked()));
        }
        if (this.held.length() > 0) {
            // This wait ends without the late reply; it is there for the next.
            this.outbox.addAll(items: this.held.view());
            this.held = DynamicArray.empty();
            this.handOn();
            return Result::Ok(value: Ready.of(readable: false, writable: !this.blocked()));
        }
        bool readable = this.readAt < this.toClient.length() || this.hungUp;
        return Result::Ok(value: Ready.of(readable: readable, writable: !this.blocked()));
    }

    public unsafe fn void shutdown() {
        if (this.shutDown) { return; }
        this.shutDown = true;
        if (this.tracer.length() > 0) { _ = this.tracer[0].send(item: "close"); }
    }
    public fn Optional<RedisError> explain(IoError error) { return Optional::None; }

    // What the script has sent goes on to the client: as it is, or over TLS once the handshake is done (until then
    // it waits). A hangup the script asked for comes after it, with close_notify over TLS.
    unsafe fn void handOn() {
        if (this.engine.length() == 0) {
            this.toClient.addAll(items: this.outbox.view());
            this.outbox = DynamicArray.empty();
            return;
        }
        if (!this.established) { return; }
        isize sent = 0;
        while (sent < this.outbox.length()) {
            Result<isize, IoError> w = this.engine[0].write(bytes: this.outbox.view().slice(from: sent, count: this.outbox.length() - sent));
            match (w) { case Ok(value: n): { sent = sent + n; } case Err(error: e): { sent = this.outbox.length(); } };
        }
        this.outbox = DynamicArray.empty();
        if (this.hungUp && !this.abrupt) { Result<Unit, TlsError> closed = this.engine[0].close(); }
        this.engine[0].innerRefMut().drain(into: this.toClient);
    }

    // Run the engine on what the client sent: the handshake, then the plaintext through the script, then the
    // ciphertext out to the client. A handshake that fails sends the engine's alert, and the server hangs up.
    unsafe fn void pump() {
        if (!this.established && !this.hungUp) {
            Result<Progress, TlsError> step = this.engine[0].handshake();
            match (give step) {
                case Ok(value: p): {
                    Progress at = p;
                    bool done = match (at) { case Done: true; case _: false; };
                    if (done) { this.established = true; this.checkSni(); }
                }
                case Err(error: e): { this.engine[0].innerRefMut().drain(into: this.toClient); this.hungUp = true; return; }
            };
        }
        if (this.established && !this.hungUp) {
            FixedArray<uint8> buf = FixedArray.make(size: 4096);
            bool more = true;
            while (more) {
                Result<isize, IoError> r = this.engine[0].read(into: buf.viewMut());
                match (r) {
                    case Ok(value: n): { if (n == 0) { more = false; } this.fromClient.feed(bytes: buf.view().slice(from: 0, count: n)); }
                    case Err(error: e): {
                        more = false;
                        // Anything but "nothing more yet" ends the session: the client's records did not hold.
                        bool waiting = match (e.kind()) { case WouldBlock: true; case _: false; };
                        if (!waiting) { this.hungUp = true; }
                    }
                };
            }
            this.serve();
        }
        this.handOn();
        this.engine[0].innerRefMut().drain(into: this.toClient);
    }

    // The client must have sent the SNI the test names.
    unsafe fn void checkSni() {
        if (this.sniWanted.length() == 0) { return; }
        Optional<string> seen = this.engine[0].requestedServerName();
        string got = match (give seen) { case Some(value: v): give v; case None: "-"; };
        if (!got.equals(other: this.sniWanted)) {
            string line = "-ERR fake server: SNI ".concat(other: got).concat(other: ", wanted ").concat(other: this.sniWanted).concat(other: "\r\n");
            this.outbox.addAll(items: line.bytes());
            this.hungUp = true;
        }
    }

    // Answer every whole command the client has sent with the next step.
    unsafe fn void serve() {
        while (!this.hungUp) {
            Read r = this.fromClient.next();
            match (give r) {
                case Incomplete: { return; }
                case Invalid(error: e): { this.hungUp = true; return; }
                case Complete(value: v): { this.answer(command: v); }
            };
        }
    }

    unsafe fn void answer(const ref Value command) {
        DynamicArray<string> args = argsOf(v: command);
        if (this.tracer.length() > 0) { _ = this.tracer[0].send(item: joined(args: args)); }
        if (this.pong.length() > 0 && args.length() == 1 && args[0] == "PING") {
            this.outbox.addAll(items: this.pong.view());
            this.handOn();
            return;
        }
        if (this.next >= this.steps.length()) { return; }
        isize at = this.next;
        this.next = this.next + 1;
        match (this.steps[at]) {
            case Expect(args: want, reply: r): {
                if (!sameArgs(a: want, b: args)) {
                    string wanted = joined(args: want);
                    this.mismatch(wanted: wanted, args: args);
                    return;
                }
                this.outbox.addAll(items: r.view());
            }
            case ExpectBytes(args: want, reply: r): {
                if (!sameBytes(want: want, command: command)) {
                    DynamicArray<string> shown = DynamicArray.empty();
                    isize k = 0;
                    while (k < want.length()) { shown.add(item: utf8OrMark(b: want[k].view())); k = k + 1; }
                    string wanted = joined(args: shown);
                    this.mismatch(wanted: wanted, args: args);
                    return;
                }
                this.outbox.addAll(items: r.view());
            }
            case Any(reply: r): { this.outbox.addAll(items: r.view()); }
            case Send(bytes: b): { this.outbox.addAll(items: b.view()); }
            case Silent: { }
            case Close: { this.hungUp = true; return; }
            case Hangup: { this.hungUp = true; return; }
            case Reset: { this.hungUp = true; this.resetting = true; this.abrupt = true; return; }
            case Late(reply: r): { this.held.addAll(items: r.view()); }
            case Pause: { }
            case Truncate(reply: r, keep: k): {
                isize before = this.toClient.length();
                this.outbox.addAll(items: r.view());
                this.handOn();
                isize end = before + k;
                if (end < this.toClient.length()) {
                    DynamicArray<uint8> kept = DynamicArray.empty();
                    kept.addAll(items: this.toClient.view().slice(from: 0, count: end));
                    this.toClient = give kept;
                }
                this.abrupt = true;
                this.hungUp = true;
                return;
            }
            case Patient(reply: r, atLeastMs: n): {
                this.patient.addAll(items: r.view());
                this.patience = n;
                this.holding = true;
            }
        };
        // Each step's bytes leave as they are made: over TLS, a reply and what the server sends after it are records
        // of their own, as a server's are.
        this.handOn();
        this.advance();
    }

    // The command was not the one the script expects: say so, as an error reply, and hang up.
    fn void mismatch(const ref string wanted, const ref DynamicArray<string> args) {
        string got = joined(args: args);
        string line = "-ERR fake server: expected [".concat(other: wanted).concat(other: "], got [").concat(other: got).concat(other: "]\r\n");
        this.outbox.addAll(items: line.bytes());
        this.hungUp = true;
    }

    // The steps that need no command: bytes sent of the server's own accord, a hangup, and a pause.
    unsafe fn void advance() {
        while (this.next < this.steps.length() && !this.hungUp && !this.pausing) {
            bool own = match (this.steps[this.next]) { case Send(bytes: b): true; case Hangup: true; case Reset: true; case Pause: true; case _: false; };
            if (!own) { return; }
            match (this.steps[this.next]) {
                case Send(bytes: b): { this.outbox.addAll(items: b.view()); }
                case Pause: { this.pausing = true; }
                case Reset: { this.hungUp = true; this.resetting = true; this.abrupt = true; }
                case _: { this.hungUp = true; }
            };
            this.next = this.next + 1;
            this.handOn();
        }
    }
}

// A command's arguments as text; a part that is not UTF-8 shows as "?".
fn DynamicArray<string> argsOf(const ref Value v) {
    DynamicArray<string> list = DynamicArray.empty();
    match (v) {
        case Array(items: parts): {
            isize i = 0;
            while (i < parts.length()) {
                string text = match (parts[i]) {
                    case Bulk(bytes: b): utf8OrMark(b: b.view());
                    case _: "?";
                };
                list.add(item: give text);
                i = i + 1;
            }
        }
        case _: { list.add(item: "?"); }
    };
    return give list;
}

fn string utf8OrMark(ConstView<uint8> b) {
    Result<string, Utf8Error> r = decode(bytes: b);
    return match (give r) { case Ok(value: s): give s; case Err(error: e): "?"; };
}

fn bool sameArgs(const ref DynamicArray<string> a, const ref DynamicArray<string> b) {
    if (a.length() != b.length()) { return false; }
    isize i = 0;
    while (i < a.length()) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn bool sameBytes(const ref DynamicArray<DynamicArray<uint8>> want, const ref Value command) {
    return match (command) {
        case Array(items: parts): sameParts(want: want, parts: parts);
        case _: false;
    };
}

fn bool sameParts(const ref DynamicArray<DynamicArray<uint8>> want, const ref DynamicArray<Value> parts) {
    if (want.length() != parts.length()) { return false; }
    isize i = 0;
    while (i < parts.length()) {
        bool same = match (parts[i]) { case Bulk(bytes: b): b.equals(other: want[i]); case _: false; };
        if (!same) { return false; }
        i = i + 1;
    }
    return true;
}

fn string joined(const ref DynamicArray<string> args) {
    string text = "";
    isize i = 0;
    while (i < args.length()) {
        if (i > 0) { text = text.concat(other: " "); }
        text = text.concat(other: args[i]);
        i = i + 1;
    }
    return text;
}

// What one dial does: refuse, give up on its deadline, or connect to a scripted server, over TLS or not.
type enum Dial implements Sendable {
    Refuse,
    TimeOut,
    Serve(DynamicArray<Step> steps),
    ServeTls(DynamicArray<Step> steps, TlsConfig config, string sni),
    // `Serve`, by a traced server (FakeServer.traced) that tells `tracer` what happens, answering PING with `pong`.
    ServeTraced(DynamicArray<Step> steps, Sender<string> tracer, DynamicArray<uint8> pong);
}

// A `Dialer` that answers each dial with the next entry; with none left, it refuses as a closed port would. Made
// `byPlace`, each entry belongs to a place ("127.0.0.1:7200", as `DialTarget.place()` names it), and a dial takes the
// first entry left for its target's place, or is refused: a connection that dials somewhere it should not finds a
// closed port.
type resource ScriptDialer implements Dialer, Sendable {
    DynamicArray<Dial> dials;
    DynamicArray<string> places;   // empty: in order, wherever the dial goes

    public ctor make(DynamicArray<Dial> dials) { this.dials = give dials; this.places = DynamicArray.empty(); }
    public ctor byPlace(DynamicArray<string> places, DynamicArray<Dial> dials) {
        if (places.length() != dials.length()) { panic(msg: "ScriptDialer.byPlace: a place for every dial"); }
        this.dials = give dials;
        this.places = give places;
    }

    public unsafe fn Result<Owned<Transport>, IoError> dial(const ref DialTarget target, int32 timeoutMs) {
        if (this.dials.length() == 0) { return Result::Err(error: IoError.of(kind: IoErrorKind::ConnectionRefused)); }
        isize at = 0;
        if (this.places.length() > 0) {
            string place = target.place();
            at = -1;
            isize i = 0;
            while (i < this.places.length()) {
                if (this.places[i] == place) { at = i; break; }
                i = i + 1;
            }
            if (at < 0) { return Result::Err(error: IoError.of(kind: IoErrorKind::ConnectionRefused)); }
            string unused = this.places.remove(index: at);
        }
        Dial d = this.dials.remove(index: at);
        match (give d) {
            case Refuse: { return Result::Err(error: IoError.of(kind: IoErrorKind::ConnectionRefused)); }
            case TimeOut: { return Result::Err(error: IoError.of(kind: IoErrorKind::TimedOut)); }
            case Serve(steps: s): {
                Owned<Transport> fake = new FakeServer.make(steps: give s, chunk: 1, writeLimit: 3);
                return Result::Ok(value: give fake);
            }
            case ServeTls(steps: s, config: c, sni: n): {
                Owned<Transport> fake = new FakeServer.secure(steps: give s, chunk: 1, writeLimit: 3, config: c, sni: give n);
                return Result::Ok(value: give fake);
            }
            case ServeTraced(steps: s, tracer: t, pong: p): {
                Owned<Transport> fake = new FakeServer.traced(steps: give s, chunk: 1, writeLimit: 3, tracer: give t, pong: give p);
                return Result::Ok(value: give fake);
            }
        };
    }
}

// `Dialers` for a cluster (`Cluster.connectWith`): each connection the cluster opens takes the next dialer, in the
// order the test has them. A dialer made `byPlace` refuses a place it was not given, so a cluster that opens its
// connections in another order, or dials a node it should not, finds closed ports. Past the last, a connection's
// dialer refuses every dial.
type resource ScriptDialers implements Dialers, Sendable {
    DynamicArray<Owned<Dialer>> ready;

    public ctor make() { this.ready = DynamicArray.empty(); }
    public fn void then(Owned<Dialer> dialer) { this.ready.add(item: give dialer); }

    public unsafe fn Owned<Dialer> another() {
        if (this.ready.length() == 0) {
            Owned<Dialer> none = new ScriptDialer.make(dials: DynamicArray.empty());
            return give none;
        }
        return this.ready.remove(index: 0);
    }
}
