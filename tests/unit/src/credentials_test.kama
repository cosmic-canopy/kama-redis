// A credentials provider (src/credentials.kama; docs/ROADMAP.md, "Phase 7b", decision 5) over the scripted server: it is
// asked at every connect and every redial, and again before a call once its login's refreshAfter has passed; a
// provider that fails, or a login the server refuses, closes the connection and is `Credentials`, with nothing of the
// call sent. Each login's password says which answer it was, so a script shows which login every handshake and AUTH
// carried; a command the client should not send meets an Expect it does not match, and the call fails.
import { std::collections::DynamicArray, std::memory::Owned, std::time::Duration, std::time::sleep,
         redis::Connection, redis::Config, redis::Command, redis::RedisError, redis::Credentials, redis::Login,
         redis::Subscriber, redis::Delivery, redis::Dialer, redis::Dialers, redis::Cluster, redis::resp::Value,
         redis::Pipeline, redis::TxOutcome, redis::Transport, FakeServer,
         redis_unit_tests::check, Step, Dial, ScriptDialer, ScriptDialers, expect, reply, identity, welcome, configOf,
         callOutcome, again, dialed, losing, send, isIo, reconnectOf, said, done, pub, joined, names, subscriberWith };
export { credentialsTests, ScriptCredentials, Answer, loginAs, providing, answerList };

fn string server() { return "redis-8.10.2"; }

// What a scripted provider answers, in turn; past the last, the last again.
type enum Answer implements Sendable {
    // A login: no user when `user` is "", no refresh when `refreshMs` is 0.
    Give(string user, string password, int64 refreshMs),
    // A failure, as `Config` with these words.
    Fail(string why);
}

// A provider that answers from a script. A fork answers the same script from its start, as a new provider would.
type resource ScriptCredentials implements Credentials, Sendable {
    DynamicArray<Answer> answers;
    isize at = 0;

    public ctor make(DynamicArray<Answer> answers) { this.answers = give answers; }

    public unsafe fn Result<Login, RedisError> login() {
        if (this.answers.length() == 0) { return Result::Err(error: RedisError::Config(detail: "no answers")); }
        isize i = this.at;
        if (i < this.answers.length() - 1) { this.at = this.at + 1; } else { i = this.answers.length() - 1; }
        return match (this.answers[i]) {
            case Give(user: u, password: p, refreshMs: r): {
                Optional<string> user = Optional::None;
                if (u.length() > 0) { user = Optional::Some(value: copy u); }
                Optional<Duration> after = Optional::None;
                if (r > 0i64) { after = Optional::Some(value: Duration.fromMillis(ms: r)); }
                := Login.of(user: give user, password: copy p, refreshAfter: after);
            }
            case Fail(why: w): Result::Err(error: RedisError::Config(detail: copy w));
        };
    }

    public unsafe fn Owned<Credentials> fork() {
        Owned<Credentials> o = new ScriptCredentials.make(answers: copy this.answers);
        return give o;
    }
}

fn Answer loginAs(const ref string password, int64 refreshMs) { return Answer::Give(user: "kr_acl", password: copy password, refreshMs: refreshMs); }

unsafe fn Config providing(const ref string url, DynamicArray<Answer> answers) {
    Config c = configOf(url: url);
    Owned<Credentials> p = new ScriptCredentials.make(answers: give answers);
    Result<Unit, RedisError> set = c.setCredentials(provider: give p);
    match (give set) { case Ok(value: u): { } case Err(error: e): { string m = e.message(); panic(msg: "credentials_test: ${m}"); } };
    return give c;
}

fn DynamicArray<Answer> answerList() { return DynamicArray.empty(); }
fn DynamicArray<Dial> dials() { return DynamicArray.empty(); }

// A handshake that logs in as kr_acl with `password` (HELLO 3 AUTH), then the two SETINFOs.
fn DynamicArray<Step> loggedIn(const ref string password) {
    DynamicArray<Step> s = DynamicArray.empty();
    s.add(item: expect(command: "HELLO 3 AUTH kr_acl ".concat(other: password), answer: reply(server: server(), kase: "hello3-auth")));
    identity(s: s, server: server());
    return give s;
}

// The same, ending a redial: then the PING.
fn DynamicArray<Step> backAs(const ref string password) {
    DynamicArray<Step> s = loggedIn(password: password);
    s.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    return give s;
}

fn void get(ref DynamicArray<Step> s) { s.add(item: expect(command: "GET kr:k", answer: reply(server: server(), kase: "get-hit/3"))); }

// A re-AUTH as kr_acl with `password`, answered +OK.
fn void reauth(ref DynamicArray<Step> s, const ref string password) {
    s.add(item: expect(command: "AUTH kr_acl ".concat(other: password), answer: reply(server: server(), kase: "auth2")));
}

// A call's outcome: "ok", "credentials provider: <why>", "credentials server: <code>", "reconnect: <tries> <why>", or
// "(error) <message>".
fn string outcomeOf(const ref Result<Value, RedisError> r) {
    return match (r) {
        case Ok(value: v): "ok";
        case Err(error: e): match (e) {
            case Credentials(error: c): {
                string why = c.byServer() ? "server: ".concat(other: codeOf(e: c.cause())) : "provider: ".concat(other: c.cause().message());
                := "credentials ".concat(other: why);
            }
            case Reconnect(error: x): {
                string inner = match (x.cause()) {
                    case Credentials(error: c): "credentials ".concat(other: c.cause().message());
                    case _: x.cause().message();
                };
                int32 n = x.tries();
                := "reconnect: ${n} ".concat(other: inner);
            }
            case _: { string m = e.message(); := "(error) ${m}"; }
        };
    };
}

fn string codeOf(const ref RedisError e) {
    return match (e) { case Server(error: s): s.codeText(); case _: e.message(); };
}

unsafe fn void wait(int64 ms) { sleep(d: Duration.fromMillis(ms: ms)); }

// ---- the configuration ----

unsafe fn int32 configTests() {
    int32 f = 0;
    // One source: a URL's password and a provider are refused together, in either order, as are setAuth and a user.
    Config withPassword = configOf(url: "redis://kr_acl:secret@127.0.0.1:6379");
    Owned<Credentials> p1 = new ScriptCredentials.make(answers: answerList());
    Result<Unit, RedisError> r1 = withPassword.setCredentials(provider: give p1);
    f = f + check(ok: !ok(r: r1) && !withPassword.hasCredentials(), what: "credentials: a provider beside a URL's password is refused");
    Config withUser = configOf(url: "redis://127.0.0.1:6379");
    Result<Unit, RedisError> auth = withUser.setAuth(user: Optional::Some(value: "kr_acl"), password: "secret");
    Owned<Credentials> p2 = new ScriptCredentials.make(answers: answerList());
    Result<Unit, RedisError> r2 = withUser.setCredentials(provider: give p2);
    f = f + check(ok: ok(r: auth) && !ok(r: r2), what: "credentials: a provider beside setAuth's login is refused");
    Config provided = providing(url: "redis://127.0.0.1:6379", answers: answerList());
    Result<Unit, RedisError> r3 = provided.setAuth(user: Optional::None, password: "secret");
    f = f + check(ok: !ok(r: r3) && provided.hasCredentials(), what: "credentials: setAuth beside a provider is refused");
    // A copy holds a fork: it has a provider of its own.
    Config copied = copy provided;
    f = f + check(ok: copied.hasCredentials(), what: "credentials: a Config's copy holds a fork of its provider");
    // A login the provider builds: an empty user or password, or a refresh that is not after now, is refused.
    Result<Login, RedisError> l1 = Login.of(user: Optional::Some(value: ""), password: "pw", refreshAfter: Optional::None);
    Result<Login, RedisError> l2 = Login.of(user: Optional::None, password: "", refreshAfter: Optional::None);
    Result<Login, RedisError> l3 = Login.of(user: Optional::None, password: "pw", refreshAfter: Optional::Some(value: Duration.zero()));
    Result<Login, RedisError> l4 = Login.of(user: Optional::None, password: "pw", refreshAfter: Optional::Some(value: Duration.fromMillis(ms: 1i64)));
    f = f + check(ok: !loginOk(r: l1) && !loginOk(r: l2) && !loginOk(r: l3) && loginOk(r: l4),
                  what: "credentials: a login with an empty user or password, or a refresh that is not after now, is refused");
    return f;
}

fn bool ok(const ref Result<Unit, RedisError> r) { return match (r) { case Ok(value: u): true; case Err(error: e): false; }; }
fn bool loginOk(const ref Result<Login, RedisError> r) { return match (r) { case Ok(value: l): true; case Err(error: e): false; }; }

// ---- a connection ----

unsafe fn int32 connectionTests() {
    int32 f = 0;

    // Asked at the connect, and at each redial: each handshake logs in with the provider's answer then.
    DynamicArray<Answer> a1 = answerList();
    a1.add(item: loginAs(password: "pw1", refreshMs: 0i64));
    a1.add(item: loginAs(password: "pw2", refreshMs: 0i64));
    Config c1 = providing(url: "redis://127.0.0.1:6379", answers: give a1);
    DynamicArray<Dial> d1 = dials();
    DynamicArray<Step> first = loggedIn(password: "pw1");
    first.add(item: Step::Close);
    d1.add(item: Dial::Serve(steps: give first));
    DynamicArray<Step> second = backAs(password: "pw2");
    get(s: second);
    d1.add(item: Dial::Serve(steps: give second));
    Connection k1 = dialed(dials: give d1, config: c1, what: "asked at the connect");
    Result<Value, RedisError> lost = send(c: k1, text: "GET kr:k");
    Result<Value, RedisError> back = send(c: k1, text: "GET kr:k");
    string o1 = outcomeOf(r: back);
    f = f + check(ok: isIo(r: lost) && o1 == "ok", what: "credentials: asked at the connect and again at the redial, each login its own (${o1})");

    // Over RESP2: AUTH with the provider's login.
    DynamicArray<Answer> a2 = answerList();
    a2.add(item: loginAs(password: "pw1", refreshMs: 0i64));
    Config c2 = providing(url: "redis://127.0.0.1:6379?protocol=2", answers: give a2);
    DynamicArray<Dial> d2 = dials();
    DynamicArray<Step> s2 = DynamicArray.empty();
    s2.add(item: expect(command: "AUTH kr_acl pw1", answer: reply(server: server(), kase: "auth2")));
    s2.add(item: expect(command: "GET kr:k", answer: reply(server: server(), kase: "get-hit/2")));
    d2.add(item: Dial::Serve(steps: give s2));
    Connection k2 = dialed(dials: give d2, config: c2, what: "RESP2");
    string o2 = outcomeOf(r: send(c: k2, text: "GET kr:k"));
    f = f + check(ok: o2 == "ok", what: "credentials: under RESP2, AUTH with the provider's login (${o2})");

    // Once the login's refreshAfter has passed, the next call logs in anew before it writes; before, it does not.
    DynamicArray<Answer> a3 = answerList();
    a3.add(item: loginAs(password: "pw1", refreshMs: 300i64));
    a3.add(item: loginAs(password: "pw2", refreshMs: 0i64));
    Config c3 = providing(url: "redis://127.0.0.1:6379", answers: give a3);
    DynamicArray<Dial> d3 = dials();
    DynamicArray<Step> s3 = loggedIn(password: "pw1");
    get(s: s3);
    reauth(s: s3, password: "pw2");
    get(s: s3);
    get(s: s3);
    d3.add(item: Dial::Serve(steps: give s3));
    Connection k3 = dialed(dials: give d3, config: c3, what: "refresh");
    string early = outcomeOf(r: send(c: k3, text: "GET kr:k"));
    wait(ms: 600i64);
    string due = outcomeOf(r: send(c: k3, text: "GET kr:k"));
    string after = outcomeOf(r: send(c: k3, text: "GET kr:k"));
    f = f + check(ok: early == "ok" && due == "ok" && after == "ok",
                  what: "credentials: a login past its refreshAfter is renewed (AUTH) before the next call, and the next login holds (${early}; ${due}; ${after})");

    // A refused re-AUTH: the call is Credentials, nothing of it sent, the connection closed; the next call makes it
    // again, asking anew. The old link would refuse a login there, so a client that went on with it fails visibly.
    DynamicArray<Answer> a4 = answerList();
    a4.add(item: loginAs(password: "pw1", refreshMs: 300i64));
    a4.add(item: loginAs(password: "revoked", refreshMs: 0i64));
    a4.add(item: loginAs(password: "pw3", refreshMs: 0i64));
    Config c4 = providing(url: "redis://127.0.0.1:6379", answers: give a4);
    DynamicArray<Dial> d4 = dials();
    DynamicArray<Step> s4 = loggedIn(password: "pw1");
    s4.add(item: expect(command: "AUTH kr_acl revoked", answer: reply(server: server(), kase: "reauth-wrong/3")));
    s4.add(item: expect(command: "AUTH kr_acl pw3", answer: reply(server: server(), kase: "reauth-wrong/3")));
    d4.add(item: Dial::Serve(steps: give s4));
    DynamicArray<Step> s4b = backAs(password: "pw3");
    get(s: s4b);
    d4.add(item: Dial::Serve(steps: give s4b));
    Connection k4 = dialed(dials: give d4, config: c4, what: "refused");
    wait(ms: 600i64);
    string refused = outcomeOf(r: send(c: k4, text: "GET kr:k"));
    bool closed = k4.isClosed();
    string next4 = outcomeOf(r: send(c: k4, text: "GET kr:k"));
    f = f + check(ok: refused == "credentials server: WRONGPASS" && !closed && next4 == "ok",
                  what: "credentials: a refused re-AUTH fails the call unsent and closes the link; the next call makes it again (${refused}; ${next4})");

    // The provider failing at a refresh: the same, its own error the cause.
    DynamicArray<Answer> a5 = answerList();
    a5.add(item: loginAs(password: "pw1", refreshMs: 300i64));
    a5.add(item: Answer::Fail(why: "token service down"));
    a5.add(item: loginAs(password: "pw3", refreshMs: 0i64));
    Config c5 = providing(url: "redis://127.0.0.1:6379", answers: give a5);
    DynamicArray<Dial> d5 = dials();
    DynamicArray<Step> s5 = loggedIn(password: "pw1");
    s5.add(item: expect(command: "AUTH kr_acl pw3", answer: reply(server: server(), kase: "reauth-wrong/3")));
    d5.add(item: Dial::Serve(steps: give s5));
    DynamicArray<Step> s5b = backAs(password: "pw3");
    get(s: s5b);
    d5.add(item: Dial::Serve(steps: give s5b));
    Connection k5 = dialed(dials: give d5, config: c5, what: "provider fails");
    wait(ms: 600i64);
    string failed = outcomeOf(r: send(c: k5, text: "GET kr:k"));
    string next5 = outcomeOf(r: send(c: k5, text: "GET kr:k"));
    f = f + check(ok: failed == "credentials provider: token service down" && next5 == "ok",
                  what: "credentials: a provider failing at a refresh fails the call unsent; the next call makes the link again (${failed}; ${next5})");

    // The link lost as the re-AUTH goes: nothing of the call was sent, so the call makes the link again (which logs in
    // anew) and sends, once.
    DynamicArray<Answer> a6 = answerList();
    a6.add(item: loginAs(password: "pw1", refreshMs: 300i64));
    a6.add(item: loginAs(password: "pw2", refreshMs: 0i64));
    a6.add(item: loginAs(password: "pw3", refreshMs: 0i64));
    Config c6 = providing(url: "redis://127.0.0.1:6379", answers: give a6);
    DynamicArray<Dial> d6 = dials();
    DynamicArray<Step> s6 = loggedIn(password: "pw1");
    s6.add(item: Step::Close);
    d6.add(item: Dial::Serve(steps: give s6));
    DynamicArray<Step> s6b = backAs(password: "pw3");
    get(s: s6b);
    d6.add(item: Dial::Serve(steps: give s6b));
    Connection k6 = dialed(dials: give d6, config: c6, what: "lost at the re-AUTH");
    wait(ms: 600i64);
    string through = outcomeOf(r: send(c: k6, text: "GET kr:k"));
    f = f + check(ok: through == "ok", what: "credentials: a link lost at the re-AUTH is made again, logging in anew, and the call sent once (${through})");

    // The provider failing at the connect is the connect's error; at a redial, final: one try.
    DynamicArray<Answer> a7 = answerList();
    a7.add(item: Answer::Fail(why: "token service down"));
    Config c7 = providing(url: "redis://127.0.0.1:6379", answers: give a7);
    DynamicArray<Dial> d7 = dials();
    d7.add(item: Dial::Serve(steps: loggedIn(password: "never")));
    Owned<Dialer> dd7 = new ScriptDialer.make(dials: give d7);
    Result<Connection, RedisError> r7 = Connection.connectWith(dialer: give dd7, config: c7);
    string o7 = match (r7) { case Ok(value: c): "connected"; case Err(error: e): match (e) { case Credentials(error: c): "credentials"; case _: e.message(); }; };
    f = f + check(ok: o7 == "credentials", what: "credentials: a provider failing at the connect is the connect's error (${o7})");
    DynamicArray<Answer> a8 = answerList();
    a8.add(item: loginAs(password: "pw1", refreshMs: 0i64));
    a8.add(item: Answer::Fail(why: "token service down"));
    Config c8 = providing(url: "redis://127.0.0.1:6379?reconnect_timeout=5", answers: give a8);
    DynamicArray<Dial> d8 = dials();
    d8.add(item: Dial::Serve(steps: losing2(password: "pw1")));
    d8.add(item: Dial::Serve(steps: loggedIn(password: "never")));
    Connection k8 = dialed(dials: give d8, config: c8, what: "provider fails at the redial");
    Result<Value, RedisError> gone = send(c: k8, text: "GET kr:k");
    string redial = outcomeOf(r: send(c: k8, text: "GET kr:k"));
    f = f + check(ok: redial == "reconnect: 1 credentials token service down",
                  what: "credentials: a provider failing at a redial is final, one try (${redial})");

    // A WATCH in force when a fresh login loses the link: the WATCH went with it, so the transaction is held back
    // (WatchConflict), never sent on the new link.
    DynamicArray<Answer> a10 = answerList();
    a10.add(item: loginAs(password: "pw1", refreshMs: 300i64));
    a10.add(item: loginAs(password: "pw2", refreshMs: 0i64));
    a10.add(item: loginAs(password: "pw3", refreshMs: 0i64));
    Config c10 = providing(url: "redis://127.0.0.1:6379", answers: give a10);
    DynamicArray<Dial> d10 = dials();
    DynamicArray<Step> s10 = loggedIn(password: "pw1");
    s10.add(item: expect(command: "WATCH kr:w", answer: reply(server: server(), kase: "watch/3")));
    s10.add(item: Step::Close);
    d10.add(item: Dial::Serve(steps: give s10));
    d10.add(item: Dial::Serve(steps: backAs(password: "pw3")));
    Connection k10 = dialed(dials: give d10, config: c10, what: "a WATCH lost with a fresh login");
    string watched = outcomeOf(r: send(c: k10, text: "WATCH kr:w"));
    wait(ms: 600i64);
    Pipeline tx = Pipeline.make();
    Command set = Command.of(name: "SET");
    set.arg(text: "kr:w");
    set.arg(text: "v");
    tx.add(command: set);
    Result<TxOutcome, RedisError> t10 = k10.transact(pipeline: tx);
    string held = match (t10) { case Ok(value: o): match (o) { case WatchConflict: "held back"; case _: "committed"; }; case Err(error: e): e.message(); };
    f = f + check(ok: watched == "ok" && held == "held back",
                  what: "credentials: a WATCH lost as a fresh login lost the link holds the transaction back, unsent (${held})");

    // Over a transport the caller opened, the provider's login too.
    DynamicArray<Answer> a11 = answerList();
    a11.add(item: loginAs(password: "pw1", refreshMs: 0i64));
    Config c11 = providing(url: "redis://127.0.0.1:6379", answers: give a11);
    DynamicArray<Step> s11 = loggedIn(password: "pw1");
    get(s: s11);
    Owned<Transport> fake = new FakeServer.make(steps: give s11, chunk: 1, writeLimit: 3);
    Result<Connection, RedisError> r11 = Connection.connectOver(transport: give fake, config: c11);
    string o11 = match (give r11) {
        case Ok(value: c): { Connection k = give c; := outcomeOf(r: send(c: k, text: "GET kr:k")); }
        case Err(error: e): e.message();
    };
    f = f + check(ok: o11 == "ok", what: "credentials: connectOver logs in with the provider's login (${o11})");

    // authenticate on a provider's connection is Usage.
    DynamicArray<Answer> a9 = answerList();
    a9.add(item: loginAs(password: "pw1", refreshMs: 0i64));
    Config c9 = providing(url: "redis://127.0.0.1:6379", answers: give a9);
    DynamicArray<Dial> d9 = dials();
    d9.add(item: Dial::Serve(steps: loggedIn(password: "pw1")));
    Connection k9 = dialed(dials: give d9, config: c9, what: "authenticate");
    Result<Unit, RedisError> hand = k9.authenticate(user: Optional::Some(value: "kr_acl"), password: "other");
    bool usage = match (hand) { case Err(error: e): match (e) { case Usage(detail: d): true; case _: false; }; case Ok(value: u): false; };
    f = f + check(ok: usage, what: "credentials: authenticate on a provider's connection is Usage");
    return f;
}

// ---- authenticate after a lost link (no provider) ----

unsafe fn int32 authenticateTests() {
    int32 f = 0;
    // The link lost, `authenticate` makes it again as the new user: its AUTH is the handshake's, never the old login's
    // first. Later redials log in as the new user too.
    Config old = configOf(url: "redis://kr_acl:old@127.0.0.1:6379");
    DynamicArray<Dial> d1 = dials();
    DynamicArray<Step> first = loggedIn(password: "old");
    first.add(item: Step::Close);
    d1.add(item: Dial::Serve(steps: give first));
    DynamicArray<Step> second = backAs(password: "new");
    second.add(item: Step::Close);
    d1.add(item: Dial::Serve(steps: give second));
    DynamicArray<Step> third = backAs(password: "new");
    get(s: third);
    d1.add(item: Dial::Serve(steps: give third));
    Connection k1 = dialed(dials: give d1, config: old, what: "authenticate after a loss");
    Result<Value, RedisError> lost = send(c: k1, text: "GET kr:k");
    Result<Unit, RedisError> moved = k1.authenticate(user: Optional::Some(value: "kr_acl"), password: "new");
    Result<Value, RedisError> lostAgain = send(c: k1, text: "GET kr:k");
    string o1 = outcomeOf(r: send(c: k1, text: "GET kr:k"));
    f = f + check(ok: isIo(r: lost) && ok(r: moved) && isIo(r: lostAgain) && o1 == "ok",
                  what: "credentials: authenticate after a lost link makes it again as the new user, and redials keep it (${o1})");

    // The new login refused as the link is made: the old one is kept.
    Config kept = configOf(url: "redis://kr_acl:old@127.0.0.1:6379?reconnect_timeout=5");
    DynamicArray<Dial> d2 = dials();
    d2.add(item: Dial::Serve(steps: losing2(password: "old")));
    DynamicArray<Step> refusing = DynamicArray.empty();
    refusing.add(item: expect(command: "HELLO 3 AUTH kr_acl bad", answer: reply(server: server(), kase: "hello3-auth-wrong")));
    d2.add(item: Dial::Serve(steps: give refusing));
    DynamicArray<Step> restored = backAs(password: "old");
    get(s: restored);
    d2.add(item: Dial::Serve(steps: give restored));
    Connection k2 = dialed(dials: give d2, config: kept, what: "authenticate refused");
    Result<Value, RedisError> gone = send(c: k2, text: "GET kr:k");
    Result<Unit, RedisError> bad = k2.authenticate(user: Optional::Some(value: "kr_acl"), password: "bad");
    string o2 = outcomeOf(r: send(c: k2, text: "GET kr:k"));
    f = f + check(ok: !ok(r: bad) && o2 == "ok", what: "credentials: a new login refused as the link is made keeps the old one (${o2})");
    return f;
}

fn DynamicArray<Step> losing2(const ref string password) {
    DynamicArray<Step> s = loggedIn(password: password);
    s.add(item: Step::Close);
    return give s;
}

// ---- a subscriber ----

unsafe fn int32 subscriberTests() {
    int32 f = 0;
    // RESP3: the subscriber logs in anew where it is; a message that comes before AUTH's +OK waits for `next`.
    DynamicArray<Answer> a1 = answerList();
    a1.add(item: loginAs(password: "pw1", refreshMs: 300i64));
    a1.add(item: loginAs(password: "pw2", refreshMs: 0i64));
    Config c1 = providing(url: "redis://127.0.0.1:6379", answers: give a1);
    DynamicArray<Dial> d1 = dials();
    DynamicArray<Step> s1 = loggedIn(password: "pw1");
    s1.add(item: expect(command: "SUBSCRIBE kr:c1", answer: pub(kase: "sub-one")));
    DynamicArray<uint8> both = joined(a: pub(kase: "message"), b: reply(server: server(), kase: "auth2"));
    s1.add(item: expect(command: "AUTH kr_acl pw2", answer: give both));
    d1.add(item: Dial::Serve(steps: give s1));
    Subscriber sub1 = subscriberWith(dials: give d1, config: c1, what: "RESP3 subscriber");
    string subscribed = done(r: sub1.subscribe(names: names(a: "kr:c1", b: "")));
    wait(ms: 600i64);
    string n1 = said(r: sub1.next(timeout: Optional::None));
    f = f + check(ok: subscribed == "ok" && n1 == "message kr:c1 hello",
                  what: "credentials: a RESP3 subscriber logs in anew where it is, and the message on the way waits for next (${n1})");

    // RESP2: a subscribed connection takes no AUTH, so the link is made again, logging in anew and subscribing again,
    // and `Reconnected` marks the gap.
    DynamicArray<Answer> a2 = answerList();
    a2.add(item: loginAs(password: "pw1", refreshMs: 300i64));
    a2.add(item: loginAs(password: "pw2", refreshMs: 0i64));
    Config c2 = providing(url: "redis://127.0.0.1:6379?protocol=2", answers: give a2);
    DynamicArray<Dial> d2 = dials();
    DynamicArray<Step> s2 = DynamicArray.empty();
    s2.add(item: expect(command: "AUTH kr_acl pw1", answer: reply(server: server(), kase: "auth2")));
    s2.add(item: expect(command: "SUBSCRIBE kr:c1", answer: reply(server: server(), kase: "sub-one/2")));
    d2.add(item: Dial::Serve(steps: give s2));
    DynamicArray<Step> s2b = DynamicArray.empty();
    s2b.add(item: expect(command: "AUTH kr_acl pw2", answer: reply(server: server(), kase: "auth2")));
    s2b.add(item: expect(command: "PING", answer: reply(server: server(), kase: "ping")));
    s2b.add(item: expect(command: "SUBSCRIBE kr:c1", answer: reply(server: server(), kase: "sub-one/2")));
    d2.add(item: Dial::Serve(steps: give s2b));
    Subscriber sub2 = subscriberWith(dials: give d2, config: c2, what: "RESP2 subscriber");
    string subscribed2 = done(r: sub2.subscribe(names: names(a: "kr:c1", b: "")));
    wait(ms: 600i64);
    string n2 = said(r: sub2.next(timeout: Optional::Some(value: Duration.fromMillis(ms: 50i64))));
    f = f + check(ok: subscribed2 == "ok" && n2.startsWith(prefix: "reconnected: ") && sub2.channelCount() == 1,
                  what: "credentials: a RESP2 subscriber makes its link again to log in anew, and says Reconnected (${n2})");
    return f;
}

// ---- a cluster ----

unsafe fn int32 clusterTests() {
    int32 f = 0;
    // Each node's connection logs in with a fork of its own; a provider that fails at a node is the call's, final.
    DynamicArray<Answer> a1 = answerList();
    a1.add(item: Answer::Fail(why: "token service down"));
    Config c1 = providing(url: "redis://127.0.0.1:7000", answers: give a1);
    Owned<ScriptDialers> ds = new ScriptDialers.make();
    DynamicArray<Dial> d1 = dials();
    d1.add(item: Dial::Serve(steps: loggedIn(password: "never")));
    Owned<Dialer> seed = new ScriptDialer.make(dials: give d1);
    ds.then(dialer: give seed);
    Owned<Dialers> all = give ds;
    Result<Cluster, RedisError> r1 = Cluster.connectWith(dialers: give all, config: c1);
    string o1 = match (r1) { case Ok(value: c): "connected"; case Err(error: e): match (e) { case Credentials(error: c): "credentials"; case _: e.message(); }; };
    f = f + check(ok: o1 == "credentials", what: "credentials: a cluster whose provider fails at its seed fails with Credentials, untried again (${o1})");
    return f;
}

unsafe fn int32 credentialsTests() {
    int32 f = 0;
    f = f + configTests();
    f = f + connectionTests();
    f = f + authenticateTests();
    f = f + subscriberTests();
    f = f + clusterTests();
    return f;
}
