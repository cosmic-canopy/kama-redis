// redis::Cluster over scripted nodes (docs/ROADMAP.md, "Phase 6"). Each connection the cluster opens takes the next
// scripted dialer (`ScriptDialers`), keyed by its place, so a cluster that opens its connections in another order, or
// dials a node it should not, finds closed ports. What the nodes say is redis-8.10.2's cluster, from
// topology_vectors.kama: 7000-7002 primaries with the slots in thirds, 7003-7005 their replicas, and after a failover
// 7004 in place of 7001. Replies a cluster's captures lack are the standalone server's (server_vectors.kama).
import { std::collections::DynamicArray, std::memory::Owned, std::time::Duration, std::time::sleep,
         redis::Cluster, redis::ClusterTarget, redis::NodeReply, redis::Config, redis::Command, redis::RedisError,
         redis::Dialer, redis::Dialers, redis::Script, redis::ScriptCall, redis::libraryVersion, redis::resp::Value,
         redis::Connection, redis::Pipeline, redis::Replies, redis::TxOutcome, redis::TxBody, redis::Scan,
         redis::ClusterSubscriber, redis::Delivery,
         redis::cluster::keySlot,
         redis_unit_tests::check, redis_unit_tests::stop, Step, Dial, ScriptDialer, ScriptDialers, expect, reply, proxy, configOf, callOutcome,
         commandOf, bytesOf, textOf, topo, topologyKeyServers, topologyKeys, topologyNames, topologyHex, unhex };
export { clusterTests };

fn string server() { return "redis-8.10.2"; }

// The keys the cluster's cases use (topology_vectors.kama): 0 and 1 in shard 0 (7000) in two slots, 2 in shard 1
// (7001), 3 in shard 2 (7002), 4 and 5 in the slot that migrates from 7000 to 7001 (4 on 7000, 5 on neither).
fn string keyAt(isize index) {
    DynamicArray<string> servers = topologyKeyServers();
    DynamicArray<string> keys = topologyKeys();
    isize i = 0;
    while (i < servers.length()) {
        if (servers[i] == server()) {
            string all = copy keys[i];
            isize n = 0;
            isize start = 0;
            isize k = 0;
            while (k <= all.length()) {
                if (k == all.length() || all.bytes()[k] == 32ui8) {
                    if (n == index) { return all.substring(start: start, end: k); }
                    n = n + 1;
                    start = k + 1;
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    panic(msg: "cluster_test: no key ${index}");
}

fn DynamicArray<Step> steps() { return DynamicArray.empty(); }

// What `at`'s cluster answered to `kase`, for a case where servers differ.
fn DynamicArray<uint8> topoAt(const ref string at, const ref string kase) {
    string name = at.concat(other: " ").concat(other: kase);
    DynamicArray<string> names = topologyNames();
    DynamicArray<string> hex = topologyHex();
    isize i = 0;
    while (i < names.length()) {
        if (names[i] == name) { return unhex(text: hex[i]); }
        i = i + 1;
    }
    panic(msg: "cluster_test: no topology vector ${name}");
}

// A node's side of the handshake under RESP3: its HELLO (in cluster mode), then the two SETINFOs.
fn DynamicArray<Step> node() {
    DynamicArray<Step> s = steps();
    s.add(item: expect(command: "HELLO 3", answer: topo(kase: "hello3-node")));
    string version = libraryVersion();
    s.add(item: expect(command: "CLIENT SETINFO LIB-NAME kama-redis", answer: reply(server: server(), kase: "setinfo-name")));
    s.add(item: expect(command: "CLIENT SETINFO LIB-VER ".concat(other: version), answer: reply(server: server(), kase: "setinfo-ver")));
    return give s;
}

// A node that answers its handshake, then CLUSTER SLOTS with the map `slots` ("slots/3").
fn DynamicArray<Step> seed(const ref string slots) {
    DynamicArray<Step> s = node();
    s.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: slots)));
    return give s;
}

// A node that answers its handshake, then `command` with `answer`.
fn DynamicArray<Step> answering(const ref string command, DynamicArray<uint8> answer) {
    DynamicArray<Step> s = node();
    s.add(item: expect(command: command, answer: give answer));
    return give s;
}

// The connections a test's cluster opens, in the order it opens them: each one's place, and what each dial there
// meets (a redial is the connection's next dial).
type resource Opens {
    DynamicArray<Owned<Dialer>> made;

    public ctor make() { this.made = DynamicArray.empty(); }

    // The next connection, at `place`, its one dial served by `script`.
    public unsafe fn void serve(string place, DynamicArray<Step> script) {
        DynamicArray<Dial> d = DynamicArray.empty();
        d.add(item: Dial::Serve(steps: give script));
        this.each(place: give place, dials: give d);
    }

    // The next connection, at `place`, its dial refused.
    public unsafe fn void refuse(string place) {
        DynamicArray<Dial> d = DynamicArray.empty();
        d.add(item: Dial::Refuse);
        this.each(place: give place, dials: give d);
    }

    // The next connection, at `place`, each of its dials in turn.
    public unsafe fn void each(string place, DynamicArray<Dial> dials) {
        DynamicArray<string> where = DynamicArray.empty();
        isize i = 0;
        while (i < dials.length()) { where.add(item: copy place); i = i + 1; }
        Owned<Dialer> d = new ScriptDialer.byPlace(places: give where, dials: give dials);
        this.made.add(item: give d);
    }

    public unsafe fn Owned<Dialers> dialers() {
        Owned<ScriptDialers> all = new ScriptDialers.make();
        while (this.made.length() > 0) { all.then(dialer: this.made.remove(index: 0)); }
        Owned<Dialers> d = give all;
        return give d;
    }
}

// The seed 7000 alone, a second each to connect and to wait.
fn string oneSeed() { return "redis://127.0.0.1:7000?connect_timeout=1&reconnect_timeout=1"; }

unsafe fn Result<Cluster, RedisError> through(Opens o, const ref string url) {
    Opens taken = give o;
    Owned<Dialers> d = taken.dialers();
    Config c = configOf(url: url);
    return Cluster.connectWith(dialers: give d, config: c);
}

// The cluster a check needs. When it cannot be made, the check `what` fails here (counted in `fails`), and a stand-in,
// a cluster whose seed answers nothing past the map, lets the test go on to its end.
unsafe fn Cluster clustered(Opens o, const ref string url, const ref string what, ref int32 fails) {
    Result<Cluster, RedisError> r = through(o: give o, url: url);
    return match (give r) {
        case Ok(value: c): give c;
        case Err(error: e): { string m = e.message(); fails = fails + check(ok: false, what: "${what} (${m})"); := standIn(); }
    };
}

unsafe fn Cluster standIn() {
    Opens o = Opens.make();
    o.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    Result<Cluster, RedisError> r = through(o: give o, url: oneSeed());
    return match (give r) {
        case Ok(value: c): give c;
        case Err(error: e): { := stop::<Cluster>(msg: "cluster_test: the stand-in cluster"); }
    };
}

fn bool isBulk(const ref Result<Value, RedisError> r, const ref string text) {
    return match (r) { case Ok(value: v): match (v) { case Bulk(bytes: b): textOf(b: b.view()) == text; case _: false; }; case Err(error: e): false; };
}
fn bool isNull(const ref Result<Value, RedisError> r) {
    return match (r) { case Ok(value: v): v.isNull(); case Err(error: e): false; };
}
fn bool isInteger(const ref Result<Value, RedisError> r, int64 n) {
    return match (r) { case Ok(value: v): match (v) { case Integer(value: x): x == n; case _: false; }; case Err(error: e): false; };
}
fn bool isStatus(const ref Result<Value, RedisError> r, const ref string text) {
    return match (r) { case Ok(value: v): match (v) { case Simple(bytes: b): textOf(b: b.view()) == text; case _: false; }; case Err(error: e): false; };
}
fn bool hasCode(const ref Result<Value, RedisError> r, const ref string code) {
    return match (r) {
        case Err(error: e): match (e) { case Server(error: s): s.codeText() == code; case _: false; };
        case Ok(value: v): false;
    };
}
fn bool isUsage(const ref Result<Value, RedisError> r, const ref string words) {
    return match (r) { case Err(error: e): match (e) { case Usage(detail: d): d.contains(substring: words); case _: false; }; case Ok(value: v): false; };
}
fn bool isIo(const ref Result<Value, RedisError> r) {
    return match (r) { case Err(error: e): match (e) { case Io(error: x): true; case _: false; }; case Ok(value: v): false; };
}
// The texts of an array reply's items, joined by spaces, a null as "-"; "?" for anything else.
fn string itemsOf(const ref Result<Value, RedisError> r) {
    DynamicArray<Value> xs = match (r) { case Ok(value: v): match (v) { case Array(items: i): copy i; case _: DynamicArray.empty(); }; case Err(error: e): DynamicArray.empty(); };
    bool array = match (r) { case Ok(value: v): match (v) { case Array(items: i): true; case _: false; }; case Err(error: e): false; };
    if (!array) { return "?"; }
    string text = "";
    isize i = 0;
    while (i < xs.length()) {
        if (i > 0) { text = text.concat(other: " "); }
        string one = match (xs[i]) {
            case Bulk(bytes: b): textOf(b: b.view());
            case Integer(value: n): { int64 x = n; := "${x}"; }
            case Null: "-";
            case _: "?";
        };
        text = text.concat(other: one);
        i = i + 1;
    }
    return text;
}

unsafe fn Result<Value, RedisError> callText(ref Cluster c, const ref string text) {
    Command command = commandOf(text: text);
    return c.call(command: command);
}

// Where a command goes: its keys' slot's primary, each node's connection opened when a call first goes there.
unsafe fn int32 routingTests() {
    int32 f = 0;
    string a = keyAt(index: 0);
    string b = keyAt(index: 2);
    Opens o = Opens.make();
    DynamicArray<Step> s0 = seed(slots: "slots/3");
    s0.add(item: expect(command: "GET ${a}", answer: topo(kase: "replica-get-readonly/3")));
    o.serve(place: "127.0.0.1:7000", script: give s0);
    o.serve(place: "127.0.0.1:7001", script: answering(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3")));
    Cluster c = clustered(o: give o, url: oneSeed(), what: "route: connect", fails: f);
    f = f + check(ok: c.topology().nodeCount() == 6 && c.topology().shardCount() == 3, what: "route: the map has six nodes in three shards");
    Result<Value, RedisError> r1 = callText(c: c, text: "GET ${a}");
    string o1 = callOutcome(r: r1);
    f = f + check(ok: isBulk(r: r1, text: "va"), what: "route: a key of shard 0 goes to 7000, the seed's connection: ${o1}");
    Result<Value, RedisError> r2 = callText(c: c, text: "GET ${b}");
    string o2 = callOutcome(r: r2);
    f = f + check(ok: isNull(r: r2), what: "route: a key of shard 1 goes to 7001, a connection opened for it: ${o2}");

    // A map whose endpoints are unknown (cluster-preferred-endpoint-type unknown-endpoint) names the node asked.
    Opens u = Opens.make();
    u.serve(place: "127.0.0.1:7000", script: seed(slots: "slots-unknown-endpoint/3"));
    u.serve(place: "127.0.0.1:7001", script: answering(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3")));
    Cluster cu = clustered(o: give u, url: oneSeed(), what: "route: connect, unknown endpoints", fails: f);
    Result<Value, RedisError> r3 = callText(c: cu, text: "GET ${b}");
    string o3 = callOutcome(r: r3);
    f = f + check(ok: isNull(r: r3), what: "route: an unknown endpoint is the host asked: ${o3}");
    return f;
}

// MOVED: followed at once, the map patched, then read whole again a second later; ASK: this command, once.
unsafe fn int32 redirectTests() {
    int32 f = 0;
    string b = keyAt(index: 2);
    string my = keyAt(index: 5);
    isize slotB = keySlot(key: b.bytes());

    Opens o = Opens.make();
    DynamicArray<Step> s0 = seed(slots: "slots/3");
    s0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots-after-failover/3")));
    o.serve(place: "127.0.0.1:7000", script: give s0);
    o.serve(place: "127.0.0.1:7001", script: answering(command: "GET ${b}", answer: topo(kase: "moved-after-failover/3")));
    DynamicArray<Step> s4 = answering(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3"));
    s4.add(item: expect(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3")));
    s4.add(item: expect(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3")));
    o.serve(place: "127.0.0.1:7004", script: give s4);
    Cluster c = clustered(o: give o, url: oneSeed(), what: "moved: connect", fails: f);
    Result<Value, RedisError> r1 = callText(c: c, text: "GET ${b}");
    string o1 = callOutcome(r: r1);
    f = f + check(ok: isNull(r: r1), what: "moved: followed to 7004: ${o1}");
    isize owner = c.topology().primaryOf(slot: slotB);
    f = f + check(ok: owner >= 0 && c.topology().node(index: owner).port() == 7004, what: "moved: the map takes the slot at once");
    f = f + check(ok: c.topology().shardCount() == 4, what: "moved: the patched map has 7004 as a shard of its own until it is read again");
    Result<Value, RedisError> r2 = callText(c: c, text: "GET ${b}");
    string o2 = callOutcome(r: r2);
    f = f + check(ok: isNull(r: r2), what: "moved: the next call goes straight to 7004: ${o2}");
    f = f + check(ok: c.topology().shardCount() == 4, what: "moved: within a second of the last reading, the map is not read again");
    sleep(d: Duration.fromMillis(ms: 1100i64));
    Result<Value, RedisError> r3 = callText(c: c, text: "GET ${b}");
    string o3 = callOutcome(r: r3);
    f = f + check(ok: isNull(r: r3) && c.topology().shardCount() == 3, what: "moved: a second on, the map is read again: ${o3}");

    // ASK: ASKING and the command at the node named, in one write; the map unchanged.
    Opens k = Opens.make();
    DynamicArray<Step> k0 = seed(slots: "slots/3");
    k0.add(item: expect(command: "GET ${my}", answer: topo(kase: "ask/3")));
    k0.add(item: expect(command: "GET ${my}", answer: topo(kase: "ask/3")));
    k.serve(place: "127.0.0.1:7000", script: give k0);
    DynamicArray<Step> k1 = node();
    k1.add(item: expect(command: "ASKING", answer: topo(kase: "asking/3")));
    k1.add(item: expect(command: "GET ${my}", answer: topo(kase: "importing-asking/3")));
    k1.add(item: expect(command: "ASKING", answer: topo(kase: "asking/3")));
    k1.add(item: expect(command: "GET ${my}", answer: topo(kase: "importing-asking/3")));
    k.serve(place: "127.0.0.1:7001", script: give k1);
    Cluster ck = clustered(o: give k, url: oneSeed(), what: "ask: connect", fails: f);
    Result<Value, RedisError> a1 = callText(c: ck, text: "GET ${my}");
    string oa1 = callOutcome(r: a1);
    f = f + check(ok: isNull(r: a1), what: "ask: ASKING then the command at 7001: ${oa1}");
    isize mslot = keySlot(key: my.bytes());
    isize still = ck.topology().primaryOf(slot: mslot);
    f = f + check(ok: still >= 0 && ck.topology().node(index: still).port() == 7000, what: "ask: the map is not changed");
    Result<Value, RedisError> a2 = callText(c: ck, text: "GET ${my}");
    string oa2 = callOutcome(r: a2);
    f = f + check(ok: isNull(r: a2), what: "ask: the next call asks 7000 again: ${oa2}");

    // The budget: max_redirects=1 follows one MOVED and returns the second; 0 follows none.
    Opens m = Opens.make();
    m.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    m.serve(place: "127.0.0.1:7001", script: answering(command: "GET ${b}", answer: topo(kase: "moved-after-failover/3")));
    m.serve(place: "127.0.0.1:7004", script: answering(command: "GET ${b}", answer: topo(kase: "moved/3")));
    Cluster cm = clustered(o: give m, url: "redis://127.0.0.1:7000?connect_timeout=1&reconnect_timeout=1&max_redirects=1", what: "budget: connect", fails: f);
    Result<Value, RedisError> b1 = callText(c: cm, text: "GET ${b}");
    string ob1 = callOutcome(r: b1);
    f = f + check(ok: hasCode(r: b1, code: "MOVED") && ob1.contains(substring: "7001"), what: "budget: past max_redirects the last MOVED is the call's: ${ob1}");
    Opens z = Opens.make();
    z.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    z.serve(place: "127.0.0.1:7001", script: answering(command: "GET ${b}", answer: topo(kase: "moved-after-failover/3")));
    Cluster cz = clustered(o: give z, url: "redis://127.0.0.1:7000?connect_timeout=1&reconnect_timeout=1&max_redirects=0", what: "budget: connect, none", fails: f);
    Result<Value, RedisError> b2 = callText(c: cz, text: "GET ${b}");
    string ob2 = callOutcome(r: b2);
    f = f + check(ok: hasCode(r: b2, code: "MOVED") && ob2.contains(substring: "7004"), what: "budget: max_redirects=0 follows none: ${ob2}");
    return f;
}

// What ran nothing is waited out and sent again: TRYAGAIN after a pause, CLUSTERDOWN after the map is read again, and
// a node that cannot be reached by reading the map and going where it says. What may have run is the call's.
unsafe fn int32 waitTests() {
    int32 f = 0;
    string a = keyAt(index: 0);
    string b = keyAt(index: 2);
    string mx = keyAt(index: 4);
    string my = keyAt(index: 5);

    Opens t = Opens.make();
    DynamicArray<Step> t0 = seed(slots: "slots/3");
    t0.add(item: expect(command: "MGET ${mx} ${my}", answer: topo(kase: "migrating-tryagain/3")));
    t0.add(item: expect(command: "MGET ${mx} ${my}", answer: reply(server: server(), kase: "mget/3")));
    t.serve(place: "127.0.0.1:7000", script: give t0);
    Cluster ct = clustered(o: give t, url: oneSeed(), what: "tryagain: connect", fails: f);
    Result<Value, RedisError> r1 = callText(c: ct, text: "MGET ${mx} ${my}");
    string o1 = callOutcome(r: r1);
    f = f + check(ok: itemsOf(r: r1) != "?", what: "tryagain: sent again after a pause: ${o1}");

    Opens d = Opens.make();
    DynamicArray<Step> d0 = seed(slots: "slots/3");
    d0.add(item: expect(command: "GET ${a}", answer: topo(kase: "clusterdown/3")));
    d0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots/3")));
    d0.add(item: expect(command: "GET ${a}", answer: topo(kase: "clusterdown-read/3")));
    d.serve(place: "127.0.0.1:7000", script: give d0);
    Cluster cd = clustered(o: give d, url: oneSeed(), what: "clusterdown: connect", fails: f);
    Result<Value, RedisError> r2 = callText(c: cd, text: "GET ${a}");
    string o2 = callOutcome(r: r2);
    f = f + check(ok: isBulk(r: r2, text: "va"), what: "clusterdown: the map read again, then sent again: ${o2}");

    // LOADING (a node restarted, reading its data): the map read again, then sent again.
    Opens ld = Opens.make();
    DynamicArray<Step> ld0 = seed(slots: "slots/3");
    ld0.add(item: expect(command: "GET ${a}", answer: reply(server: server(), kase: "loading-get")));
    ld0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots/3")));
    ld0.add(item: expect(command: "GET ${a}", answer: topo(kase: "clusterdown-read/3")));
    ld.serve(place: "127.0.0.1:7000", script: give ld0);
    Cluster cld = clustered(o: give ld, url: oneSeed(), what: "loading: connect", fails: f);
    Result<Value, RedisError> rl = callText(c: cld, text: "GET ${a}");
    string ol = callOutcome(r: rl);
    f = f + check(ok: isBulk(r: rl, text: "va"), what: "loading: the map read again, then sent again: ${ol}");

    // A failover: 7001's link closed while idle, and its one redial refused (nothing was sent), so the map is read
    // again from 7000, which names 7004, and the call goes there.
    Opens fo = Opens.make();
    DynamicArray<Step> fo0 = seed(slots: "slots/3");
    fo0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots-after-failover/3")));
    fo.serve(place: "127.0.0.1:7000", script: give fo0);
    DynamicArray<Step> fo1 = answering(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3"));
    fo1.add(item: Step::Hangup);
    fo.serve(place: "127.0.0.1:7001", script: give fo1);
    fo.serve(place: "127.0.0.1:7004", script: answering(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3")));
    Cluster cfo = clustered(o: give fo, url: oneSeed(), what: "failover: connect", fails: f);
    Result<Value, RedisError> rf1 = callText(c: cfo, text: "GET ${b}");
    Result<Value, RedisError> rf2 = callText(c: cfo, text: "GET ${b}");
    string of2 = callOutcome(r: rf2);
    f = f + check(ok: isNull(r: rf1) && isNull(r: rf2), what: "failover: a node's redial refused, the map read again, the call at 7004: ${of2}");

    // A cluster that stays down: within reconnect_timeout, then its words.
    Opens g = Opens.make();
    DynamicArray<Step> g0 = seed(slots: "slots/3");
    isize n = 0;
    while (n < 12) {
        g0.add(item: expect(command: "GET ${a}", answer: topo(kase: "clusterdown/3")));
        g0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots/3")));
        n = n + 1;
    }
    g.serve(place: "127.0.0.1:7000", script: give g0);
    Cluster cg = clustered(o: give g, url: "redis://127.0.0.1:7000?connect_timeout=1&reconnect_timeout=0.3", what: "clusterdown: connect, down", fails: f);
    Result<Value, RedisError> r3 = callText(c: cg, text: "GET ${a}");
    string o3 = callOutcome(r: r3);
    f = f + check(ok: hasCode(r: r3, code: "CLUSTERDOWN"), what: "clusterdown: past reconnect_timeout, the cluster's words: ${o3}");

    // 7001 cannot be reached (nothing was sent): the map, read again from 7000, says 7004, and the call goes there.
    Opens h = Opens.make();
    DynamicArray<Step> h0 = seed(slots: "slots/3");
    h0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots-after-failover/3")));
    h.serve(place: "127.0.0.1:7000", script: give h0);
    h.refuse(place: "127.0.0.1:7001");
    h.serve(place: "127.0.0.1:7004", script: answering(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3")));
    Cluster ch = clustered(o: give h, url: oneSeed(), what: "unreachable: connect", fails: f);
    Result<Value, RedisError> r4 = callText(c: ch, text: "GET ${b}");
    string o4 = callOutcome(r: r4);
    f = f + check(ok: isNull(r: r4), what: "unreachable: the map read again, the call sent where it says: ${o4}");

    // A node's link lost after the command was written: the call's error, never sent again; the next call redials.
    Opens l = Opens.make();
    DynamicArray<Dial> dials = DynamicArray.empty();
    DynamicArray<Step> l0 = seed(slots: "slots/3");
    l0.add(item: Step::Close);
    dials.add(item: Dial::Serve(steps: give l0));
    dials.add(item: Dial::Serve(steps: thenPinged(script: answering(command: "GET ${a}", answer: topo(kase: "replica-get-readonly/3")))));
    l.each(place: "127.0.0.1:7000", dials: give dials);
    Cluster cl = clustered(o: give l, url: oneSeed(), what: "lost: connect", fails: f);
    Result<Value, RedisError> r5 = callText(c: cl, text: "GET ${a}");
    string o5 = callOutcome(r: r5);
    f = f + check(ok: isIo(r: r5), what: "lost: a command that may have run is the call's error: ${o5}");
    Result<Value, RedisError> r6 = callText(c: cl, text: "GET ${a}");
    string o6 = callOutcome(r: r6);
    f = f + check(ok: isBulk(r: r6, text: "va"), what: "lost: the next call makes the node's link again: ${o6}");
    return f;
}

// A redial ends with a PING (Connection.probe): `script`'s handshake, the PING answered, then the rest of it.
fn DynamicArray<Step> thenPinged(DynamicArray<Step> script) {
    DynamicArray<Step> s = give script;
    // The handshake's three steps come first; the PING follows them.
    s.insertAt(index: 3, item: expect(command: "PING", answer: topo(kase: "ping-node/3")));
    return give s;
}

// Commands the tips spread: split by slot, or sent to every primary, and their replies made one.
unsafe fn int32 spreadTests() {
    int32 f = 0;
    string a = keyAt(index: 0);
    string a2 = keyAt(index: 1);
    string b = keyAt(index: 2);
    string c3 = keyAt(index: 3);
    string mx = keyAt(index: 4);
    string my = keyAt(index: 5);

    // MGET across three shards: a piece per slot, in the order of the first key of each, the values in key order.
    Opens m = Opens.make();
    DynamicArray<Step> m0 = seed(slots: "slots/3");
    m0.add(item: expect(command: "MGET ${a}", answer: topo(kase: "mget-a/3")));
    m0.add(item: expect(command: "MGET ${a}", answer: topo(kase: "mget-a/3")));
    m0.add(item: expect(command: "MGET ${a2}", answer: topo(kase: "mget-b/3")));
    m0.add(item: expect(command: "MGET ${mx} ${my}", answer: topo(kase: "mget-tag/3")));
    m.serve(place: "127.0.0.1:7000", script: give m0);
    m.serve(place: "127.0.0.1:7001", script: answering(command: "MGET ${b}", answer: topo(kase: "mget-b/3")));
    DynamicArray<Step> m2 = answering(command: "MGET ${c3}", answer: topo(kase: "mget-c/3"));
    m2.add(item: expect(command: "MGET ${c3}", answer: topo(kase: "mget-c/3")));
    m.serve(place: "127.0.0.1:7002", script: give m2);
    Cluster cm = clustered(o: give m, url: oneSeed(), what: "mget: connect", fails: f);
    Result<Value, RedisError> r1 = callText(c: cm, text: "MGET ${b} ${a} ${c3}");
    string o1 = itemsOf(r: r1);
    f = f + check(ok: o1 == "- va vc", what: "mget: split by slot, the values in the keys' order: ${o1}");
    // Two keys on one node, in two slots: two pieces there.
    Result<Value, RedisError> r2 = callText(c: cm, text: "MGET ${a} ${a2}");
    string o2 = itemsOf(r: r2);
    f = f + check(ok: o2 == "va -", what: "mget: two slots of one node are two pieces: ${o2}");
    // Two keys of one slot are one piece, and its values go back to their keys' places.
    Result<Value, RedisError> r2b = callText(c: cm, text: "MGET ${mx} ${c3} ${my}");
    string o2b = itemsOf(r: r2b);
    f = f + check(ok: o2b == "vx vc -", what: "mget: a piece of two keys, its values in their keys' places: ${o2b}");

    // EXISTS: summed. MSET: OK when every piece is; one piece refused is the call's error.
    Opens e = Opens.make();
    DynamicArray<Step> e0 = seed(slots: "slots/3");
    e0.add(item: expect(command: "EXISTS ${a}", answer: topo(kase: "exists-a/3")));
    e0.add(item: expect(command: "MSET ${a} va", answer: topo(kase: "mset-a/3")));
    e0.add(item: expect(command: "MSET ${a} va", answer: topo(kase: "mset-a/3")));
    e.serve(place: "127.0.0.1:7000", script: give e0);
    DynamicArray<Step> e1 = answering(command: "EXISTS ${b}", answer: topo(kase: "exists-b/3"));
    e1.add(item: expect(command: "MSET ${b} vb", answer: topo(kase: "mset-a/3")));
    e1.add(item: expect(command: "MSET ${b} vb", answer: reply(server: server(), kase: "readonly")));
    e.serve(place: "127.0.0.1:7001", script: give e1);
    e.serve(place: "127.0.0.1:7002", script: answering(command: "EXISTS ${c3}", answer: topo(kase: "exists-c/3")));
    Cluster ce = clustered(o: give e, url: oneSeed(), what: "exists: connect", fails: f);
    Result<Value, RedisError> r3 = callText(c: ce, text: "EXISTS ${a} ${b} ${c3}");
    string o3 = callOutcome(r: r3);
    f = f + check(ok: isInteger(r: r3, n: 2i64), what: "exists: the pieces' counts summed: ${o3}");
    Result<Value, RedisError> r4 = callText(c: ce, text: "MSET ${a} va ${b} vb");
    string o4 = callOutcome(r: r4);
    f = f + check(ok: isStatus(r: r4, text: "OK"), what: "mset: a piece per slot, each key with its value: ${o4}");
    Result<Value, RedisError> r5 = callText(c: ce, text: "MSET ${a} va ${b} vb");
    string o5 = callOutcome(r: r5);
    f = f + check(ok: hasCode(r: r5, code: "READONLY"), what: "mset: a piece refused is the call's error: ${o5}");

    // MSETEX counts its keys: each piece counts its own, and what follows the keys goes with every piece.
    Opens x = Opens.make();
    x.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    x.serve(place: "127.0.0.1:7001", script: answering(command: "MSETEX 1 ${b} vb EX 10", answer: topo(kase: "exists-c/3")));
    DynamicArray<Step> x2 = answering(command: "MSETEX 1 ${c3} vc EX 10", answer: topo(kase: "exists-a/3"));
    x.serve(place: "127.0.0.1:7002", script: give x2);
    Cluster cx = clustered(o: give x, url: oneSeed(), what: "msetex: connect", fails: f);
    Result<Value, RedisError> rx = callText(c: cx, text: "MSETEX 2 ${b} vb ${c3} vc EX 10");
    string ox = callOutcome(r: rx);
    f = f + check(ok: isInteger(r: rx, n: 1i64), what: "msetex: a piece per slot, each counting its keys, the options after each: ${ox}");

    // WAIT: the least of the primaries' counts. SCRIPT KILL: one primary's success is enough, and none is the error.
    Opens w = Opens.make();
    DynamicArray<Step> w0 = seed(slots: "slots/3");
    w0.add(item: expect(command: "WAIT 0 0", answer: topo(kase: "dbsize-a/3")));
    w0.add(item: expect(command: "SCRIPT KILL", answer: reply(server: server(), kase: "notbusy")));
    w0.add(item: expect(command: "SCRIPT KILL", answer: reply(server: server(), kase: "notbusy")));
    w.serve(place: "127.0.0.1:7000", script: give w0);
    DynamicArray<Step> w1 = answering(command: "WAIT 0 0", answer: topo(kase: "dbsize-c/3"));
    w1.add(item: expect(command: "SCRIPT KILL", answer: topo(kase: "mset-a/3")));
    w1.add(item: expect(command: "SCRIPT KILL", answer: reply(server: server(), kase: "notbusy")));
    w.serve(place: "127.0.0.1:7001", script: give w1);
    DynamicArray<Step> w2 = answering(command: "WAIT 0 0", answer: topo(kase: "dbsize-a/3"));
    w2.add(item: expect(command: "SCRIPT KILL", answer: reply(server: server(), kase: "notbusy")));
    w2.add(item: expect(command: "SCRIPT KILL", answer: reply(server: server(), kase: "notbusy")));
    w.serve(place: "127.0.0.1:7002", script: give w2);
    Cluster cw = clustered(o: give w, url: oneSeed(), what: "wait: connect", fails: f);
    Result<Value, RedisError> rw = callText(c: cw, text: "WAIT 0 0");
    string ow = callOutcome(r: rw);
    f = f + check(ok: isInteger(r: rw, n: 1i64), what: "wait: the least of the primaries' counts: ${ow}");
    Result<Value, RedisError> rk = callText(c: cw, text: "SCRIPT KILL");
    string ok1 = callOutcome(r: rk);
    f = f + check(ok: isStatus(r: rk, text: "OK"), what: "script kill: one primary's success is the call's: ${ok1}");
    Result<Value, RedisError> rk2 = callText(c: cw, text: "SCRIPT KILL");
    string ok2 = callOutcome(r: rk2);
    f = f + check(ok: hasCode(r: rk2, code: "NOTBUSY"), what: "script kill: no primary's success is the error: ${ok2}");

    // DBSIZE summed, KEYS gathered, SCRIPT EXISTS and-ed, PING answered by every primary.
    Script one = Script.of(source: "return 1");
    string sha = one.sha();
    Opens p = Opens.make();
    DynamicArray<Step> p0 = seed(slots: "slots/3");
    p0.add(item: expect(command: "DBSIZE", answer: topo(kase: "dbsize-a/3")));
    p0.add(item: expect(command: "KEYS ${a}", answer: topo(kase: "keys-a/3")));
    p0.add(item: expect(command: "SCRIPT EXISTS ${sha}", answer: topo(kase: "script-exists-a/3")));
    p0.add(item: expect(command: "PING", answer: topo(kase: "ping-node/3")));
    p.serve(place: "127.0.0.1:7000", script: give p0);
    DynamicArray<Step> p1 = answering(command: "DBSIZE", answer: topo(kase: "dbsize-b/3"));
    p1.add(item: expect(command: "KEYS ${a}", answer: topo(kase: "keys-b/3")));
    p1.add(item: expect(command: "SCRIPT EXISTS ${sha}", answer: topo(kase: "script-exists-b/3")));
    p1.add(item: expect(command: "PING", answer: topo(kase: "ping-node/3")));
    p.serve(place: "127.0.0.1:7001", script: give p1);
    DynamicArray<Step> p2 = answering(command: "DBSIZE", answer: topo(kase: "dbsize-c/3"));
    p2.add(item: expect(command: "KEYS ${a}", answer: topo(kase: "keys-b/3")));
    p2.add(item: expect(command: "SCRIPT EXISTS ${sha}", answer: topo(kase: "script-exists-b/3")));
    p2.add(item: expect(command: "PING", answer: topo(kase: "ping-node/3")));
    p.serve(place: "127.0.0.1:7002", script: give p2);
    Cluster cp = clustered(o: give p, url: oneSeed(), what: "primaries: connect", fails: f);
    Result<Value, RedisError> r6 = callText(c: cp, text: "DBSIZE");
    string o6 = callOutcome(r: r6);
    f = f + check(ok: isInteger(r: r6, n: 3i64), what: "dbsize: every primary's, summed: ${o6}");
    Result<Value, RedisError> r7 = callText(c: cp, text: "KEYS ${a}");
    string o7 = itemsOf(r: r7);
    f = f + check(ok: o7 == a, what: "keys: every primary's, one after another: ${o7}");
    Result<Value, RedisError> r8 = callText(c: cp, text: "SCRIPT EXISTS ${sha}");
    string o8 = itemsOf(r: r8);
    f = f + check(ok: o8 == "0", what: "script exists: a script is there only when every primary has it: ${o8}");
    Result<Value, RedisError> r9 = callText(c: cp, text: "PING");
    string o9 = callOutcome(r: r9);
    f = f + check(ok: isStatus(r: r9, text: "PONG"), what: "ping: every primary answers: ${o9}");
    return f;
}

// What is refused before anything is written, each naming what to use; and what goes to a node a key names.
unsafe fn int32 refusalTests() {
    int32 f = 0;
    string a = keyAt(index: 0);
    string b = keyAt(index: 2);
    Opens o = Opens.make();
    o.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    DynamicArray<Step> s1 = answering(command: "FOO.BAR ${b}", answer: reply(server: server(), kase: "unknown"));
    s1.add(item: expect(command: "EVALSHA d3c21d0c2b9ca22f82737626a27bcaf5d288f99f 1 ${b}", answer: reply(server: server(), kase: "noscript")));
    s1.add(item: Step::Any(reply: reply(server: server(), kase: "evalsha-hit")));
    o.serve(place: "127.0.0.1:7001", script: give s1);
    Cluster c = clustered(o: give o, url: oneSeed(), what: "refusals: connect", fails: f);
    Result<Value, RedisError> info = callText(c: c, text: "INFO");
    f = f + check(ok: isUsage(r: info, words: "callEach"), what: "refused: INFO's reply is each node's own, naming callEach");
    Result<Value, RedisError> scan = callText(c: c, text: "SCAN 0");
    f = f + check(ok: isUsage(r: scan, words: "callEach"), what: "refused: SCAN, naming callEach");
    Result<Value, RedisError> random = callText(c: c, text: "RANDOMKEY");
    f = f + check(ok: isUsage(r: random, words: "callEach"), what: "refused: RANDOMKEY, naming callEach");
    Result<Value, RedisError> watch = callText(c: c, text: "WATCH ${a}");
    f = f + check(ok: isUsage(r: watch, words: "watched"), what: "refused: WATCH, naming watched");
    Result<Value, RedisError> asking = callText(c: c, text: "asking");
    f = f + check(ok: isUsage(r: asking, words: "ASKING itself"), what: "refused: ASKING, the cluster's own");
    Result<Value, RedisError> sub = callText(c: c, text: "SUBSCRIBE ch");
    f = f + check(ok: isUsage(r: sub, words: "pub/sub"), what: "refused: what a connection refuses");
    Result<Value, RedisError> module = callText(c: c, text: "FOO.BAR ${b}");
    f = f + check(ok: isUsage(r: module, words: "callFor"), what: "refused: a command the table does not know, naming callFor");
    Result<Value, RedisError> rename = callText(c: c, text: "RENAME ${a} ${b}");
    f = f + check(ok: isUsage(r: rename, words: "hash tag"), what: "refused: keys in two slots, naming a hash tag");

    // callFor: whatever the table says, the node of the key's slot.
    Command foo = commandOf(text: "FOO.BAR ${b}");
    Result<Value, RedisError> r1 = c.callFor(key: b.bytes(), command: foo);
    string o1 = callOutcome(r: r1);
    f = f + check(ok: hasCode(r: r1, code: "ERR") && o1.contains(substring: "FOO") == false && o1.contains(substring: "fake server") == false,
                  what: "callFor: sent to 7001, the key's node: ${o1}");

    // eval: EVALSHA at the node of the script's keys, then EVAL there on NOSCRIPT.
    Script s = Script.of(source: "return redis.call('GET', KEYS[1])");
    ScriptCall call = ScriptCall.of(script: s);
    call.addKeyBytes(bytes: b.bytes());
    Result<Value, RedisError> r2 = c.eval(call: call);
    string o2 = callOutcome(r: r2);
    f = f + check(ok: isBulk(r: r2, text: "hello"), what: "eval: EVALSHA at the keys' node, then EVAL on NOSCRIPT: ${o2}");
    c.close();
    Result<Value, RedisError> closed = callText(c: c, text: "GET ${a}");
    bool isClosed = match (closed) { case Err(error: e): match (e) { case Closed: true; case _: false; }; case Ok(value: v): false; };
    f = f + check(ok: isClosed && c.isClosed(), what: "close: every call answers Closed");
    return f;
}

// callEach: every primary's, or every node's, reply as it is.
unsafe fn int32 eachTests() {
    int32 f = 0;
    Opens o = Opens.make();
    DynamicArray<Step> s0 = seed(slots: "slots/3");
    s0.add(item: expect(command: "DBSIZE", answer: topo(kase: "dbsize-a/3")));
    s0.add(item: expect(command: "PING", answer: topo(kase: "ping-node/3")));
    o.serve(place: "127.0.0.1:7000", script: give s0);
    DynamicArray<Step> s1 = answering(command: "DBSIZE", answer: topo(kase: "dbsize-b/3"));
    s1.add(item: expect(command: "PING", answer: topo(kase: "ping-node/3")));
    o.serve(place: "127.0.0.1:7001", script: give s1);
    DynamicArray<Step> s2 = answering(command: "DBSIZE", answer: topo(kase: "dbsize-c/3"));
    s2.add(item: expect(command: "PING", answer: topo(kase: "ping-node/3")));
    o.serve(place: "127.0.0.1:7002", script: give s2);
    o.serve(place: "127.0.0.1:7003", script: answering(command: "PING", answer: topo(kase: "ping-node/3")));
    o.serve(place: "127.0.0.1:7004", script: answering(command: "PING", answer: topo(kase: "ping-node/3")));
    o.serve(place: "127.0.0.1:7005", script: answering(command: "PING", answer: topo(kase: "ping-node/3")));
    Cluster c = clustered(o: give o, url: oneSeed(), what: "each: connect", fails: f);
    Command dbsize = commandOf(text: "DBSIZE");
    Result<DynamicArray<NodeReply>, RedisError> r1 = c.callEach(command: dbsize, on: ClusterTarget::Primaries);
    DynamicArray<NodeReply> each = match (give r1) { case Ok(value: x): give x; case Err(error: e): DynamicArray.empty(); };
    string seen = "";
    isize i = 0;
    while (i < each.length()) {
        int32 port = each[i].node().port();
        Result<Value, RedisError> r = each[i].take();
        int64 n = match (r) { case Ok(value: v): match (v) { case Integer(value: x): x; case _: -1i64; }; case Err(error: e): -1i64; };
        seen = seen.concat(other: "${port}=${n} ");
        i = i + 1;
    }
    f = f + check(ok: seen == "7000=2 7001=0 7002=1 ", what: "each: every primary's reply, unmerged: ${seen}");
    bool again = each.length() > 0 && match (each[0].take()) { case Err(error: e): match (e) { case Usage(detail: d): true; case _: false; }; case Ok(value: v): false; };
    f = f + check(ok: again, what: "each: a node's reply is taken once");
    Command ping = commandOf(text: "PING");
    Result<DynamicArray<NodeReply>, RedisError> r2 = c.callEach(command: ping, on: ClusterTarget::AllNodes);
    DynamicArray<NodeReply> all = match (give r2) { case Ok(value: x): give x; case Err(error: e): DynamicArray.empty(); };
    isize pongs = 0;
    i = 0;
    while (i < all.length()) {
        Result<Value, RedisError> r = all[i].take();
        if (isStatus(r: r, text: "PONG")) { pongs = pongs + 1; }
        i = i + 1;
    }
    f = f + check(ok: all.length() == 6 && pongs == 6, what: "each: every node, the replicas too");
    return f;
}

// Connecting: the seeds in turn, the map from the first that gives one; what a cluster is not refused, in words.
unsafe fn int32 connectTests() {
    int32 f = 0;
    Opens two = Opens.make();
    two.refuse(place: "127.0.0.1:7000");
    two.serve(place: "127.0.0.1:7001", script: seed(slots: "slots/3"));
    Result<Cluster, RedisError> r1 = through(o: give two, url: "redis://127.0.0.1:7000,127.0.0.1:7001?connect_timeout=1&reconnect_timeout=1");
    bool second = match (r1) { case Ok(value: c): c.topology().nodeCount() == 6; case Err(error: e): false; };
    f = f + check(ok: second, what: "seeds: one refused, the next gives the map");

    Opens none = Opens.make();
    none.refuse(place: "127.0.0.1:7000");
    none.refuse(place: "127.0.0.1:7001");
    Result<Cluster, RedisError> r2 = through(o: give none, url: "redis://127.0.0.1:7000,127.0.0.1:7001?connect_timeout=1&reconnect_timeout=1");
    string o2 = match (r2) { case Ok(value: c): "ok"; case Err(error: e): e.message(); };
    bool both = match (r2) { case Err(error: e): match (e) { case Connect(error: c): c.count() == 2; case _: false; }; case Ok(value: c): false; };
    f = f + check(ok: both, what: "seeds: none reached is Connect, with an attempt for each: ${o2}");

    Opens plain = Opens.make();
    plain.serve(place: "127.0.0.1:7000", script: seed(slots: "slots-standalone/3"));
    Result<Cluster, RedisError> r3 = through(o: give plain, url: oneSeed());
    string o3 = match (r3) { case Ok(value: c): "ok"; case Err(error: e): e.message(); };
    bool standalone = match (r3) { case Err(error: e): match (e) { case Config(detail: d): d.contains(substring: "not in cluster mode") && d.contains(substring: "Connection.connect"); case _: false; }; case Ok(value: c): false; };
    f = f + check(ok: standalone, what: "a server not in cluster mode is refused, naming Connection.connect: ${o3}");

    Opens empty = Opens.make();
    empty.serve(place: "127.0.0.1:7000", script: seed(slots: "slots-empty/3"));
    Result<Cluster, RedisError> re = through(o: give empty, url: oneSeed());
    string oe = match (re) { case Ok(value: c): "ok"; case Err(error: e): e.message(); };
    f = f + check(ok: oe.contains(substring: "serves no slot"), what: "connect: a cluster whose slots are not assigned is refused: ${oe}");

    DynamicArray<string> refused = DynamicArray.empty();
    refused.add(item: "redis-sentinel://127.0.0.1:7300?master_name=kr");
    refused.add(item: "unix:///tmp/kr.sock");
    refused.add(item: "redis://127.0.0.1:7000?reconnect=off");
    DynamicArray<string> words = DynamicArray.empty();
    words.add(item: "Sentinel");
    words.add(item: "unix://");
    words.add(item: "reconnect=off");
    isize i = 0;
    while (i < refused.length()) {
        Opens unused = Opens.make();
        Result<Cluster, RedisError> r = through(o: give unused, url: refused[i]);
        string got = match (r) { case Ok(value: c): "ok"; case Err(error: e): e.message(); };
        bool config = match (r) { case Err(error: e): match (e) { case Config(detail: d): d.contains(substring: words[i]); case _: false; }; case Ok(value: c): false; };
        string u = copy refused[i];
        f = f + check(ok: config, what: "connect: ${u} is not a cluster's: ${got}");
        i = i + 1;
    }

    // A node that refuses HELLO takes the RESP2 path, and every node after it speaks RESP2 too: no HELLO to them.
    Opens p2 = Opens.make();
    DynamicArray<Step> s0 = steps();
    s0.add(item: expect(command: "HELLO 3", answer: proxy(name: "envoy-1.39.0 HELLO 3")));
    s0.add(item: Step::Any(reply: reply(server: server(), kase: "setinfo-name")));
    s0.add(item: Step::Any(reply: reply(server: server(), kase: "setinfo-ver")));
    s0.add(item: expect(command: "PING", answer: topo(kase: "ping-node/2")));
    s0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots/2")));
    p2.serve(place: "127.0.0.1:7000", script: give s0);
    string b = keyAt(index: 2);
    DynamicArray<Step> s1 = steps();
    s1.add(item: expect(command: "PING", answer: topo(kase: "ping-node/2")));
    s1.add(item: expect(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/2")));
    p2.serve(place: "127.0.0.1:7001", script: give s1);
    Cluster c = clustered(o: give p2, url: oneSeed(), what: "protocol: connect", fails: f);
    Result<Value, RedisError> r4 = callText(c: c, text: "GET ${b}");
    string o4 = callOutcome(r: r4);
    f = f + check(ok: isNull(r: r4), what: "protocol: every node speaks what the first settled on: ${o4}");
    return f;
}

// A pipeline of `texts`, each a command written as words.
fn Pipeline pipelineOf(const ref DynamicArray<string> texts) {
    Pipeline p = Pipeline.make();
    isize i = 0;
    while (i < texts.length()) { Command c = commandOf(text: texts[i]); p.add(command: c); i = i + 1; }
    return give p;
}

fn DynamicArray<string> words2(const ref string a, const ref string b) {
    DynamicArray<string> w = DynamicArray.empty();
    w.add(item: copy a);
    w.add(item: copy b);
    return give w;
}

// Each reply of a pipeline as text, joined by " | ": a value as callOutcome shows it, an I/O failure as "io".
fn string repliesOf(Result<Replies, RedisError> r) {
    return match (give r) {
        case Ok(value: rs): { string text = everyReply(rs: rs); := give text; }
        case Err(error: e): "(".concat(other: e.message()).concat(other: ")");
    };
}
fn string everyReply(Replies rs) {
    Replies all = give rs;
    string text = "";
    isize i = 0;
    while (i < all.length()) {
        Result<Value, RedisError> one = all.take(index: i);
        if (i > 0) { text = text.concat(other: " | "); }
        string shown = valueOf(r: one);
        if (isIo(r: one)) { shown = "io"; }
        text = text.concat(other: shown);
        i = i + 1;
    }
    return text;
}

// A reply as text: a string as it is, a null as "(nil)", an integer in decimal, an error as its message.
fn string valueOf(const ref Result<Value, RedisError> r) {
    return match (r) {
        case Ok(value: v): match (v) {
            case Bulk(bytes: b): textOf(b: b.view());
            case Simple(bytes: b): textOf(b: b.view());
            case Null: "(nil)";
            case Integer(value: n): { int64 x = n; := "${x}"; }
            case Array(items: xs): { isize n = xs.length(); := "[${n}]"; }
            case _: "?";
        };
        case Err(error: e): e.message();
    };
}

// A transaction's outcome as text: "committed N", "conflict", or the error.
fn string txOutcome(const ref Result<TxOutcome, RedisError> r) {
    return match (r) {
        case Ok(value: o): match (o) {
            case Committed(replies: rs): { isize n = rs.length(); := "committed ${n}"; }
            case WatchConflict: "conflict";
        };
        case Err(error: e): e.message();
    };
}

// A pipeline: each node's commands in one batch, the replies back in the pipeline's order; what ran nothing sent
// again; what may have run kept as its reply.
unsafe fn int32 pipelineTests() {
    int32 f = 0;
    string a = keyAt(index: 0);
    string a2 = keyAt(index: 1);
    string b = keyAt(index: 2);
    string c3 = keyAt(index: 3);
    string mx = keyAt(index: 4);
    string my = keyAt(index: 5);

    Opens o = Opens.make();
    DynamicArray<Step> s0 = seed(slots: "slots/3");
    s0.add(item: expect(command: "GET ${a}", answer: topo(kase: "replica-get-readonly/3")));
    s0.add(item: expect(command: "GET ${a2}", answer: reply(server: server(), kase: "get-missing/3")));
    o.serve(place: "127.0.0.1:7000", script: give s0);
    o.serve(place: "127.0.0.1:7001", script: answering(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3")));
    o.serve(place: "127.0.0.1:7002", script: answering(command: "GET ${c3}", answer: reply(server: server(), kase: "get-hit/3")));
    Cluster c = clustered(o: give o, url: oneSeed(), what: "pipeline: connect", fails: f);
    DynamicArray<string> texts = DynamicArray.empty();
    texts.add(item: "GET ${a}"); texts.add(item: "GET ${b}"); texts.add(item: "GET ${c3}"); texts.add(item: "GET ${a2}");
    Pipeline p = pipelineOf(texts: texts);
    Result<Replies, RedisError> r1 = c.run(pipeline: p);
    string o1 = repliesOf(r: give r1);
    f = f + check(ok: o1 == "va | (nil) | hello | (nil)", what: "pipeline: a batch per node, the replies in the pipeline's order: ${o1}");

    // MOVED: the command goes again, to 7004; the others' replies stand.
    Opens m = Opens.make();
    DynamicArray<Step> m0 = seed(slots: "slots/3");
    m0.add(item: expect(command: "GET ${a}", answer: topo(kase: "replica-get-readonly/3")));
    m.serve(place: "127.0.0.1:7000", script: give m0);
    m.serve(place: "127.0.0.1:7001", script: answering(command: "GET ${b}", answer: topo(kase: "moved-after-failover/3")));
    m.serve(place: "127.0.0.1:7004", script: answering(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3")));
    Cluster cm = clustered(o: give m, url: oneSeed(), what: "pipeline moved: connect", fails: f);
    Pipeline pm = pipelineOf(texts: words2(a: "GET ${b}", b: "GET ${a}"));
    Result<Replies, RedisError> r2 = cm.run(pipeline: pm);
    string o2 = repliesOf(r: give r2);
    f = f + check(ok: o2 == "(nil) | va", what: "pipeline: MOVED sends that command again where it says: ${o2}");

    // ASK: ASKING and the command at 7001, in the next round's batch there.
    Opens k = Opens.make();
    DynamicArray<Step> k0 = seed(slots: "slots/3");
    k0.add(item: expect(command: "GET ${my}", answer: topo(kase: "ask/3")));
    k0.add(item: expect(command: "GET ${a}", answer: topo(kase: "replica-get-readonly/3")));
    k.serve(place: "127.0.0.1:7000", script: give k0);
    DynamicArray<Step> k1 = node();
    k1.add(item: expect(command: "ASKING", answer: topo(kase: "asking/3")));
    k1.add(item: expect(command: "GET ${my}", answer: topo(kase: "importing-asking/3")));
    k.serve(place: "127.0.0.1:7001", script: give k1);
    Cluster ck = clustered(o: give k, url: oneSeed(), what: "pipeline ask: connect", fails: f);
    Pipeline pk = pipelineOf(texts: words2(a: "GET ${my}", b: "GET ${a}"));
    Result<Replies, RedisError> r3 = ck.run(pipeline: pk);
    string o3 = repliesOf(r: give r3);
    f = f + check(ok: o3 == "(nil) | va", what: "pipeline: ASK sends ASKING and the command at the node named: ${o3}");
    isize mslot = keySlot(key: my.bytes());
    isize kept = ck.topology().primaryOf(slot: mslot);
    f = f + check(ok: kept >= 0 && ck.topology().node(index: kept).port() == 7000, what: "pipeline: ASK leaves the map as it was");

    // TRYAGAIN: sent again after a pause.
    Opens t = Opens.make();
    DynamicArray<Step> t0 = seed(slots: "slots/3");
    t0.add(item: expect(command: "MGET ${mx} ${my}", answer: topo(kase: "migrating-tryagain/3")));
    t0.add(item: expect(command: "MGET ${mx} ${my}", answer: topo(kase: "mget-tag/3")));
    t.serve(place: "127.0.0.1:7000", script: give t0);
    Cluster ct = clustered(o: give t, url: oneSeed(), what: "pipeline tryagain: connect", fails: f);
    DynamicArray<string> one = DynamicArray.empty();
    one.add(item: "MGET ${mx} ${my}");
    Pipeline pt = pipelineOf(texts: one);
    Result<Replies, RedisError> r4 = ct.run(pipeline: pt);
    string o4 = repliesOf(r: give r4);
    f = f + check(ok: !o4.contains(substring: "TRYAGAIN") && !o4.startsWith(prefix: "("), what: "pipeline: TRYAGAIN is waited out: ${o4}");

    // A node's link lost on the way: its command's reply is the failure (it may have run); the other node's stands.
    Opens l = Opens.make();
    DynamicArray<Step> l0 = seed(slots: "slots/3");
    l0.add(item: expect(command: "GET ${a}", answer: topo(kase: "replica-get-readonly/3")));
    l.serve(place: "127.0.0.1:7000", script: give l0);
    DynamicArray<Step> l1 = node();
    l1.add(item: Step::Close);
    l.serve(place: "127.0.0.1:7001", script: give l1);
    Cluster cl = clustered(o: give l, url: oneSeed(), what: "pipeline lost: connect", fails: f);
    Pipeline pl = pipelineOf(texts: words2(a: "GET ${a}", b: "GET ${b}"));
    Result<Replies, RedisError> r5 = cl.run(pipeline: pl);
    string o5 = repliesOf(r: give r5);
    f = f + check(ok: o5 == "va | io", what: "pipeline: a node lost mid-batch fails its commands, which may have run: ${o5}");

    // A node that will not open: nothing was sent, so the map is read again and the command goes where it says.
    Opens u = Opens.make();
    DynamicArray<Step> u0 = seed(slots: "slots/3");
    u0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots-after-failover/3")));
    u.serve(place: "127.0.0.1:7000", script: give u0);
    u.refuse(place: "127.0.0.1:7001");
    u.serve(place: "127.0.0.1:7004", script: answering(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3")));
    Cluster cu = clustered(o: give u, url: oneSeed(), what: "pipeline unreachable: connect", fails: f);
    DynamicArray<string> onlyB = DynamicArray.empty();
    onlyB.add(item: "GET ${b}");
    Pipeline pu = pipelineOf(texts: onlyB);
    Result<Replies, RedisError> r6 = cu.run(pipeline: pu);
    string o6 = repliesOf(r: give r6);
    f = f + check(ok: o6 == "(nil)", what: "pipeline: a node that will not open, the map read again: ${o6}");

    // max_redirects=0: the MOVED is that command's reply.
    Opens z = Opens.make();
    z.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    z.serve(place: "127.0.0.1:7001", script: answering(command: "GET ${b}", answer: topo(kase: "moved-after-failover/3")));
    Cluster cz = clustered(o: give z, url: "redis://127.0.0.1:7000?connect_timeout=1&reconnect_timeout=1&max_redirects=0", what: "pipeline budget: connect", fails: f);
    Pipeline pz = pipelineOf(texts: onlyB);
    Result<Replies, RedisError> r7 = cz.run(pipeline: pz);
    string o7 = repliesOf(r: give r7);
    f = f + check(ok: o7.contains(substring: "MOVED"), what: "pipeline: past max_redirects, the MOVED is the reply: ${o7}");

    // max_redirects=1, and two nodes that point at each other: the second MOVED is the reply, a round later.
    Opens pp = Opens.make();
    pp.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    pp.serve(place: "127.0.0.1:7001", script: answering(command: "GET ${b}", answer: topo(kase: "moved-after-failover/3")));
    pp.serve(place: "127.0.0.1:7004", script: answering(command: "GET ${b}", answer: topo(kase: "moved/3")));
    Cluster cpp = clustered(o: give pp, url: "redis://127.0.0.1:7000?connect_timeout=1&reconnect_timeout=1&max_redirects=1", what: "pipeline ping-pong: connect", fails: f);
    Pipeline ppp = pipelineOf(texts: onlyB);
    string o8 = repliesOf(r: cpp.run(pipeline: ppp));
    f = f + check(ok: o8.contains(substring: "MOVED 7627 127.0.0.1:7001"), what: "pipeline: a command's redirections count across rounds: ${o8}");

    // Refused before anything is written, naming the command; an empty pipeline writes nothing.
    Opens n = Opens.make();
    n.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    Cluster cn = clustered(o: give n, url: oneSeed(), what: "pipeline refusals: connect", fails: f);
    Pipeline every = pipelineOf(texts: words2(a: "GET ${a}", b: "DBSIZE"));
    string e1 = repliesOf(r: cn.run(pipeline: every));
    f = f + check(ok: e1.contains(substring: "command 2:") && e1.contains(substring: "every node"), what: "pipeline: a command for every node is refused: ${e1}");
    DynamicArray<string> spread = DynamicArray.empty();
    spread.add(item: "MGET ${a} ${b}");
    Pipeline two = pipelineOf(texts: spread);
    string e2 = repliesOf(r: cn.run(pipeline: two));
    f = f + check(ok: e2.contains(substring: "command 1:") && e2.contains(substring: "more than one slot"), what: "pipeline: keys in two slots are refused: ${e2}");
    Pipeline watch = pipelineOf(texts: words2(a: "WATCH ${a}", b: "GET ${a}"));
    string e3 = repliesOf(r: cn.run(pipeline: watch));
    f = f + check(ok: e3.contains(substring: "command 1:") && e3.contains(substring: "watched"), what: "pipeline: WATCH is refused: ${e3}");
    Pipeline empty = Pipeline.make();
    string e4 = repliesOf(r: cn.run(pipeline: empty));
    f = f + check(ok: e4 == "", what: "pipeline: an empty one has no replies: ${e4}");
    return f;
}

// A transaction at the node of its keys' slot; what ran nothing sent again whole.
unsafe fn int32 transactionTests() {
    int32 f = 0;
    string a = keyAt(index: 0);
    string b = keyAt(index: 2);
    string mx = keyAt(index: 4);
    string my = keyAt(index: 5);

    Opens o = Opens.make();
    DynamicArray<Step> s0 = seed(slots: "slots/3");
    s0.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    s0.add(item: expect(command: "SET ${a} 1", answer: reply(server: server(), kase: "queued/3")));
    s0.add(item: expect(command: "INCR ${a}", answer: reply(server: server(), kase: "queued/3")));
    s0.add(item: expect(command: "EXEC", answer: reply(server: server(), kase: "exec-ok/3")));
    o.serve(place: "127.0.0.1:7000", script: give s0);
    Cluster c = clustered(o: give o, url: oneSeed(), what: "transact: connect", fails: f);
    Pipeline tx = pipelineOf(texts: words2(a: "SET ${a} 1", b: "INCR ${a}"));
    Result<TxOutcome, RedisError> r1 = c.transact(pipeline: tx);
    string o1 = txOutcome(r: r1);
    f = f + check(ok: o1 == "committed 2", what: "transact: at the node of its keys' slot: ${o1}");
    Pipeline across = pipelineOf(texts: words2(a: "SET ${a} 1", b: "SET ${b} 1"));
    string e1 = txOutcome(r: c.transact(pipeline: across));
    f = f + check(ok: e1.contains(substring: "share one slot") && e1.contains(substring: "command 2"), what: "transact: keys in two slots are refused: ${e1}");
    Pipeline every = pipelineOf(texts: words2(a: "SET ${a} 1", b: "FLUSHALL"));
    string e2 = txOutcome(r: c.transact(pipeline: every));
    f = f + check(ok: e2.contains(substring: "every node"), what: "transact: a command for every node is refused: ${e2}");

    // Every keyed command answered ASK (its keys are all on the importing node): ASKING, then the transaction there.
    Opens k = Opens.make();
    DynamicArray<Step> k0 = seed(slots: "slots/3");
    k0.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    k0.add(item: expect(command: "SET ${my} vy", answer: topo(kase: "multi-ask/3")));
    k0.add(item: expect(command: "EXEC", answer: topo(kase: "exec-after-ask/3")));
    k.serve(place: "127.0.0.1:7000", script: give k0);
    DynamicArray<Step> k1 = node();
    k1.add(item: expect(command: "ASKING", answer: topo(kase: "asking/3")));
    k1.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    k1.add(item: expect(command: "SET ${my} vy", answer: reply(server: server(), kase: "queued/3")));
    k1.add(item: expect(command: "EXEC", answer: topo(kase: "importing-asking-multi/3")));
    k.serve(place: "127.0.0.1:7001", script: give k1);
    Cluster ck = clustered(o: give k, url: oneSeed(), what: "transact ask: connect", fails: f);
    DynamicArray<string> setMy = DynamicArray.empty();
    setMy.add(item: "SET ${my} vy");
    Pipeline txk = pipelineOf(texts: setMy);
    string o2 = txOutcome(r: ck.transact(pipeline: txk));
    f = f + check(ok: o2 == "committed 1", what: "transact: ASK on every key, ASKING then the transaction at the importing node: ${o2}");

    // Some keys still on the source (QUEUED there) and one asked for: the slot is waited out, not followed.
    Opens h = Opens.make();
    DynamicArray<Step> h0 = seed(slots: "slots/3");
    h0.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    h0.add(item: expect(command: "SET ${mx} vx", answer: reply(server: server(), kase: "queued/3")));
    h0.add(item: expect(command: "SET ${my} vy", answer: topo(kase: "multi-ask/3")));
    h0.add(item: expect(command: "EXEC", answer: topo(kase: "exec-after-mixed/3")));
    h0.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    h0.add(item: expect(command: "SET ${mx} vx", answer: reply(server: server(), kase: "queued/3")));
    h0.add(item: expect(command: "SET ${my} vy", answer: reply(server: server(), kase: "queued/3")));
    h0.add(item: expect(command: "EXEC", answer: reply(server: server(), kase: "exec-ok/3")));
    h.serve(place: "127.0.0.1:7000", script: give h0);
    Cluster ch = clustered(o: give h, url: oneSeed(), what: "transact half moved: connect", fails: f);
    Pipeline txh = pipelineOf(texts: words2(a: "SET ${mx} vx", b: "SET ${my} vy"));
    string o3 = txOutcome(r: ch.transact(pipeline: txh));
    f = f + check(ok: o3 == "committed 2", what: "transact: a slot half moved under its keys is waited out at the source: ${o3}");

    // Valkey 9.1 queues a transaction in a migrating slot and answers at EXEC for all of it: ASK when every key is on
    // the importing node, which is followed; TRYAGAIN when some are still on the source, which is waited out.
    string vk = "valkey-9.1.2";
    Opens va = Opens.make();
    DynamicArray<Step> va0 = seed(slots: "slots/3");
    va0.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    va0.add(item: expect(command: "SET ${my} vy", answer: topoAt(at: vk, kase: "multi-ask/3")));
    va0.add(item: expect(command: "EXEC", answer: topoAt(at: vk, kase: "exec-after-ask/3")));
    va.serve(place: "127.0.0.1:7000", script: give va0);
    DynamicArray<Step> va1 = node();
    va1.add(item: expect(command: "ASKING", answer: topoAt(at: vk, kase: "asking/3")));
    va1.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    va1.add(item: expect(command: "SET ${my} vy", answer: reply(server: server(), kase: "queued/3")));
    va1.add(item: expect(command: "EXEC", answer: topoAt(at: vk, kase: "importing-asking-multi/3")));
    va.serve(place: "127.0.0.1:7001", script: give va1);
    Cluster cva = clustered(o: give va, url: oneSeed(), what: "transact valkey ask: connect", fails: f);
    Pipeline txva = pipelineOf(texts: setMy);
    string o5 = txOutcome(r: cva.transact(pipeline: txva));
    f = f + check(ok: o5 == "committed 1", what: "transact: Valkey 9.1's ASK at EXEC is followed, ASKING then the transaction: ${o5}");
    Opens vm = Opens.make();
    DynamicArray<Step> vm0 = seed(slots: "slots/3");
    vm0.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    vm0.add(item: expect(command: "SET ${mx} vx", answer: topoAt(at: vk, kase: "multi-ask/3")));
    vm0.add(item: expect(command: "SET ${my} vy", answer: topoAt(at: vk, kase: "multi-ask/3")));
    vm0.add(item: expect(command: "EXEC", answer: topoAt(at: vk, kase: "exec-after-mixed/3")));
    vm0.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    vm0.add(item: expect(command: "SET ${mx} vx", answer: reply(server: server(), kase: "queued/3")));
    vm0.add(item: expect(command: "SET ${my} vy", answer: reply(server: server(), kase: "queued/3")));
    vm0.add(item: expect(command: "EXEC", answer: reply(server: server(), kase: "exec-ok/3")));
    vm.serve(place: "127.0.0.1:7000", script: give vm0);
    Cluster cvm = clustered(o: give vm, url: oneSeed(), what: "transact valkey mixed: connect", fails: f);
    Pipeline txvm = pipelineOf(texts: words2(a: "SET ${mx} vx", b: "SET ${my} vy"));
    string o6 = txOutcome(r: cvm.transact(pipeline: txvm));
    f = f + check(ok: o6 == "committed 2", what: "transact: Valkey 9.1's TRYAGAIN at EXEC, half moved, is waited out: ${o6}");

    // MOVED while queueing (the slot's primary failed over): the whole transaction again, at 7004.
    Opens m = Opens.make();
    m.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    DynamicArray<Step> m1 = node();
    m1.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    m1.add(item: expect(command: "SET ${b} vb", answer: topo(kase: "moved-after-failover/3")));
    m1.add(item: expect(command: "EXEC", answer: topo(kase: "exec-after-moved/3")));
    m.serve(place: "127.0.0.1:7001", script: give m1);
    DynamicArray<Step> m4 = node();
    m4.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    m4.add(item: expect(command: "SET ${b} vb", answer: reply(server: server(), kase: "queued/3")));
    m4.add(item: expect(command: "EXEC", answer: topo(kase: "importing-asking-multi/3")));
    m.serve(place: "127.0.0.1:7004", script: give m4);
    Cluster cm = clustered(o: give m, url: oneSeed(), what: "transact moved: connect", fails: f);
    DynamicArray<string> setB = DynamicArray.empty();
    setB.add(item: "SET ${b} vb");
    Pipeline txm = pipelineOf(texts: setB);
    string o4 = txOutcome(r: cm.transact(pipeline: txm));
    f = f + check(ok: o4 == "committed 1", what: "transact: MOVED while queueing, the transaction again at the owner: ${o4}");
    return f;
}

// A body that reads `key` over the watching node's connection, then sets `target` to x.
type resource ReadThenSet implements TxBody {
    string key;
    string target;
    int32 builds = 0;
    public ctor of(string key, string target) { this.key = give key; this.target = give target; }
    public unsafe fn Result<Unit, RedisError> build(ref Connection conn, ref Pipeline tx) {
        this.builds = this.builds + 1;
        Command get = Command.of(name: "GET");
        get.arg(text: this.key);
        Result<Value, RedisError> read = conn.call(command: get);
        Command set = Command.of(name: "SET");
        set.arg(text: this.target);
        set.arg(text: "x");
        tx.add(command: set);
        return Result::Ok(value: Unit::Unit);
    }
    public const fn int32 count() { return this.builds; }
}

type resource Fails implements TxBody {
    public ctor make() { }
    public fn Result<Unit, RedisError> build(ref Connection conn, ref Pipeline tx) {
        return Result::Err(error: RedisError::Value(detail: "the body refused"));
    }
}

// The steps of one watched attempt at a node: WATCH key, the body's GET, then MULTI, SET and EXEC answered `exec`.
fn void attempt(ref DynamicArray<Step> s, const ref string key, DynamicArray<uint8> got, DynamicArray<uint8> exec) {
    s.add(item: expect(command: "WATCH ${key}", answer: reply(server: server(), kase: "watch/3")));
    s.add(item: expect(command: "GET ${key}", answer: give got));
    s.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    s.add(item: expect(command: "SET ${key} x", answer: reply(server: server(), kase: "queued/3")));
    s.add(item: expect(command: "EXEC", answer: give exec));
}

// watched: WATCH, the body and the transaction on the node of the watched keys' slot, over its one connection.
unsafe fn int32 watchedTests() {
    int32 f = 0;
    string a = keyAt(index: 0);
    string b = keyAt(index: 2);

    // A conflict, then a commit.
    Opens o = Opens.make();
    DynamicArray<Step> s0 = seed(slots: "slots/3");
    attempt(s: s0, key: a, got: topo(kase: "replica-get-readonly/3"), exec: reply(server: server(), kase: "exec-null/3"));
    attempt(s: s0, key: a, got: topo(kase: "replica-get-readonly/3"), exec: topo(kase: "importing-asking-multi/3"));
    o.serve(place: "127.0.0.1:7000", script: give s0);
    Cluster c = clustered(o: give o, url: oneSeed(), what: "watched: connect", fails: f);
    Command watch = commandOf(text: "WATCH ${a}");
    ReadThenSet body = ReadThenSet.of(key: copy a, target: copy a);
    string o1 = txOutcome(r: c.watched(watch: watch, body: body, attempts: 3));
    f = f + check(ok: o1 == "committed 1" && body.count() == 2, what: "watched: a conflict runs it again, then it commits: ${o1}");

    // MOVED at WATCH: followed, and it all runs at 7004.
    Opens m = Opens.make();
    m.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    m.serve(place: "127.0.0.1:7001", script: answering(command: "WATCH ${b}", answer: topo(kase: "moved-after-failover/3")));
    DynamicArray<Step> m4 = node();
    attempt(s: m4, key: b, got: reply(server: server(), kase: "get-missing/3"), exec: topo(kase: "importing-asking-multi/3"));
    m.serve(place: "127.0.0.1:7004", script: give m4);
    Cluster cm = clustered(o: give m, url: oneSeed(), what: "watched moved: connect", fails: f);
    Command watchB = commandOf(text: "WATCH ${b}");
    ReadThenSet bodyB = ReadThenSet.of(key: copy b, target: copy b);
    string o2 = txOutcome(r: cm.watched(watch: watchB, body: bodyB, attempts: 3));
    f = f + check(ok: o2 == "committed 1" && bodyB.count() == 1, what: "watched: MOVED at WATCH is followed: ${o2}");

    // The slot moved between WATCH and EXEC: it runs again, from fresh reads, at the new owner.
    Opens v = Opens.make();
    v.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    DynamicArray<Step> v1 = node();
    v1.add(item: expect(command: "WATCH ${b}", answer: reply(server: server(), kase: "watch/3")));
    v1.add(item: expect(command: "GET ${b}", answer: reply(server: server(), kase: "get-missing/3")));
    v1.add(item: expect(command: "MULTI", answer: reply(server: server(), kase: "multi/3")));
    v1.add(item: expect(command: "SET ${b} x", answer: topo(kase: "moved-after-failover/3")));
    v1.add(item: expect(command: "EXEC", answer: topo(kase: "exec-after-moved/3")));
    v.serve(place: "127.0.0.1:7001", script: give v1);
    DynamicArray<Step> v4 = node();
    attempt(s: v4, key: b, got: reply(server: server(), kase: "get-missing/3"), exec: topo(kase: "importing-asking-multi/3"));
    v.serve(place: "127.0.0.1:7004", script: give v4);
    Cluster cv = clustered(o: give v, url: oneSeed(), what: "watched moved under: connect", fails: f);
    ReadThenSet bodyV = ReadThenSet.of(key: copy b, target: copy b);
    string o3 = txOutcome(r: cv.watched(watch: watchB, body: bodyV, attempts: 3));
    f = f + check(ok: o3 == "committed 1" && bodyV.count() == 2, what: "watched: a slot moved between WATCH and EXEC runs it again at the owner: ${o3}");

    // A transaction off the watched keys' slot, and a body that fails: UNWATCH, and the error.
    Opens u = Opens.make();
    DynamicArray<Step> u0 = seed(slots: "slots/3");
    u0.add(item: expect(command: "WATCH ${a}", answer: reply(server: server(), kase: "watch/3")));
    u0.add(item: expect(command: "GET ${a}", answer: topo(kase: "replica-get-readonly/3")));
    u0.add(item: expect(command: "UNWATCH", answer: reply(server: server(), kase: "unwatch/3")));
    u0.add(item: expect(command: "WATCH ${a}", answer: reply(server: server(), kase: "watch/3")));
    u0.add(item: expect(command: "UNWATCH", answer: reply(server: server(), kase: "unwatch/3")));
    u0.add(item: expect(command: "PING", answer: topo(kase: "ping-node/3")));
    u.serve(place: "127.0.0.1:7000", script: give u0);
    Cluster cu = clustered(o: give u, url: oneSeed(), what: "watched refusals: connect", fails: f);
    ReadThenSet elsewhere = ReadThenSet.of(key: copy a, target: copy b);
    string e1 = txOutcome(r: cu.watched(watch: watch, body: elsewhere, attempts: 3));
    f = f + check(ok: e1.contains(substring: "watched keys' slot"), what: "watched: a transaction off the watched slot is refused: ${e1}");
    Fails refuses = Fails.make();
    string e2 = txOutcome(r: cu.watched(watch: watch, body: refuses, attempts: 3));
    f = f + check(ok: e2.contains(substring: "the body refused"), what: "watched: a body that fails ends it: ${e2}");
    // Both sent UNWATCH: the connection answers its next command in step.
    Command ping = commandOf(text: "PING");
    Result<DynamicArray<NodeReply>, RedisError> each = cu.callEach(command: ping, on: ClusterTarget::Primaries);
    DynamicArray<NodeReply> replies = match (give each) { case Ok(value: x): give x; case Err(error: e): DynamicArray.empty(); };
    bool inStep = replies.length() > 0 && isStatus(r: replies[0].take(), text: "PONG");
    f = f + check(ok: inStep, what: "watched: UNWATCH after each refusal");
    Command both = commandOf(text: "WATCH ${a} ${b}");
    string e3 = txOutcome(r: cu.watched(watch: both, body: elsewhere, attempts: 3));
    f = f + check(ok: e3.contains(substring: "keys of one slot"), what: "watched: WATCH of keys in two slots is refused: ${e3}");
    return f;
}

// A node's handshake for reads from replicas: READONLY after the SETINFOs, in the same write.
fn DynamicArray<Step> nodeReading() {
    DynamicArray<Step> s = node();
    s.add(item: expect(command: "READONLY", answer: topo(kase: "replica-readonly/3")));
    return give s;
}

fn string replicaSeed() { return "redis://127.0.0.1:7000?connect_timeout=1&reconnect_timeout=1&read_from=replica"; }

// read_from=replica: every link sends READONLY as it is made; a read goes to a replica of its slot, a write to the
// primary; a replica that will not serve sends the read to the primary.
unsafe fn int32 replicaTests() {
    int32 f = 0;
    string a = keyAt(index: 0);
    string c3 = keyAt(index: 3);

    Opens o = Opens.make();
    DynamicArray<Step> s0 = nodeReading();
    s0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots/3")));
    s0.add(item: expect(command: "SET ${a} x", answer: reply(server: server(), kase: "select1")));
    s0.add(item: expect(command: "SET ${a} y", answer: reply(server: server(), kase: "select1")));
    o.serve(place: "127.0.0.1:7000", script: give s0);
    DynamicArray<Step> s3 = nodeReading();
    s3.add(item: expect(command: "GET ${a}", answer: topo(kase: "replica-get-readonly/3")));
    s3.add(item: expect(command: "GET ${a}", answer: topo(kase: "replica-get-readonly/3")));
    o.serve(place: "127.0.0.1:7003", script: give s3);
    Cluster c = clustered(o: give o, url: replicaSeed(), what: "replica: connect", fails: f);
    Result<Value, RedisError> r1 = callText(c: c, text: "GET ${a}");
    string o1 = callOutcome(r: r1);
    f = f + check(ok: isBulk(r: r1, text: "va"), what: "replica: a read goes to the slot's replica, READONLY in its handshake: ${o1}");
    Result<Value, RedisError> r2 = callText(c: c, text: "SET ${a} x");
    string o2 = callOutcome(r: r2);
    f = f + check(ok: isStatus(r: r2, text: "OK"), what: "replica: a write goes to the primary: ${o2}");
    Pipeline p = pipelineOf(texts: words2(a: "GET ${a}", b: "SET ${a} y"));
    string o3 = repliesOf(r: c.run(pipeline: p));
    f = f + check(ok: o3 == "va | OK", what: "replica: in a pipeline, each read at a replica and each write at the primary: ${o3}");

    // MASTERDOWN (a replica cut off from its primary, serving no stale data): the map read again, then the primary.
    Opens m = Opens.make();
    DynamicArray<Step> m0 = nodeReading();
    m0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots/3")));
    m0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots/3")));
    m.serve(place: "127.0.0.1:7000", script: give m0);
    DynamicArray<Step> m5 = nodeReading();
    m5.add(item: expect(command: "GET ${c3}", answer: topo(kase: "masterdown/3")));
    m.serve(place: "127.0.0.1:7005", script: give m5);
    DynamicArray<Step> m2 = nodeReading();
    m2.add(item: expect(command: "GET ${c3}", answer: reply(server: server(), kase: "get-hit/3")));
    m.serve(place: "127.0.0.1:7002", script: give m2);
    Cluster cm = clustered(o: give m, url: replicaSeed(), what: "replica masterdown: connect", fails: f);
    Result<Value, RedisError> r4 = callText(c: cm, text: "GET ${c3}");
    string o4 = callOutcome(r: r4);
    f = f + check(ok: isBulk(r: r4, text: "hello"), what: "replica: MASTERDOWN sends the read to the primary: ${o4}");

    // RESP2: READONLY is one of the path's steps; and a replica's link made again sends READONLY again.
    Opens t = Opens.make();
    DynamicArray<Step> t0 = steps();
    t0.add(item: expect(command: "READONLY", answer: topo(kase: "replica-readonly/2")));
    t0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots/2")));
    t.serve(place: "127.0.0.1:7000", script: give t0);
    DynamicArray<Dial> d3 = DynamicArray.empty();
    DynamicArray<Step> first = steps();
    first.add(item: expect(command: "READONLY", answer: topo(kase: "replica-readonly/2")));
    first.add(item: expect(command: "GET ${a}", answer: topo(kase: "replica-get-readonly/2")));
    first.add(item: Step::Hangup);
    d3.add(item: Dial::Serve(steps: give first));
    DynamicArray<Step> again = steps();
    again.add(item: expect(command: "READONLY", answer: topo(kase: "replica-readonly/2")));
    again.add(item: expect(command: "PING", answer: topo(kase: "ping-node/2")));
    again.add(item: expect(command: "GET ${a}", answer: topo(kase: "replica-get-readonly/2")));
    d3.add(item: Dial::Serve(steps: give again));
    t.each(place: "127.0.0.1:7003", dials: give d3);
    Cluster ct = clustered(o: give t, url: "redis://127.0.0.1:7000?connect_timeout=1&reconnect_timeout=1&read_from=replica&protocol=2", what: "replica resp2: connect", fails: f);
    Result<Value, RedisError> r5 = callText(c: ct, text: "GET ${a}");
    Result<Value, RedisError> r6 = callText(c: ct, text: "GET ${a}");
    string o6 = callOutcome(r: r6);
    f = f + check(ok: isBulk(r: r5, text: "va") && isBulk(r: r6, text: "va"), what: "replica: RESP2's READONLY, and again on a link made again: ${o6}");
    return f;
}

// A SCAN page: cursor `cursor`, the one key `key`.
fn DynamicArray<uint8> scanPage(const ref string cursor, const ref string key) {
    isize nc = cursor.length();
    isize nk = key.length();
    return bytesOf(text: "*2\r\n$${nc}\r\n${cursor}\r\n*1\r\n$${nk}\r\n${key}\r\n");
}

// SCAN on a cluster: every primary in turn, each from cursor 0 to its 0; a node whose link is made again mid-scan, or
// a key's slot that moves, ends it.
unsafe fn int32 clusterScanTests() {
    int32 f = 0;
    string a = keyAt(index: 0);
    string b = keyAt(index: 2);
    Opens o = Opens.make();
    DynamicArray<Step> s0 = seed(slots: "slots/3");
    s0.add(item: expect(command: "SCAN 0", answer: scanPage(cursor: "17", key: a)));
    s0.add(item: expect(command: "SCAN 17", answer: reply(server: server(), kase: "scan/3")));
    s0.add(item: expect(command: "SSCAN ${a} 0", answer: reply(server: server(), kase: "sscan/3")));
    o.serve(place: "127.0.0.1:7000", script: give s0);
    o.serve(place: "127.0.0.1:7001", script: answering(command: "SCAN 0", answer: reply(server: server(), kase: "scan/3")));
    o.serve(place: "127.0.0.1:7002", script: answering(command: "SCAN 0", answer: reply(server: server(), kase: "scan/3")));
    Cluster c = clustered(o: give o, url: oneSeed(), what: "scan: connect", fails: f);
    Scan keys = Scan.keys();
    isize pages = 0;
    bool failed = false;
    while (!keys.isDone() && pages < 10) {
        Result<Value, RedisError> page = keys.nextIn(cluster: c);
        bool ok = match (page) { case Ok(value: v): true; case Err(error: e): false; };
        if (!ok) { failed = true; break; }
        pages = pages + 1;
    }
    Result<Value, RedisError> after = keys.nextIn(cluster: c);
    string done = callOutcome(r: after);
    f = f + check(ok: !failed && pages == 4 && done.contains(substring: "every node answered cursor 0"), what: "scan: every primary in turn, two pages at 7000: ${pages} ${done}");
    Scan members = Scan.setMembers(key: a);
    Result<Value, RedisError> m1 = members.nextIn(cluster: c);
    string om = callOutcome(r: m1);
    f = f + check(ok: om == "ok" && members.isDone(), what: "scan: SSCAN at its key's node: ${om}");

    // 7000's link is lost after the first page: the cursor is not its new process's, and the scan ends.
    Opens l = Opens.make();
    DynamicArray<Dial> d0 = DynamicArray.empty();
    DynamicArray<Step> l0 = seed(slots: "slots/3");
    l0.add(item: expect(command: "SCAN 0", answer: scanPage(cursor: "17", key: a)));
    l0.add(item: Step::Hangup);
    d0.add(item: Dial::Serve(steps: give l0));
    DynamicArray<Step> l1 = thenPinged(script: node());
    l1.add(item: expect(command: "SCAN 17", answer: reply(server: server(), kase: "scan/3")));
    d0.add(item: Dial::Serve(steps: give l1));
    l.each(place: "127.0.0.1:7000", dials: give d0);
    Cluster cl = clustered(o: give l, url: oneSeed(), what: "scan lost: connect", fails: f);
    Scan lost = Scan.keys();
    Result<Value, RedisError> q1 = lost.nextIn(cluster: cl);
    Result<Value, RedisError> q2 = lost.nextIn(cluster: cl);
    string oq = callOutcome(r: q2);
    f = f + check(ok: callOutcome(r: q1) == "ok" && oq.contains(substring: "connected again"), what: "scan: a node's link made again mid-scan ends it: ${oq}");

    // A key's slot moves between pages (MOVED, followed to 7004): the cursor is not the new node's, and the scan ends.
    Opens v = Opens.make();
    v.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    DynamicArray<Step> v1 = answering(command: "SSCAN ${b} 0", answer: scanPage(cursor: "17", key: "m1"));
    v1.add(item: expect(command: "SSCAN ${b} 17", answer: topo(kase: "moved-after-failover/3")));
    v.serve(place: "127.0.0.1:7001", script: give v1);
    v.serve(place: "127.0.0.1:7004", script: answering(command: "SSCAN ${b} 17", answer: reply(server: server(), kase: "sscan/3")));
    Cluster cv = clustered(o: give v, url: oneSeed(), what: "scan moved: connect", fails: f);
    Scan set = Scan.setMembers(key: b);
    Result<Value, RedisError> w1 = set.nextIn(cluster: cv);
    Result<Value, RedisError> w2 = set.nextIn(cluster: cv);
    string ow = callOutcome(r: w2);
    f = f + check(ok: callOutcome(r: w1) == "ok" && ow.contains(substring: "slot moved"), what: "scan: a key's slot that moves mid-scan ends it: ${ow}");
    return f;
}

unsafe fn ClusterSubscriber subscribed(Opens o, const ref string what, ref int32 fails) {
    Opens taken = give o;
    Owned<Dialers> d = taken.dialers();
    Config c = configOf(url: oneSeed());
    Result<ClusterSubscriber, RedisError> r = ClusterSubscriber.connectWith(dialers: give d, config: c);
    return match (give r) {
        case Ok(value: x): give x;
        case Err(error: e): {
            string m = e.message();
            fails = fails + check(ok: false, what: "${what} (${m})");
            Opens again = Opens.make();
            again.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
            := subscribed(o: give again, what: what, fails: fails);
        }
    };
}

// A delivery as text: "message <channel> <payload>", "moved <channel> <host:port>", "reconnected", "unsubscribed
// <channel>", "none", or the error.
fn string deliveryOf(Result<Optional<Delivery>, RedisError> r) {
    return match (give r) {
        case Err(error: e): { string m = e.message(); := "(error) ${m}"; }
        case Ok(value: o): match (give o) {
            case None: "none";
            case Some(value: d): match (give d) {
                case Message(message: m): { string ch = textOf(b: m.channel()); string pl = textOf(b: m.payload()); := "message ${ch} ${pl}"; }
                case Moved(channel: c, to: n): { string ch = textOf(b: c.view()); string at = n.place(); := "moved ${ch} ${at}"; }
                case Reconnected(cause: e): "reconnected";
                case Unsubscribed(kind: k, channel: c): { string ch = textOf(b: c.view()); := "unsubscribed ${ch}"; }
                case _: "?";
            };
        };
    };
}

fn Optional<Duration> aSecond() { return Optional::Some(value: Duration.fromSecs(s: 1i64)); }

// Pub/sub on a cluster: channels at one primary, shard channels at their slots' primaries, every node's deliveries.
unsafe fn int32 clusterSubscriberTests() {
    int32 f = 0;
    string b = keyAt(index: 2);

    Opens o = Opens.make();
    o.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    DynamicArray<Step> s0 = answering(command: "SUBSCRIBE kr:c1", answer: reply(server: server(), kase: "sub-one/3"));
    s0.add(item: Step::Send(bytes: reply(server: server(), kase: "message/3")));
    o.serve(place: "127.0.0.1:7000", script: give s0);
    DynamicArray<Step> s1 = answering(command: "SSUBSCRIBE kr:s1", answer: reply(server: server(), kase: "ssub-one/3"));
    s1.add(item: Step::Send(bytes: reply(server: server(), kase: "smessage/3")));
    o.serve(place: "127.0.0.1:7001", script: give s1);
    ClusterSubscriber cs = subscribed(o: give o, what: "cluster subscriber: connect", fails: f);
    Result<Unit, RedisError> u1 = cs.subscribe(names: "kr:c1");
    Result<Unit, RedisError> u2 = cs.ssubscribe(names: "kr:s1");
    bool both = match (u1) { case Ok(value: x): match (u2) { case Ok(value: y): true; case Err(error: e): false; }; case Err(error: e): false; };
    f = f + check(ok: both && cs.channelCount() == 1 && cs.shardCount() == 1, what: "cluster subscriber: a channel at a primary, a shard channel at its slot's");
    string d1 = deliveryOf(r: cs.next(timeout: aSecond()));
    string d2 = deliveryOf(r: cs.next(timeout: aSecond()));
    f = f + check(ok: d1 == "message kr:c1 hello" && d2 == "message kr:s1 hello", what: "cluster subscriber: every node's messages: ${d1}; ${d2}");
    string d3 = deliveryOf(r: cs.next(timeout: Optional::Some(value: Duration.zero())));
    f = f + check(ok: d3 == "none", what: "cluster subscriber: nothing more, none: ${d3}");

    // The shard channel's slot moves (a failover: 7001's own sunsubscribe): followed to 7004, and Moved first.
    // The first reading of the map is behind (gossip has not reached 7000 yet): it is read again until it names 7004.
    Opens m = Opens.make();
    DynamicArray<Step> m0 = seed(slots: "slots/3");
    m0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots/3")));
    m0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots-after-failover/3")));
    m.serve(place: "127.0.0.1:7000", script: give m0);
    DynamicArray<Step> m1 = answering(command: "SSUBSCRIBE ${b}", answer: topo(kase: "ssub-shard/3"));
    m1.add(item: Step::Send(bytes: topo(kase: "sunsubscribe-failover/3")));
    m.serve(place: "127.0.0.1:7001", script: give m1);
    m.serve(place: "127.0.0.1:7004", script: answering(command: "SSUBSCRIBE ${b}", answer: topo(kase: "ssub-shard-moved/3")));
    ClusterSubscriber cm = subscribed(o: give m, what: "cluster subscriber moved: connect", fails: f);
    Result<Unit, RedisError> u3 = cm.ssubscribe(names: b);
    string mv = deliveryOf(r: cm.next(timeout: aSecond()));
    f = f + check(ok: mv == "moved ${b} 127.0.0.1:7004" && cm.shardCount() == 1, what: "cluster subscriber: a shard channel whose slot moved is followed: ${mv}");

    // The channels' node lost for good (its one redial refused): the map read again, the channels at another primary
    // (7000 will not open, 7001 does), and Reconnected.
    Opens l = Opens.make();
    DynamicArray<Step> l0 = seed(slots: "slots/3");
    l0.add(item: expect(command: "CLUSTER SLOTS", answer: topo(kase: "slots/3")));
    l.serve(place: "127.0.0.1:7000", script: give l0);
    DynamicArray<Step> l1 = answering(command: "SUBSCRIBE kr:c1", answer: reply(server: server(), kase: "sub-one/3"));
    l1.add(item: Step::Hangup);
    l.serve(place: "127.0.0.1:7000", script: give l1);
    l.refuse(place: "127.0.0.1:7000");
    DynamicArray<Step> l2 = answering(command: "SUBSCRIBE kr:c1", answer: reply(server: server(), kase: "sub-one/3"));
    l2.add(item: Step::Send(bytes: reply(server: server(), kase: "message/3")));
    l.serve(place: "127.0.0.1:7001", script: give l2);
    ClusterSubscriber cl = subscribed(o: give l, what: "cluster subscriber lost: connect", fails: f);
    Result<Unit, RedisError> u4 = cl.subscribe(names: "kr:c1");
    string g1 = deliveryOf(r: cl.next(timeout: aSecond()));
    // Reconnected means subscribed again, already: at 7001.
    isize placed = cl.channelCount();
    string g2 = deliveryOf(r: cl.next(timeout: aSecond()));
    f = f + check(ok: g1 == "reconnected" && placed == 1 && g2 == "message kr:c1 hello",
                  what: "cluster subscriber: a node lost for good, its channels at another primary: ${g1} (${placed} subscribed); ${g2}");

    // Nothing subscribed, nothing can come.
    Opens n = Opens.make();
    n.serve(place: "127.0.0.1:7000", script: seed(slots: "slots/3"));
    ClusterSubscriber cn = subscribed(o: give n, what: "cluster subscriber empty: connect", fails: f);
    string e1 = deliveryOf(r: cn.next(timeout: aSecond()));
    f = f + check(ok: e1.contains(substring: "nothing is subscribed"), what: "cluster subscriber: nothing subscribed is Usage: ${e1}");
    return f;
}

unsafe fn int32 clusterTests() {
    int32 f = 0;
    f = f + routingTests();
    f = f + redirectTests();
    f = f + waitTests();
    f = f + spreadTests();
    f = f + refusalTests();
    f = f + eachTests();
    f = f + connectTests();
    f = f + pipelineTests();
    f = f + transactionTests();
    f = f + watchedTests();
    f = f + replicaTests();
    f = f + clusterScanTests();
    f = f + clusterSubscriberTests();
    return f;
}
