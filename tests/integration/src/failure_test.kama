// Failures and sizes, live: a connection the server kills, errors by their codes, an error inside EXEC's reply, and
// replies large in bytes and in elements.
import { std::collections::DynamicArray, std::collections::Map, std::time::Duration, std::time::sleep, redis::Connection, redis::Command, redis::RedisError, redis::ServerInfo,
         redis::reply, redis::resp::Value, redis_integration_tests::check, redis_integration_tests::setting, mainUrl, open, attempt, ask, commandOf, codeOf, shown };
export { failureTests };

unsafe fn Connection connected(const ref string what) {
    Result<Connection, RedisError> r = open(url: mainUrl(userinfo: "", tail: ""));
    Connection c = match (give r) {
        case Ok(value: v): give v;
        case Err(error: e): { string m = e.message(); panic(msg: "failure_test: ${what}: ${m}"); return connected(what: what); }
    };
    return give c;
}

unsafe fn int32 failureTests() {
    int32 f = 0;

    // A connection the server kills. A call that has already written meets the loss as an I/O error; one made after
    // the close has come finds it before it writes (step 6). Right after the kill either can happen. Either way the
    // connection comes back, as a new client, and nothing is sent twice.
    Connection victim = connected(what: "victim");
    int64 id = match (victim.server()) { case Some(value: v): v.id(); case None: -1i64; };
    Connection killer = connected(what: "killer");
    string killed = ask(c: killer, text: "CLIENT KILL ID ${id}");
    Command ping = Command.of(name: "PING");
    Result<Value, RedisError> after = victim.call(command: ping);
    bool io = match (after) { case Err(error: e): match (e) { case Io(error: x): true; case _: false; }; case Ok(value: v): false; };
    bool answered = match (after) { case Ok(value: v): true; case Err(error: e): false; };
    bool lostNotClosed = !victim.isClosed();
    string next = ask(c: victim, text: "PING");
    int64 newId = match (victim.server()) { case Some(value: v): v.id(); case None: -1i64; };
    f = f + check(ok: killed == "1" && (io || answered) && lostNotClosed && next == "PONG" && newId != id,
                  what: "failure: CLIENT KILL: ${killed}, then an I/O error or nothing, then a new client: ${next}, id ${id} -> ${newId}");

    // What select and authenticate set outlives the redial.
    string aclPw = setting(name: "REDISTEST_ACL_PASSWORD");
    Connection kept = connected(what: "kept");
    Result<Unit, RedisError> chose = kept.select(db: 5);
    Result<Unit, RedisError> became = kept.authenticate(user: Optional::Some(value: "kr_acl"), password: copy aclPw);
    int64 keptId = match (kept.server()) { case Some(value: v): v.id(); case None: -1i64; };
    string killedKept = ask(c: killer, text: "CLIENT KILL ID ${keptId}");
    string lostKept = ask(c: kept, text: "PING");
    string info = ask(c: kept, text: "CLIENT INFO");
    int64 keptNewId = match (kept.server()) { case Some(value: v): v.id(); case None: -1i64; };
    f = f + check(ok: killedKept == "1" && keptNewId != keptId && info.contains(substring: " db=5 ") && info.contains(substring: " user=kr_acl "),
                  what: "failure: CLIENT KILL after select(db: 5) and authenticate(kr_acl): the redial is both: ${info}");

    // A server with no room left refuses a connection as it accepts it, then closes: each connect is that refusal, in
    // the server's words, whatever the handshake had sent. maxclients is put back however it went.
    string aclPassword = copy aclPw;
    Connection admin = connected(what: "maxclients");
    Command getLimit = commandOf(text: "CONFIG GET maxclients");
    Result<Map<string, int64>, RedisError> limits = reply::<Map<string, int64>>(result: admin.call(command: getLimit));
    int64 was = match (limits) { case Ok(value: m): match (m.get(key: "maxclients")) { case Some(value: n): n; case None: -1i64; }; case Err(error: e): -1i64; };
    string lowered = ask(c: admin, text: "CONFIG SET maxclients 1");
    string full3 = attempt(url: mainUrl(userinfo: "", tail: ""));
    string full2 = attempt(url: mainUrl(userinfo: "", tail: "?protocol=2"));
    string fullAuth = attempt(url: mainUrl(userinfo: "kr_acl:${aclPassword}@", tail: "/1?client_name=kama-test"));
    string restored = ask(c: admin, text: "CONFIG SET maxclients ${was}");
    string refusal = "ERR max number of clients reached";
    f = f + check(ok: was > 1i64 && lowered == "OK" && full3 == refusal && full2 == refusal && fullAuth == refusal && restored == "OK",
                  what: "failure: maxclients: the refusal is the connect's error (${was}, ${lowered}): ${full3} / ${full2} / ${fullAuth}; put back: ${restored}");

    // Errors by their codes; the connection goes on after each.
    Connection c = connected(what: "codes");
    string setS = ask(c: c, text: "SET kr:string v");
    f = f + check(ok: codeOf(c: c, text: "LPUSH kr:string x") == "WRONGTYPE", what: "failure: WRONGTYPE");
    f = f + check(ok: codeOf(c: c, text: "NOSUCHCOMMAND") == "ERR", what: "failure: ERR for an unknown command");
    f = f + check(ok: codeOf(c: c, text: "EVALSHA ffffffffffffffffffffffffffffffffffffffff 0") == "NOSCRIPT", what: "failure: NOSCRIPT");
    // MULTI is refused before it is sent (transact sends a transaction whole), so the SET after it runs at once: OK,
    // not QUEUED. EXECABORT is in transaction_test.kama.
    string multi = ask(c: c, text: "MULTI");
    string direct = ask(c: c, text: "SET kr:direct v");
    f = f + check(ok: multi.startsWith(prefix: "(failed) a connection does not carry MULTI") && direct == "OK", what: "failure: MULTI is refused before it is sent: ${multi}; then SET: ${direct}");
    string created = ask(c: c, text: "XGROUP CREATE kr:stream g $ MKSTREAM");
    f = f + check(ok: codeOf(c: c, text: "XGROUP CREATE kr:stream g $ MKSTREAM") == "BUSYGROUP", what: "failure: BUSYGROUP");
    f = f + check(ok: codeOf(c: c, text: "XREADGROUP GROUP nog c STREAMS kr:stream >") == "NOGROUP", what: "failure: NOGROUP");
    string still = ask(c: c, text: "PING");
    f = f + check(ok: still == "PONG" && !c.isClosed(), what: "failure: the connection goes on after error replies");

    // A command a connection does not carry is refused before it is sent: the server never sees the SUBSCRIBE, so
    // the connection is not in subscriber mode and answers PING as usual.
    string sub = ask(c: c, text: "subscribe kr:chan");
    string unsubscribed = ask(c: c, text: "PING");
    f = f + check(ok: sub.startsWith(prefix: "(failed) a connection does not carry pub/sub") && unsubscribed == "PONG" && !c.isClosed(),
                  what: "failure: SUBSCRIBE is refused before it is sent: ${sub}, then ${unsubscribed}");

    // An error inside a reply stays a value there: redis.pcall's, inside EVAL's array.
    string s1 = ask(c: c, text: "SET kr:exec v");
    Command eval = Command.of(name: "EVAL");
    eval.arg(text: "return {1, redis.pcall('LPUSH', KEYS[1], 'x')}");
    eval.arg(text: "1");
    eval.arg(text: "kr:exec");
    Result<Value, RedisError> evalled = c.call(command: eval);
    string inside = match (evalled) { case Ok(value: v): shown(v: v); case Err(error: e): e.message(); };
    f = f + check(ok: inside.startsWith(prefix: "[1, (error) WRONGTYPE "), what: "failure: an error inside a reply stays inside its array: ${inside}");

    // 10 MiB in one bulk string, both ways.
    DynamicArray<uint8> big = DynamicArray.withCapacity(capacity: 10485760);
    isize i = 0;
    while (i < 10485760) { big.add(item: truncate<uint8>(i * 7 + i / 4096)); i = i + 1; }
    Command set = Command.of(name: "SET");
    set.arg(text: "kr:big");
    set.argBytes(bytes: big.view());
    Result<Value, RedisError> stored = c.call(command: set);
    bool ok = match (stored) { case Ok(value: v): match (v) { case Simple(bytes: b): b.length() == 2; case _: false; }; case Err(error: e): false; };
    Command get = Command.of(name: "GET");
    get.arg(text: "kr:big");
    Result<Value, RedisError> fetched = c.call(command: get);
    bool same = match (fetched) {
        case Ok(value: v): match (v) { case Bulk(bytes: b): sameBytes(a: b, b2: big); case _: false; };
        case Err(error: e): false;
    };
    f = f + check(ok: ok && same, what: "failure: a 10 MiB value round trip");

    // 100,000 elements in one reply.
    string cleared = ask(c: c, text: "DEL kr:list");
    int32 batch = 0;
    while (batch < 100) {
        Command push = Command.of(name: "RPUSH");
        push.arg(text: "kr:list");
        int32 k = 0;
        while (k < 1000) { push.argInt(value: cast<int64>(batch * 1000 + k)); k = k + 1; }
        Result<Value, RedisError> pushed = c.call(command: push);
        batch = batch + 1;
    }
    Command range = Command.of(name: "LRANGE");
    range.arg(text: "kr:list");
    range.argInt(value: 0i64);
    range.argInt(value: -1i64);
    Result<Value, RedisError> all = c.call(command: range);
    isize count = match (all) { case Ok(value: v): match (v) { case Array(items: xs): xs.length(); case _: -1; }; case Err(error: e): -1; };
    f = f + check(ok: count == 100000, what: "failure: an LRANGE of 100,000 elements: ${count}");

    // A connection killed while it sat idle: the next call finds the close before it writes, makes the connection
    // again and is answered, with no error. (The wait lets the close come through the container's port forwarder.)
    Connection idle = connected(what: "idle victim");
    int64 idleId = match (idle.server()) { case Some(value: v): v.id(); case None: -1i64; };
    Connection killer2 = connected(what: "killer 2");
    string killedIdle = ask(c: killer2, text: "CLIENT KILL ID ${idleId}");
    sleep(d: Duration.fromMillis(ms: 300i64));
    string unseen = ask(c: idle, text: "PING");
    int64 idleNewId = match (idle.server()) { case Some(value: v): v.id(); case None: -1i64; };
    f = f + check(ok: killedIdle == "1" && unseen == "PONG" && idleNewId != idleId,
                  what: "failure: CLIENT KILL while idle, then a call that never sees it: ${unseen}, id ${idleId} -> ${idleNewId}");

    // The server's idle timeout (timeout 1) closes a connection that waits 2.5 s: its next call never sees it either.
    // The setting is put back however it went.
    string shortened = ask(c: killer2, text: "CONFIG SET timeout 1");
    Connection sleeper = connected(what: "sleeper");
    int64 sleeperId = match (sleeper.server()) { case Some(value: v): v.id(); case None: -1i64; };
    sleep(d: Duration.fromMillis(ms: 2500i64));
    string woke = ask(c: sleeper, text: "PING");
    int64 sleeperNewId = match (sleeper.server()) { case Some(value: v): v.id(); case None: -1i64; };
    string untimed = ask(c: killer2, text: "CONFIG SET timeout 0");
    f = f + check(ok: shortened == "OK" && woke == "PONG" && sleeperNewId != sleeperId && untimed == "OK",
                  what: "failure: the server's idle timeout, then a call that never sees it: ${woke}, id ${sleeperId} -> ${sleeperNewId}; put back: ${untimed}");
    return f;
}

fn bool sameBytes(const ref DynamicArray<uint8> a, const ref DynamicArray<uint8> b2) {
    if (a.length() != b2.length()) { return false; }
    isize i = 0;
    while (i < a.length()) {
        if (a[i] != b2[i]) { return false; }
        i = i + 1;
    }
    return true;
}
