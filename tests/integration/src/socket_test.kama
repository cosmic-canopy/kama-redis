// Unix-domain sockets, live. The server runs in a container whose socket a macOS host cannot reach, so the test
// listens on a socket of its own and relays each connection to the server's TCP port (as @kama/postgres's
// socket_test does): the client runs its real Unix transport against a real server.
import { std::collections::FixedArray, std::collections::View, std::io::IoError, std::net::UnixListener,
         std::net::UnixStream, std::net::TcpStream, std::net::Poller, std::net::Interest,
         std::concurrent::Channel, std::concurrent::Sender, std::concurrent::Receiver, std::concurrent::Undelivered,
         redis::Connection, redis::RedisError, redis_integration_tests::check, redis_integration_tests::setting,
         open, attempt, ask };
export { socketTests };

// Copy what one side has to the other: false once the side read from has closed or failed.
unsafe fn bool forward(ref UnixStream unix, ref TcpStream tcp, bool fromUnix, View<uint8> buf, isize toFd) {
    Result<isize, IoError> r = Result::Ok(value: 0);
    if (fromUnix) { r = unix.read(into: buf); } else { r = tcp.read(into: buf); }
    isize n = 0;
    match (r) {
        case Ok(value: k): { n = k; }
        case Err(error: e): { match (e.kind()) { case WouldBlock: { return true; } case _: { return false; } }; }
    };
    if (n <= 0) { return false; }
    Result<Poller, IoError> made = Poller.create();
    Poller waiter = match (give made) { case Ok(value: p): give p; case Err(error: e): { return false; } };
    waiter.add(fd: toFd, interest: Interest::Write);
    isize sent = 0;
    while (sent < n) {
        Result<isize, IoError> w = Result::Ok(value: 0);
        if (fromUnix) { w = tcp.write(bytes: buf.slice(from: sent, count: n - sent)); } else { w = unix.write(bytes: buf.slice(from: sent, count: n - sent)); }
        isize m = 0;
        match (w) {
            case Ok(value: k): { m = k; }
            case Err(error: e): { match (e.kind()) { case WouldBlock: { m = 0; } case _: { return false; } }; }
        };
        if (m == 0) { Result<int32, IoError> ready = waiter.wait(timeoutMs: 5000); }
        sent = sent + m;
    }
    return true;
}

// Relay one connection until either side closes.
unsafe fn void pump(UnixStream unix, TcpStream tcp) {
    Result<Unit, IoError> a = unix.setNonBlocking(on: true);
    Result<Unit, IoError> b = tcp.setNonBlocking(on: true);
    Result<Poller, IoError> made = Poller.create();
    Poller p = match (give made) { case Ok(value: x): give x; case Err(error: e): { return; } };
    isize uf = unix.rawHandle();
    isize tf = tcp.rawHandle();
    p.add(fd: uf, interest: Interest::Read);
    p.add(fd: tf, interest: Interest::Read);
    FixedArray<uint8> buf = FixedArray.make(size: 65536);
    bool live = true;
    while (live) {
        Result<int32, IoError> waited = p.wait(timeoutMs: 30000);
        int32 n = match (waited) { case Ok(value: k): k; case Err(error: e): 0; };
        if (n == 0) { live = false; }
        if (live && p.readyFor(fd: uf).readable) { live = forward(unix: ref unix, tcp: ref tcp, fromUnix: true, buf: buf.viewMut(), toFd: tf); }
        if (live && p.readyFor(fd: tf).readable) { live = forward(unix: ref unix, tcp: ref tcp, fromUnix: false, buf: buf.viewMut(), toFd: uf); }
    }
}

type resource Relay implements Sendable {
    UnixListener listener;
    string host;
    uint16 port = 0ui16;
    int32 count = 0;
    Sender<int32> done;
    public ctor make(UnixListener listener, string host, uint16 port, int32 count, Sender<int32> done) {
        this.listener = give listener; this.host = give host; this.port = port; this.count = count; this.done = give done;
    }
    // Relay `count` connections, one after another, then report how many arrived. A connection that never comes
    // ends the relay after 10 seconds, so a failing test cannot hang the run.
    public unsafe fn void run() {
        Result<Unit, IoError> nb = this.listener.setNonBlocking(on: true);
        Result<Poller, IoError> made = Poller.create();
        Poller p = match (give made) { case Ok(value: x): give x; case Err(error: e): { Result<Unit, Undelivered<int32>> r = this.done.send(item: -1); return; } };
        p.add(fd: this.listener.rawHandle(), interest: Interest::Read);
        int32 served = 0;
        bool waiting = true;
        while (served < this.count && waiting) {
            Result<int32, IoError> w = p.wait(timeoutMs: 10000);
            int32 ready = match (w) { case Ok(value: k): k; case Err(error: e): 0; };
            if (ready == 0) { waiting = false; continue; }
            Result<UnixStream, IoError> accepted = this.listener.accept();
            match (give accepted) {
                case Ok(value: client): {
                    Result<TcpStream, IoError> upstream = TcpStream.connect(host: this.host, port: this.port);
                    match (give upstream) {
                        case Ok(value: server): { pump(unix: give client, tcp: give server); }
                        case Err(error: e): { UnixStream unanswered = give client; }
                    };
                    served = served + 1;
                }
                case Err(error: e): { }
            };
        }
        Result<Unit, Undelivered<int32>> r = this.done.send(item: served);
    }
}

fn void relay(Relay job) { job.run(); }

// What a connection over the socket says to `command`, or why it could not be made.
unsafe fn string through(const ref string url, const ref string command) {
    Result<Connection, RedisError> r = open(url: url);
    Connection c = match (give r) { case Ok(value: v): give v; case Err(error: e): { return e.message(); } };
    string answer = ask(c: c, text: command);
    c.close();
    return answer;
}

unsafe fn int32 socketTests() {
    int32 f = 0;
    string dir = setting(name: "REDISTEST_SOCKDIR");
    string host = setting(name: "REDISTEST_HOST");
    string port = setting(name: "REDISTEST_PORT");
    string pw = setting(name: "REDISTEST_ACL_PASSWORD");
    string path = dir.concat(other: "/redis.sock");
    Result<UnixListener, IoError> bound = UnixListener.bind(path: path);
    UnixListener listener = match (give bound) { case Ok(value: l): give l; case Err(error: e): { return check(ok: false, what: "socket: bind ".concat(other: path)); } };
    uint16 portNumber = 0ui16;
    foreach (uint8 b in port) { portNumber = portNumber * 10ui16 + cast<uint16>(b - 48ui8); }

    Channel<int32> results = Channel.bounded(capacity: 1);
    Receiver<int32> rx = results.receiver();
    Relay job = Relay.make(listener: give listener, host: copy host, port: portNumber, count: 2, done: results.sender());
    string plain = "";
    string authed = "";
    scope {
        spawn relay(job: give job);
        plain = through(url: "unix://".concat(other: path).concat(other: "?db=2"), command: "CLIENT INFO");
        authed = through(url: "unix://kr_acl:".concat(other: pw).concat(other: "@").concat(other: path).concat(other: "?protocol=2"), command: "ACL WHOAMI");
    }
    Optional<int32> served = rx.recv();
    f = f + check(ok: plain.contains(substring: " db=2 "), what: "socket: unix:// with ?db=2: ${plain}");
    f = f + check(ok: authed == "kr_acl", what: "socket: unix:// with a user, under protocol=2: ${authed}");
    f = f + check(ok: match (served) { case Some(value: n): n == 2; case None: false; }, what: "socket: both connections went through the socket");

    // No server at the path.
    string missing = dir.concat(other: "/nowhere.sock");
    string none = attempt(url: "unix://".concat(other: missing));
    string want = "Could not connect to ".concat(other: missing).concat(other: ": No such file or directory");
    f = f + check(ok: none == want, what: "socket: no server at the path: ${none}");
    return f;
}
