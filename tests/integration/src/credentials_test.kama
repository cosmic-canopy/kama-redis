// A credentials provider, live (docs/ROADMAP.md, "Phase 7b", step 2): a user made for the test (kr_rot) whose
// passwords change under a connection. The server keeps a connection logged in as it was whatever its user's
// passwords become (ACL SETUSER resetpass or off leave it running), so these show what the client does: it logs in
// anew when its login's time comes, makes its link again with the provider's newest login, and closes a connection
// whose new login the server refuses rather than run on as the old one.
import { std::collections::DynamicArray, std::memory::Owned, std::time::Duration, std::time::sleep,
         redis::Connection, redis::Config, redis::Cluster, redis::Command, redis::RedisError, redis::Credentials,
         redis::Login, redis::resp::Value,
         redis_integration_tests::check, redis_integration_tests::setting, open, ask, commandOf, shown, mainUrl };
export { credentialsTests };

// What a test's provider answers, in turn; past the last, the last again: kr_rot's login, another user's, or a failure.
type enum Answer implements Sendable { Give(string password, int64 refreshMs), GiveAs(string user, string password), Fail(string why) }

// A provider that answers logins from a script. A fork answers the same script from its start.
type resource TurnCredentials implements Credentials, Sendable {
    DynamicArray<Answer> turns;
    isize at = 0;

    public ctor make(DynamicArray<Answer> turns) { this.turns = give turns; }

    public unsafe fn Result<Login, RedisError> login() {
        isize i = this.at;
        if (i < this.turns.length() - 1) { this.at = this.at + 1; } else { i = this.turns.length() - 1; }
        return match (this.turns[i]) {
            case Give(password: p, refreshMs: r): {
                Optional<Duration> after = Optional::None;
                if (r > 0i64) { after = Optional::Some(value: Duration.fromMillis(ms: r)); }
                := Login.of(user: Optional::Some(value: "kr_rot"), password: copy p, refreshAfter: after);
            }
            case GiveAs(user: u, password: p): Login.of(user: Optional::Some(value: copy u), password: copy p, refreshAfter: Optional::None);
            case Fail(why: w): Result::Err(error: RedisError::Config(detail: copy w));
        };
    }

    public unsafe fn Owned<Credentials> fork() {
        Owned<Credentials> o = new TurnCredentials.make(turns: copy this.turns);
        return give o;
    }
}

fn DynamicArray<Answer> noTurns() { return DynamicArray.empty(); }

unsafe fn Result<Config, RedisError> providing(const ref string url, DynamicArray<Answer> answers) {
    Result<Config, RedisError> parsed = Config.parse(url: url);
    Config c = match (give parsed) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
    Owned<Credentials> p = new TurnCredentials.make(turns: give answers);
    Result<Unit, RedisError> set = c.setCredentials(provider: give p);
    match (give set) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
    return Result::Ok(value: give c);
}

unsafe fn Result<Connection, RedisError> loggedIn(const ref string url, DynamicArray<Answer> answers) {
    Result<Config, RedisError> c = providing(url: url, answers: give answers);
    Config config = match (give c) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
    return Connection.connect(config: config);
}

// A call's outcome: its reply shown, "credentials server: <code>", "credentials provider: <why>", "reconnect: <why>",
// or "(failed) <message>".
unsafe fn string tried(ref Connection c, const ref string text) {
    Command command = commandOf(text: text);
    Result<Value, RedisError> r = c.call(command: command);
    return match (r) {
        case Ok(value: v): shown(v: v);
        case Err(error: e): match (e) {
            case Credentials(error: x): x.byServer() ? "credentials server: ".concat(other: codeOf(e: x.cause())) : "credentials provider: ".concat(other: x.cause().message());
            case Reconnect(error: x): "reconnect: ".concat(other: codeOf(e: x.cause()));
            case _: "(failed) ".concat(other: e.message());
        };
    };
}

fn string codeOf(const ref RedisError e) { return match (e) { case Server(error: s): s.codeText(); case _: e.message(); }; }

// How many clients of the server are logged in as kr_rot, from CLIENT LIST.
unsafe fn isize rotClients(ref Connection admin) {
    string list = ask(c: admin, text: "CLIENT LIST");
    isize n = 0;
    isize i = 0;
    string word = "user=kr_rot ";
    while (i + word.length() <= list.length()) {
        if (list.substring(start: i, end: i + word.length()) == word) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

unsafe fn void wait(int64 ms) { sleep(d: Duration.fromMillis(ms: ms)); }

// kr_rot's clients once they number `want`, or after two seconds: a client's close reaches the server's event loop a
// moment after the client makes it.
unsafe fn isize settledClients(ref Connection admin, isize want) {
    isize n = rotClients(admin: admin);
    isize tries = 0;
    while (n != want && tries < 40) { wait(ms: 50i64); n = rotClients(admin: admin); tries = tries + 1; }
    return n;
}

unsafe fn int32 standaloneTests() {
    int32 f = 0;
    string url = mainUrl(userinfo: "", tail: "");
    Result<Connection, RedisError> a = open(url: url);
    Connection admin = match (give a) { case Ok(value: c): give c; case Err(error: e): { string m = e.message(); return check(ok: false, what: "credentials: admin: ${m}"); } };

    // Rotation: the provider's first login is kr_rot's, its next kr_rot2's, so ACL WHOAMI shows when the connection
    // logged in anew. The login's time comes and the connection logs in as kr_rot2; the client is then killed, and the
    // redial logs in with the provider's newest login, kr_rot2's.
    string made = ask(c: admin, text: "ACL DELUSER kr_rot kr_rot2");
    string set = ask(c: admin, text: "ACL SETUSER kr_rot on >pw1 ~* &* +@all");
    string set2 = ask(c: admin, text: "ACL SETUSER kr_rot2 on >pw2 ~* &* +@all");
    DynamicArray<Answer> t1 = noTurns();
    t1.add(item: Answer::Give(password: "pw1", refreshMs: 300i64));
    t1.add(item: Answer::GiveAs(user: "kr_rot2", password: "pw2"));
    Result<Connection, RedisError> r1 = loggedIn(url: url, answers: give t1);
    match (give r1) {
        case Ok(value: c): {
            Connection k = give c;
            string who = tried(c: k, text: "ACL WHOAMI");
            wait(ms: 600i64);
            string renewed = tried(c: k, text: "ACL WHOAMI");
            string killed = ask(c: admin, text: "CLIENT KILL USER kr_rot2");
            string first = tried(c: k, text: "ACL WHOAMI");
            string back = tried(c: k, text: "ACL WHOAMI");
            f = f + check(ok: set == "OK" && set2 == "OK" && who == "kr_rot" && renewed == "kr_rot2" && killed == "1"
                              && (first == "kr_rot2" || first.startsWith(prefix: "(failed) ")) && back == "kr_rot2",
                          what: "credentials: a login renewed when its time comes, and the redial after a kill logs in with the newest (${who}; ${renewed}; ${killed}; ${first}; ${back})");
        }
        case Err(error: e): { string m = e.message(); f = f + check(ok: false, what: "credentials: rotation: connect: ${m}"); }
    };

    // Revocation: the provider's next login is one the server refuses. The call fails unsent and the connection is
    // closed (the server would have kept it as kr_rot); the next call's redial is refused too.
    string reset = ask(c: admin, text: "ACL SETUSER kr_rot resetpass >pw1");
    DynamicArray<Answer> t2 = noTurns();
    t2.add(item: Answer::Give(password: "pw1", refreshMs: 300i64));
    t2.add(item: Answer::Give(password: "revoked", refreshMs: 0i64));
    Result<Connection, RedisError> r2 = loggedIn(url: url, answers: give t2);
    match (give r2) {
        case Ok(value: c): {
            Connection k = give c;
            string who = tried(c: k, text: "ACL WHOAMI");
            isize before = settledClients(admin: admin, want: 1);
            wait(ms: 600i64);
            string refused = tried(c: k, text: "ACL WHOAMI");
            isize after = settledClients(admin: admin, want: 0);
            string again = tried(c: k, text: "ACL WHOAMI");
            f = f + check(ok: reset == "OK" && who == "kr_rot" && before == 1 && refused == "credentials server: WRONGPASS" && after == 0
                              && again == "reconnect: WRONGPASS",
                          what: "credentials: a refused login closes the connection rather than run on as the old one (${refused}; ${before} then ${after} kr_rot clients; ${again})");
        }
        case Err(error: e): { string m = e.message(); f = f + check(ok: false, what: "credentials: revocation: connect: ${m}"); }
    };

    // The provider failing when the login's time comes: the same, its own error the cause.
    DynamicArray<Answer> t3 = noTurns();
    t3.add(item: Answer::Give(password: "pw1", refreshMs: 300i64));
    t3.add(item: Answer::Fail(why: "token service down"));
    Result<Connection, RedisError> r3 = loggedIn(url: url, answers: give t3);
    match (give r3) {
        case Ok(value: c): {
            Connection k = give c;
            string who = tried(c: k, text: "ACL WHOAMI");
            wait(ms: 600i64);
            string failed = tried(c: k, text: "ACL WHOAMI");
            isize after = settledClients(admin: admin, want: 0);
            f = f + check(ok: who == "kr_rot" && failed == "credentials provider: token service down" && after == 0,
                          what: "credentials: a provider failing when the login's time comes closes the connection (${failed}; ${after} kr_rot clients)");
        }
        case Err(error: e): { string m = e.message(); f = f + check(ok: false, what: "credentials: provider failing: connect: ${m}"); }
    };
    string gone = ask(c: admin, text: "ACL DELUSER kr_rot kr_rot2");
    return f;
}

// A cluster: kr_rot made on every node (ACL SETUSER goes to all nodes), and each node's connection logs in with the
// provider's login.
unsafe fn int32 clusterTests() {
    int32 f = 0;
    string url = setting(name: "REDISTEST_CLUSTER_URL").concat(other: "?connect_timeout=2&reconnect_timeout=5");
    Result<Config, RedisError> ac = Config.parse(url: url);
    Config adminConfig = match (give ac) { case Ok(value: v): give v; case Err(error: e): { string m = e.message(); return check(ok: false, what: "credentials: cluster admin: ${m}"); } };
    Result<Cluster, RedisError> ar = Cluster.connect(config: adminConfig);
    Cluster admin = match (give ar) { case Ok(value: c): give c; case Err(error: e): { string m = e.message(); return check(ok: false, what: "credentials: cluster admin: ${m}"); } };
    Command make = commandOf(text: "ACL SETUSER kr_rot on resetpass >pw1 ~* &* +@all");
    Result<Value, RedisError> made = admin.call(command: make);
    string m1 = match (made) { case Ok(value: v): shown(v: v); case Err(error: e): e.message(); };
    DynamicArray<Answer> t = noTurns();
    t.add(item: Answer::Give(password: "pw1", refreshMs: 0i64));
    Result<Config, RedisError> pc = providing(url: url, answers: give t);
    Config config = match (give pc) { case Ok(value: v): give v; case Err(error: e): { string m = e.message(); return check(ok: false, what: "credentials: cluster: ${m}"); } };
    Result<Cluster, RedisError> cr = Cluster.connect(config: config);
    match (give cr) {
        case Ok(value: c): {
            Cluster k = give c;
            // Keys in each of the three shards (cluster_test.kama's keysPerShard puts kr:{a}… where it wants; any three
            // keys of different slots will do here, since a wrong login fails whichever node it meets).
            isize ok = 0;
            isize i = 0;
            while (i < 30) {
                Command set = Command.of(name: "SET");
                set.arg(text: "kr:cred:${i}");
                set.arg(text: "v");
                Result<Value, RedisError> r = k.call(command: set);
                match (r) { case Ok(value: v): { ok = ok + 1; } case Err(error: e): { } };
                i = i + 1;
            }
            f = f + check(ok: m1 == "OK" && ok == 30, what: "credentials: every node of a cluster logs in with the provider's login (${m1}; ${ok} of 30 writes)");
        }
        case Err(error: e): { string m = e.message(); f = f + check(ok: false, what: "credentials: cluster: connect: ${m}"); }
    };
    Command undo = commandOf(text: "ACL DELUSER kr_rot");
    Result<Value, RedisError> dropped = admin.call(command: undo);
    return f;
}

// Through sentinels: the sentinels are asked with their own login (none, on the plain group), and the master they name
// is logged in to with the provider's.
unsafe fn int32 sentinelTests() {
    int32 f = 0;
    string url = setting(name: "REDISTEST_SENTINEL_URL").concat(other: "&connect_timeout=2&reconnect_timeout=5");
    Result<Connection, RedisError> a = open(url: url);
    Connection admin = match (give a) { case Ok(value: c): give c; case Err(error: e): { string m = e.message(); return check(ok: false, what: "credentials: sentinel admin: ${m}"); } };
    string made = ask(c: admin, text: "ACL SETUSER kr_rot on resetpass >pw1 ~* &* +@all");
    DynamicArray<Answer> t = noTurns();
    t.add(item: Answer::Give(password: "pw1", refreshMs: 0i64));
    Result<Connection, RedisError> r = loggedIn(url: url, answers: give t);
    match (give r) {
        case Ok(value: c): {
            Connection k = give c;
            string who = tried(c: k, text: "ACL WHOAMI");
            f = f + check(ok: made == "OK" && who == "kr_rot", what: "credentials: through sentinels, the master is logged in to with the provider's login (${made}; ${who})");
        }
        case Err(error: e): { string m = e.message(); f = f + check(ok: false, what: "credentials: sentinel: connect: ${m}"); }
    };
    string gone = ask(c: admin, text: "ACL DELUSER kr_rot");
    return f;
}

unsafe fn int32 credentialsTests() {
    int32 f = 0;
    f = f + standaloneTests();
    f = f + clusterTests();
    f = f + sentinelTests();
    return f;
}
