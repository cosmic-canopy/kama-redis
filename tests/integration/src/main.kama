// The live tests: one program, run against each server in the matrix by tools/test-integration.sh, which starts the
// server (tools/redis.sh) and exports its REDISTEST_* settings. A failing case prints its name. When cases fail, run
// `tools/redis.sh smoke --server S` first: it tells a misconfigured server from a wrong client.
import { core::println, core::env, flush, connectTests, authTests, socketTests, timeoutTests, failureTests, argTests, replyTests, pipelineTests, transactionTests, scriptTests, scanTests, subscriberTests, tlsTests, restartTests, sentinelTests, clusterTests };
export { check, setting, stop };

fn int32 check(bool ok, string what) {
    if (!ok) { println(s: "  FAIL ${what}"); return 1; }
    return 0;
}

// A value of type T that is never made: the program stops here, saying `msg`. A `match` arm that cannot go on ends
// with it (`:= stop::<T>(msg: …)`, or `return stop::<R>(…)`), since no compiler of both kinds takes an arm that ends in
// `panic` (KRD-12).
fn T stop<T>(const ref string msg) {
    panic(msg: msg);
}

// A REDISTEST_* setting the runner exports; the program cannot run without them.
unsafe fn string setting(string name) {
    Optional<string> v = env(name: copy name);
    return match (give v) {
        case Some(value: s): give s;
        case None: { return stop::<string>(msg: "REDISTEST settings are missing: run tools/test-integration.sh, or source out/redistest-<server>.env"); }
    };
}

fn int32 main() {
    int32 failed = flush();
    failed = failed + connectTests();
    failed = failed + authTests();
    failed = failed + socketTests();
    failed = failed + timeoutTests();
    failed = failed + failureTests();
    failed = failed + argTests();
    failed = failed + replyTests();
    failed = failed + pipelineTests();
    failed = failed + transactionTests();
    failed = failed + scriptTests();
    failed = failed + scanTests();
    failed = failed + subscriberTests();
    failed = failed + tlsTests();
    // Through sentinels, on the sentinel topology's containers (tools/redis.sh --topology sentinel).
    failed = failed + sentinelTests();
    // A cluster, on the cluster topology's containers (tools/redis.sh --topology cluster).
    failed = failed + clusterTests();
    // Last: each restart loses every other connection to the server.
    failed = failed + restartTests();
    string server = setting(name: "REDISTEST_SERVER");
    if (failed != 0) { println(s: "redis integration tests on ${server}: ${failed} failed"); return 1; }
    println(s: "redis integration tests on ${server}: OK");
    return 0;
}
