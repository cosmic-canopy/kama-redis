import { std::collections::DynamicArray, std::collections::Deque, std::io::IoError, std::io::IoErrorKind, std::memory::Owned, std::memory::replace,
         std::net::SocketAddr, std::net::resolve, std::time::Duration, std::time::Instant, std::time::monotonicNow, std::time::sleep,
         std::random::Rng,
         redis::Config, redis::Protocol, redis::UrlTransport, redis::RedisError, redis::ServerError, redis::ServerCode,
         redis::ConnectError, redis::ConnectAttempt, redis::ReconnectError, redis::SentinelError, redis::SentinelRole,
         redis::Transport, redis::TcpTransport, redis::UnixTransport,
         redis::Dialer, redis::DialTarget, redis::Command, redis::ServerInfo, redis::TlsSession,
         redis::Credentials, redis::Login, redis::CredentialsError,
         redis::secure::TlsTransport, redis::secure::prepareTls, redis::secure::hasIdentity, tls::TlsConfig, tls::TlsError,
         redis::Pipeline, redis::Replies, redis::TxOutcome, redis::TxBody, redis::ScriptCall, redis::wire::Wire, redis::wire::Deadline, redis::wire::admit,
         redis::wire::watchEffect, redis::wire::serverError, redis::wire::blockingWait, redis::wire::callDeadline, redis::wire::isWatch, redis::wire::footprint, redis::wire::unattributed,
         redis::wire::transient, redis::wire::closedKind, redis::wire::backoffAfter,
         redis::wire::Place, redis::wire::Address, redis::wire::addressOf, redis::wire::instancesOf, redis::wire::roleOf, redis::wire::MAX_SENTINELS,
         redis::resp::Writer, redis::resp::Value, redis::resp::Read };
export { Connection, libraryName, libraryVersion };

// One connection to a Redis or Valkey server. It belongs to one isolate at a time and moves between them whole.
//
// Connecting (docs/ROADMAP.md, "Phase 2", says why each step is as it is):
//   1. The config's host resolves to its addresses, tried in the resolver's order; a unix:// config has its one
//      socket. Each address gets `connect_timeout` for its connect and, once connected, the handshake. A failed
//      connect moves on to the next address; once one connects, the handshake's outcome is the connect's.
//   2. Over TLS (rediss://, valkeys://), the TLS handshake comes first, within the same `connect_timeout`; its
//      failure is the connect's, and the next address is not tried (src/secure/).
//   3. The handshake is one write and, normally, one round trip: HELLO 3 with AUTH and SETNAME, then SELECT and the
//      two CLIENT SETINFOs that name this library. A server that refuses HELLO (a proxy) gets the RESP2 path on the
//      same connection: AUTH, CLIENT SETNAME and SELECT, or PING when none is needed. `protocol=2` goes straight to that path; `protocol=3`
//      never takes it.
//
// Through sentinels (redis-sentinel://, Config.sentinel; docs/ROADMAP.md, "Phase 6"), step 1's address comes from them,
// as Sentinel's client specification says: each sentinel in turn, within `connect_timeout`, is asked for the master
// (GET-MASTER-ADDR-BY-NAME) or, for `role=replica`, for a replica that is up (SENTINEL REPLICAS), the master when none
// is. The sentinel that answered moves to the front of the list, and the sentinels it knows (SENTINEL SENTINELS) join
// it. The server named must then confirm its role: HELLO's `role`, or ROLE on the RESP2 path. One that says otherwise
// is asked for again after a pause, within `reconnect_timeout`, since a sentinel can be behind a failover. Every
// reconnect asks the sentinels again, and a failover kills every client of the servers it reconfigures, so the next
// call finds the new master. A write a demoted master refuses (READONLY) never ran: the call asks again and sends it
// once more.
//
// After that, `call` sends one command and returns its reply, `run` sends a pipeline's commands in one write and
// returns their replies, and `transact` sends them as one transaction (src/transaction.kama). A command a connection cannot carry (SUBSCRIBE,
// MONITOR, …) or one refused while it was built is refused before anything is written (`Usage`, `Value`). An error
// reply is `RedisError::Server`, and the connection goes on. A failure of the connection itself (I/O, bytes that are not RESP, `command_timeout`) loses
// it: that call fails with what happened, and is never sent again, since it may have run. The next call makes the
// connection again (`redial`, docs/ROADMAP.md "Phase 7a"), unless the caller closed it, it is over the caller's own
// transport, or reconnect=off; then every call answers `Closed`.

// This library's name and version, as CLIENT SETINFO's lib-name and lib-ver tell them to the server.
// tools/test.sh checks the version against kama.json's.
fn string libraryName() { return "kama-redis"; }
fn string libraryVersion() { return "0.2.0"; }

// The most push messages a connection sets aside for `takePushes`; past it the oldest is dropped, and counted.
comptime isize MAX_PUSHES = 1024;

type resource Connection implements Sendable {
    Wire wire;
    Writer outbox;
    bool live = false;
    // Closed by the caller (`close()`): for good. A connection that is not live otherwise was lost.
    bool shut = false;
    Protocol speaking;
    // The server's HELLO, when the handshake sent one: zero or one.
    DynamicArray<ServerInfo> identified;
    // What the TLS handshake settled, on a TLS connection: zero or one.
    DynamicArray<TlsSession> secured;
    // Push messages that arrived in place of a reply, oldest first: at most MAX_PUSHES, holding at most the reader's
    // `maxReplyBytes`. Past either bound the oldest goes, and is counted.
    Deque<Value> pushes;
    int64 pushBytes = 0;
    int64 pushBudget = 0;
    int64 pushesDropped = 0;
    Duration commandLimit;
    // What this connection was made from, kept whole, and how it opened its link: the caller's dialer, this client's
    // own sockets, or neither, for a transport the caller opened (`connectOver`).
    Config settings;
    Opener dialing;
    // A WATCH the server answered OK is in force. One in force when the link was lost is lost with it, and the next
    // transaction answers WatchConflict without being sent: it never runs on a new link without its WATCH.
    bool watching = false;
    bool watchLost = false;
    // The redial's backoff, kept across calls so that a caller's loop cannot storm a server that is down: how many
    // redials in a row have failed, the instant before which the next may not start, and the jitter's source.
    int32 failedRedials = 0;
    Instant redialAfter;
    Rng jitter;
    // This link's identity, drawn at random as each link is made: a SCAN's cursor means nothing on another link, whether
    // this connection made its link again or the scan went on over another connection (a pool's).
    int64 linkId = 0;
    // When the credentials provider must be asked again (src/credentials.kama): None while the login holds. The user
    // last logged in as. Whether `authenticate` changed who this connection is (a pool will not keep it).
    Optional<Instant> loginDue;
    Optional<string> loginUser;
    bool authenticatedByHand = false;

    // A Subscriber owns its connection while it is subscribed, and reads what comes back itself (src/subscriber.kama).
    friend redis::Subscriber::write[transmit];
    friend redis::Subscriber::read[receiveFrame];
    friend redis::Subscriber::keepAside[setAside];
    friend redis::Subscriber::over[budget];
    friend redis::Subscriber::linked[lost, ready];
    friend redis::Subscriber::release[lost];
    friend redis::Subscriber::change[lost];
    friend redis::Subscriber::lostWith[lose];
    friend redis::Subscriber::rawHandle[rawHandle];
    friend redis::Subscriber::relogin[loginExpired, nextLogin, loggedIn];
    friend redis::Scan::next[generation];
    // A cluster asks its live nodes for the map first (src/cluster.kama).
    friend redis::NodeLink::live[lost];
    friend redis::NodeLink::begin[begin];
    friend redis::NodeLink::finish[finish];
    friend redis::NodeLink::transact[transactAt];
    friend redis::NodeLink::generation[generation];
    // A pool takes a connection back and checks one it leases (src/pool/pool.kama).
    friend redis::pool::PoolCore::release[putBack];
    friend redis::pool::PoolCore::checkout[settleIdle];

    unsafe ctor over(Owned<Transport> transport, const ref Config config, Opener dialing) {
        this.wire = Wire.over(transport: give transport, limits: config.limits());
        this.outbox = Writer.make();
        this.live = true;
        this.speaking = Protocol::Resp3;
        this.identified = DynamicArray.empty();
        this.secured = DynamicArray.empty();
        this.pushes = Deque.empty();
        this.pushBudget = config.limits().maxReplyBytes;
        this.commandLimit = config.commandTimeout();
        this.settings = copy config;
        this.dialing = give dialing;
        this.redialAfter = monotonicNow();
        this.jitter = Rng.fromEntropy();
        this.linkId = cast<int64>(this.jitter.next() >> 1);
        this.loginDue = Optional::None;
        this.loginUser = Optional::None;
    }

    // Connect to the server `config` names, over a socket of this client's.
    public unsafe ctor Result<Connection, RedisError> connect(const ref Config config) {
        Optional<RedisError> wrong = oneServer(config: config);
        match (give wrong) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        Opener opener = Opener.builtIn(keepAlive: config.keepAlive());
        return Connection.establish(config: config, opener: give opener);
    }

    // `connect`, with each address's transport opened by `dialer` (a tunnel, a proxy) rather than by this client.
    public unsafe ctor Result<Connection, RedisError> connectWith(Owned<Dialer> dialer, const ref Config config) {
        Optional<RedisError> wrong = oneServer(config: config);
        match (give wrong) { case Some(value: e): { Owned<Dialer> unused = give dialer; return Result::Err(error: give e); } case None: { } };
        Opener opener = Opener.through(dialer: give dialer);
        return Connection.establish(config: config, opener: give opener);
    }

    // The handshake over a transport the caller opened: TLS first, when `config` is a TLS one. `config` supplies
    // everything but where to connect; `connect_timeout` bounds the handshake.
    public unsafe ctor Result<Connection, RedisError> connectOver(Owned<Transport> transport, const ref Config config) {
        Optional<RedisError> wrong = oneServer(config: config);
        if (config.viaSentinel()) {
            Optional<RedisError> unused = give wrong;
            wrong = Optional::Some(value: RedisError::Config(detail: "a Sentinel configuration finds its server through the sentinels, so it cannot run over a transport the caller opened: connect with Connection.connect or connectWith"));
        }
        match (give wrong) { case Some(value: e): { Owned<Transport> unused = give transport; return Result::Err(error: give e); } case None: { } };
        Config own = copy config;
        Opener none = Opener.none();
        none.holdCredentials(creds: own.takeCredentials());
        Deadline deadline = Deadline.within(span: own.connectTimeout());
        DynamicArray<TlsSession> session = DynamicArray.empty();
        Result<Owned<Transport>, RedisError> secured = Connection::secure(link: give transport, config: own, place: hostAndPort(config: own), deadline: deadline, session: session);
        Owned<Transport> link = match (give secured) { case Ok(value: t): give t; case Err(error: e): { return Result::Err(error: give e); } };
        Connection c = Connection.over(transport: give link, config: own, dialing: give none);
        c.secured = give session;
        Result<Unit, RedisError> done = c.handshake(config: own, deadline: deadline, again: false);
        return match (give done) {
            case Ok(value: u): { c.settings.setProtocol(protocol: c.speaking); := Result::Ok(value: give c); }
            case Err(error: e): { Connection failed = give c; := Result::Err(error: give e); }
        };
    }

    // A connection to the first address of `config` that opens, made by `opener`, which the connection keeps, with
    // the config's credentials provider beside it: the Config the connection keeps holds none.
    unsafe ctor Result<Connection, RedisError> establish(const ref Config config, Opener opener) {
        Config own = copy config;
        opener.holdCredentials(creds: own.takeCredentials());
        Deadline left = Deadline.none();
        DynamicArray<TlsSession> session = DynamicArray.empty();
        Result<Owned<Transport>, RedisError> reached = Connection::reach(config: own, opener: opener, left: left, session: session);
        Owned<Transport> link = match (give reached) { case Ok(value: t): give t; case Err(error: e): { return Result::Err(error: give e); } };
        Connection c = Connection.over(transport: give link, config: own, dialing: give opener);
        c.secured = give session;
        Result<Unit, RedisError> shaken = c.handshake(config: own, deadline: left, again: false);
        Result<Unit, RedisError> done = c.confirmed(shaken: give shaken, config: own, deadline: left);
        return match (give done) {
            case Ok(value: u): { c.settings.setProtocol(protocol: c.speaking); := Result::Ok(value: give c); }
            case Err(error: e): { Connection failed = give c; := Result::Err(error: give e); }
        };
    }

    // The link to the first address of `config` that opens, secured when `config` is a TLS one, and in `left` the
    // deadline its handshake has: each address has `connect_timeout` for all of it. An address that does not open is
    // an attempt in `Connect`, and the next is tried; once one opens, what follows is final.
    static unsafe fn Result<Owned<Transport>, RedisError> reach(const ref Config config, ref Opener opener, ref Deadline left, ref DynamicArray<TlsSession> session) {
        if (config.viaSentinel()) {
            Result<Config, RedisError> asked = Connection::askSentinels(config: config, opener: opener);
            Config node = match (give asked) { case Ok(value: c): give c; case Err(error: e): { return Result::Err(error: give e); } };
            return Connection::reach(config: node, opener: opener, left: left, session: session);
        }
        ConnectError failures = ConnectError.make();
        DynamicArray<DialTarget> targets = Connection::targetsOf(config: config, failures: failures);
        isize i = 0;
        while (i < targets.length()) {
            Deadline deadline = Deadline.within(span: config.connectTimeout());
            Result<Owned<Transport>, IoError> opened = opener.open(target: targets[i], timeoutMs: deadline.remainingMs());
            match (give opened) {
                case Err(error: e): { failures.add(attempt: ConnectAttempt.make(place: targets[i].place(), failure: e)); }
                case Ok(value: t): {
                    left = deadline;
                    return Connection::secure(link: give t, config: config, place: targets[i].place(), deadline: deadline, session: session);
                }
            };
            i = i + 1;
        }
        return Result::Err(error: RedisError::Connect(error: give failures));
    }

    // The server a Sentinel configuration names, from the sentinels: each in turn, each within `connect_timeout` for its
    // connect and handshake (with the sentinels' own credentials, and no database), until one gives an address. The
    // sentinel that answered moves to the front of `opener`'s list, and the sentinels it knows join it. The answer is a
    // configuration for that server. `Connect` when no sentinel could be reached, `Sentinel` when none gave an address.
    static unsafe fn Result<Config, RedisError> askSentinels(const ref Config config, ref Opener opener) {
        opener.seedSentinels(config: config);
        Optional<string> named = config.masterName();
        string master = match (give named) { case Some(value: m): give m; case None: ""; };
        SentinelError answers = SentinelError.of(master: copy master);
        ConnectError unreachable = ConnectError.make();
        bool answered = false;
        isize i = 0;
        while (i < opener.sentinelCount()) {
            Place at = opener.sentinelAt(index: i);
            string place = at.text();
            Config asking = config.forSentinel(host: copy at.host(), port: at.port());
            Deadline left = Deadline.none();
            DynamicArray<TlsSession> session = DynamicArray.empty();
            Result<Owned<Transport>, RedisError> reached = Connection::reach(config: asking, opener: opener, left: left, session: session);
            bool connected = match (reached) { case Ok(value: t): true; case Err(error: e): false; };
            if (!connected) {
                RedisError e = match (give reached) { case Err(error: x): give x; case Ok(value: t): RedisError::Closed; };
                answers.add(place: copy place, answer: e.message());
                match (e) {
                    case Connect(error: c): {
                        isize k = 0;
                        while (k < c.count()) { unreachable.add(attempt: copy c.attempt(index: k)); k = k + 1; }
                    }
                    case _: { answered = true; }
                };
                i = i + 1;
                continue;
            }
            answered = true;
            Owned<Transport> link = match (give reached) { case Ok(value: t): give t; case Err(error: e): { return Result::Err(error: give e); } };
            Connection s = Connection.over(transport: give link, config: asking, dialing: Opener.none());
            s.secured = give session;
            Result<Unit, RedisError> shaken = s.handshake(config: asking, deadline: left, again: false);
            bool spoke = match (shaken) { case Ok(value: u): true; case Err(error: e): false; };
            if (!spoke) {
                RedisError e = match (give shaken) { case Err(error: x): give x; case Ok(value: u): RedisError::Closed; };
                answers.add(place: copy place, answer: e.message());
                i = i + 1;
                continue;
            }
            Address said = s.lookup(config: config, master: master);
            match (give said) {
                case At(place: p): {
                    s.learnSentinels(opener: opener, master: master);
                    s.close();
                    opener.promote(index: i);
                    opener.found(place: p.text());
                    return Result::Ok(value: config.forNode(host: copy p.host(), port: p.port()));
                }
                case Unknown: { answers.add(place: copy place, answer: "it does not know master ".concat(other: master)); }
                case Malformed(why: w): { answers.add(place: copy place, answer: give w); }
            };
            s.close();
            i = i + 1;
        }
        if (!answered) { return Result::Err(error: RedisError::Connect(error: give unreachable)); }
        return Result::Err(error: RedisError::Sentinel(error: give answers));
    }

    // What this connection, to a sentinel, says the server is: GET-MASTER-ADDR-BY-NAME for the master; for a replica,
    // one of those SENTINEL REPLICAS shows up, at random, or the master when none is.
    unsafe fn Address lookup(const ref Config config, const ref string master) {
        if (config.role() == SentinelRole::Replica) {
            Command replicas = Command.of(name: "SENTINEL");
            replicas.arg(text: "REPLICAS");
            replicas.arg(text: master);
            Result<Value, RedisError> r = this.call(command: replicas);
            bool listed = match (r) { case Ok(value: v): true; case Err(error: e): false; };
            if (!listed) {
                return match (give r) { case Err(error: e): Address::Malformed(why: e.message()); case Ok(value: v): Address::Unknown; };
            }
            Value v = match (give r) { case Ok(value: x): give x; case Err(error: e): Value::Null; };
            DynamicArray<Place> up = instancesOf(v: v, upOnly: true);
            if (up.length() > 0) {
                isize k = this.jitter.below(n: up.length());
                return Address::At(place: copy up[k]);
            }
        }
        Command ask = Command.of(name: "SENTINEL");
        ask.arg(text: "GET-MASTER-ADDR-BY-NAME");
        ask.arg(text: master);
        Result<Value, RedisError> r = this.call(command: ask);
        return match (give r) {
            case Ok(value: v): addressOf(v: v);
            case Err(error: e): Address::Malformed(why: e.message());
        };
    }

    // The sentinels this one knows (SENTINEL SENTINELS), added to `opener`'s list. A refusal changes nothing: the list
    // is an aid.
    unsafe fn void learnSentinels(ref Opener opener, const ref string master) {
        Command known = Command.of(name: "SENTINEL");
        known.arg(text: "SENTINELS");
        known.arg(text: master);
        Result<Value, RedisError> r = this.call(command: known);
        match (give r) {
            case Ok(value: v): {
                DynamicArray<Place> more = instancesOf(v: v, upOnly: false);
                isize k = 0;
                while (k < more.length()) { opener.learn(place: copy more[k]); k = k + 1; }
            }
            case Err(error: e): { }
        };
    }

    // After a handshake through sentinels: the server named must confirm its role. One that does not is asked for
    // again after a pause, with a redial's backoff, within `reconnect_timeout`. A connection that is not through
    // sentinels has nothing to confirm.
    unsafe fn Result<Unit, RedisError> confirmed(Result<Unit, RedisError> shaken, const ref Config config, Deadline deadline) {
        if (!config.viaSentinel()) { return give shaken; }
        match (give shaken) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        Result<Unit, RedisError> checked = this.confirmRole(config: config, deadline: deadline);
        bool behind = match (checked) { case Err(error: e): unconfirmed(e: e); case Ok(value: u): false; };
        if (!behind) { return give checked; }
        RedisError first = match (give checked) { case Err(error: e): give e; case Ok(value: u): RedisError::Closed; };
        return this.rediscover(config: config, first: give first);
    }

    // The server a sentinel named is what was asked for: the master, or for `role=replica` a replica (or the master,
    // when none is up). Its HELLO says its role; on the RESP2 path, which sends no HELLO, ROLE does. One that says
    // otherwise loses the link, and is `Sentinel`, unconfirmed.
    unsafe fn Result<Unit, RedisError> confirmRole(const ref Config config, Deadline deadline) {
        string said = "";
        if (this.identified.length() > 0) {
            said = copy this.identified[0].role();
        } else {
            this.outbox.clear();
            Command role = Command.of(name: "ROLE");
            role.encode(into: this.outbox);
            Result<Unit, RedisError> sent = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
            match (give sent) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            Result<Value, RedisError> got = this.nextReply(deadline: deadline);
            Value v = match (give got) { case Ok(value: x): give x; case Err(error: e): { return Result::Err(error: give e); } };
            if (v.isError()) { ServerError refused = serverError(v: v); this.lose(); return Result::Err(error: RedisError::Server(error: give refused)); }
            said = roleOf(v: v);
            if (said == "slave") { said = "replica"; }
        }
        bool wantReplica = config.role() == SentinelRole::Replica;
        if (said == "master" || (wantReplica && said == "replica")) { return Result::Ok(value: Unit::Unit); }
        this.lose();
        Optional<string> named = config.masterName();
        string master = match (give named) { case Some(value: m): give m; case None: ""; };
        return Result::Err(error: RedisError::Sentinel(error: SentinelError.unconfirmed(master: give master, place: this.dialing.foundText(), role: give said)));
    }

    // A server that did not confirm its role, asked for again: tries paced as a redial's, until one confirms, one
    // fails for good, or `reconnect_timeout` passes. Its error is the last try's.
    unsafe fn Result<Unit, RedisError> rediscover(const ref Config config, RedisError first) {
        Deadline window = Deadline.within(span: config.reconnectTimeout());
        RedisError last = give first;
        this.failedRedials = 1;
        this.redialAfter = monotonicNow() + this.backoff();
        while (window.allows(at: this.redialAfter)) {
            this.pace(window: window);
            RedisError before = give last;
            Result<Unit, RedisError> once = this.redialOnce(config: config);
            match (give once) {
                case Ok(value: u): {
                    this.failedRedials = 0;
                    this.redialAfter = monotonicNow();
                    return Result::Ok(value: Unit::Unit);
                }
                case Err(error: e): {
                    this.failedRedials = this.failedRedials + 1;
                    this.redialAfter = monotonicNow() + this.backoff();
                    if (!transient(e: e)) { return Result::Err(error: give e); }
                    last = give e;
                }
            };
        }
        return Result::Err(error: give last);
    }

    // `link`, secured first when `config` is a TLS one: the TLS handshake runs within `deadline`, its failure names
    // the server at `place`, and what it settled goes into `session`. A TLS configuration is never carried in
    // plaintext.
    static unsafe fn Result<Owned<Transport>, RedisError> secure(Owned<Transport> link, const ref Config config, string place, Deadline deadline, ref DynamicArray<TlsSession> session) {
        if (config.transport() != UrlTransport::Tls) { return Result::Ok(value: give link); }
        Result<TlsConfig, RedisError> prepared = prepareTls(config: config);
        TlsConfig tls = match (give prepared) {
            case Ok(value: x): give x;
            case Err(error: e): { Owned<Transport> unused = give link; unused.shutdown(); return Result::Err(error: give e); }
        };
        string name = config.tlsServerName();
        Result<Owned<TlsTransport>, RedisError> started = new TlsTransport.start(link: give link, config: tls, name: name, certificateLoaded: hasIdentity(config: config));
        Owned<TlsTransport> secured = match (give started) { case Ok(value: x): give x; case Err(error: e): { return Result::Err(error: give e); } };
        Result<Unit, RedisError> shaken = secured.handshake(deadline: deadline, place: place);
        match (give shaken) { case Ok(value: u): { } case Err(error: e): { secured.shutdown(); return Result::Err(error: give e); } };
        session.add(item: secured.session());
        Owned<Transport> up = give secured;
        return Result::Ok(value: give up);
    }

    // Where `config` can be reached: its socket, or every address its host resolves to. A name that does not resolve
    // is recorded as the one attempt, and there is nowhere to go.
    static unsafe fn DynamicArray<DialTarget> targetsOf(const ref Config config, ref ConnectError failures) {
        DynamicArray<DialTarget> targets = DynamicArray.empty();
        if (config.transport() == UrlTransport::Unix) {
            targets.add(item: DialTarget.overSocket(path: copy config.socketPath()));
            return give targets;
        }
        uint16 port = cast<uint16>(config.port());
        Result<DynamicArray<SocketAddr>, IoError> found = resolve(host: config.host(), port: port);
        match (give found) {
            case Ok(value: all): {
                isize i = 0;
                while (i < all.length()) {
                    targets.add(item: DialTarget.overTcp(host: copy config.host(), address: all[i]));
                    i = i + 1;
                }
                if (all.length() == 0) {
                    failures.add(attempt: ConnectAttempt.make(place: hostAndPort(config: config), failure: IoError.of(kind: IoErrorKind::NotFound)));
                }
            }
            case Err(error: e): { failures.add(attempt: ConnectAttempt.make(place: hostAndPort(config: config), failure: e)); }
        };
        return give targets;
    }

    // Send `command` and return its reply. A command refused while it was built (`Value`), or one a connection cannot
    // carry (`Usage`), is refused before anything is written. The deadline is `command_timeout`, plus the command's
    // own timeout when it blocks on the server (BLPOP, XREAD BLOCK, WAIT, …); a timeout of 0 blocks with no deadline. An error reply is `Server`, and the connection is still
    // usable; an error inside a reply (one of EXEC's) stays a `Value::Error` there. A push message that comes in place
    // of the reply is set aside, never taken for it.
    public unsafe fn Result<Value, RedisError> call(const ref Command command) {
        Result<Unit, RedisError> admitted = admit(command: command);
        match (give admitted) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        return this.exchange(command: command);
    }

    // Change the database this connection uses: SELECT, and every reconnect selects it too. A database the Config
    // would refuse (below 0) is `Config`, and nothing is sent; an error reply (past the server's last database) is
    // `Server`, and nothing changes.
    public unsafe fn Result<Unit, RedisError> select(int64 db) {
        Config next = copy this.settings;
        Result<Unit, RedisError> valid = next.setDatabase(db: db);
        match (give valid) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        Command choose = Command.of(name: "SELECT");
        choose.argInt(value: db);
        Result<Value, RedisError> r = this.exchange(command: choose);
        match (give r) { case Ok(value: v): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.settings = give next;
        return Result::Ok(value: Unit::Unit);
    }

    // Change who this connection is: AUTH, and every reconnect logs in as that user too. With no user, the password
    // is the `default` user's. A user or password the Config would refuse (empty) is `Config`, and nothing is sent; a
    // refusal (WRONGPASS) is `Server`, and the connection stays the user it was.
    // A connection whose link was lost logs in as the new user as it is made again, not as the old one first. On a
    // connection whose credentials come from a provider (Config.setCredentials) it is `Usage`: the provider is the one
    // source, and the connection logs in anew itself when its login changes.
    public unsafe fn Result<Unit, RedisError> authenticate(Optional<string> user, string password) {
        if (this.dialing.hasCredentials()) {
            return Result::Err(error: RedisError::Usage(detail: "this connection's credentials come from its provider (Config.setCredentials), which it asks again itself when its login changes"));
        }
        Config next = copy this.settings;
        Optional<string> named = copy user;
        string secret = copy password;
        Result<Unit, RedisError> valid = next.setAuth(user: give named, password: give secret);
        match (give valid) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        Result<Unit, RedisError> idle = this.settle();
        match (give idle) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        if (!this.live) {
            // The link is made again as the new user, whose AUTH is its handshake's; failing, the old one is kept.
            if (!this.canRedial()) { return Result::Err(error: RedisError::Closed); }
            Config before = replace::<Config>(place: this.settings, with: give next);
            Result<Unit, RedisError> up = this.ready();
            match (give up) {
                case Ok(value: u): { this.authenticatedByHand = true; return Result::Ok(value: Unit::Unit); }
                case Err(error: e): { this.settings = give before; return Result::Err(error: give e); }
            };
        }
        Command auth = Command.of(name: "AUTH");
        match (user) { case Some(value: u): { auth.arg(text: u); } case None: { } };
        auth.arg(text: password);
        Result<Value, RedisError> r = this.exchange(command: auth);
        match (give r) { case Ok(value: v): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.settings = give next;
        this.loginUser = copy user;
        this.authenticatedByHand = true;
        return Result::Ok(value: Unit::Unit);
    }

    // Send `command`, which the table of commands a connection cannot carry has passed, and return its reply. Through
    // sentinels, a master that refuses it as READONLY was made a replica since the connection reached it: the command
    // never ran, so the link is dropped, the sentinels are asked again by the redial, and it is sent once more.
    unsafe fn Result<Value, RedisError> exchange(const ref Command command) {
        Result<Value, RedisError> first = this.exchangeOnce(command: command);
        if (!this.settings.viaSentinel() || this.settings.role() != SentinelRole::Master) { return give first; }
        bool demoted = match (first) {
            case Err(error: e): match (e.serverCode()) { case Some(value: c): match (c) { case ReadOnly: true; case _: false; }; case None: false; };
            case Ok(value: v): false;
        };
        if (!demoted) { return give first; }
        Result<Value, RedisError> dropped = give first;
        this.lose();
        return this.exchangeOnce(command: command);
    }

    unsafe fn Result<Value, RedisError> exchangeOnce(const ref Command command) {
        Result<Unit, RedisError> up = this.prepared();
        match (give up) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        Deadline deadline = callDeadline(limit: this.commandLimit, extra: blockingWait(command: command));
        this.outbox.clear();
        command.encode(into: this.outbox);
        Result<Unit, RedisError> sent = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
        Result<Value, RedisError> got = this.nextReply(deadline: deadline);
        Value v = match (give got) { case Ok(value: x): give x; case Err(error: e): { return Result::Err(error: give e); } };
        if (v.isError()) {
            ServerError refused = serverError(v: v);
            Value dropped = give v;
            return Result::Err(error: RedisError::Server(error: give refused));
        }
        this.noteWatch(effect: watchEffect(command: command));
        return Result::Ok(value: give v);
    }

    // Send every command of `pipeline` in one write, and read their replies in order: one round trip for all of them.
    // A pipeline refused while it was built (a command `call` would refuse) is refused before anything is written,
    // and an empty one writes nothing. Each reply stands alone, an error reply included (`Replies.take`). A failure
    // of the connection itself (I/O, bytes that are not RESP, the deadline) fails the whole call and closes it, as it
    // does a `call`. There is one deadline for the write and every reply: `command_timeout`, plus each blocking
    // command's own timeout, since they wait in turn.
    public unsafe fn Result<Replies, RedisError> run(const ref Pipeline pipeline) {
        Optional<RedisError> problem = pipeline.problem();
        match (give problem) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        bool unsent = false;
        Result<Deadline, RedisError> begun = this.begin(pipeline: pipeline, unsent: unsent);
        Deadline deadline = match (give begun) { case Ok(value: d): d; case Err(error: e): { return Result::Err(error: give e); } };
        return this.finish(pipeline: pipeline, deadline: deadline);
    }

    // A pipeline's first half: what came while idle, the link (made again if it was lost), then every command in one
    // write. The deadline its replies have; `unsent` when the failure came before anything was written. A cluster
    // begins every node's batch before it finishes any (src/cluster.kama).
    unsafe fn Result<Deadline, RedisError> begin(const ref Pipeline pipeline, ref bool unsent) {
        Result<Unit, RedisError> up = this.prepared();
        match (give up) { case Ok(value: u): { } case Err(error: e): { unsent = true; return Result::Err(error: give e); } };
        Deadline deadline = callDeadline(limit: this.commandLimit, extra: pipeline.waiting());
        if (pipeline.length() == 0) { return Result::Ok(value: deadline); }
        Result<Unit, RedisError> sent = this.wire.send(bytes: pipeline.bytes(), deadline: deadline);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
        return Result::Ok(value: deadline);
    }

    // A pipeline's second half: a reply for each command, in order, by `deadline`.
    unsafe fn Result<Replies, RedisError> finish(const ref Pipeline pipeline, Deadline deadline) {
        DynamicArray<Value> values = DynamicArray.empty();
        while (values.length() < pipeline.length()) {
            Result<Value, RedisError> got = this.nextReply(deadline: deadline);
            match (give got) {
                case Ok(value: v): { values.add(item: give v); }
                case Err(error: e): { return Result::Err(error: give e); }
            };
        }
        isize at = pipeline.watchIndex();
        if (at >= 0 && !values[at].isError()) { this.noteWatch(effect: pipeline.watchResult()); }
        // Through sentinels, a READONLY means the master was made a replica: each reply stands, since others of the
        // pipeline may have run, and the next call asks the sentinels again.
        if (this.demotedIn(values: values)) { this.lose(); }
        return Result::Ok(value: Replies.of(values: give values));
    }

    // Whether, on a connection through sentinels to the master, a reply among `values` is READONLY.
    fn bool demotedIn(const ref DynamicArray<Value> values) {
        if (!this.settings.viaSentinel() || this.settings.role() != SentinelRole::Master) { return false; }
        isize i = 0;
        while (i < values.length()) {
            if (values[i].isError()) {
                ServerError e = serverError(v: values[i]);
                bool readOnly = match (e.code()) { case ReadOnly: true; case _: false; };
                if (readOnly) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    // Call a script (src/script.kama): EVALSHA, and if the server lacks the script (NOSCRIPT, so it never ran), EVAL,
    // which also loads it for the next call. Any other answer, an error included, is EVALSHA's.
    public unsafe fn Result<Value, RedisError> eval(const ref ScriptCall call) {
        Command bySha = call.bySha();
        Result<Value, RedisError> first = this.call(command: bySha);
        bool missing = match (first) {
            case Err(error: e): match (e.serverCode()) { case Some(value: c): match (c) { case NoScript: true; case _: false; }; case None: false; };
            case Ok(value: v): false;
        };
        if (!missing) { return give first; }
        Command bySource = call.bySource();
        return this.call(command: bySource);
    }

    // Send `pipeline` as one transaction: MULTI, its commands and EXEC, in one write. Every reply is read before the
    // outcome is decided, so the connection stays in step with the server whatever happens:
    //   - EXEC's array is `Committed`, a reply per command; one that failed when EXEC ran it is its own error;
    //   - EXEC's null is `WatchConflict`: a watched key changed, and nothing ran;
    //   - a command the server refused while queueing it aborts the transaction: `Server`, with that first error;
    //   - an error to EXEC itself (OOM, READONLY, …) is `Server`, with it;
    //   - an error to MULTI (a user who may not run it) is `Server`, with it. The server then ran each command on its
    //     own, as MULTI was not in force, and that cannot be undone; every client has this, and the ACL is the fix.
    // A pipeline with WATCH or UNWATCH is `Usage`, as the server refuses them inside a transaction; WATCH first, with
    // `call` or `watched`. Nothing blocks inside a transaction, so the deadline is `command_timeout` alone.
    public unsafe fn Result<TxOutcome, RedisError> transact(const ref Pipeline pipeline) {
        DynamicArray<bool> asked = DynamicArray.empty();
        return this.transactAt(pipeline: pipeline, asking: false, asked: asked);
    }

    // `transact`, and for a cluster (src/cluster.kama): with `asking`, ASKING first in the same write, so that a slot's
    // importing node takes the whole transaction; and in `asked`, whether each command's queueing was answered ASK.
    unsafe fn Result<TxOutcome, RedisError> transactAt(const ref Pipeline pipeline, bool asking, ref DynamicArray<bool> asked) {
        Optional<RedisError> problem = pipeline.problem();
        match (give problem) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        if (pipeline.watches()) {
            return Result::Err(error: RedisError::Usage(detail: "WATCH and UNWATCH cannot be inside a transaction, where the server refuses them: WATCH first, with call or watched"));
        }
        if (!this.live && !this.canRedial()) { return Result::Err(error: RedisError::Closed); }
        Result<Unit, RedisError> idle = this.settle();
        match (give idle) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        // The keys watched were lost with the link: nothing would guard this transaction, so it does not run.
        if (this.watchLost) { this.watchLost = false; return Result::Ok(value: TxOutcome::WatchConflict); }
        Result<Unit, RedisError> up = this.ready();
        match (give up) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        Result<Unit, RedisError> fresh = this.refreshed();
        match (give fresh) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        // A fresh login that lost the link lost the WATCH with it.
        if (this.watchLost) { this.watchLost = false; return Result::Ok(value: TxOutcome::WatchConflict); }
        // EXEC drops every watched key, whatever it answers; a link lost from here on loses no WATCH.
        this.watching = false;
        Deadline deadline = Deadline.within(span: this.commandLimit);
        this.outbox.clear();
        if (asking) {
            Command asks = Command.of(name: "ASKING");
            asks.encode(into: this.outbox);
        }
        Command multi = Command.of(name: "MULTI");
        multi.encode(into: this.outbox);
        this.outbox.raw(bytes: pipeline.bytes());
        Command exec = Command.of(name: "EXEC");
        exec.encode(into: this.outbox);
        Result<Unit, RedisError> sent = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };

        // ASKING's reply, MULTI's, then one per command, then EXEC's: all of them, before anything is decided.
        Optional<RedisError> refused = Optional::None;
        if (asking) {
            Result<Value, RedisError> a = this.nextReply(deadline: deadline);
            Value asked0 = match (give a) { case Ok(value: x): give x; case Err(error: e): { return Result::Err(error: give e); } };
            if (asked0.isError()) { refused = Optional::Some(value: RedisError::Server(error: serverError(v: asked0))); }
        }
        Result<Value, RedisError> m = this.nextReply(deadline: deadline);
        Value began = match (give m) { case Ok(value: x): give x; case Err(error: e): { return Result::Err(error: give e); } };
        bool multiFailed = began.isError();
        if (multiFailed) {
            bool none = match (refused) { case Some(value: e): false; case None: true; };
            if (none) { refused = Optional::Some(value: RedisError::Server(error: serverError(v: began))); }
        } else if (!isStatus(v: began, text: "OK")) {
            this.lose();
            return Result::Err(error: RedisError::Unexpected(detail: "MULTI was answered with something other than OK"));
        }
        isize i = 0;
        while (i < pipeline.length()) {
            Result<Value, RedisError> q = this.nextReply(deadline: deadline);
            Value queued = match (give q) { case Ok(value: x): give x; case Err(error: e): { return Result::Err(error: give e); } };
            bool ask = false;
            if (queued.isError()) {
                ServerError queueing = serverError(v: queued);
                bool redirected = match (queueing.code()) { case Ask: true; case _: false; };
                ask = redirected;
            }
            asked.add(item: ask);
            bool first = match (refused) { case Some(value: e): false; case None: true; };
            if (queued.isError() && first) {
                refused = Optional::Some(value: RedisError::Server(error: serverError(v: queued)));
            } else if (!multiFailed && !queued.isError() && !isStatus(v: queued, text: "QUEUED")) {
                this.lose();
                return Result::Err(error: RedisError::Unexpected(detail: "a command inside MULTI was answered with something other than QUEUED"));
            }
            i = i + 1;
        }
        Result<Value, RedisError> x = this.nextReply(deadline: deadline);
        Value ended = match (give x) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
        bool abandoned = match (refused) { case Some(value: e): true; case None: false; };
        if (abandoned) {
            Value dropped = give ended;
            bool readOnly = match (refused) {
                case Some(value: e): match (e.serverCode()) { case Some(value: c): match (c) { case ReadOnly: true; case _: false; }; case None: false; };
                case None: false;
            };
            if (readOnly && this.settings.viaSentinel() && this.settings.role() == SentinelRole::Master) { this.lose(); }
            return match (give refused) {
                case Some(value: e): Result::Err(error: give e);
                case None: Result::Err(error: RedisError::Closed);
            };
        }
        if (ended.isError()) {
            ServerError failed = serverError(v: ended);
            Value dropped = give ended;
            // Valkey 9.1 queues a transaction's commands in a slot being migrated, and answers at EXEC for all of them
            // (tools/gen-topology-vectors.sh, exec-after-ask): an ASK there means every key is on the importing node.
            bool asksAll = match (failed.code()) { case Ask: true; case _: false; };
            if (asksAll) {
                isize k = 0;
                while (k < asked.length()) { asked[k] = true; k = k + 1; }
            }
            bool readOnly = match (failed.code()) { case ReadOnly: true; case _: false; };
            if (readOnly && this.settings.viaSentinel() && this.settings.role() == SentinelRole::Master) { this.lose(); }
            return Result::Err(error: RedisError::Server(error: give failed));
        }
        if (ended.isNull()) {
            Value dropped = give ended;
            return Result::Ok(value: TxOutcome::WatchConflict);
        }
        Value ran = unattributed(v: give ended);
        isize count = match (ran) { case Array(items: xs): xs.length(); case _: -1; };
        if (count != pipeline.length()) {
            this.lose();
            return Result::Err(error: RedisError::Unexpected(detail: "EXEC was answered with something other than a reply per command"));
        }
        DynamicArray<Value> replies = match (give ran) { case Array(items: xs): give xs; case _: DynamicArray.empty(); };
        return Result::Ok(value: TxOutcome::Committed(replies: Replies.of(values: give replies)));
    }

    // Run a transaction under WATCH: send `watch` (a WATCH command naming the keys), let `body` read what it needs and
    // build the transaction, and send it. When a watched key changed before EXEC, do it all again, up to `attempts`
    // times in all, then answer `WatchConflict`. A body that fails ends it with that error, after UNWATCH.
    // (go-redis leaves the retry to the caller; redis-py and redis-rs retry without a bound. The bound is the caller's
    // to state here.)
    public unsafe fn Result<TxOutcome, RedisError> watched(const ref Command watch, TxBody body, int32 attempts) {
        if (attempts < 1) {
            return Result::Err(error: RedisError::Usage(detail: "watched needs at least 1 attempt"));
        }
        if (!isWatch(command: watch) || watch.length() < 2) {
            return Result::Err(error: RedisError::Usage(detail: "watched takes a WATCH command that names the keys it watches"));
        }
        int32 tries = 0;
        while (tries < attempts) {
            tries = tries + 1;
            Result<Value, RedisError> w = this.call(command: watch);
            bool watchSet = match (w) { case Ok(value: v): true; case Err(error: e): false; };
            if (!watchSet) {
                return match (give w) { case Err(error: e): Result::Err(error: give e); case Ok(value: v): Result::Err(error: RedisError::Closed); };
            }
            Pipeline tx = Pipeline.make();
            Result<Unit, RedisError> built = body.build(conn: ref this, tx: ref tx);
            bool buildOk = match (built) { case Ok(value: u): true; case Err(error: e): false; };
            if (!buildOk) {
                Command unwatch = Command.of(name: "UNWATCH");
                Result<Value, RedisError> ignored = this.call(command: unwatch);
                return match (give built) { case Err(error: e): Result::Err(error: give e); case Ok(value: u): Result::Err(error: RedisError::Closed); };
            }
            Result<TxOutcome, RedisError> outcome = this.transact(pipeline: tx);
            bool retry = match (outcome) { case Ok(value: o): match (o) { case WatchConflict: true; case _: false; }; case Err(error: e): false; };
            if (!retry) { return give outcome; }
        }
        return Result::Ok(value: TxOutcome::WatchConflict);
    }

    // The next reply, by `deadline`. A push message that comes in place of a reply is set aside, never taken for it.
    // A failure of the connection itself closes it.
    unsafe fn Result<Value, RedisError> nextReply(Deadline deadline) {
        while (true) {
            Result<Value, RedisError> got = this.wire.receive(deadline: deadline);
            Value v = match (give got) {
                case Ok(value: x): give x;
                case Err(error: e): { this.lose(); return Result::Err(error: give e); }
            };
            bool push = match (v) { case Push(items: p): true; case _: false; };
            if (push) {
                this.setAside(push: give v);
                continue;
            }
            return Result::Ok(value: give v);
        }
    }

    // Close the connection. It sends no QUIT, which is deprecated since 7.2. Closing twice is harmless.
    public unsafe fn void close() { this.shut = true; this.lose(); }

    // Whether every call answers `Closed`: the caller closed it, or it was lost and cannot be made again (over a
    // transport the caller opened, or with reconnect=off). A lost connection that can be made again is not closed:
    // its next call makes it.
    public const fn bool isClosed() { return !this.live && !this.canRedial(); }

    // The protocol the handshake settled on.
    public const fn Protocol protocol() { return this.speaking; }

    // What the server said of itself in its HELLO reply; None when the handshake took the RESP2 path, which sends
    // no HELLO.
    public const fn Optional<ServerInfo> server() {
        if (this.identified.length() == 0) { return Optional::None; }
        return Optional::Some(value: copy this.identified[0]);
    }

    // What the TLS handshake settled: the version, the cipher suite, the server's certificate. None on a connection
    // that is not TLS.
    public const fn Optional<TlsSession> tlsSession() {
        if (this.secured.length() == 0) { return Optional::None; }
        return Optional::Some(value: copy this.secured[0]);
    }

    // How many push messages are set aside, waiting for `takePushes`.
    public const fn isize pendingPushes() { return this.pushes.length(); }

    // The push messages set aside, oldest first, handed over: a push that came in place of a reply (a module's, or an
    // invalidation another connection's CLIENT TRACKING … REDIRECT sends here). Pub/sub messages go to a `Subscriber`.
    public fn DynamicArray<Value> takePushes() {
        DynamicArray<Value> taken = DynamicArray.empty();
        bool more = true;
        while (more) {
            Optional<Value> next = this.pushes.popFront();
            match (give next) { case Some(value: v): { taken.add(item: give v); } case None: { more = false; } };
        }
        this.pushBytes = 0;
        return give taken;
    }

    // How many push messages were dropped, unread, to keep the set-aside ones within their bounds: at most
    // MAX_PUSHES of them, holding at most `resp::Limits.maxReplyBytes`. It only grows.
    public const fn int64 droppedPushes() { return this.pushesDropped; }

    // Keep `push` for `takePushes`, dropping the oldest while the set-aside ones are past a bound.
    unsafe fn void setAside(Value push) {
        this.pushBytes = this.pushBytes + footprint(v: push);
        this.pushes.pushBack(item: give push);
        while (this.pushes.length() > MAX_PUSHES || (this.pushBytes > this.pushBudget && this.pushes.length() > 1)) {
            Optional<Value> oldest = this.pushes.popFront();
            match (give oldest) {
                case Some(value: v): { this.pushBytes = this.pushBytes - footprint(v: v); this.pushesDropped = this.pushesDropped + 1i64; }
                case None: { }
            };
        }
    }

    // How long each later call may take; zero is no limit. It starts as the config's `command_timeout`.
    public fn Result<Unit, RedisError> setCommandTimeout(Duration timeout) {
        if (timeout.isNegative()) { return Result::Err(error: RedisError::Config(detail: "command_timeout cannot be negative: 0 is no limit")); }
        this.commandLimit = timeout;
        return Result::Ok(value: Unit::Unit);
    }
    public const fn Duration commandTimeout() { return this.commandLimit; }

    unsafe ~Connection() { this.close(); }

    // HELLO, then what follows it in the same write (docs/ROADMAP.md, "Phase 2", "The handshake is one round trip").
    unsafe fn Result<Unit, RedisError> handshake(const ref Config config, Deadline deadline, bool again) {
        Result<Optional<Login>, RedisError> wanted = this.loginFor(config: config);
        Optional<Login> login = match (give wanted) { case Ok(value: l): give l; case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
        Optional<Protocol> asked = config.protocol();
        bool resp2 = match (asked) { case Some(value: p): p == Protocol::Resp2; case None: false; };
        if (resp2) { return this.resp2Handshake(config: config, deadline: deadline, login: login); }
        bool required = match (asked) { case Some(value: p): true; case None: false; };

        Command hello = Command.of(name: "HELLO");
        hello.arg(text: "3");
        bool carriesAuth = false;
        match (login) {
            case Some(value: l): {
                Optional<string> user = l.user();
                string name = match (user) { case Some(value: u): copy u; case None: "default"; };
                hello.arg(text: "AUTH");
                hello.arg(text: name);
                hello.arg(text: l.password());
                carriesAuth = true;
            }
            case None: { }
        };
        Optional<string> clientName = config.clientName();
        match (clientName) { case Some(value: n): { hello.arg(text: "SETNAME"); hello.arg(text: n); } case None: { } };
        this.outbox.clear();
        hello.encode(into: this.outbox);
        isize after = 0;
        bool selecting = config.database() != 0i64;
        if (selecting) {
            Command select = Command.of(name: "SELECT");
            select.argInt(value: config.database());
            select.encode(into: this.outbox);
            after = after + 1;
        }
        bool identifying = config.identity();
        if (identifying) {
            Command libName = Command.of(name: "CLIENT");
            libName.arg(text: "SETINFO"); libName.arg(text: "LIB-NAME"); libName.arg(text: libraryName());
            libName.encode(into: this.outbox);
            Command libVer = Command.of(name: "CLIENT");
            libVer.arg(text: "SETINFO"); libVer.arg(text: "LIB-VER"); libVer.arg(text: libraryVersion());
            libVer.encode(into: this.outbox);
            after = after + 2;
        }
        // A cluster's link for replica reads: READONLY, in the same write, on every link made.
        bool readonly = config.replicaReads;
        if (readonly) {
            Command ro = Command.of(name: "READONLY");
            ro.encode(into: this.outbox);
            after = after + 1;
        }
        Result<Unit, RedisError> sent = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };

        Result<Value, RedisError> first = this.wire.receive(deadline: deadline);
        Value reply = match (give first) {
            case Ok(value: v): give v;
            case Err(error: e): {
                this.lose();
                // A redial meets a server that spoke HELLO before: a close here is the server going away, not a proxy.
                if (again) { return Result::Err(error: give e); }
                return Result::Err(error: helloFailure(e: give e, tls: config.transport() == UrlTransport::Tls));
            }
        };
        if (reply.isError()) {
            ServerError refused = serverError(v: reply);
            bool fatal = match (refused.code()) {
                case WrongPass: true;
                case NoPerm: true;
                // A server wants a password and none was given. A NOAUTH to a HELLO that carried AUTH means the peer
                // never read it (Envoy checks its password before it looks at HELLO).
                case NoAuth: !carriesAuth;
                case _: required;
            };
            if (fatal) { this.lose(); return Result::Err(error: RedisError::Server(error: give refused)); }
            // HELLO is not supported here: drop the rest of the write's replies, then the RESP2 path. A server that
            // closes on the way refused the connection itself (maxclients says so as it accepts, then closes), so its
            // refusal is the error, not the close.
            isize k = 0;
            while (k < after) {
                Result<Value, RedisError> dropped = this.wire.receive(deadline: deadline);
                match (give dropped) { case Ok(value: v): { } case Err(error: e): { this.lose(); return Result::Err(error: refusedOr(e: give e, refused: give refused)); } };
                k = k + 1;
            }
            Result<Unit, RedisError> fell = this.resp2Handshake(config: config, deadline: deadline, login: login);
            return match (give fell) {
                case Ok(value: u): { ServerError unused = give refused; := Result::Ok(value: u); }
                case Err(error: e): Result::Err(error: refusedOr(e: give e, refused: give refused));
            };
        }
        Result<ServerInfo, RedisError> read = ServerInfo.fromHello(reply: give reply);
        ServerInfo info = match (give read) {
            case Ok(value: i): give i;
            case Err(error: why): { this.lose(); return Result::Err(error: give why); }
        };
        int64 proto = info.proto();
        if (proto != 3i64) {
            this.lose();
            return Result::Err(error: RedisError::Unexpected(detail: "the server answered HELLO 3 with protocol ${proto}"));
        }
        if (selecting) {
            Result<Unit, RedisError> chosen = this.expectOk(what: "SELECT", deadline: deadline);
            match (give chosen) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
        }
        if (identifying) {
            // CLIENT SETINFO's own documentation asks clients to ignore its failure: a server before 7.2 lacks it.
            isize k = 0;
            while (k < 2) {
                Result<Value, RedisError> named = this.wire.receive(deadline: deadline);
                match (give named) { case Ok(value: v): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
                k = k + 1;
            }
        }
        if (readonly) {
            Result<Unit, RedisError> ro = this.expectOk(what: "READONLY", deadline: deadline);
            match (give ro) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
        }
        this.speaking = Protocol::Resp3;
        this.identified.add(item: give info);
        return Result::Ok(value: Unit::Unit);
    }

    // The RESP2 path: AUTH, CLIENT SETNAME and SELECT, each only when needed, in one write; each must answer OK.
    // No CLIENT SETINFO, because twemproxy closes the connection on any CLIENT command it was not asked for. With
    // nothing to send, it sends PING, which twemproxy and Envoy answer themselves, so a connect always knows the link
    // is open (Lettuce's `pingBeforeActivateConnection` on its RESP2 path): a server with no room left (maxclients)
    // says so as it accepts, then closes, and only a round trip sees that.
    unsafe fn Result<Unit, RedisError> resp2Handshake(const ref Config config, Deadline deadline, const ref Optional<Login> login) {
        this.outbox.clear();
        DynamicArray<string> steps = DynamicArray.empty();
        match (login) {
            case Some(value: l): {
                Command auth = Command.of(name: "AUTH");
                Optional<string> user = l.user();
                match (user) { case Some(value: u): { auth.arg(text: u); } case None: { } };
                auth.arg(text: l.password());
                auth.encode(into: this.outbox);
                steps.add(item: "AUTH");
            }
            case None: { }
        };
        Optional<string> clientName = config.clientName();
        match (clientName) {
            case Some(value: n): {
                Command setName = Command.of(name: "CLIENT");
                setName.arg(text: "SETNAME");
                setName.arg(text: n);
                setName.encode(into: this.outbox);
                steps.add(item: "CLIENT SETNAME");
            }
            case None: { }
        };
        if (config.database() != 0i64) {
            Command select = Command.of(name: "SELECT");
            select.argInt(value: config.database());
            select.encode(into: this.outbox);
            steps.add(item: "SELECT");
        }
        if (config.replicaReads) {
            Command ro = Command.of(name: "READONLY");
            ro.encode(into: this.outbox);
            steps.add(item: "READONLY");
        }
        this.speaking = Protocol::Resp2;
        if (steps.length() == 0) {
            Command ping = Command.of(name: "PING");
            ping.encode(into: this.outbox);
            Result<Unit, RedisError> pinged = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
            match (give pinged) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            Result<Value, RedisError> got = this.wire.receive(deadline: deadline);
            Value pong = match (give got) { case Ok(value: x): give x; case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            if (pong.isError()) { this.lose(); return Result::Err(error: RedisError::Server(error: serverError(v: pong))); }
            if (!isStatus(v: pong, text: "PONG")) {
                this.lose();
                return Result::Err(error: RedisError::Unexpected(detail: "PING answered with something other than PONG"));
            }
            return Result::Ok(value: Unit::Unit);
        }
        Result<Unit, RedisError> sent = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
        isize i = 0;
        while (i < steps.length()) {
            Result<Unit, RedisError> ok = this.expectOk(what: steps[i], deadline: deadline);
            match (give ok) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
            i = i + 1;
        }
        return Result::Ok(value: Unit::Unit);
    }

    // The next reply, which must be OK: an error reply is `Server`, anything else `Unexpected`.
    unsafe fn Result<Unit, RedisError> expectOk(const ref string what, Deadline deadline) {
        Result<Value, RedisError> got = this.wire.receive(deadline: deadline);
        Value v = match (give got) { case Ok(value: x): give x; case Err(error: e): { return Result::Err(error: give e); } };
        if (v.isError()) { return Result::Err(error: RedisError::Server(error: serverError(v: v))); }
        bool ok = match (v) { case Simple(bytes: b): b.length() == 2 && b[0] == 79ui8 && b[1] == 75ui8; case _: false; };
        if (!ok) { return Result::Err(error: RedisError::Unexpected(detail: what.concat(other: " answered with something other than OK"))); }
        return Result::Ok(value: Unit::Unit);
    }

    // ---- credentials (src/credentials.kama) ----

    // The login a handshake sends: the credentials provider's, asked now, or the configuration's own; None for none. A
    // provider's failure is `Credentials`.
    unsafe fn Result<Optional<Login>, RedisError> loginFor(const ref Config config) {
        if (this.dialing.hasCredentials()) {
            Result<Login, RedisError> got = this.dialing.login();
            return match (give got) {
                case Ok(value: l): { this.loggedIn(login: l); := Result::Ok(value: Optional::Some(value: give l)); }
                case Err(error: e): Result::Err(error: RedisError::Credentials(error: CredentialsError.provider(cause: give e)));
            };
        }
        Optional<string> password = config.password();
        this.loginDue = Optional::None;
        this.loginUser = config.user();
        return match (give password) {
            case Some(value: pw): Result::Ok(value: Optional::Some(value: Login.make(name: config.user(), secret: give pw, after: Optional::None)));
            case None: Result::Ok(value: Optional::None);
        };
    }

    // The provider's next login, to log in anew on the live link. Its failure loses the link, and is `Credentials`.
    unsafe fn Result<Login, RedisError> nextLogin() {
        Result<Login, RedisError> got = this.dialing.login();
        return match (give got) {
            case Ok(value: l): Result::Ok(value: give l);
            case Err(error: e): { this.lose(); := Result::Err(error: RedisError::Credentials(error: CredentialsError.provider(cause: give e))); }
        };
    }

    // `login` is in force: it holds until its refreshAfter passes.
    unsafe fn void loggedIn(const ref Login login) {
        Optional<Duration> after = login.refreshAfter();
        this.loginDue = match (after) { case Some(value: d): Optional::Some(value: monotonicNow() + d); case None: Optional::None; };
        this.loginUser = login.user();
    }

    // Whether the provider's last login has passed its refreshAfter.
    unsafe fn bool loginExpired() {
        return match (this.loginDue) { case Some(value: at): monotonicNow() >= at; case None: false; };
    }

    // Before a call writes: what came while idle (settle), the link (ready), and a fresh login once the last one's time
    // has passed (refreshed).
    unsafe fn Result<Unit, RedisError> prepared() {
        Result<Unit, RedisError> idle = this.settle();
        match (give idle) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        Result<Unit, RedisError> up = this.ready();
        match (give up) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        return this.refreshed();
    }

    // A fresh login, once the last one's time has passed: the provider asked again, and AUTH, before the call writes.
    // A link lost on the way is made again, which logs in anew, since nothing of the call was sent. The provider's
    // failure, or the server's refusal, is `Credentials`, and the connection stays closed until the next call.
    unsafe fn Result<Unit, RedisError> refreshed() {
        if (!this.loginExpired()) { return Result::Ok(value: Unit::Unit); }
        Result<Unit, RedisError> done = this.relogin();
        bool settled = match (done) { case Err(error: e): match (e) { case Credentials(error: c): true; case _: false; }; case Ok(value: u): true; };
        if (settled) { return give done; }
        Result<Unit, RedisError> dropped = give done;
        return this.ready();
    }

    // Log in anew on the live link: the provider asked, then AUTH, its reply awaited (a push on the way is set aside).
    // Every failure loses the link; the provider's, or the server's refusal, is `Credentials`.
    unsafe fn Result<Unit, RedisError> relogin() {
        Result<Login, RedisError> got = this.nextLogin();
        Login login = match (give got) { case Ok(value: l): give l; case Err(error: e): { return Result::Err(error: give e); } };
        Deadline deadline = Deadline.within(span: this.commandLimit);
        this.outbox.clear();
        Command auth = Command.of(name: "AUTH");
        Optional<string> user = login.user();
        match (user) { case Some(value: u): { auth.arg(text: u); } case None: { } };
        auth.arg(text: login.password());
        auth.encode(into: this.outbox);
        Result<Unit, RedisError> sent = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
        Result<Value, RedisError> answer = this.nextReply(deadline: deadline);
        Value v = match (give answer) { case Ok(value: x): give x; case Err(error: e): { return Result::Err(error: give e); } };
        if (v.isError()) {
            ServerError refused = serverError(v: v);
            this.lose();
            return Result::Err(error: RedisError::Credentials(error: CredentialsError.refusal(cause: RedisError::Server(error: give refused))));
        }
        if (!isStatus(v: v, text: "OK")) { this.lose(); return Result::Err(error: RedisError::Unexpected(detail: "AUTH answered with something other than OK")); }
        this.loggedIn(login: login);
        return Result::Ok(value: Unit::Unit);
    }

    // ---- for a pool (src/pool/pool.kama; docs/ROADMAP.md, "Phase 7b", decision 3) ----

    // Whether this connection can go back to a pool whose connections `config` makes, with what a lease changed put
    // back. Not one the caller closed, one whose link is lost (a pool never redials on its own time), one whose user
    // `authenticate` changed, or one that read something no call asked for while it sat. Otherwise: the command timeout
    // is `config`'s again, a WATCH lost is forgotten, and the pushes set aside are dropped (counted in droppedPushes);
    // then UNWATCH for a WATCH in force and SELECT for a database `select` changed, in one write within the command
    // timeout, each to be answered OK. Sent now, so a failure is the releaser's, never the next lease's.
    unsafe fn bool putBack(const ref Config config) {
        if (this.shut || !this.live || this.authenticatedByHand) { return false; }
        if (!this.idleIntact()) { return false; }
        this.commandLimit = config.commandTimeout();
        this.watchLost = false;
        this.dropPushes();
        this.outbox.clear();
        isize asked = 0;
        if (this.watching) {
            Command unwatch = Command.of(name: "UNWATCH");
            unwatch.encode(into: this.outbox);
            asked = asked + 1;
        }
        bool reselect = this.settings.database() != config.database();
        if (reselect) {
            Command select = Command.of(name: "SELECT");
            select.argInt(value: config.database());
            select.encode(into: this.outbox);
            asked = asked + 1;
        }
        if (asked == 0) { return true; }
        Deadline deadline = Deadline.within(span: this.commandLimit);
        Result<Unit, RedisError> sent = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { this.lose(); return false; } };
        isize k = 0;
        while (k < asked) {
            Result<Value, RedisError> got = this.nextReply(deadline: deadline);
            Value v = match (give got) { case Ok(value: x): give x; case Err(error: e): { return false; } };
            if (!isStatus(v: v, text: "OK")) { this.lose(); return false; }
            k = k + 1;
        }
        this.watching = false;
        if (reselect) {
            Result<Unit, RedisError> chosen = this.settings.setDatabase(db: config.database());
            match (give chosen) { case Ok(value: u): { } case Err(error: e): { this.lose(); return false; } };
        }
        this.dropPushes();
        return true;
    }

    // For a pool's acquire: whether an idle connection's link is still up, found with no round trip.
    unsafe fn bool settleIdle() {
        if (this.shut || !this.live) { return false; }
        return this.idleIntact();
    }

    // Whether nothing but pushes came while the connection sat idle (the pushes are set aside): a close, or anything
    // else, loses the link, and it is not made again here.
    unsafe fn bool idleIntact() {
        Result<Unit, RedisError> caught = this.wire.catchUp();
        Optional<RedisError> stray = this.sortIdle();
        bool intact = match (caught) { case Ok(value: u): true; case Err(error: e): false; };
        bool clean = match (stray) { case Some(value: e): false; case None: true; };
        if (!intact || !clean) { this.lose(); return false; }
        return this.live;
    }

    // Drop the pushes set aside, counting them as dropped.
    fn void dropPushes() {
        this.pushesDropped = this.pushesDropped + cast<int64>(this.pushes.length());
        this.pushes = Deque.empty();
        this.pushBytes = 0;
    }

    // ---- for a Subscriber (src/subscriber.kama), which reads what comes back itself ----

    // Write `command`, a subscriber's (un)subscribe or PING. A failure closes the connection.
    unsafe fn Result<Unit, RedisError> transmit(const ref Command command, Deadline deadline) {
        if (!this.live) { return Result::Err(error: RedisError::Closed); }
        this.outbox.clear();
        command.encode(into: this.outbox);
        Result<Unit, RedisError> sent = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
        return Result::Ok(value: Unit::Unit);
    }

    // The next value from the server, whatever it is. A failure is handed back, not acted on: a subscriber's wait
    // whose time passed leaves the connection open, and what was half read stays in the reader.
    unsafe fn Result<Value, RedisError> receiveFrame(Deadline deadline) {
        if (!this.live) { return Result::Err(error: RedisError::Closed); }
        return this.wire.receive(deadline: deadline);
    }

    // How much a subscriber may keep queued: the reader's `maxReplyBytes`, as for the set-aside pushes.
    const fn int64 budget() { return this.pushBudget; }

    // Whether the link is lost: not live, whether or not it can be made again.
    const fn bool lost() { return !this.live; }

    // This link's identity (a SCAN's cursor means nothing on another link).
    const fn int64 generation() { return this.linkId; }

    // The link's socket, when this client opened it, for waiting on it beside others; -1 otherwise.
    const fn isize rawHandle() {
        if (!this.live) { return -1; }
        return this.dialing.handle();
    }

    // The connection is unusable: stop the transport, and answer `Closed` from now on.
    unsafe fn void lose() {
        if (!this.live) { return; }
        this.live = false;
        if (this.watching) { this.watching = false; this.watchLost = true; }
        this.wire.shutdown();
    }

    // What a call that the server answered OK does to the keys watched (watchEffect).
    fn void noteWatch(int32 effect) {
        if (effect > 0) { this.watching = true; }
        if (effect < 0) { this.watching = false; this.watchLost = false; }
    }

    // ---- reconnecting (docs/ROADMAP.md, "Phase 7a") ----

    // Before a call writes: what came while the connection sat idle. A push is set aside, and a push half come stays
    // in the reader for the call to finish. The link closed (CLIENT KILL, the server's idle timeout, a restart) or
    // anything else (a reply no call asked for, part of one, bytes that are not RESP) loses the connection before
    // anything of the call is written, so the call makes it again and sends. Usually that hides the loss; a close can
    // still land between this and the write. Over a transport the caller opened there is nothing to make it again
    // with, and the call fails with what it found, as it would have once it wrote.
    unsafe fn Result<Unit, RedisError> settle() {
        if (!this.live) { return Result::Ok(value: Unit::Unit); }
        Result<Unit, RedisError> caught = this.wire.catchUp();
        // What came before an end is sorted first: a push that came whole is the caller's, even from a link now gone.
        Optional<RedisError> stray = this.sortIdle();
        match (give caught) {
            case Ok(value: u): { }
            case Err(error: e): { Optional<RedisError> unused = give stray; this.lose(); return this.lostIdle(e: give e); }
        };
        return match (give stray) {
            case Some(value: e): { this.lose(); := this.lostIdle(e: give e); }
            case None: Result::Ok(value: Unit::Unit);
        };
    }

    // The values among the bytes read while no call waited: each push set aside; anything else, or part of it, is
    // what `settle` loses the link over. A push half come stays in the reader.
    fn Optional<RedisError> sortIdle() {
        while (true) {
            Read r = this.wire.nextBuffered();
            match (give r) {
                case Complete(value: v): {
                    bool push = match (v) { case Push(items: p): true; case _: false; };
                    if (!push) { Value unused = give v; return Optional::Some(value: RedisError::Unexpected(detail: "a reply came that no call asked for")); }
                    this.setAside(push: give v);
                }
                case Incomplete: {
                    uint8 kind = this.wire.pendingKind();
                    if (kind == 0ui8 || kind == 62ui8) { return Optional::None; }
                    return Optional::Some(value: RedisError::Unexpected(detail: "part of a reply came that no call asked for"));
                }
                case Invalid(error: e): { return Optional::Some(value: RedisError::Protocol(error: e)); }
            };
        }
    }

    // A link `settle` found lost before the call wrote anything: the call makes it again when it can, and otherwise
    // fails with what was found.
    const fn Result<Unit, RedisError> lostIdle(RedisError e) {
        if (this.canRedial()) { RedisError dropped = give e; return Result::Ok(value: Unit::Unit); }
        return Result::Err(error: give e);
    }

    // Whether a lost link can be made again: not closed by the caller, made by a dialer of this connection's own (not
    // a transport the caller opened), and reconnect on.
    const fn bool canRedial() { return !this.shut && this.dialing.canDial() && this.settings.reconnect(); }

    // The link, ready for a call: as it is, or made again once it was lost. `Closed` when it cannot be.
    unsafe fn Result<Unit, RedisError> ready() {
        if (this.live) { return Result::Ok(value: Unit::Unit); }
        if (!this.canRedial()) { return Result::Err(error: RedisError::Closed); }
        return this.redial();
    }

    // Make the link again, as the first was made: every address of the kept Config, the TLS files read again, the
    // handshake in the protocol this connection speaks, as the database and user it was last given; then a PING,
    // which a server still loading its dataset answers -LOADING. What a server that is down, restarting or full does
    // (`transient`) is tried again after a pause (`backoff`), for up to reconnect_timeout; anything else is final.
    // The call that redials has sent nothing of its own, so its error is `Reconnect`.
    unsafe fn Result<Unit, RedisError> redial() {
        Config config = copy this.settings;
        Deadline window = Deadline.within(span: config.reconnectTimeout());
        int32 tries = 0;
        while (true) {
            this.pace(window: window);
            tries = tries + 1;
            Result<Unit, RedisError> once = this.redialOnce(config: config);
            match (give once) {
                case Ok(value: u): {
                    this.failedRedials = 0;
                    this.redialAfter = monotonicNow();
                    return Result::Ok(value: Unit::Unit);
                }
                case Err(error: e): {
                    this.failedRedials = this.failedRedials + 1;
                    this.redialAfter = monotonicNow() + this.backoff();
                    if (!transient(e: e) || !window.allows(at: this.redialAfter)) {
                        return Result::Err(error: RedisError::Reconnect(error: ReconnectError.of(cause: give e, tries: tries)));
                    }
                }
            };
        }
    }

    // Wait for the backoff to end, but not past `window`: each call makes at least one try.
    unsafe fn void pace(Deadline window) {
        Instant now = monotonicNow();
        if (now >= this.redialAfter) { return; }
        Instant until = this.redialAfter;
        if (window.isBounded() && window.end() < until) { until = window.end(); }
        if (now < until) { sleep(d: until - now); }
    }

    // The pause before the next try (backoffAfter).
    unsafe fn Duration backoff() { return backoffAfter(failures: this.failedRedials, jitter: ref this.jitter); }

    // One try: the link, the handshake on it, then a PING.
    unsafe fn Result<Unit, RedisError> redialOnce(const ref Config config) {
        Deadline left = Deadline.none();
        DynamicArray<TlsSession> session = DynamicArray.empty();
        Result<Owned<Transport>, RedisError> reached = Connection::reach(config: config, opener: this.dialing, left: left, session: session);
        Owned<Transport> link = match (give reached) { case Ok(value: t): give t; case Err(error: e): { return Result::Err(error: give e); } };
        this.wire = Wire.over(transport: give link, limits: config.limits());
        this.identified = DynamicArray.empty();
        this.secured = give session;
        this.live = true;
        Result<Unit, RedisError> done = this.handshake(config: config, deadline: left, again: true);
        match (give done) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
        if (config.viaSentinel()) {
            Result<Unit, RedisError> checked = this.confirmRole(config: config, deadline: left);
            match (give checked) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        }
        Result<Unit, RedisError> probed = this.probe(deadline: left);
        match (give probed) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
        this.linkId = cast<int64>(this.jitter.next() >> 1);
        return Result::Ok(value: Unit::Unit);
    }

    // A server that took the handshake may still be loading its dataset: PING, and -LOADING is the redial's to wait
    // out. Any other answer, an error included (a user who may not PING, a script that keeps the server BUSY), is a
    // server that is serving.
    unsafe fn Result<Unit, RedisError> probe(Deadline deadline) {
        this.outbox.clear();
        Command ping = Command.of(name: "PING");
        ping.encode(into: this.outbox);
        Result<Unit, RedisError> sent = this.wire.send(bytes: this.outbox.view(), deadline: deadline);
        match (give sent) { case Ok(value: u): { } case Err(error: e): { this.lose(); return Result::Err(error: give e); } };
        Result<Value, RedisError> got = this.nextReply(deadline: deadline);
        Value v = match (give got) { case Ok(value: x): give x; case Err(error: e): { return Result::Err(error: give e); } };
        if (v.isError()) {
            ServerError answer = serverError(v: v);
            bool loading = match (answer.code()) { case Loading: true; case _: false; };
            if (loading) { this.lose(); return Result::Err(error: RedisError::Server(error: give answer)); }
        }
        return Result::Ok(value: Unit::Unit);
    }
}

// Whether `v` is the status `text` (+OK, +QUEUED), an attribute around it included.
fn bool isStatus(const ref Value v, const ref string text) {
    return match (v) {
        case Simple(bytes: b): sameText(b: b, text: text);
        case Attributed(parts: ps): ps.length() > 0 && isStatus(v: ps[ps.length() - 1], text: text);
        case _: false;
    };
}

fn bool sameText(const ref DynamicArray<uint8> b, const ref string text) {
    if (b.length() != text.length()) { return false; }
    isize i = 0;
    while (i < b.length()) {
        if (b[i] != text[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// A failure after a refused HELLO. When it is the server closing the connection, the server refused the connection
// itself (maxclients answers so as it accepts, then closes), and its refusal is the error.
fn RedisError refusedOr(RedisError e, ServerError refused) {
    if (closedLink(e: e)) { return RedisError::Server(error: give refused); }
    return give e;
}

// Whether `e` is the server closing the connection: an end of stream, or a write or read the peer reset.
fn bool closedLink(const ref RedisError e) {
    return match (e) { case Io(error: x): closedKind(x: x); case _: false; };
}

// Whether `e` is a server the sentinels named not confirming its role: a failover a sentinel had not seen yet.
fn bool unconfirmed(const ref RedisError e) {
    return match (e) { case Sentinel(error: s): s.isUnconfirmed(); case _: false; };
}

// A hangup in answer to HELLO says what it most likely means.
fn RedisError helloFailure(RedisError e, bool tls) {
    bool eof = match (e) { case Io(error: x): match (x.kind()) { case UnexpectedEof: true; case _: false; }; case _: false; };
    if (!eof) { return give e; }
    string proxy = "A proxy that does not know HELLO, such as twemproxy, closes the connection: connect to one with protocol=2";
    if (tls) { return RedisError::Unexpected(detail: "Server closed the connection in answer to HELLO. ".concat(other: proxy)); }
    // Every server in the matrix closes its TLS port on a plaintext HELLO without a byte (tools/gen-server-vectors.sh,
    // plaintext-at-tls).
    return RedisError::Unexpected(detail: "Server closed the connection in answer to HELLO. A server's TLS port closes a plaintext connection: connect to one with rediss://. ".concat(other: proxy));
}

// What `config` asks of one connection that it cannot give: a cluster's options, or a cluster's seeds.
fn Optional<RedisError> oneServer(const ref Config config) {
    if (config.clusterOptions()) {
        return Optional::Some(value: RedisError::Config(detail: "read_from and max_redirects are a cluster's options: connect to a cluster with Cluster.connect"));
    }
    if (config.hostCount() > 1 && !config.viaSentinel()) {
        return Optional::Some(value: RedisError::Config(detail: "several hosts are a cluster's seeds, or sentinels: connect to a cluster with Cluster.connect, or through sentinels with redis-sentinel://; a connection takes one host"));
    }
    return Optional::None;
}

// "host:port", the host in brackets when it is an IPv6 address.
fn string hostAndPort(const ref Config config) {
    int32 port = config.port();
    string host = copy config.host();
    if (host.contains(substring: ":")) { host = "[".concat(other: host).concat(other: "]"); }
    return "${host}:${port}";
}

// Opens one address's transport: a socket of this client's, or the caller's dialer.
type resource Opener implements Sendable {
    DynamicArray<Owned<Dialer>> dialers;   // empty: this client's own sockets; one: the caller's dialer
    Duration keepIdle;
    bool dials = true;                      // false for a transport the caller opened: there is nothing to dial with
    // Through sentinels: the sentinels to ask, the one that last answered first, and the server it named. Kept across
    // redials, as Sentinel's client specification keeps them.
    DynamicArray<Place> sentinels;
    string foundAt;
    // The socket of the link last opened, when this client opened it; -1 over a caller's dialer.
    isize lastHandle = -1;
    // The server's credentials provider (Config.setCredentials): zero or one, asked at every handshake.
    DynamicArray<Owned<Credentials>> creds;

    public ctor builtIn(Duration keepAlive) {
        this.dialers = DynamicArray.empty();
        this.keepIdle = keepAlive;
        this.sentinels = DynamicArray.empty();
        this.foundAt = "";
        this.creds = DynamicArray.empty();
    }
    public ctor through(Owned<Dialer> dialer) {
        this.dialers = DynamicArray.empty();
        this.dialers.add(item: give dialer);
        this.keepIdle = Duration.zero();
        this.sentinels = DynamicArray.empty();
        this.foundAt = "";
        this.creds = DynamicArray.empty();
    }
    public ctor none() {
        this.dialers = DynamicArray.empty();
        this.keepIdle = Duration.zero();
        this.dials = false;
        this.sentinels = DynamicArray.empty();
        this.foundAt = "";
        this.creds = DynamicArray.empty();
    }

    // The sentinels `config` names, the first time it is asked; after that, the list as answers have ordered it.
    public fn void seedSentinels(const ref Config config) {
        if (this.sentinels.length() > 0) { return; }
        isize i = 0;
        while (i < config.hostCount()) {
            this.sentinels.add(item: Place.make(host: config.hostAt(index: i), port: config.portAt(index: i)));
            i = i + 1;
        }
    }
    public const fn isize sentinelCount() { return this.sentinels.length(); }
    public const fn Place sentinelAt(isize index) { return copy this.sentinels[index]; }
    // The sentinel at `index` answered: it is asked first from now on.
    public unsafe fn void promote(isize index) {
        if (index <= 0 || index >= this.sentinels.length()) { return; }
        Place p = this.sentinels.remove(index: index);
        this.sentinels.insertAt(index: 0, item: give p);
    }
    // A sentinel another named, added at the end unless it is there already or the list is full.
    public fn void learn(Place place) {
        if (this.sentinels.length() >= MAX_SENTINELS) { return; }
        isize i = 0;
        while (i < this.sentinels.length()) {
            if (this.sentinels[i].same(other: place)) { return; }
            i = i + 1;
        }
        this.sentinels.add(item: give place);
    }
    // Where the sentinels last said the server is ("127.0.0.1:7200").
    public fn void found(string place) { this.foundAt = give place; }
    public const fn string foundText() { return copy this.foundAt; }

    // The credentials provider a connection logs in with, taken from its Config (zero or one).
    public fn void holdCredentials(DynamicArray<Owned<Credentials>> creds) { this.creds = give creds; }
    public const fn bool hasCredentials() { return this.creds.length() > 0; }
    // The provider's login, asked now.
    public unsafe fn Result<Login, RedisError> login() {
        if (this.creds.length() == 0) { return Result::Err(error: RedisError::Usage(detail: "no credentials provider")); }
        return this.creds[0].login();
    }

    // Whether this can open a link again: false for a transport the caller opened.
    public const fn bool canDial() { return this.dials; }

    // The socket of the link last opened, for waiting on it beside others (std::net::Poller); -1 when a dialer of the
    // caller's opened it.
    public const fn isize handle() { return this.lastHandle; }

    public unsafe fn Result<Owned<Transport>, IoError> open(const ref DialTarget target, int32 timeoutMs) {
        if (this.dialers.length() > 0) { this.lastHandle = -1; return this.dialers[0].dial(target: target, timeoutMs: timeoutMs); }
        if (target.isSocket()) {
            Result<Owned<UnixTransport>, IoError> local = new UnixTransport.connect(path: target.socketPath(), timeoutMs: timeoutMs);
            Owned<UnixTransport> unix = match (give local) { case Ok(value: t): give t; case Err(error: e): { return Result::Err(error: e); } };
            Owned<Transport> socket = give unix;
            return Result::Ok(value: give socket);
        }
        Optional<SocketAddr> at = target.address();
        SocketAddr address = match (at) { case Some(value: a): a; case None: { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); } };
        Result<Owned<TcpTransport>, IoError> made = new TcpTransport.connect(address: address, timeoutMs: timeoutMs);
        Owned<TcpTransport> tcp = match (give made) { case Ok(value: t): give t; case Err(error: e): { return Result::Err(error: e); } };
        if (this.keepIdle.asNanos() > 0i64) {
            Result<Unit, IoError> kept = tcp.keepAlive(idle: this.keepIdle);
            match (kept) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: e); } };
        }
        this.lastHandle = tcp.handle;
        Owned<Transport> transport = give tcp;
        return Result::Ok(value: give transport);
    }
}
