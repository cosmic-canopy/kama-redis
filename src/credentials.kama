import { std::collections::DynamicArray, std::memory::Owned, std::time::Duration, redis::RedisError };
export { Credentials, Login, CredentialsError };

// Where a connection's user and password come from when they change while it lives: an ElastiCache IAM or Entra ID
// token, a secret a sidecar rotates (docs/ROADMAP.md, "Phase 7b", decision 5). It is set on a Config
// (`Config.setCredentials`), and a URL's password and `setAuth` are then refused, so there is one source.
//
// It is asked at every connect and every redial, for the server's own login; the sentinels keep `setSentinelAuth`.
// Its answer may say when to ask again (`refreshAfter`). Once that has passed, the connection's next call asks again
// and logs in anew (AUTH) before it writes anything, so a token never lapses on a live connection. A provider that
// fails, or a login the server refuses, closes the connection: the call is `RedisError::Credentials`, nothing of it
// was sent, and the next call makes the connection again, asking anew. A connection never goes on as the user it was
// once its credentials have changed.
//
// A Config's copy holds a `fork()` of its provider, and so does each connection made from it, so `fork` may be called
// more often than connections are made: keep it cheap. A provider that fetches a token over the network shares what
// it fetched among its forks itself, or fetches once per connection. The peers': redis-py's `CredentialProvider`,
// go-redis's `CredentialsProviderContext`, and rueidis's `AuthCredentialsFn`, whose `RefreshAfter` this follows.
type contract Credentials for resource implements Sendable {
    // The login to send now. An error is the connect's, or the call's (`Credentials`).
    fn Result<Login, RedisError> login();
    // Another provider like this one, for another connection.
    fn Owned<Credentials> fork();
}

// A user and password, and how long they hold before the provider is asked again (None: while the connection lives).
// With no user, the password is the `default` user's.
type resource Login implements Sendable, Copyable<This>(bare: give) {
    Optional<string> name;
    string secret;
    Optional<Duration> after;

    // An empty user or password, or a refresh that is not after now, is `Config`.
    public ctor Result<Login, RedisError> of(Optional<string> user, string password, Optional<Duration> refreshAfter) {
        bool emptyUser = match (user) { case Some(value: u): u.length() == 0; case None: false; };
        if (emptyUser) { return Result::Err(error: RedisError::Config(detail: "a login's user is empty: give a user, or none for the default user")); }
        if (password.length() == 0) { return Result::Err(error: RedisError::Config(detail: "a login's password is empty: an empty password authenticates no one")); }
        bool now = match (refreshAfter) { case Some(value: d): d.asNanos() <= 0i64; case None: false; };
        if (now) { return Result::Err(error: RedisError::Config(detail: "a login's refreshAfter must be more than 0, or None for never")); }
        Login l = Login.make(name: give user, secret: give password, after: refreshAfter);
        return Result::Ok(value: give l);
    }
    ctor make(Optional<string> name, string secret, Optional<Duration> after) { this.name = give name; this.secret = give secret; this.after = after; }
    public ctor copy(ref Login source) { this.name = copy source.name; this.secret = copy source.secret; this.after = source.after; }

    public const fn Optional<string> user() { return copy this.name; }
    public const fn Optional<Duration> refreshAfter() { return this.after; }
    // The password, for the handshake and a re-AUTH: nothing else reads it.
    const fn const ref string password() { return this.secret; }
    friend redis::Connection::handshake[password];
    friend redis::Connection::resp2Handshake[password];
    friend redis::Connection::relogin[password];
    friend redis::Subscriber::relogin[password];
    friend redis::Connection::loginFor[make];
}

// Why a connection's credentials could not be used: its provider failed (`cause()` is the provider's error), or the
// server refused what it gave when the connection logged in anew (`cause()` is that `Server` error, WRONGPASS). Nothing
// of the call was sent, and the connection is closed until its next call.
type resource CredentialsError implements Sendable, Copyable<This>(bare: give) {
    DynamicArray<RedisError> causes;   // one
    bool refused;

    public ctor provider(RedisError cause) { this.causes = DynamicArray.empty(); this.causes.add(item: give cause); this.refused = false; }
    public ctor refusal(RedisError cause) { this.causes = DynamicArray.empty(); this.causes.add(item: give cause); this.refused = true; }
    public ctor copy(ref CredentialsError source) { this.causes = copy source.causes; this.refused = source.refused; }

    public const fn const ref RedisError cause() { return this.causes[0]; }
    // Whether the server refused the login (true), or the provider failed (false).
    public const fn bool byServer() { return this.refused; }

    // "the credentials provider failed: …", or "the server refused the credentials provider's login: WRONGPASS …".
    public const fn string message() {
        string why = this.causes[0].message();
        if (this.refused) { return "the server refused the credentials provider's login: ".concat(other: why); }
        return "the credentials provider failed: ".concat(other: why);
    }
}
