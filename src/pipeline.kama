import { std::collections::DynamicArray, std::collections::ConstView, std::time::Duration, std::memory::replace,
         redis::Command, redis::RedisError,
         redis::ScriptCall,
         redis::resp::Writer, redis::resp::Value, redis::wire::admit, redis::wire::serverError, redis::wire::Wait,
         redis::wire::blockingWait, redis::wire::later, redis::wire::isWatch, redis::wire::watchEffect };
export { Pipeline, Replies };

// Commands sent together: `Connection.run` writes them all in one write and reads their replies in order, one round
// trip for all of them (docs/ROADMAP.md, "Decided, and why", "Phase 3", "Pipelines").
//
//   Pipeline p = Pipeline.make();
//   p.add(command: cmd"INCR ${counter}");
//   p.add(command: cmd"GET ${key}");
//   Result<Replies, RedisError> rs = conn.run(pipeline: p);
//   Replies replies = …;
//   Result<int64, RedisError> n = reply::<int64>(result: replies.take(index: 0));
//
// Each command is checked as it is added, as `call` checks one: a command refused while it was built, or one a
// connection does not carry, refuses the whole pipeline before anything is written, naming the command
// ("command 2: …"). Each reply stands alone: an error reply is that command's, and the others are still read.
type resource Pipeline implements Sendable {
    Writer encoded;
    isize count = 0;
    bool refused = false;
    bool misuse = false;
    string trouble = "";
    Wait waits;   // how long its blocking commands may wait on the server, in turn
    bool watching = false;   // it has a WATCH or UNWATCH, which a transaction cannot
    isize lastWatch = -1;    // the index of its last WATCH or UNWATCH, whose reply settles what is watched after it
    int32 lastEffect = 0;    // and what that command does (watchEffect)
    DynamicArray<isize> starts;   // where each command's bytes begin, so a cluster can send each where it goes

    friend redis::Connection::run[problem];
    friend redis::Connection::begin[bytes, waiting];
    friend redis::Connection::finish[watchIndex, watchResult];
    friend redis::Connection::transactAt[bytes, problem, watches];
    friend redis::Cluster::run[problem];
    friend redis::Cluster::transact[problem, watches];
    friend redis::Cluster::commandAt[commandBytes];

    public ctor make() {
        this.encoded = Writer.make();
        this.waits = Wait::Span(span: Duration.zero());
        this.starts = DynamicArray.empty();
    }

    // Add `command`. The pipeline keeps its own copy, as the bytes it will send.
    public fn void add(const ref Command command) {
        this.count = this.count + 1;
        Result<Unit, RedisError> admitted = admit(command: command);
        match (admitted) {
            case Ok(value: u): { }
            case Err(error: e): {
                if (!this.refused) {
                    isize n = this.count;
                    this.refused = true;
                    bool value = match (e) { case Value(detail: d): true; case _: false; };
                    this.misuse = !value;
                    this.trouble = "command ${n}: ".concat(other: e.message());
                }
            }
        };
        if (!this.refused) {
            if (isWatch(command: command)) {
                this.watching = true;
                this.lastWatch = this.count - 1;
                this.lastEffect = watchEffect(command: command);
            }
            this.starts.add(item: this.encoded.length());
            command.encode(into: this.encoded);
            this.waits = later(a: this.waits, b: blockingWait(command: command));
        }
    }

    // Add a call of a script, as EVAL with its source: inside a pipeline a NOSCRIPT could not be answered in time
    // (src/script.kama).
    public fn void addScript(const ref ScriptCall call) {
        Command c = call.bySource();
        this.add(command: c);
    }

    // How many commands it has.
    public const fn isize length() { return this.count; }

    const fn ConstView<uint8> bytes() { return this.encoded.view(); }
    // Command `index`'s bytes, as `encode` wrote them.
    const fn ConstView<uint8> commandBytes(isize index) {
        isize end = this.encoded.length();
        if (index + 1 < this.starts.length()) { end = this.starts[index + 1]; }
        return this.encoded.view().slice(from: this.starts[index], count: end - this.starts[index]);
    }
    const fn Wait waiting() { return this.waits; }
    const fn bool watches() { return this.watching; }
    // The index of the last WATCH or UNWATCH, -1 for none, and what it does once answered OK.
    const fn isize watchIndex() { return this.lastWatch; }
    const fn int32 watchResult() { return this.lastEffect; }

    // Why it will not be sent, if it will not: `Value` for an argument, `Usage` otherwise.
    const fn Optional<RedisError> problem() {
        if (!this.refused) { return Optional::None; }
        if (this.misuse) { return Optional::Some(value: RedisError::Usage(detail: copy this.trouble)); }
        return Optional::Some(value: RedisError::Value(detail: copy this.trouble));
    }
}

// A pipeline's replies, in the order of its commands, each its command's own: a value, or an error. Each is taken once.
// On a connection the error is the server's (an error reply); on a cluster it can also be the failure of a node's
// link, for the commands that node had, which may have run.
type resource Replies implements Sendable {
    DynamicArray<Result<Value, RedisError>> results;
    DynamicArray<bool> taken;

    friend redis::Connection::finish[of];
    friend redis::Connection::transactAt[of];
    friend redis::Cluster::run[ofResults];

    ctor of(DynamicArray<Value> values) {
        this.taken = DynamicArray.empty();
        this.results = DynamicArray.withCapacity(capacity: values.length());
        isize i = 0;
        while (i < values.length()) {
            Value v = replace::<Value>(place: values[i], with: Value::Null);
            i = i + 1;
            this.taken.add(item: false);
            if (v.isError()) {
                RedisError e = RedisError::Server(error: serverError(v: v));
                Value dropped = give v;
                this.results.add(item: Result::Err(error: give e));
            } else {
                this.results.add(item: Result::Ok(value: give v));
            }
        }
    }

    ctor ofResults(DynamicArray<Result<Value, RedisError>> results) {
        this.taken = DynamicArray.empty();
        isize i = 0;
        while (i < results.length()) { this.taken.add(item: false); i = i + 1; }
        this.results = give results;
    }

    public const fn isize length() { return this.results.length(); }

    // The reply to command `index` (0 for the first), taken out: an error reply is `Server`, as `call` gives one, and
    // the other replies are still there. A reply taken already is `Usage`; an index past the end panics, as a
    // collection's does.
    public fn Result<Value, RedisError> take(isize index) {
        if (index < 0 || index >= this.results.length()) {
            isize n = this.results.length();
            panic(msg: "Replies.take: index ${index} of ${n} replies");
        }
        if (this.taken[index]) {
            return Result::Err(error: RedisError::Usage(detail: "reply ${index} was taken already: each reply is taken once"));
        }
        this.taken[index] = true;
        return replace::<Result<Value, RedisError>>(place: this.results[index], with: Result::Err(error: RedisError::Closed));
    }
}
