import { std::collections::DynamicArray, redis::Command, redis::RedisError, redis::wire::Commands, redis::wire::Keys,
         redis::wire::keysOf, redis::wire::slotIn };
export { CommandTable, CommandKeys };

// A command's keys, and the slot a cluster sends it to, as the servers themselves say: from every server's COMMAND
// key specifications (src/wire/commands.kama, generated by tools/gen-command-table.sh), read as the server reads them.
// `keysOf` is what COMMAND GETKEYS answers; `slotOf` is what a cluster routes by, which is the keys and a shard
// channel (SPUBLISH, SSUBSCRIBE). Load the table once: it holds every command the servers in the matrix have.
//
//   CommandTable table = CommandTable.load();
//   Result<Optional<isize>, RedisError> slot = table.slotOf(command: cmd"MGET {user:1}:name {user:1}:email");
type resource CommandTable implements Sendable {
    Commands commands;

    public ctor load() { this.commands = Commands.load(); }

    // How many commands and subcommands it knows.
    public const fn isize count() { return this.commands.count(); }

    // The arguments of `command` that are keys, as COMMAND GETKEYS finds them. `Usage` for a command the table does
    // not know (a module's, a newer server's).
    public unsafe fn Result<CommandKeys, RedisError> keysOf(const ref Command command) {
        isize at = this.commands.indexOf(command: command);
        if (at < 0) { return Result::Err(error: unknown(command: command)); }
        Keys k = keysOf(info: this.commands.at(index: at), command: command, notKeys: false);
        return Result::Ok(value: CommandKeys.of(keys: give k));
    }

    // The slot a cluster sends `command` to: its keys' (a shard channel's included); None for a command without keys,
    // which any node can take. `Usage` for keys in more than one slot, which a cluster refuses (CROSSSLOT), and for a
    // command the table does not know.
    public unsafe fn Result<Optional<isize>, RedisError> slotOf(const ref Command command) {
        isize at = this.commands.indexOf(command: command);
        if (at < 0) { return Result::Err(error: unknown(command: command)); }
        Keys k = keysOf(info: this.commands.at(index: at), command: command, notKeys: true);
        return slotIn(command: command, keys: k);
    }
}

// Which arguments of a command are keys (0 is the command's name), in the order the specs find them, and whether one
// could not be followed to its end, so that the server may find more (SORT's STORE, MIGRATE's KEYS).
type resource CommandKeys implements Sendable {
    Keys found;

    friend redis::cluster::CommandTable::keysOf[of];

    ctor of(Keys keys) { this.found = give keys; }

    public const fn isize count() { return this.found.count(); }
    public const fn isize position(isize index) { return this.found.at(index: index); }
    public const fn bool partial() { return this.found.partial(); }
}

fn RedisError unknown(const ref Command command) {
    return RedisError::Usage(detail: "this client's table of commands does not know this one (a module's, or a newer server's): send it to the node a key names with Cluster.callFor, or to every node with Cluster.callEach");
}
