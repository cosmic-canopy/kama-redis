import { std::collections::ConstView };
export { decimal, unsignedDecimal };

// The server's own grammar for an integer (string2ll in util.c), which both a reply's text and a command's timeout
// are read by.

// A decimal integer as the server writes one (string2ll): an optional '-', then digits with no leading zero, and
// nothing else — no '+', no space, no "-0". None when `b` is not one, or does not fit an int64.
fn Optional<int64> decimal(ConstView<uint8> b) {
    isize n = b.length();
    if (n == 0 || n > 20) { return Optional::None; }
    bool negative = b[0] == 45;
    isize i = 0;
    if (negative) { i = 1; }
    if (i == n) { return Optional::None; }
    if (b[i] == 48) {
        if (n == 1) { return Optional::Some(value: 0i64); }
        return Optional::None;
    }
    uint64 limit = 9223372036854775807ui64;
    if (negative) { limit = 9223372036854775808ui64; }
    uint64 v = 0ui64;
    while (i < n) {
        uint8 c = b[i];
        if (c < 48 || c > 57) { return Optional::None; }
        uint64 d = cast<uint64>(c - 48);
        if (v > (limit - d) / 10ui64) { return Optional::None; }
        v = v * 10ui64 + d;
        i = i + 1;
    }
    if (!negative) { return Optional::Some(value: cast<int64>(v)); }
    if (v == 9223372036854775808ui64) { return Optional::Some(value: -9223372036854775807i64 - 1i64); }
    return Optional::Some(value: 0i64 - cast<int64>(v));
}

// The same grammar for a uint64: digits only, no leading zero.
fn Optional<uint64> unsignedDecimal(ConstView<uint8> b) {
    isize n = b.length();
    if (n == 0 || n > 20) { return Optional::None; }
    if (b[0] == 48) {
        if (n == 1) { return Optional::Some(value: 0ui64); }
        return Optional::None;
    }
    uint64 limit = 18446744073709551615ui64;
    uint64 v = 0ui64;
    isize i = 0;
    while (i < n) {
        uint8 c = b[i];
        if (c < 48 || c > 57) { return Optional::None; }
        uint64 d = cast<uint64>(c - 48);
        if (v > (limit - d) / 10ui64) { return Optional::None; }
        v = v * 10ui64 + d;
        i = i + 1;
    }
    return Optional::Some(value: v);
}
