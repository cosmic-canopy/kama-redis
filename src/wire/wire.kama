import { std::collections::ConstView, std::collections::DynamicArray, std::io::IoError, std::io::IoErrorKind, std::memory::Owned,
         std::time::Instant, std::time::Duration, std::time::monotonicNow,
         redis::Transport, redis::Interest, redis::Ready, redis::RedisError, redis::resp::Reader, redis::resp::Read, redis::resp::Value,
         redis::resp::Limits };
export { Wire, Deadline, footprint, unattributed };

// redis::wire — RESP over a `Transport`: replies read as they arrive, straight into the reader's buffer
// (`resp::Reader.spare`/`commit`), and requests written out, each step bounded by a deadline. Internal: a
// connection is the only user.

// When a wait must end: never, or at an instant of the monotonic clock.
type value Deadline implements Sendable {
    bool bounded = false;
    Instant at;

    public ctor none() { this.bounded = false; this.at = Instant.of(rawNanos: 0ui64); }
    public unsafe ctor after(Duration span) { this.bounded = true; this.at = monotonicNow() + span; }
    // `after(span)`, or `none()` for a zero span, which is how a setting says "no limit".
    public unsafe ctor within(Duration span) {
        this.bounded = span.asNanos() > 0i64;
        this.at = Instant.of(rawNanos: 0ui64);
        if (this.bounded) { this.at = monotonicNow() + span; }
    }

    public const fn bool isBounded() { return this.bounded; }

    // The instant it passes; meaningful only when it is bounded.
    public const fn Instant end() { return this.at; }

    // Whether a wait that ends at `at` ends before this deadline passes: always, when it is not bounded.
    public const fn bool allows(Instant at) { return !this.bounded || at < this.at; }

    // What `Transport.wait` takes: -1 for no limit, else the milliseconds left, rounded up so a wait never ends
    // just short of the deadline and spins; 0 once it has passed.
    public unsafe const fn int32 remainingMs() {
        if (!this.bounded) { return -1; }
        Instant now = monotonicNow();
        if (now >= this.at) { return 0; }
        int64 nanos = (this.at - now).asNanos();
        int64 ms = (nanos + 999999i64) / 1000000i64;
        if (ms > 2147483647i64) { return 2147483647; }
        return cast<int32>(ms);
    }
}

// How much room a read asks the reader for: hiredis's own read size.
comptime isize READ_BYTES = 16384;
// The most reads `catchUp` makes, so that a server sending without pause cannot hold a call before it writes.
comptime isize CATCH_UP_READS = 64;

type resource Wire implements Sendable {
    Owned<Transport> link;
    Reader reader;
    // How many writes this link has begun: a client-side cache's sync rule counts them (Connection.cached).
    int64 writes = 0;

    public ctor over(Owned<Transport> transport, Limits limits) {
        this.link = give transport;
        this.reader = Reader.withLimits(limits: limits);
    }

    // The next value from the server, once all its bytes have come. Bytes that break RESP are `Protocol`, and the
    // reader answers the same from then on: nothing says where the next reply starts.
    public unsafe fn Result<Value, RedisError> receive(Deadline deadline) {
        while (true) {
            Read r = this.reader.next();
            match (give r) {
                case Complete(value: v): { return Result::Ok(value: give v); }
                case Invalid(error: e): { return Result::Err(error: RedisError::Protocol(error: e)); }
                case Incomplete: {
                    Result<Unit, RedisError> filled = this.fill(deadline: deadline);
                    match (give filled) { case Ok(value: u): { } case Err(error: e): { return Result::Err(error: give e); } };
                }
            };
        }
    }

    // Write all of `bytes`, waiting for the transport as often as it needs, until `deadline`. While a write must
    // wait, whatever the server sends is read into the reader, as libpq's pqSendSome reads: a server answering the
    // commands it already has stops reading once its own output fills, so a client that only wrote would wait
    // forever on a long pipeline. Once the server has stopped sending (EOF, an error), only writing is waited for;
    // the reader meets the end when it gets there.
    public unsafe fn Result<Unit, RedisError> send(ConstView<uint8> bytes, Deadline deadline) {
        this.writes = this.writes + 1i64;
        isize sent = 0;
        bool reading = true;
        while (sent < bytes.length()) {
            Result<isize, IoError> w = this.link.write(bytes: bytes.slice(from: sent, count: bytes.length() - sent));
            bool wait = false;
            match (w) {
                case Ok(value: n): { if (n > 0) { sent = sent + n; } else { wait = true; } }
                case Err(error: e): {
                    match (e.kind()) { case WouldBlock: { wait = true; } case Interrupted: { } case _: { return Result::Err(error: this.failure(error: e)); } };
                }
            };
            if (wait) {
                Interest want = Interest::Write;
                if (reading) { want = Interest::ReadWrite; }
                Result<Ready, IoError> ready = this.link.wait(interest: want, timeoutMs: deadline.remainingMs());
                Ready r = match (ready) { case Ok(value: v): v; case Err(error: e): { return Result::Err(error: this.failure(error: e)); } };
                if (!r.writable && !(reading && r.readable)) { return Result::Err(error: RedisError::Timeout); }
                if (reading && r.readable) { reading = this.drain(); }
            }
        }
        return Result::Ok(value: Unit::Unit);
    }

    // How many writes this link has begun.
    public const fn int64 written() { return this.writes; }

    // Whether no reply is in progress: nothing buffered, nothing half read.
    public const fn bool isIdle() { return this.reader.isIdle(); }

    // Read whatever has arrived, into the reader, without waiting: before a call writes, what came while no call
    // waited. The end of the stream, or a failure, is `Err`.
    public unsafe fn Result<Unit, RedisError> catchUp() {
        isize reads = 0;
        while (reads < CATCH_UP_READS) {
            Result<isize, IoError> r = this.link.read(into: this.reader.spare(minimum: READ_BYTES));
            match (r) {
                case Ok(value: n): {
                    if (n == 0) { return Result::Err(error: this.failure(error: IoError.of(kind: IoErrorKind::UnexpectedEof))); }
                    this.reader.commit(count: n);
                }
                case Err(error: e): {
                    match (e.kind()) { case WouldBlock: { return Result::Ok(value: Unit::Unit); } case Interrupted: { } case _: { return Result::Err(error: this.failure(error: e)); } };
                }
            };
            reads = reads + 1;
        }
        return Result::Ok(value: Unit::Unit);
    }

    // The next whole value among the bytes already read, without reading more.
    public fn Read nextBuffered() { return this.reader.next(); }

    // The type byte of a value half come; 0 when none is (resp::Reader.pendingKind).
    public const fn uint8 pendingKind() { return this.reader.pendingKind(); }

    // Stop the transport in both directions.
    public unsafe fn void shutdown() { this.link.shutdown(); }

    // One read of whatever has arrived, into the reader. False once the server has stopped sending: at EOF, or on
    // an error, which a later read reports.
    unsafe fn bool drain() {
        Result<isize, IoError> r = this.link.read(into: this.reader.spare(minimum: READ_BYTES));
        match (r) {
            case Ok(value: n): {
                if (n == 0) { return false; }
                this.reader.commit(count: n);
            }
            case Err(error: e): {
                match (e.kind()) { case WouldBlock: { } case Interrupted: { } case _: { return false; } };
            }
        };
        return true;
    }

    // Read until at least one more byte has come.
    unsafe fn Result<Unit, RedisError> fill(Deadline deadline) {
        while (true) {
            Result<isize, IoError> r = this.link.read(into: this.reader.spare(minimum: READ_BYTES));
            bool wait = false;
            match (r) {
                case Ok(value: n): {
                    if (n == 0) { return Result::Err(error: this.failure(error: IoError.of(kind: IoErrorKind::UnexpectedEof))); }
                    this.reader.commit(count: n);
                    return Result::Ok(value: Unit::Unit);
                }
                case Err(error: e): {
                    match (e.kind()) { case WouldBlock: { wait = true; } case Interrupted: { } case _: { return Result::Err(error: this.failure(error: e)); } };
                }
            };
            if (wait) {
                Result<Ready, IoError> w = this.link.wait(interest: Interest::Read, timeoutMs: deadline.remainingMs());
                Ready ready = match (w) { case Ok(value: v): v; case Err(error: e): { return Result::Err(error: this.failure(error: e)); } };
                // Only the side asked for counts: a transport ready to write has not let a read proceed.
                if (!ready.readable) { return Result::Err(error: RedisError::Timeout); }
            }
        }
    }

    // A failure the transport reported, in its own words when it has them (a TLS transport's), else as the I/O
    // error it is.
    fn RedisError failure(IoError error) {
        Optional<RedisError> own = this.link.explain(error: error);
        return match (give own) { case Some(value: p): give p; case None: RedisError::Io(error: error); };
    }
}

// What `v` holds in memory, counted as the reader counts a reply (resp::Limits.maxReplyBytes): its bytes, plus
// `sizeof(Value)` for itself and for each value inside it. It bounds what a connection keeps aside.
fn int64 footprint(const ref Value v) {
    int64 own = cast<int64>(sizeof(Value));
    return match (v) {
        case Simple(bytes: b): own + cast<int64>(b.length());
        case Error(bytes: b): own + cast<int64>(b.length());
        case BigNumber(digits: b): own + cast<int64>(b.length());
        case Bulk(bytes: b): own + cast<int64>(b.length());
        case Verbatim(format: m, bytes: b): own + cast<int64>(m.length()) + cast<int64>(b.length());
        case Array(items: xs): own + footprintAll(xs: xs);
        case Map(entries: xs): own + footprintAll(xs: xs);
        case Set(items: xs): own + footprintAll(xs: xs);
        case Push(items: xs): own + footprintAll(xs: xs);
        case Attributed(parts: xs): own + footprintAll(xs: xs);
        case _: own;
    };
}

fn int64 footprintAll(const ref DynamicArray<Value> xs) {
    int64 total = 0;
    isize i = 0;
    while (i < xs.length()) { total = total + footprint(v: xs[i]); i = i + 1; }
    return total;
}

// A value without the RESP3 attributes around it: the value they describe.
fn Value unattributed(Value v) {
    Value current = give v;
    while (true) {
        bool wrapped = match (current) { case Attributed(parts: ps): ps.length() > 0; case _: false; };
        if (!wrapped) { return give current; }
        DynamicArray<Value> parts = match (give current) { case Attributed(parts: ps): give ps; case _: DynamicArray.empty(); };
        Optional<Value> last = parts.pop();
        current = match (give last) { case Some(value: x): give x; case None: Value::Null; };
    }
}
