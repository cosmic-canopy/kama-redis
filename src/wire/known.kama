import { std::collections::ConstView, std::time::Duration, std::fmt::parse, std::fmt::ParseError,
         std::encoding::utf8::decode, std::encoding::utf8::Utf8Error, redis::Command, redis::RedisError,
         redis::ServerError, redis::resp::Value, Deadline, decimal };
export { admit, serverError, isWatch, watchEffect, Wait, blockingWait, later, callDeadline };

// What a connection knows about a command before it sends it. (docs/ROADMAP.md, "Decided, and why", "Phase 3".)
//
// A command whose reply would not be its own is refused, by name and case-insensitively, as the server looks a
// command up. Each of these changes what the connection's next replies are, and a connection matches every reply to
// the command it sent:
//   - SUBSCRIBE and its kin put the connection in subscriber mode, where what comes back is messages;
//   - MONITOR turns it into a stream of every command the server runs, SYNC and PSYNC into a replication stream;
//   - CLIENT REPLY OFF or SKIP stop replies, and SCRIPT DEBUG turns the next EVAL into a debugging session;
//   - CLIENT TRACKING and CLIENT CACHING turn on client-side caching's invalidations, which nothing here reads yet
//     (0.3.0 brings the cache); TRACKINGINFO and GETREDIR, which only report, are allowed;
//   - HELLO and RESET change the protocol or the connection's state behind the client's back, and QUIT closes it;
//   - MULTI, EXEC and DISCARD: `Connection.transact` sends a transaction whole, MULTI to EXEC in one write, so the
//     connection is never left inside one.
// And a command that sets what the connection is is refused, since a reconnect would quietly undo it (docs/ROADMAP.md,
// "Phase 7a"): SELECT and AUTH, which `Connection.select` and `authenticate` do and every reconnect keeps; CLIENT
// SETNAME and SETINFO, which the handshake sends from the Config; and CLIENT NO-EVICT, NO-TOUCH, CAPA and
// IMPORT-SOURCE, READONLY and READWRITE, which nothing here would set again. The table is checked against every
// server's `ACL CAT connection` (tests/unit/src/connection_test.kama).
// WATCH and UNWATCH are allowed, outside a transaction (the server refuses them inside one).
//
// A blocking command waits on the server for as long as its own timeout says, so its deadline is that timeout plus
// `command_timeout` (blockingWait). The table is checked against every server's `ACL CAT blocking` and COMMAND DOCS
// (tests/unit/src/blocking_test.kama).

// Whether `command` may be sent: the first reason it was refused while it was built, then the table.
fn Result<Unit, RedisError> admit(const ref Command command) {
    Optional<RedisError> problem = command.problem();
    match (give problem) {
        case Some(value: e): { return Result::Err(error: give e); }
        case None: { }
    };
    string why = refusal(command: command);
    if (why.length() > 0) { return Result::Err(error: RedisError::Usage(detail: give why)); }
    return Result::Ok(value: Unit::Unit);
}

fn string refusal(const ref Command command) {
    if (named(command: command, word: "SUBSCRIBE") || named(command: command, word: "PSUBSCRIBE")
        || named(command: command, word: "SSUBSCRIBE") || named(command: command, word: "UNSUBSCRIBE")
        || named(command: command, word: "PUNSUBSCRIBE") || named(command: command, word: "SUNSUBSCRIBE")) {
        return "a connection does not carry pub/sub commands: a subscribed connection's replies are messages, not replies to its commands";
    }
    if (named(command: command, word: "MONITOR")) {
        return "a connection does not carry MONITOR: it turns the connection into a stream of every command the server runs";
    }
    if (named(command: command, word: "SYNC") || named(command: command, word: "PSYNC")) {
        return "a connection does not carry SYNC or PSYNC: they turn the connection into a replication stream";
    }
    if (named(command: command, word: "CLIENT") && subNamed(command: command, word: "REPLY")) {
        return "a connection does not carry CLIENT REPLY: every command it sends is matched to its reply";
    }
    if (named(command: command, word: "CLIENT") && (subNamed(command: command, word: "TRACKING") || subNamed(command: command, word: "CACHING"))) {
        return "a connection does not carry CLIENT TRACKING or CLIENT CACHING: client-side caching comes with a later release of this client, and tracking turned on by hand would pile invalidations up unread";
    }
    if (named(command: command, word: "SCRIPT") && subNamed(command: command, word: "DEBUG")) {
        return "a connection does not carry SCRIPT DEBUG: it turns the next EVAL into a debugging session";
    }
    if (named(command: command, word: "HELLO")) {
        return "a connection does not carry HELLO: the handshake sends it, from the Config's protocol, user and client name";
    }
    if (named(command: command, word: "RESET")) {
        return "a connection does not carry RESET: it drops the connection's state behind the client's back; open a new connection";
    }
    if (named(command: command, word: "MULTI") || named(command: command, word: "EXEC") || named(command: command, word: "DISCARD")) {
        return "a connection does not carry MULTI, EXEC or DISCARD: transact sends a transaction whole, MULTI to EXEC in one write";
    }
    if (named(command: command, word: "QUIT")) {
        return "a connection does not carry QUIT, which is deprecated since 7.2: close() closes the connection";
    }
    if (named(command: command, word: "SELECT")) {
        return "a connection does not carry SELECT: a reconnect would go back to the Config's database without a word; select(db:) changes it, and every reconnect keeps it";
    }
    if (named(command: command, word: "AUTH")) {
        return "a connection does not carry AUTH: a reconnect logs in as the Config says; authenticate(user:, password:) changes who it is, and every reconnect keeps it";
    }
    if (named(command: command, word: "CLIENT") && subNamed(command: command, word: "SETNAME")) {
        return "a connection does not carry CLIENT SETNAME: the name is the Config's client_name, which the handshake sends, and every reconnect sends again";
    }
    if (named(command: command, word: "CLIENT") && subNamed(command: command, word: "SETINFO")) {
        return "a connection does not carry CLIENT SETINFO: the handshake names this library (Config.setIdentity), and every reconnect does again";
    }
    if (named(command: command, word: "CLIENT") && (subNamed(command: command, word: "NO-EVICT") || subNamed(command: command, word: "NO-TOUCH")
        || subNamed(command: command, word: "CAPA") || subNamed(command: command, word: "IMPORT-SOURCE"))) {
        return "a connection does not carry CLIENT NO-EVICT, NO-TOUCH, CAPA or IMPORT-SOURCE: each sets something on the connection that a reconnect would lose without a word";
    }
    if (named(command: command, word: "READONLY") || named(command: command, word: "READWRITE")) {
        return "a connection does not carry READONLY or READWRITE: they are for reading from a cluster's replicas, which a later release of this client brings, and a reconnect would lose them without a word";
    }
    return "";
}

// Whether `command` is WATCH or UNWATCH, which the server refuses inside a transaction.
fn bool isWatch(const ref Command command) {
    return named(command: command, word: "WATCH") || named(command: command, word: "UNWATCH");
}

// What `command` does to the keys a connection watches, once the server answers it OK: 1 for WATCH, which adds to
// them, -1 for UNWATCH, which drops them all, and 0 for anything else.
fn int32 watchEffect(const ref Command command) {
    if (named(command: command, word: "WATCH")) { return 1; }
    if (named(command: command, word: "UNWATCH")) { return -1; }
    return 0;
}

// The error a `Value::Error` holds.
fn ServerError serverError(const ref Value v) {
    return match (v) {
        case Error(bytes: b): ServerError.of(bytes: b.view());
        case _: ServerError.of(bytes: "".bytes());
    };
}

fn bool named(const ref Command command, const ref string word) {
    return sameWord(part: command.part(index: 0), word: word);
}

fn bool subNamed(const ref Command command, const ref string word) {
    return command.length() > 1 && sameWord(part: command.part(index: 1), word: word);
}

// Whether `part` is `word` (upper case) in any case: ASCII letters fold, as the server's lookup folds them.
fn bool sameWord(ConstView<uint8> part, const ref string word) {
    if (part.length() != word.length()) { return false; }
    isize i = 0;
    while (i < part.length()) {
        uint8 b = part[i];
        if (b >= 97 && b <= 122) { b = b - 32; }
        if (b != word[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// ---- blocking commands ----

// How long a command may wait on the server before its reply: no longer than it takes to answer (it does not block,
// or the server refuses its timeout at once), a span (its own timeout), or for ever (a timeout of 0).
type enum Wait implements Sendable { Span(Duration span), Forever }

// The longest timeout counted as one: past it a wait is for ever. 10^12 ms is 31 years, and it keeps every sum far
// from where a Duration (int64 nanoseconds) would overflow.
comptime int64 LONGEST_MS = 1000000000000;

fn Wait noWait() { return Wait::Span(span: Duration.zero()); }

// How long `command` may block on the server (docs/ROADMAP.md, "Decided, and why", "Phase 3", "Blocking commands").
fn Wait blockingWait(const ref Command command) {
    isize n = command.length();
    if (n < 2) { return noWait(); }
    if (named(command: command, word: "BLPOP") || named(command: command, word: "BRPOP")
        || named(command: command, word: "BZPOPMIN") || named(command: command, word: "BZPOPMAX")
        || named(command: command, word: "BRPOPLPUSH") || named(command: command, word: "BLMOVE")) {
        return seconds(part: command.part(index: n - 1));
    }
    if (named(command: command, word: "BLMOVEM")) {
        if (n < 6) { return noWait(); }
        return seconds(part: command.part(index: 5));
    }
    if (named(command: command, word: "BLMPOP") || named(command: command, word: "BZMPOP")) {
        return seconds(part: command.part(index: 1));
    }
    if (named(command: command, word: "WAIT")) {
        if (n < 3) { return noWait(); }
        return millis(part: command.part(index: 2));
    }
    if (named(command: command, word: "WAITAOF")) {
        if (n < 4) { return noWait(); }
        return millis(part: command.part(index: 3));
    }
    if (named(command: command, word: "XREAD") || named(command: command, word: "XREADGROUP")) {
        return streamWait(command: command);
    }
    return noWait();
}

// XREAD and XREADGROUP: BLOCK's milliseconds, found by stepping over each option before STREAMS by its arity, as
// the server's parser steps. The last BLOCK counts, as it does there. An option the server does not know, or no
// STREAMS, is refused at once.
fn Wait streamWait(const ref Command command) {
    isize n = command.length();
    Wait found = noWait();
    isize i = 1;
    while (i < n) {
        if (wordAt(command: command, at: i, w: "STREAMS")) { return found; }
        if (wordAt(command: command, at: i, w: "BLOCK")) {
            if (i + 1 >= n) { return noWait(); }
            found = millis(part: command.part(index: i + 1));
            i = i + 2;
            continue;
        }
        if (wordAt(command: command, at: i, w: "COUNT") || wordAt(command: command, at: i, w: "MAXCOUNT")
            || wordAt(command: command, at: i, w: "MAXSIZE") || wordAt(command: command, at: i, w: "CLAIM")) {
            i = i + 2;
            continue;
        }
        if (wordAt(command: command, at: i, w: "GROUP")) {
            i = i + 3;
            continue;
        }
        if (wordAt(command: command, at: i, w: "NOACK")) {
            i = i + 1;
            continue;
        }
        return noWait();
    }
    return noWait();
}

// A timeout in seconds, as the server reads one (a long double, times 1000). Less than a millisecond is 0 to some
// servers, which block for ever then, so it is for ever here too: a deadline must never cut a wait short. One the
// server refuses (not a number, NaN, negative, out of range) does not wait.
fn Wait seconds(ConstView<uint8> part) {
    Result<string, Utf8Error> t = decode(bytes: part);
    string text = match (give t) { case Ok(value: x): give x; case Err(error: e): ""; };
    Result<float64, ParseError> p = parse::<float64>(s: text);
    bool number = match (p) { case Ok(value: x): true; case Err(error: e): false; };
    if (!number) { return noWait(); }
    float64 secs = match (p) { case Ok(value: x): x; case Err(error: e): 0.0; };
    if (secs != secs) { return noWait(); }
    float64 ms = secs * 1000.0;
    if (ms <= -1.0 || ms >= 9223372036854775807.0) { return noWait(); }
    if (ms < 1.0) { return Wait::Forever; }
    if (ms > 1000000000000.0) { return Wait::Forever; }
    return Wait::Span(span: Duration.fromMillis(ms: cast<int64>(ms) + 1i64));
}

// A timeout in milliseconds, in the server's integer grammar. 0 is for ever; one the server refuses does not wait.
fn Wait millis(ConstView<uint8> part) {
    Optional<int64> v = decimal(b: part);
    bool number = match (v) { case Some(value: x): true; case None: false; };
    if (!number) { return noWait(); }
    int64 ms = match (v) { case Some(value: x): x; case None: 0i64; };
    if (ms < 0i64) { return noWait(); }
    if (ms == 0i64 || ms > LONGEST_MS) { return Wait::Forever; }
    return Wait::Span(span: Duration.fromMillis(ms: ms));
}

// Two waits one after the other: a pipeline's blocking commands each wait in turn.
fn Wait later(Wait a, Wait b) {
    int64 x = match (a) { case Span(span: s): s.asMillis(); case Forever: -1i64; };
    int64 y = match (b) { case Span(span: s): s.asMillis(); case Forever: -1i64; };
    if (x < 0i64 || y < 0i64 || x + y > LONGEST_MS) { return Wait::Forever; }
    return Wait::Span(span: Duration.fromMillis(ms: x + y));
}

// A call's deadline: `limit` (command_timeout; zero is no limit) plus how long its commands may block on the server.
unsafe fn Deadline callDeadline(Duration limit, Wait extra) {
    int64 ms = limit.asMillis();
    if (ms <= 0i64 && limit.asNanos() <= 0i64) { return Deadline.none(); }
    int64 more = match (extra) { case Span(span: s): s.asMillis(); case Forever: -1i64; };
    if (more < 0i64 || ms > LONGEST_MS) { return Deadline.none(); }
    return Deadline.after(span: limit + Duration.fromMillis(ms: more));
}

fn bool wordAt(const ref Command command, isize at, const ref string w) {
    return sameWord(part: command.part(index: at), word: w);
}
