import { std::collections::DynamicArray, std::collections::ConstView, std::fmt::i64Str, std::fmt::f64Str,
         redis::RedisError, redis::RedisArg, redis::resp::Writer };
export { Command };

// One command: its name and arguments, each a whole RESP bulk string, never text spliced into other text. A
// connection sends it as RESP's array of bulk strings, the only shape a client sends.
//
//   Command c = Command.of(name: "SET");
//   c.arg(text: key);
//   c.argBytes(bytes: payload.view());
//   c.arg(text: "EX");
//   c.argInt(value: 10i64);
//
// or, with typed arguments (`RedisArg`), `c.add(value: ttl)`, or all at once with the tag: `cmd"SET ${key} ${payload}
// EX 10"` (src/arg.kama).
//
// A command can be refused while it is built: an argument that cannot be sent (`refuse`) is `RedisError::Value`, and
// a malformed `cmd"…"` literal is `Usage`. The first reason is kept, and a connection reports it before writing
// anything, so the connection is still usable.
type resource Command implements Sendable {
    DynamicArray<DynamicArray<uint8>> parts;
    bool refused = false;
    bool misuse = false;
    string trouble = "";

    friend redis::wire::admit[problem];
    friend redis::cmd[misused];
    friend redis::ScriptCall::finish[appendFrom];
    friend redis::Scan::next[appendFrom];
    friend redis::Subscriber::change[problem];
    friend redis::Cluster::commandAt[decoded];

    // A command named `name` ("GET", "CLIENT"), with no arguments yet.
    public ctor of(const ref string name) {
        this.parts = DynamicArray.empty();
        this.arg(text: name);
    }

    // The command `bytes` hold, as `encode` wrote it: `*<n>`, then n bulk strings. A cluster reads a pipeline's
    // commands back so to send each where its keys are. Bytes that are not that give the parts read before them.
    ctor decoded(ConstView<uint8> bytes) {
        this.parts = DynamicArray.empty();
        if (bytes.length() < 4 || bytes[0] != 42ui8) { return give this; }
        isize at = 1;
        isize count = 0;
        while (at < bytes.length() && bytes[at] >= 48ui8 && bytes[at] <= 57ui8) { count = count * 10 + cast<isize>(bytes[at] - 48ui8); at = at + 1; }
        at = at + 2;
        isize k = 0;
        while (k < count && at < bytes.length() && bytes[at] == 36ui8) {
            at = at + 1;
            isize size = 0;
            while (at < bytes.length() && bytes[at] >= 48ui8 && bytes[at] <= 57ui8) { size = size * 10 + cast<isize>(bytes[at] - 48ui8); at = at + 1; }
            at = at + 2;
            if (at + size > bytes.length()) { return give this; }
            this.argBytes(bytes: bytes.slice(from: at, count: size));
            at = at + size + 2;
            k = k + 1;
        }
    }

    // An argument: the text's bytes.
    public fn void arg(const ref string text) { this.argBytes(bytes: text.bytes()); }

    // An argument: any bytes, as they are.
    public fn void argBytes(ConstView<uint8> bytes) {
        DynamicArray<uint8> one = DynamicArray.withCapacity(capacity: bytes.length());
        one.addAll(items: bytes);
        this.parts.add(item: give one);
    }

    // An argument: a decimal integer, as the server reads one.
    public fn void argInt(int64 value) {
        string digits = i64Str(v: value);
        this.argBytes(bytes: digits.bytes());
    }

    // Refuse to send this command, because the argument being added cannot be sent; `detail` says why. A `RedisArg`
    // calls it for a value it has no form for (a NaN). Only the first refusal is kept.
    public fn void refuse(const ref string detail) {
        if (this.refused) { return; }
        isize n = this.parts.length();
        this.refused = true;
        this.trouble = "argument ${n}: ".concat(other: detail);
    }

    // Why this command will not be sent, if it will not.
    const fn Optional<RedisError> problem() {
        if (!this.refused) { return Optional::None; }
        if (this.misuse) { return Optional::Some(value: RedisError::Usage(detail: copy this.trouble)); }
        return Optional::Some(value: RedisError::Value(detail: copy this.trouble));
    }

    // An argument: a float, in the shortest decimal that reads back as the same value ("0.1", "1e+21", "-0"), and
    // `inf` or `-inf`. A NaN is refused: the server reads none (ZADD, INCRBYFLOAT and the rest refuse it).
    public fn void argFloat(float64 value) {
        if (value != value) {
            this.refuse(detail: "NaN is not a number the server reads");
            return;
        }
        if (value != 0.0 && value * 0.5 == value) {
            if (value > 0.0) { this.arg(text: "inf"); } else { this.arg(text: "-inf"); }
            return;
        }
        string digits = f64Str(v: value);
        this.argBytes(bytes: digits.bytes());
    }

    // An argument, or several, from a value that writes itself (`RedisArg`): an integer, a float, a string.
    public fn void add(RedisArg value) { value.writeRedisArg(into: ref this); }

    // The `cmd"…"` literal around the holes is malformed; `detail` says how. Reported as `Usage`.
    fn void misused(const ref string detail) {
        if (this.refused) { return; }
        this.refused = true;
        this.misuse = true;
        this.trouble = copy detail;
    }

    // Every argument of `other` (its parts after the name), and why it will not be sent, if it will not.
    fn void appendFrom(const ref Command other) {
        isize i = 1;
        while (i < other.parts.length()) {
            this.argBytes(bytes: other.parts[i].view());
            i = i + 1;
        }
        if (other.refused && !this.refused) {
            this.refused = true;
            this.misuse = other.misuse;
            this.trouble = copy other.trouble;
        }
    }

    // How many parts it has, the name included.
    public const fn isize length() { return this.parts.length(); }
    // Part `index`: 0 is the name.
    public const fn ConstView<uint8> part(isize index) { return this.parts[index].view(); }

    // Write it as RESP: an array of bulk strings.
    public const fn void encode(ref Writer into) {
        into.arrayHeader(count: this.parts.length());
        isize i = 0;
        while (i < this.parts.length()) {
            into.bulk(bytes: this.parts[i].view());
            i = i + 1;
        }
    }
}
