import { std::collections::ConstView, std::collections::DynamicArray, std::time::Duration, redis::RedisUrl,
         redis::UrlTransport, redis::UrlError, redis::RedisError, redis::resp::Limits };
export { Config, Protocol, TlsVerify, TlsVersion, SentinelRole, ReadFrom, socketPathMax };

// How to reach a server and what to ask of it: from a URL (`Config.parse`), or from a host or a socket and typed
// settings (`Config.tcp`, `Config.unix`, then the setters). Every setting is honoured or refused. A URL option this
// client does not know is refused, never ignored (go-redis refuses one too), and so is a value it cannot use.
//
// The URL options (docs/ROADMAP.md, "Phase 2", has what the peer clients call each and why these defaults):
//   protocol=2|3          unset: RESP3, or the RESP2 path when the server refuses HELLO; 3: RESP3 only; 2: RESP2,
//                         without HELLO, for a proxy that does not know it
//   connect_timeout=S     seconds, to the millisecond; 0 for no limit. Default 5. It bounds each address: its TCP
//                         connect and then the handshake. Resolving the host's name is not bounded.
//   command_timeout=S     seconds, to the millisecond; 0 for no limit. Default 5. One deadline per call, from the
//                         first byte written to the last byte of the reply; when it passes, the connection closes.
//   client_name=NAME      CLIENT SETNAME's name: the bytes ! to ~, as the server allows
//   keepalive=S           TCP keepalive, as hiredis sets it: idle S seconds, a probe every S/3, 3 probes. 0 is off.
//                         Default 15, redis-cli's.
//   reconnect=on|off      whether a lost connection is made again by its next call (docs/ROADMAP.md, "Phase 7a"). On
//                         by default; off leaves it closed, for a pool that replaces it.
//   reconnect_timeout=S   seconds, to the millisecond; 0 for no limit. Default 5. How long a call may go on trying to
//                         make a lost connection again, while the server is down or restarting.
// The database is the URL's path (redis://host/2), or ?db= on unix://, as RedisUrl reads it.
//
// Several hosts, comma-separated (docs/ROADMAP.md, "Phase 6"), are a cluster's seeds, for `Cluster.connect`, or on
// redis-sentinel:// and rediss-sentinel:// the sentinels to ask for the server (each on 26379 unless it says otherwise).
// A `Connection` refuses several hosts on any other URL.
//   master_name=NAME      redis-sentinel:// only, and needed there: the name the sentinels monitor the server by
//   role=master|replica   redis-sentinel:// only: the master (the default), or one of its replicas, to read from
//   read_from=primary|replica   a cluster's (Cluster.connect): where a read goes. primary (the default): the slot's
//                         primary; replica: one of its replicas, which may be behind it, or the primary when it has none
//   max_redirects=N       a cluster's: how many MOVED and ASK one call follows, 0 to 100. Default 5.
// The URL's user and password are the server's. The sentinels' own, when they want one, are set in code
// (`setSentinelAuth`), never in a URL.
//
// Over TLS (rediss://, valkeys://) as well (docs/ROADMAP.md, "Phase 5"); each is refused on redis:// and unix://:
//   tls_verify=full|chain|none   full (the default): the certificate chains to a trusted root and names the server;
//                         chain: it chains, and its names are not compared; none: nothing is checked
//   tls_ca=FILE           the PEM roots to trust instead of the system's bundle
//   tls_cert=FILE, tls_key=FILE   a client certificate and its key, in PEM: both, or neither
//   tls_server_name=NAME  the name the certificate must carry, and the SNI sent; default the host. An IP address is
//                         matched against the certificate's IP addresses, and never sent as SNI.
// A file is read when a connection is made, never here, so a renewed certificate is read by the next connection.

// The protocol a connection speaks.
type enum Protocol implements Sendable {
    Resp2,
    Resp3;

    // 2 or 3, as HELLO takes it.
    public const fn int32 number() { return match (this) { case Resp2: 2; case Resp3: 3; }; }
}

// Which server a Sentinel configuration asks the sentinels for.
type enum SentinelRole implements Sendable {
    // The master: GET-MASTER-ADDR-BY-NAME, confirmed with ROLE.
    Master,
    // One of the master's replicas, chosen at random among those the sentinels see up (SENTINEL REPLICAS), for reads.
    Replica;

    // As the role option spells it.
    public const fn string text() { return match (this) { case Master: "master"; case Replica: "replica"; }; }
}

// Where a cluster sends a command that only reads.
type enum ReadFrom implements Sendable {
    // The primary that serves the slot. The default, as every peer client's is.
    Primary,
    // A replica of that primary, chosen at random, or the primary when it has none up; a read the replica will not
    // serve (MASTERDOWN, its link lost) goes again to the primary. A replica may be behind its primary, so a read there
    // can miss a write the caller just made: WAIT first when it must not.
    Replica;

    // As the read_from option spells it.
    public const fn string text() { return match (this) { case Primary: "primary"; case Replica: "replica"; }; }
}

// How a TLS connection checks the server it reached.
type enum TlsVerify implements Sendable {
    // The certificate chains to a trusted root and names the server: a host name among its DNS names, an IP address
    // among its IP addresses. The default, as every peer client's is.
    Full,
    // The certificate chains to a trusted root, and its names are not compared (redis-cli's checking, Lettuce's CA).
    Chain,
    // Nothing is checked: the connection is encrypted, and the server is not authenticated. Only ever asked for by
    // name.
    None;

    // As the tls_verify option spells it.
    public const fn string text() { return match (this) { case Full: "full"; case Chain: "chain"; case None: "none"; }; }
}

// A TLS protocol version. A connection agrees on one between its bounds, TLS 1.2 and 1.3 by default: the servers'
// own default (tls-protocols).
type enum TlsVersion implements Sendable {
    Tls12,
    Tls13;

    // 2 for TLS 1.2, 3 for TLS 1.3, for comparing.
    public const fn int32 minor() { return match (this) { case Tls12: 2; case Tls13: 3; }; }
}

// The longest socket path the platform takes: sizeof(sun_path) less its terminator.
@compileFor(OS_MACOS) fn isize socketPathMax() { return 103; }
@compileFor(!OS_MACOS) fn isize socketPathMax() { return 107; }

comptime int32 DEFAULT_PORT = 6379;
comptime int32 DEFAULT_SENTINEL_PORT = 26379;
comptime int32 DEFAULT_MAX_REDIRECTS = 5;
comptime int32 MOST_REDIRECTS = 100;
comptime int64 DEFAULT_TIMEOUT_SECS = 5i64;
comptime int64 DEFAULT_KEEPALIVE_SECS = 15i64;
// TCP_KEEPIDLE's ceiling on Linux (MAX_TCP_KEEPIDLE), the strictest of the platforms.
comptime int64 MAX_KEEPALIVE_SECS = 32767i64;
// A timeout is at most nine digits of seconds, which a Duration's nanoseconds hold with room to spare.
comptime isize MAX_SECONDS_DIGITS = 9;

type resource Config implements Sendable, Copyable<This>(bare: give) {
    UrlTransport kind;
    string hostText;
    int32 portNumber = 6379;
    string pathText;
    Optional<string> userName;
    Optional<string> secret;
    int64 dbIndex = 0i64;
    Optional<Protocol> protocolChoice;
    Optional<string> nameText;
    Duration connectLimit;
    Duration commandLimit;
    Duration keepAliveIdle;
    Limits readerLimits;
    bool identify = true;
    TlsVerify verifyMode;
    Optional<string> trustPath;
    Optional<DynamicArray<uint8>> trustBytes;
    Optional<string> certPath;
    Optional<string> keyPath;
    Optional<DynamicArray<uint8>> certBytes;
    Optional<DynamicArray<uint8>> keyBytes;
    DynamicArray<uint8> keySecret;
    Optional<string> serverNameText;
    TlsVersion minVersion;
    TlsVersion maxVersion;
    bool reconnecting = true;
    Duration reconnectLimit;
    // The hosts after the first (hostText, portNumber), with their ports: a cluster's seeds, or the sentinels.
    DynamicArray<string> moreHosts;
    DynamicArray<int32> morePorts;
    // Sentinel: the hosts are sentinels, to ask for the server monitored as `master`.
    bool viaSentinels = false;
    Optional<string> master;
    SentinelRole sentinelRole;
    Optional<string> sentinelUserName;
    Optional<string> sentinelSecret;
    // A cluster's options, set or not, so a `Connection` can refuse them.
    Optional<ReadFrom> readChoice;
    Optional<int32> redirectChoice;
    // A cluster node's link that serves reads from a replica (read_from=replica): READONLY in its handshake, every
    // time it is made. Set by the cluster alone.
    bool replicaReads = false;

    // A connection through sentinels asks each one with `forSentinel`, and reaches the server it names with `forNode`.
    friend redis::Connection::askSentinels[forSentinel, forNode];
    friend redis::Cluster::nodeConfig[forNode, replicaReads];
    friend redis::Connection::handshake[replicaReads];
    friend redis::Connection::resp2Handshake[replicaReads];

    ctor blank(UrlTransport kind) {
        this.kind = kind;
        this.hostText = "127.0.0.1";
        this.portNumber = DEFAULT_PORT;
        this.pathText = "";
        this.userName = Optional::None;
        this.secret = Optional::None;
        this.dbIndex = 0i64;
        this.protocolChoice = Optional::None;
        this.nameText = Optional::None;
        this.connectLimit = Duration.fromSecs(s: DEFAULT_TIMEOUT_SECS);
        this.commandLimit = Duration.fromSecs(s: DEFAULT_TIMEOUT_SECS);
        this.keepAliveIdle = Duration.fromSecs(s: DEFAULT_KEEPALIVE_SECS);
        this.readerLimits = Limits.defaults();
        this.identify = true;
        this.verifyMode = TlsVerify::Full;
        this.trustPath = Optional::None;
        this.trustBytes = Optional::None;
        this.certPath = Optional::None;
        this.keyPath = Optional::None;
        this.certBytes = Optional::None;
        this.keyBytes = Optional::None;
        this.keySecret = DynamicArray.empty();
        this.serverNameText = Optional::None;
        this.minVersion = TlsVersion::Tls12;
        this.maxVersion = TlsVersion::Tls13;
        this.reconnecting = true;
        this.reconnectLimit = Duration.fromSecs(s: DEFAULT_TIMEOUT_SECS);
        this.moreHosts = DynamicArray.empty();
        this.morePorts = DynamicArray.empty();
        this.viaSentinels = false;
        this.master = Optional::None;
        this.sentinelRole = SentinelRole::Master;
        this.sentinelUserName = Optional::None;
        this.sentinelSecret = Optional::None;
        this.readChoice = Optional::None;
        this.redirectChoice = Optional::None;
    }

    public ctor copy(ref Config source) {
        this.kind = source.kind;
        this.hostText = copy source.hostText;
        this.portNumber = source.portNumber;
        this.pathText = copy source.pathText;
        this.userName = copy source.userName;
        this.secret = copy source.secret;
        this.dbIndex = source.dbIndex;
        this.protocolChoice = source.protocolChoice;
        this.nameText = copy source.nameText;
        this.connectLimit = source.connectLimit;
        this.commandLimit = source.commandLimit;
        this.keepAliveIdle = source.keepAliveIdle;
        this.readerLimits = source.readerLimits;
        this.identify = source.identify;
        this.verifyMode = source.verifyMode;
        this.trustPath = copy source.trustPath;
        this.trustBytes = copy source.trustBytes;
        this.certPath = copy source.certPath;
        this.keyPath = copy source.keyPath;
        this.certBytes = copy source.certBytes;
        this.keyBytes = copy source.keyBytes;
        this.keySecret = copy source.keySecret;
        this.serverNameText = copy source.serverNameText;
        this.minVersion = source.minVersion;
        this.maxVersion = source.maxVersion;
        this.reconnecting = source.reconnecting;
        this.reconnectLimit = source.reconnectLimit;
        this.moreHosts = copy source.moreHosts;
        this.morePorts = copy source.morePorts;
        this.viaSentinels = source.viaSentinels;
        this.master = copy source.master;
        this.sentinelRole = source.sentinelRole;
        this.sentinelUserName = copy source.sentinelUserName;
        this.sentinelSecret = copy source.sentinelSecret;
        this.readChoice = source.readChoice;
        this.redirectChoice = source.redirectChoice;
        this.replicaReads = source.replicaReads;
    }

    // A connection URL: redis://, valkey://, rediss://, valkeys://, unix://, redis-sentinel:// or rediss-sentinel://
    // (src/url.kama says how each is read), with the options above.
    public ctor Result<Config, RedisError> parse(const ref string url) {
        Result<RedisUrl, UrlError> read = RedisUrl.parse(text: url);
        RedisUrl u = match (give read) {
            case Ok(value: v): give v;
            case Err(error: e): { return Result::Err(error: RedisError::Config(detail: e.message())); }
        };
        UrlTransport kind = u.transport();
        Config c = Config.blank(kind: kind);
        c.viaSentinels = u.isSentinel();
        if (c.viaSentinels) { c.portNumber = DEFAULT_SENTINEL_PORT; }
        if (kind == UrlTransport::Unix) {
            string path = u.socketPath();
            Optional<RedisError> bad = checkPath(path: path);
            match (give bad) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
            c.pathText = give path;
        } else {
            Optional<string> h = u.host();
            match (give h) { case Some(value: v): { c.hostText = give v; } case None: { } };
            Optional<int32> p = u.port();
            match (p) { case Some(value: v): { c.portNumber = v; } case None: { } };
            int32 fallback = DEFAULT_PORT;
            if (c.viaSentinels) { fallback = DEFAULT_SENTINEL_PORT; }
            isize k = 1;
            while (k < u.hostCount()) {
                c.moreHosts.add(item: u.hostAt(index: k));
                int32 port = match (u.portAt(index: k)) { case Some(value: v): v; case None: fallback; };
                c.morePorts.add(item: port);
                k = k + 1;
            }
        }
        c.userName = u.user();
        c.secret = u.password();
        Optional<int64> d = u.db();
        match (d) { case Some(value: v): { c.dbIndex = v; } case None: { } };
        isize i = 0;
        while (i < u.queryLength()) {
            string key = u.queryKey(index: i);
            string value = u.queryValue(index: i);
            Optional<RedisError> bad = c.option(key: key, value: value);
            match (give bad) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
            i = i + 1;
        }
        Optional<RedisError> unpaired = c.tlsAgreement();
        match (give unpaired) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        bool named = match (c.master) { case Some(value: m): true; case None: false; };
        if (c.viaSentinels && !named) {
            return Result::Err(error: RedisError::Config(detail: "a Sentinel URL names the master the sentinels monitor: ?master_name=mymaster"));
        }
        return Result::Ok(value: give c);
    }

    // A server at `host` (a name, or an IP address without brackets) and `port`, over TCP.
    public ctor Result<Config, RedisError> tcp(string host, int32 port) {
        if (host.length() == 0) { return Result::Err(error: RedisError::Config(detail: "the host is empty: give a name or an address")); }
        if (port < 1 || port > 65535) { return Result::Err(error: RedisError::Config(detail: "the port is a number from 1 to 65535")); }
        Config c = Config.blank(kind: UrlTransport::Tcp);
        c.hostText = give host;
        c.portNumber = port;
        return Result::Ok(value: give c);
    }

    // A server at `host` and `port`, over TLS: the certificate is verified against the system's roots and must name
    // `host` (TlsVerify::Full), until the setters below say otherwise.
    public ctor Result<Config, RedisError> tls(string host, int32 port) {
        Result<Config, RedisError> made = Config.tcp(host: give host, port: port);
        Config c = match (give made) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
        c.kind = UrlTransport::Tls;
        return Result::Ok(value: give c);
    }

    // The server the sentinels at `host` and `port` monitor as `masterName`, found through them (Sentinel's client
    // specification); more sentinels with `addHost`. `tls` makes every connection TLS, the sentinels' and the
    // server's, until the setters below say otherwise.
    public ctor Result<Config, RedisError> sentinel(string masterName, string host, int32 port, bool tls) {
        if (masterName.length() == 0) { return Result::Err(error: RedisError::Config(detail: "the master's name is empty: give the name the sentinels monitor it by")); }
        Result<Config, RedisError> made = Config.tcp(host: give host, port: port);
        Config c = match (give made) { case Ok(value: v): give v; case Err(error: e): { return Result::Err(error: give e); } };
        if (tls) { c.kind = UrlTransport::Tls; }
        c.viaSentinels = true;
        c.master = Optional::Some(value: give masterName);
        return Result::Ok(value: give c);
    }

    // A server on the Unix-domain socket at `path`.
    public ctor Result<Config, RedisError> unix(string path) {
        Optional<RedisError> bad = checkPath(path: path);
        match (give bad) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        Config c = Config.blank(kind: UrlTransport::Unix);
        c.pathText = give path;
        return Result::Ok(value: give c);
    }

    // AUTH's user and password. With no user, the password is the `default` user's, as `requirepass` sets it.
    public fn Result<Unit, RedisError> setAuth(Optional<string> user, string password) {
        if (password.length() == 0) { return Result::Err(error: RedisError::Config(detail: "the password is empty: an empty password authenticates no one, so leave it out")); }
        bool emptyUser = match (user) { case Some(value: u): u.length() == 0; case None: false; };
        if (emptyUser) { return Result::Err(error: RedisError::Config(detail: "the user is empty: give a user, or none for the default user")); }
        this.userName = give user;
        this.secret = Optional::Some(value: give password);
        return Result::Ok(value: Unit::Unit);
    }

    // The database to SELECT. 0, the server's default, sends no SELECT. The server refuses one past its last.
    public fn Result<Unit, RedisError> setDatabase(int64 db) {
        if (db < 0i64) { return Result::Err(error: RedisError::Config(detail: "the database is a number from 0")); }
        this.dbIndex = db;
        return Result::Ok(value: Unit::Unit);
    }

    // RESP3 only, or RESP2 only. Without this, a connection speaks RESP3, or RESP2 where the server refuses HELLO.
    public fn void setProtocol(Protocol protocol) { this.protocolChoice = Optional::Some(value: protocol); }

    // The connection's name, as CLIENT SETNAME sets it.
    public fn Result<Unit, RedisError> setClientName(string name) {
        Optional<RedisError> bad = checkName(name: name.bytes(), what: "client_name");
        match (give bad) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        this.nameText = Optional::Some(value: give name);
        return Result::Ok(value: Unit::Unit);
    }

    // How long each address may take to connect and finish the handshake. Zero is no limit.
    public fn Result<Unit, RedisError> setConnectTimeout(Duration timeout) {
        if (timeout.isNegative()) { return Result::Err(error: RedisError::Config(detail: "connect_timeout cannot be negative: 0 is no limit")); }
        this.connectLimit = timeout;
        return Result::Ok(value: Unit::Unit);
    }

    // How long a call may take, from the first byte written to the last byte of the reply. Zero is no limit.
    public fn Result<Unit, RedisError> setCommandTimeout(Duration timeout) {
        if (timeout.isNegative()) { return Result::Err(error: RedisError::Config(detail: "command_timeout cannot be negative: 0 is no limit")); }
        this.commandLimit = timeout;
        return Result::Ok(value: Unit::Unit);
    }

    // TCP keepalive, in whole seconds, as hiredis's redisKeepAlive takes it. Zero turns it off.
    public fn Result<Unit, RedisError> setKeepAlive(Duration interval) {
        int64 n = interval.asNanos();
        if (n < 0i64 || n % 1000000000i64 != 0i64 || interval.asSecs() > MAX_KEEPALIVE_SECS) {
            return Result::Err(error: keepAliveRefused());
        }
        this.keepAliveIdle = interval;
        return Result::Ok(value: Unit::Unit);
    }

    // Whether a lost connection is made again by its next call. On by default; off leaves it closed.
    public fn void setReconnect(bool on) { this.reconnecting = on; }

    // How long a call may go on trying to make a lost connection again. Zero is no limit.
    public fn Result<Unit, RedisError> setReconnectTimeout(Duration timeout) {
        if (timeout.isNegative()) { return Result::Err(error: RedisError::Config(detail: "reconnect_timeout cannot be negative: 0 is no limit")); }
        this.reconnectLimit = timeout;
        return Result::Ok(value: Unit::Unit);
    }

    // Another host, after those already named: a cluster's seed, or a sentinel. A configuration over a socket has one.
    public fn Result<Unit, RedisError> addHost(string host, int32 port) {
        if (this.kind == UrlTransport::Unix) { return Result::Err(error: RedisError::Config(detail: "a configuration over a Unix-domain socket has one place to connect to: add a host to a TCP or TLS one")); }
        if (host.length() == 0) { return Result::Err(error: RedisError::Config(detail: "the host is empty: give a name or an address")); }
        if (port < 1 || port > 65535) { return Result::Err(error: RedisError::Config(detail: "the port is a number from 1 to 65535")); }
        this.moreHosts.add(item: give host);
        this.morePorts.add(item: port);
        return Result::Ok(value: Unit::Unit);
    }

    // Which server to ask the sentinels for (role). Refused on a configuration that is not Sentinel's.
    public fn Result<Unit, RedisError> setSentinelRole(SentinelRole role) {
        if (!this.viaSentinels) { return Result::Err(error: RedisError::Config(detail: "role is a Sentinel setting: connect through sentinels with redis-sentinel:// or Config.sentinel")); }
        this.sentinelRole = role;
        return Result::Ok(value: Unit::Unit);
    }

    // The sentinels' own user and password, apart from the server's: AUTH to each sentinel. With no user, the password
    // is the sentinels' `default` user's. Refused on a configuration that is not Sentinel's.
    public fn Result<Unit, RedisError> setSentinelAuth(Optional<string> user, string password) {
        if (!this.viaSentinels) { return Result::Err(error: RedisError::Config(detail: "the sentinels' credentials are a Sentinel setting: connect through sentinels with redis-sentinel:// or Config.sentinel")); }
        if (password.length() == 0) { return Result::Err(error: RedisError::Config(detail: "the sentinels' password is empty: an empty password authenticates no one, so leave it out")); }
        bool emptyUser = match (user) { case Some(value: u): u.length() == 0; case None: false; };
        if (emptyUser) { return Result::Err(error: RedisError::Config(detail: "the sentinels' user is empty: give a user, or none for their default user")); }
        this.sentinelUserName = give user;
        this.sentinelSecret = Optional::Some(value: give password);
        return Result::Ok(value: Unit::Unit);
    }

    // Where a cluster sends a command that only reads (read_from). `Connection.connect` refuses it.
    public fn void setReadFrom(ReadFrom from) { this.readChoice = Optional::Some(value: from); }

    // How many MOVED and ASK one cluster call follows (max_redirects), 0 to 100. `Connection.connect` refuses it.
    public fn Result<Unit, RedisError> setMaxRedirects(int32 count) {
        if (count < 0 || count > MOST_REDIRECTS) { return Result::Err(error: maxRedirectsRefused()); }
        this.redirectChoice = Optional::Some(value: count);
        return Result::Ok(value: Unit::Unit);
    }

    // The bounds on what the server may send (resp::Limits).
    public fn void setLimits(Limits limits) { this.readerLimits = limits; }

    // Whether the connection names this library to the server (CLIENT SETINFO lib-name and lib-ver). On by default.
    public fn void setIdentity(bool on) { this.identify = on; }

    // ---- TLS. Each setter is refused on a configuration that is not TLS (rediss://, valkeys://, Config.tls). ----

    // How the server's certificate is checked (tls_verify). TlsVerify::None is refused while a CA is set: it would
    // never be used.
    public fn Result<Unit, RedisError> setTlsVerify(TlsVerify mode) {
        Optional<RedisError> notTls = this.tlsOnly();
        match (give notTls) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        this.verifyMode = mode;
        Optional<RedisError> bad = this.tlsAgreement();
        match (give bad) { case Some(value: e): { this.verifyMode = TlsVerify::Full; return Result::Err(error: give e); } case None: { } };
        return Result::Ok(value: Unit::Unit);
    }

    // The PEM file of roots to trust instead of the system's bundle (tls_ca).
    public fn Result<Unit, RedisError> setTlsTrustFile(string path) {
        Optional<RedisError> notTls = this.tlsOnly();
        match (give notTls) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        if (path.length() == 0) { return Result::Err(error: RedisError::Config(detail: "the CA file's path is empty")); }
        if (this.verifyMode == TlsVerify::None) { return Result::Err(error: unusedTrust()); }
        this.trustPath = Optional::Some(value: give path);
        this.trustBytes = Optional::None;
        return Result::Ok(value: Unit::Unit);
    }

    // PEM roots to trust instead of the system's bundle, as bytes.
    public fn Result<Unit, RedisError> setTlsTrustPem(DynamicArray<uint8> pem) {
        Optional<RedisError> notTls = this.tlsOnly();
        match (give notTls) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        if (pem.length() == 0) { return Result::Err(error: RedisError::Config(detail: "the CA's PEM is empty")); }
        if (this.verifyMode == TlsVerify::None) { return Result::Err(error: unusedTrust()); }
        this.trustBytes = Optional::Some(value: give pem);
        this.trustPath = Optional::None;
        return Result::Ok(value: Unit::Unit);
    }

    // A client certificate (its chain) and its key, from PEM files (tls_cert, tls_key). `password` decrypts an
    // encrypted key; "" for one that is not.
    public fn Result<Unit, RedisError> setTlsIdentityFiles(string certificate, string key, string password) {
        Optional<RedisError> notTls = this.tlsOnly();
        match (give notTls) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        if (certificate.length() == 0 || key.length() == 0) { return Result::Err(error: RedisError::Config(detail: "the certificate's or the key's path is empty")); }
        this.certPath = Optional::Some(value: give certificate);
        this.keyPath = Optional::Some(value: give key);
        this.certBytes = Optional::None;
        this.keyBytes = Optional::None;
        this.keySecret = DynamicArray.empty();
        this.keySecret.addAll(items: password.bytes());
        return Result::Ok(value: Unit::Unit);
    }

    // A client certificate (its chain) and its key, as PEM bytes. `password` decrypts an encrypted key; empty for one
    // that is not.
    public fn Result<Unit, RedisError> setTlsIdentityPem(DynamicArray<uint8> certificate, DynamicArray<uint8> key, DynamicArray<uint8> password) {
        Optional<RedisError> notTls = this.tlsOnly();
        match (give notTls) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        if (certificate.length() == 0 || key.length() == 0) { return Result::Err(error: RedisError::Config(detail: "the certificate's or the key's PEM is empty")); }
        this.certBytes = Optional::Some(value: give certificate);
        this.keyBytes = Optional::Some(value: give key);
        this.certPath = Optional::None;
        this.keyPath = Optional::None;
        this.keySecret = give password;
        return Result::Ok(value: Unit::Unit);
    }

    // The name the certificate must carry, and the SNI sent, in place of the host (tls_server_name): a host name, or
    // an IP address without brackets.
    public fn Result<Unit, RedisError> setTlsServerName(string name) {
        Optional<RedisError> notTls = this.tlsOnly();
        match (give notTls) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        Optional<RedisError> bad = checkName(name: name.bytes(), what: "tls_server_name");
        match (give bad) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        this.serverNameText = Optional::Some(value: give name);
        return Result::Ok(value: Unit::Unit);
    }

    // The versions a connection may agree on, from `min` to `max`.
    public fn Result<Unit, RedisError> setTlsVersions(TlsVersion min, TlsVersion max) {
        Optional<RedisError> notTls = this.tlsOnly();
        match (give notTls) { case Some(value: e): { return Result::Err(error: give e); } case None: { } };
        if (min.minor() > max.minor()) { return Result::Err(error: RedisError::Config(detail: "the lowest TLS version is above the highest")); }
        this.minVersion = min;
        this.maxVersion = max;
        return Result::Ok(value: Unit::Unit);
    }

    // TCP, TLS over TCP, or a Unix-domain socket.
    public const fn UrlTransport transport() { return this.kind; }
    // The host as given, without brackets ("127.0.0.1" when none was); "" for a socket. With several, the first.
    public const fn const ref string host() { return this.hostText; }
    public const fn int32 port() { return this.portNumber; }
    // How many hosts there are: 1, or more for a cluster's seeds or the sentinels; 1 over a socket.
    public const fn isize hostCount() { return 1 + this.moreHosts.length(); }
    // Host `index` (0 is `host()`) and its port.
    public const fn string hostAt(isize index) {
        if (index == 0) { return copy this.hostText; }
        return copy this.moreHosts[index - 1];
    }
    public const fn int32 portAt(isize index) {
        if (index == 0) { return this.portNumber; }
        return this.morePorts[index - 1];
    }
    // Whether the hosts are sentinels, to ask for the server (redis-sentinel://, rediss-sentinel://, Config.sentinel).
    public const fn bool viaSentinel() { return this.viaSentinels; }
    // The name the sentinels monitor the server by; None when the hosts are not sentinels.
    public const fn Optional<string> masterName() { return copy this.master; }
    public const fn SentinelRole role() { return this.sentinelRole; }
    public const fn Optional<string> sentinelUser() { return copy this.sentinelUserName; }
    public const fn Optional<string> sentinelPassword() { return copy this.sentinelSecret; }
    // A cluster's read_from and max_redirects; their defaults when they were not set.
    public const fn ReadFrom readFrom() { return match (this.readChoice) { case Some(value: r): r; case None: ReadFrom::Primary; }; }
    public const fn int32 maxRedirects() { return match (this.redirectChoice) { case Some(value: n): n; case None: DEFAULT_MAX_REDIRECTS; }; }
    // Whether either cluster option was set: a `Connection` refuses them.
    public const fn bool clusterOptions() {
        bool r = match (this.readChoice) { case Some(value: x): true; case None: false; };
        bool m = match (this.redirectChoice) { case Some(value: x): true; case None: false; };
        return r || m;
    }
    // The socket's path; "" for TCP.
    public const fn const ref string socketPath() { return this.pathText; }
    public const fn Optional<string> user() { return copy this.userName; }
    public const fn Optional<string> password() { return copy this.secret; }
    public const fn int64 database() { return this.dbIndex; }
    // The protocol asked for; None to speak RESP3, or RESP2 where the server refuses HELLO.
    public const fn Optional<Protocol> protocol() { return this.protocolChoice; }
    public const fn Optional<string> clientName() { return copy this.nameText; }
    public const fn Duration connectTimeout() { return this.connectLimit; }
    public const fn Duration commandTimeout() { return this.commandLimit; }
    // The keepalive's idle time; zero when it is off.
    public const fn Duration keepAlive() { return this.keepAliveIdle; }
    public const fn Limits limits() { return this.readerLimits; }
    public const fn bool identity() { return this.identify; }
    public const fn bool reconnect() { return this.reconnecting; }
    public const fn Duration reconnectTimeout() { return this.reconnectLimit; }
    // The TLS settings, which mean something only over TLS.
    public const fn TlsVerify tlsVerify() { return this.verifyMode; }
    // The CA file, or the CA's PEM, trusted instead of the system's bundle; neither when it is the system's.
    public const fn Optional<string> tlsTrustFile() { return copy this.trustPath; }
    public const fn const ref Optional<DynamicArray<uint8>> tlsTrustPem() { return this.trustBytes; }
    // A client certificate and its key, as files or as PEM; none of the four when there is none.
    public const fn Optional<string> tlsCertificateFile() { return copy this.certPath; }
    public const fn Optional<string> tlsKeyFile() { return copy this.keyPath; }
    public const fn const ref Optional<DynamicArray<uint8>> tlsCertificatePem() { return this.certBytes; }
    public const fn const ref Optional<DynamicArray<uint8>> tlsKeyPem() { return this.keyBytes; }
    // The key's password; empty for a key that is not encrypted.
    public const fn const ref DynamicArray<uint8> tlsKeyPassword() { return this.keySecret; }
    // The name the certificate must carry and the SNI sent: tls_server_name, or the host.
    public const fn string tlsServerName() { return match (this.serverNameText) { case Some(value: n): copy n; case None: copy this.hostText; }; }
    public const fn TlsVersion tlsMinVersion() { return this.minVersion; }
    public const fn TlsVersion tlsMaxVersion() { return this.maxVersion; }

    // This configuration for asking the sentinel at `host` and `port`: one host, the sentinels' own credentials, no
    // database (a sentinel has none), and the TLS name the sentinel's own (tls_server_name is the server's).
    const fn Config forSentinel(string host, int32 port) {
        Config c = copy this;
        c.hostText = give host;
        c.portNumber = port;
        c.moreHosts = DynamicArray.empty();
        c.morePorts = DynamicArray.empty();
        c.viaSentinels = false;
        c.master = Optional::None;
        c.userName = copy this.sentinelUserName;
        c.secret = copy this.sentinelSecret;
        c.sentinelUserName = Optional::None;
        c.sentinelSecret = Optional::None;
        c.dbIndex = 0i64;
        c.serverNameText = Optional::None;
        return give c;
    }

    // This configuration for one server at `host` and `port`, the sentinels' answer or a cluster's node: one host, no
    // cluster options (the cluster's own), everything else as given.
    const fn Config forNode(string host, int32 port) {
        Config c = copy this;
        c.hostText = give host;
        c.portNumber = port;
        c.moreHosts = DynamicArray.empty();
        c.morePorts = DynamicArray.empty();
        c.viaSentinels = false;
        c.readChoice = Optional::None;
        c.redirectChoice = Optional::None;
        return give c;
    }

    fn Optional<RedisError> tlsOnly() {
        if (this.kind == UrlTransport::Tls) { return Optional::None; }
        return refused(m: "TLS settings need a TLS connection: rediss://, valkeys:// or Config.tls");
    }

    // What the TLS options must agree on, once all are read: a certificate with its key, and no CA when nothing is
    // verified.
    fn Optional<RedisError> tlsAgreement() {
        bool cert = match (this.certPath) { case Some(value: p): true; case None: false; };
        bool key = match (this.keyPath) { case Some(value: p): true; case None: false; };
        if (cert != key) { return refused(m: "tls_cert and tls_key go together: give both, or neither"); }
        bool trust = match (this.trustPath) { case Some(value: p): true; case None: false; };
        if (trust && this.verifyMode == TlsVerify::None) { return Optional::Some(value: unusedTrust()); }
        return Optional::None;
    }

    // One URL option; None when it was honoured.
    fn Optional<RedisError> option(const ref string key, const ref string value) {
        if (key == "protocol") {
            if (value == "2") { this.protocolChoice = Optional::Some(value: Protocol::Resp2); return Optional::None; }
            if (value == "3") { this.protocolChoice = Optional::Some(value: Protocol::Resp3); return Optional::None; }
            return refused(m: "protocol is 2 or 3: protocol=3");
        }
        if (key == "reconnect") {
            if (value == "on") { this.reconnecting = true; return Optional::None; }
            if (value == "off") { this.reconnecting = false; return Optional::None; }
            return refused(m: "reconnect is on or off: reconnect=off");
        }
        if (key == "connect_timeout" || key == "command_timeout" || key == "reconnect_timeout") {
            Optional<Duration> d = seconds(b: value.bytes());
            Duration t = match (d) {
                case Some(value: v): v;
                case None: { return refused(m: key.concat(other: " is seconds, to the millisecond, and 0 for no limit: ").concat(other: key).concat(other: "=2.5")); }
            };
            if (key == "connect_timeout") { this.connectLimit = t; }
            else if (key == "command_timeout") { this.commandLimit = t; }
            else { this.reconnectLimit = t; }
            return Optional::None;
        }
        if (key == "client_name") {
            Optional<RedisError> bad = checkName(name: value.bytes(), what: "client_name");
            match (give bad) { case Some(value: e): { return Optional::Some(value: give e); } case None: { } };
            this.nameText = Optional::Some(value: copy value);
            return Optional::None;
        }
        if (key == "keepalive") {
            Optional<int64> n = wholeSeconds(b: value.bytes());
            int64 secs = match (n) { case Some(value: v): v; case None: -1i64; };
            if (secs < 0i64 || secs > MAX_KEEPALIVE_SECS) { return Optional::Some(value: keepAliveRefused()); }
            this.keepAliveIdle = Duration.fromSecs(s: secs);
            return Optional::None;
        }
        // RedisUrl has read a unix:// URL's database already.
        if (key == "db" && this.kind == UrlTransport::Unix) { return Optional::None; }
        if (key == "master_name" || key == "role") {
            if (!this.viaSentinels) { return refused(m: key.concat(other: " is a Sentinel option: connect through sentinels with redis-sentinel:// or rediss-sentinel://")); }
            if (key == "master_name") {
                if (value.length() == 0) { return refused(m: "master_name is empty: give the name the sentinels monitor the server by"); }
                this.master = Optional::Some(value: copy value);
                return Optional::None;
            }
            if (value == "master") { this.sentinelRole = SentinelRole::Master; return Optional::None; }
            if (value == "replica") { this.sentinelRole = SentinelRole::Replica; return Optional::None; }
            return refused(m: "role is master or replica: role=replica");
        }
        if (key == "read_from") {
            if (value == "primary") { this.readChoice = Optional::Some(value: ReadFrom::Primary); return Optional::None; }
            if (value == "replica") { this.readChoice = Optional::Some(value: ReadFrom::Replica); return Optional::None; }
            return refused(m: "read_from is primary or replica: read_from=replica");
        }
        if (key == "max_redirects") {
            Optional<int64> n = wholeSeconds(b: value.bytes());
            int64 count = match (n) { case Some(value: v): v; case None: -1i64; };
            if (count < 0i64 || count > cast<int64>(MOST_REDIRECTS)) { return Optional::Some(value: maxRedirectsRefused()); }
            this.redirectChoice = Optional::Some(value: cast<int32>(count));
            return Optional::None;
        }
        if (key == "tls_verify" || key == "tls_ca" || key == "tls_cert" || key == "tls_key" || key == "tls_server_name") {
            if (this.kind != UrlTransport::Tls) { return refused(m: key.concat(other: " is a TLS option: connect over rediss:// or valkeys://")); }
            return this.tlsOption(key: key, value: value);
        }
        return refused(m: "unknown URL option \"".concat(other: key).concat(other: "\": the options are protocol, connect_timeout, command_timeout, client_name, keepalive, reconnect and reconnect_timeout; a cluster's read_from and max_redirects; Sentinel's master_name and role; and over TLS tls_verify, tls_ca, tls_cert, tls_key and tls_server_name"));
    }

    // One TLS option, on a TLS URL. tls_cert and tls_key are checked together, and tls_ca against tls_verify, once
    // every option is read (tlsAgreement).
    fn Optional<RedisError> tlsOption(const ref string key, const ref string value) {
        if (key == "tls_verify") {
            if (value == "full") { this.verifyMode = TlsVerify::Full; return Optional::None; }
            if (value == "chain") { this.verifyMode = TlsVerify::Chain; return Optional::None; }
            if (value == "none") { this.verifyMode = TlsVerify::None; return Optional::None; }
            return refused(m: "tls_verify is full, chain or none: tls_verify=full");
        }
        if (key == "tls_server_name") {
            Optional<RedisError> bad = checkName(name: value.bytes(), what: "tls_server_name");
            match (give bad) { case Some(value: e): { return Optional::Some(value: give e); } case None: { } };
            this.serverNameText = Optional::Some(value: copy value);
            return Optional::None;
        }
        if (value.length() == 0) { return refused(m: key.concat(other: " is empty: give a file's path")); }
        if (key == "tls_ca") { this.trustPath = Optional::Some(value: copy value); return Optional::None; }
        if (key == "tls_cert") { this.certPath = Optional::Some(value: copy value); return Optional::None; }
        this.keyPath = Optional::Some(value: copy value);
        return Optional::None;
    }
}

fn Optional<RedisError> refused(const ref string m) { return Optional::Some(value: RedisError::Config(detail: copy m)); }

fn RedisError unusedTrust() {
    return RedisError::Config(detail: "a CA (tls_ca) is not used when nothing is verified (tls_verify=none): leave the CA out, or verify");
}

fn RedisError maxRedirectsRefused() {
    return RedisError::Config(detail: "max_redirects is a whole number from 0 to 100: max_redirects=5");
}

fn RedisError keepAliveRefused() {
    return RedisError::Config(detail: "keepalive is whole seconds up to 32767, and 0 for off: keepalive=15");
}

// The server's rule for a client name (validateClientName in networking.c): the bytes ! to ~. An empty name would
// set none, so it is refused rather than sent.
fn Optional<RedisError> checkName(ConstView<uint8> name, const ref string what) {
    if (name.length() == 0) { return refused(m: what.concat(other: " is empty: an empty name sets none, so leave it out")); }
    isize i = 0;
    while (i < name.length()) {
        if (name[i] < 33ui8 || name[i] > 126ui8) {
            return refused(m: what.concat(other: " cannot contain spaces, newlines or special characters: the server takes the bytes ! to ~"));
        }
        i = i + 1;
    }
    return Optional::None;
}

fn Optional<RedisError> checkPath(const ref string path) {
    if (path.length() == 0) { return refused(m: "the socket path is empty"); }
    if (path.length() > socketPathMax()) {
        isize most = socketPathMax();
        return refused(m: "the socket path is longer than the ${most} bytes this platform's sockets take");
    }
    return Optional::None;
}

// Seconds as a decimal number, to the millisecond: "5", "0.25", "2.5"; at most nine digits before the point.
fn Optional<Duration> seconds(ConstView<uint8> b) {
    isize n = b.length();
    isize i = 0;
    int64 whole = 0i64;
    while (i < n && b[i] >= 48ui8 && b[i] <= 57ui8) {
        whole = whole * 10i64 + cast<int64>(b[i] - 48ui8);
        i = i + 1;
    }
    if (i == 0 || i > MAX_SECONDS_DIGITS) { return Optional::None; }
    int64 millis = 0i64;
    if (i < n) {
        if (b[i] != 46ui8) { return Optional::None; }
        i = i + 1;
        isize digits = 0;
        while (i < n && b[i] >= 48ui8 && b[i] <= 57ui8 && digits < 3) {
            millis = millis * 10i64 + cast<int64>(b[i] - 48ui8);
            i = i + 1;
            digits = digits + 1;
        }
        if (digits == 0 || i < n) { return Optional::None; }
        while (digits < 3) { millis = millis * 10i64; digits = digits + 1; }
    }
    return Optional::Some(value: Duration.fromMillis(ms: whole * 1000i64 + millis));
}

// Whole seconds: one or more digits, at most nine.
fn Optional<int64> wholeSeconds(ConstView<uint8> b) {
    if (b.length() == 0 || b.length() > MAX_SECONDS_DIGITS) { return Optional::None; }
    int64 v = 0i64;
    isize i = 0;
    while (i < b.length()) {
        if (b[i] < 48ui8 || b[i] > 57ui8) { return Optional::None; }
        v = v * 10i64 + cast<int64>(b[i] - 48ui8);
        i = i + 1;
    }
    return Optional::Some(value: v);
}
