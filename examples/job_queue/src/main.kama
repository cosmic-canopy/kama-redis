// job_queue: a reliable work queue. A worker takes each job with BLMOVE, which moves it to a processing list in the
// same step, and removes it from there once the job is done. A worker that stops halfway, or a call that fails after
// it was sent (the connection lost: the move may have happened), leaves the job in the processing list, where the
// next worker's recovery finds it: no job is lost. This client never sends a command again on its own, since one
// that may have run is the caller's to decide about; the processing list is how this queue decides.
//
//   REDIS_URL=redis://127.0.0.1:6379 kama run examples/job_queue/kama.json
import { core::println, core::env, redis::Config, redis::Connection, redis::Command, redis::RedisError, redis::cmd,
         redis::reply, redis::replyOpt };

unsafe fn string serverUrl() {
    Optional<string> v = env(name: "REDIS_URL");
    return match (give v) { case Some(value: u): give u; case None: "redis://127.0.0.1:6379"; };
}

unsafe fn int32 work(ref Connection conn) {
    string queue = "example:queue";
    string processing = "example:processing";
    Command clear = cmd"DEL ${queue} ${processing}";
    Result<int64, RedisError> cleared = reply::<int64>(result: conn.call(command: clear));

    // The producer: three jobs, and one a worker took before it stopped, left in the processing list.
    Command produce = cmd"RPUSH ${queue} job-1 job-2 job-3";
    Result<int64, RedisError> produced = reply::<int64>(result: conn.call(command: produce));
    Command interrupted = cmd"RPUSH ${processing} job-0";
    Result<int64, RedisError> left = reply::<int64>(result: conn.call(command: interrupted));

    // Recovery: what a stopped worker left in processing goes back to the front of the queue.
    int32 recovered = 0;
    while (true) {
        Command back = cmd"LMOVE ${processing} ${queue} RIGHT LEFT";
        Result<Optional<string>, RedisError> moved = replyOpt::<string>(result: conn.call(command: back));
        bool more = match (moved) { case Ok(value: o): match (o) { case Some(value: j): true; case None: false; }; case Err(error: e): false; };
        if (!more) { break; }
        recovered = recovered + 1;
    }
    println(s: "recovered ${recovered} job(s) a stopped worker left");

    // The worker: take a job (waiting up to a second), do it, then remove it from processing.
    int32 done = 0;
    while (true) {
        int64 wait = 1;
        Command take = cmd"BLMOVE ${queue} ${processing} LEFT RIGHT ${wait}";
        Result<Optional<string>, RedisError> taken = replyOpt::<string>(result: conn.call(command: take));
        string job = match (give taken) {
            case Ok(value: o): match (give o) {
                case Some(value: j): give j;
                // Nothing within the second: the queue is empty.
                case None: { println(s: "the queue is empty"); return done; }
            };
            // The call may have moved a job before it failed: if so, the job is in processing, for the recovery.
            case Err(error: e): { println(s: e.message()); return -1; }
        };
        println(s: "doing ${job}");
        Command finish = cmd"LREM ${processing} 1 ${job}";
        Result<int64, RedisError> finished = reply::<int64>(result: conn.call(command: finish));
        match (finished) { case Ok(value: n): { } case Err(error: e): { println(s: e.message()); return -1; } };
        done = done + 1;
    }
}

fn int32 main() {
    Result<Config, RedisError> parsed = Config.parse(url: serverUrl());
    Config config = match (give parsed) { case Ok(value: c): give c; case Err(error: e): { println(s: e.message()); return 1; } };
    Result<Connection, RedisError> opened = Connection.connect(config: config);
    Connection conn = match (give opened) { case Ok(value: c): give c; case Err(error: e): { println(s: e.message()); return 1; } };
    int32 done = work(conn: conn);
    conn.close();
    println(s: "${done} job(s) done");
    if (done != 4) { return 1; }
    return 0;
}
