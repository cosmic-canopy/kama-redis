// scripts: a rate limiter as a Lua script, so that counting and expiring happen in one step on the server. The
// script is sent by its SHA-1 (EVALSHA), and by its source only when the server does not have it yet: NOSCRIPT means
// it never ran, so sending it again is safe.
//
//   REDIS_URL=redis://127.0.0.1:6379 kama run examples/scripts/kama.json
import { core::println, core::env, redis::Config, redis::Connection, redis::RedisError, redis::Script, redis::ScriptCall,
         redis::cmd, redis::reply };

unsafe fn string serverUrl() {
    Optional<string> v = env(name: "REDIS_URL");
    return match (give v) { case Some(value: u): give u; case None: "redis://127.0.0.1:6379"; };
}

// At most ARGV[1] calls per ARGV[2] seconds for the key: 1 when this call is allowed, 0 when it is not.
fn Script limiter() {
    return Script.of(source: "local n = redis.call('INCR', KEYS[1]) if n == 1 then redis.call('EXPIRE', KEYS[1], ARGV[2]) end if n > tonumber(ARGV[1]) then return 0 end return 1");
}

unsafe fn int32 allowed(ref Connection conn, const ref Script script, const ref string who) {
    ScriptCall call = ScriptCall.of(script: script);
    string key = "example:rate:".concat(other: who);
    int64 most = 3;
    int64 window = 60;
    call.addKey(value: key);
    call.addArg(value: most);
    call.addArg(value: window);
    Result<int64, RedisError> verdict = reply::<int64>(result: conn.eval(call: call));
    return match (verdict) { case Ok(value: n): cast<int32>(n); case Err(error: e): { println(s: e.message()); := -1; } };
}

fn int32 main() {
    Result<Config, RedisError> parsed = Config.parse(url: serverUrl());
    Config config = match (give parsed) { case Ok(value: c): give c; case Err(error: e): { println(s: e.message()); return 1; } };
    Result<Connection, RedisError> opened = Connection.connect(config: config);
    Connection conn = match (give opened) { case Ok(value: c): give c; case Err(error: e): { println(s: e.message()); return 1; } };
    Result<int64, RedisError> cleared = reply::<int64>(result: conn.call(command: cmd"DEL example:rate:ada"));
    Script script = limiter();
    int32 yes = 0;
    int32 no = 0;
    int32 i = 0;
    while (i < 5) {
        int32 v = allowed(conn: conn, script: script, who: "ada");
        if (v < 0) { conn.close(); return 1; }
        if (v == 1) { yes = yes + 1; } else { no = no + 1; }
        i = i + 1;
    }
    println(s: "5 calls: ${yes} allowed, ${no} refused");
    conn.close();
    if (yes != 3 || no != 2) { return 1; }
    return 0;
}
